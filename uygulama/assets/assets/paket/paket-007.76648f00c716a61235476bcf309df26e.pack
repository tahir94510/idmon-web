{"surum":1,"uretim":"2026-10-04","taksonomi_parmak_izi":"c38bfac816a16c83","motor_parmak_izi":"89f6a7c03067ceb5","tohum":20260902,"dilim":7,"madde_sayisi":500,"maddeler":[{"kimlik":"1afc70c13af0","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 14 kişilik A grubunun puan ortalaması 42, 28 kişilik B grubunun puan ortalaması 48 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"138","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"90","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"45","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"1.932","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"46","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 14 × 42","ifade":"588"},{"aciklama":"B grubu: 28 × 48","ifade":"1.344"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"1.932 / 42 = 46"},{"aciklama":"Ortak ortalama:","ifade":"46"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.334,"gorsel":null},{"kimlik":"c16b5e5ab593","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 24 ve a · b = 130 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"56","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"576","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"C","metin":"446","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"D","metin":"316","dogru":true,"yanilgi":null},{"harf":"E","metin":"836","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"24² − 2 × 130 = 576 − 260 = 316"},{"aciklama":"a² + b² değeri:","ifade":"316"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.985,"gorsel":null},{"kimlik":"af87bf8dafe0","sablon":"oran.paylastirma.artan_pay","govde":"990 TL paranın bir kısmı Ece'ye ve Kerem'e 3 : 7 oranında dağıtılmış, Ece'nin payı 285 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"1.940 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"99 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"210 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"665 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"40 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ece'nin payından birim payı çöz:","ifade":"3k = 285 → k = 95"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(3 + 7) × 95 = 950 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"990 − 950 = 40 TL"},{"aciklama":"Geriye kalan:","ifade":"40 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.345,"gorsel":null},{"kimlik":"72da84e0fe18","sablon":"yuzde.artis.indirim","govde":"Fiyatı 1.600 TL olan bir güneş gözlüğü, %10 indirimle satılmaktadır. Güneş gözlüğünün indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.590 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"B","metin":"1.760 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"1.440 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.296 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"160 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"1.600 × 10 / 100 = 160"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"1.600 − 160 = 1.440"},{"aciklama":"İndirimli fiyat:","ifade":"1.440 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.92,"gorsel":null},{"kimlik":"9906081794c0","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 6 kişilik bir grubun yaş ortalaması 40, ikinci bir grubun yaş ortalaması ise 85'tir. İki grup birleştiğinde yaş ortalaması 67 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"9 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"6 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"24 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"15 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"45 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"6·40 + n·85"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(6·40 + n·85) / (6 + n) = 67"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"6·(40 − 67) = n·(67 − 85)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"9 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.059,"gorsel":null},{"kimlik":"daff2b37b3c1","sablon":"mantik.dizi.sabit_fark","govde":"46, 63, 80, 97, 114, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"114","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"130","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"C","metin":"97","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"148","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"E","metin":"131","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"63−46=17 , 80−63=17 , 97−80=17 , 114−97=17"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerliyor:","ifade":"fark = 17"},{"aciklama":"Son terime bu farkı ekle:","ifade":"114 + 17 = 131"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"131"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.85,"gorsel":null},{"kimlik":"49b8dff96488","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 4, onlar basamağındaki rakam 6'dır. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"409","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"B","metin":"436","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"364","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"D","metin":"463","dogru":true,"yanilgi":null},{"harf":"E","metin":"43","dogru":false,"yanilgi":"sifir_basamak_atlandi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (4 − b) = 99 ⟹ 4 − b = 1 ⟹ b = 3"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 4 + 10 × 6 + 3 = 463"},{"aciklama":"Aranan sayı:","ifade":"463"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"e53bdb1a0b36","sablon":"problem.isci.ek_isci","govde":"20 işçi bir işi 28 günde bitirmektedir. Aynı iş 14 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"14 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"B","metin":"20 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"10 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"D","metin":"40 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"34 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"20 × 28 = 560"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"560 / 14 = 40"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"40 − 20 = 20"},{"aciklama":"Gereken ek işçi:","ifade":"20 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.687,"gorsel":null},{"kimlik":"a72f7f6383e3","sablon":"veri.ortalama.medyan_tek","govde":"108, 38, 26, 96, 182 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"104","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"96","dogru":true,"yanilgi":null},{"harf":"C","metin":"90","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"26","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"E","metin":"108","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"26 < 38 < 96 < 108 < 182"},{"aciklama":"Terim sayısı 5, yani tek: ortada tek bir terim var.","ifade":"5 → 3. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"96"},{"aciklama":"Ortanca:","ifade":"96"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.643,"gorsel":null},{"kimlik":"24536780d79b","sablon":"kume.temel.herkes_en_az_bir","govde":"Bir grupta 87 kişi vardır ve herkes bu iki dilden en az birini bilmektedir. İngilizce bilen 53, Almanca bilen 59 kişi olduğuna göre, her iki dili de bilen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"34","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"B","metin":"112","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"62","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"D","metin":"25","dogru":true,"yanilgi":null},{"harf":"E","metin":"28","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Herkes en az birini bildiği için birleşim grubun tamamıdır:","ifade":"s(A ∪ B) = 87"},{"aciklama":"Birleşim formülünü kesişim için çöz:","ifade":"s(A ∩ B) = 53 + 59 − 87 = 25"},{"aciklama":"Her iki dili de bilen kişi sayısı:","ifade":"25"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":2.091,"gorsel":null},{"kimlik":"593b12bc7293","sablon":"oran.paylastirma.fark","govde":"1.950 TL tutarındaki bir ödül, Zeynep ile Yusuf arasında 3/10 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.050 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"450 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"975 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"1.950 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"1.500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"3 + 10 = 13"},{"aciklama":"Bir parçanın değeri:","ifade":"1.950 / 13 = 150 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(10 − 3) × 150 = 1.050 TL"},{"aciklama":"Aradaki fark:","ifade":"1.050 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"6f04bf3d5f5d","sablon":"yuzde.artis.zam","govde":"Fiyatı 5.000 TL olan bir battaniye, %10 zamlanmıştır. Zamdan sonra battaniyenin fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"5.010 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"5.500 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"4.500 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"55.000 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"5.000 × 10/100 = 500 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"5.000 + 500 = 5.500 TL"},{"aciklama":"Zamlı fiyat:","ifade":"5.500 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.483,"gorsel":null},{"kimlik":"2f8233b0677d","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 4 kişinin yaş ortalaması 86. Gruba bir kişi daha katılınca ortalama 88'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"8","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"B","metin":"87","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"94","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"88","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"96","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"4 × 86 = 344"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"5 × 88 = 440"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"440 − 344 = 96"},{"aciklama":"Katılan kişinin yaşı:","ifade":"96"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.149,"gorsel":null},{"kimlik":"6f487dcf2681","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 13 ile bölümünden elde edilen bölüm 7, kalan ise 2'dir. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"117","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"B","metin":"93","dogru":true,"yanilgi":null},{"harf":"C","metin":"89","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"D","metin":"33","dogru":false,"yanilgi":"kalan_bolen_karisimi"},{"harf":"E","metin":"91","dogru":false,"yanilgi":"kalan_sifir_sayildi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"13 × 7 + 2 = 91 + 2 = 93"},{"aciklama":"Kalan (2) bölenden (13) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"93"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.972,"gorsel":null},{"kimlik":"531c8821c29a","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Trabzon'un Kış satışı silinmiş, yerine 0 yazılmıştır. Trabzon satırının gerçek yıllık toplamı 1.180 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"295 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"1.180 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"630 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"130 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"325 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Trabzon satırında görünen üç değeri topla:","ifade":"305 + 350 + 200 = 855"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"1.180 − 855 = 325"},{"aciklama":"Silinen değer:","ifade":"325 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.158,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[395,145,85,130]},{"ad":"Konya","degerler":[160,365,85,315]},{"ad":"Ankara","degerler":[205,340,55,140]},{"ad":"Trabzon","degerler":[305,350,200,0]}]}},{"kimlik":"0d0c7d9d9ac2","sablon":"mantik.dizi.sabit_oran","govde":"20, 40, 80, 160, 320, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"160","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"B","metin":"480","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"1.280","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"640","dogru":true,"yanilgi":null},{"harf":"E","metin":"320","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farklar sabit değil; oranlara bak:","ifade":"40÷20=2 , 80÷40=2 , 160÷80=2 , 320÷160=2"},{"aciklama":"Oran her adımda aynı, yani her terim bir öncekinin katı:","ifade":"oran = 2"},{"aciklama":"Son terimi bu oranla çarp:","ifade":"320 × 2 = 640"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"640"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"a9475f54b6d9","sablon":"problem.isci.kalan_is","govde":"Bir işi Kaan tek başına 144 günde, Kerem tek başına 72 günde bitirmektedir. Kaan işe başlayıp 80 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Kerem tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"40 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"216 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"108 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"72 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"E","metin":"32 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kaan günde işin 1/144'ünü yapıyor; 80 günde:","ifade":"80/144"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 80/144 = 4/9"},{"aciklama":"Kerem işin tamamını 72 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"4/9 × 72 = 32"},{"aciklama":"Kalan iş için gereken süre:","ifade":"32 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":2.272,"gorsel":null},{"kimlik":"142ba4e34621","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Ali, Mustafa ve Emre arasında sırasıyla 4, 7 ve 8 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 2.280 TL olduğuna göre, Emre'nin payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"120 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"960 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"480 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"760 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","meti