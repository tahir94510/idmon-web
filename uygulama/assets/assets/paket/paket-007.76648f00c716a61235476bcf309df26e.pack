null},{"harf":"D","metin":"450 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"10/3 saat","dogru":false,"yanilgi":"hareket_tek_hiz"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"90 × 5 = 450 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"135 − 90 = 45 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"450 / 45 = 10"},{"aciklama":"Yetişme süresi:","ifade":"10 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"476b37fd22ec","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|3x − 29| < 45 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"11","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"32","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"C","metin":"29","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"D","metin":"15","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"30","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"|A| < 45 eşitsizliği, A'nın −45 ile 45 arasında olması demektir:","ifade":"−45 < 3x − 29 < 45"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−16/3 < x < 74/3"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"30 tane"},{"aciklama":"Tam sayı adedi:","ifade":"30"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"10c8a12ccab6","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan domates, soğan ve armudun kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 120 kilogram satılmış ve toplam 90 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram domates ve soğan satılmıştır?","secenekler":[{"harf":"A","metin":"105","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},