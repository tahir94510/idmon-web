],"zorluk":-1.023,"gorsel":null},{"kimlik":"a542414cff82","sablon":"yuzde.faiz.anapara","govde":"Yıllık %20 basit faiz oranıyla 10 ay vadeye yatırılan bir anapara 6.000 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.000 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"3.600 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"42.000 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"36.000 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"30.000 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"10 ay için faiz katsayısı:","ifade":"20/100 × 10/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"6.000 / (20 × 10/1200) = 36.000 TL"},{"aciklama":"Anapara:","ifade":"36.000 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.589,"gorsel":null},{"kimlik":"a26087d29ad4","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|2x + 16| < 58 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"57","dogru":true,"yanilgi":null},{"harf":"B","metin":"56","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"C","metin":"28","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"D","metin":"41","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"59","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"|A| < 58 eşitsizliği, A'nın −58 ile 58 arasında olması demektir:","ifade":"−58 < 2x + 16 < 58"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−37 < x < 21"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"57 tane"},{"aciklama":"Tam sayı adedi:","ifade":"57"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.66,"gorsel":null},{"kimlik":"e0943fd5d1df","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"305 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"205 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"5 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"255 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"280 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"Antalya: 320 − 315 = 5 · İzmir: 255 − 30 = 225 · Konya: 280 − 25 = 255 · Trabzon: 275 − 70 = 205"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Konya, 255 adet"},{"aciklama":"En büyük artış:","ifade":"255 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":0.123,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[315,165,320,210]},{"ad":"İzmir","degerler":[30,200,255,60]},{"ad":"Konya","degerler":[25,385,280,295]},{"ad":"Trabzon","degerler":[70,75,275,375]}]}},{"kimlik":"734f61123cad","sablon":"mantik.esleme.yanlis_ifade","govde":"Ayşe, Buse, Kaan, Kerem ve Selin adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Kerem ile Ayşe yan yana oturmamaktadır.\n• Ayşe, Buse adlı kişinin hemen solundadır.\n• Buse, Selin adlı kişinin solunda oturmaktadır.\n• Kerem, Ayşe adlı kişinin solunda oturmaktadır.\n• Buse ortadaki koltukta oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Ayşe, Kaan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Kaan, Kerem adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"C","metin":"Ayşe ortadaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"D","metin":"Kerem, Kaan adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"E","metin":"Selin, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Kerem − Kaan − Ayşe − Buse − Selin"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Kerem, Kaan adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"68696f00a1b3","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Konya'ya giderken yolun ilk bölümünü saatte 80 km hızla 1 saatte, kalan bölümünü saatte 90 km hızla 3 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"320 km","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"B","metin":"340 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"350 km","dogru":true,"yanilgi":null},{"harf":"D","metin":"330 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"E","metin":"80 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"80 × 1 = 80 km"},{"aciklama":"İkinci bölüm:","ifade":"90 × 3 = 270 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"80 + 270 = 350 km"},{"aciklama":"Toplam yol:","ifade":"350 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":null},{"kimlik":"46b9a603f364","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"160 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"235 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"80 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"4 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"230 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Konya: 160/4 · İzmir: 235/32 · Eskişehir: 80/40 · Bursa: 230/14"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Konya satırında:","ifade":"160/4"},{"aciklama":"O satırın satış sayısı:","ifade":"160 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.14,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[160,4]},{"ad":"İzmir","degerler":[235,32]},{"ad":"Eskişehir","degerler":[80,40]},{"ad":"Bursa","degerler":[230,14]}]}},{"kimlik":"d278ed9038bc","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 17| = 10 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"389","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−189","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"7","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"189","dogru":true,"yanilgi":null},{"harf":"E","metin":"27","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 17 + 10 = 27 ve x = 17 − 10 = 7"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(17 + 10) × (17 − 10) = 17² − 10² = 189"},{"aciklama":"Köklerin çarpımı:","ifade":"189"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.604,"gorsel":null},{"kimlik":"4f0a4082a88c","sablon":"oran.temel.oran_ve_fark","govde":"Selin'in parasının Serkan'ın parasına oranı 13/9'dur. Aralarındaki fark 1.760 TL olduğuna göre Selin kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"440 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"9.680 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"5.720 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"3.960 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"1.040 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Selin 13k, Serkan 9k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"13k − 9k = 4k = 1.760"},{"aciklama":"Birim payı bul:","ifade":"k = 1.760 / 4 = 440"},{"aciklama":"Selin için:","ifade":"13 × 440 = 5.720"},{"aciklama":"Selin'in parası:","ifade":"5.720 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.653,"gorsel":null},{"kimlik":"42e5d2145c49","sablon":"yuzde.faiz.basit_ay","govde":"38.400 TL tutarındaki bir anapara, yıllık %40 basit faiz oranıyla 8 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"10.240 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"15.360 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"48.640 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.920 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"122.880 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"8 ay, yıl cinsinden:","ifade":"8/12"},{"aciklama":"Faiz tutarı:","ifade":"38.400 × 40/100 × 8/12 = 10.240 TL"},{"aciklama":"Elde edilen faiz:","ifade":"10.240 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"b1559d4e3657","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Sonbahar mevsiminde Ankara'nın yaptığı satışın Samsun'un yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"0,5","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"100","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"0,25","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"4","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"2","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sonbahar sütunundan iki değeri oku:","ifade":"Ankara: 200 · Samsun: 100"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"200 / 100 = 2"},{"aciklama":"Aranan oran:","ifade":"2"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[550,150,550,200]},{"ad":"İzmir","degerler":[450,500,450,250]},{"ad":"Samsun","degerler":[350,250,100,100]},{"ad":"Ankara","degerler":[600,400,200,400]}]}},{"kimlik":"056be19ef527","sablon":"cebir.denklem.kesirli","govde":"(x + 12)/4 − (x − 11)/3 = 8 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"72","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"B","metin":"−16","dogru":true,"yanilgi":null},{"harf":"C","metin":"16/7","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"D","metin":"−104","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−4","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Paydaların EKOK'u 12; denklemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(4, 3) = 12"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"3(x + 12) − 4(x − 11) = 96"},{"aciklama":"Benzer terimleri topla:","ifade":"−x + 80 = 96"},{"aciklama":"x'i yalıt:","ifade":"x = 16 / −1 = −16"},{"aciklama":"x değeri:","ifade":"−16"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":2.606,"gorsel":null},{"kimlik":"bbd4aa5acb46","sablon":"kume.temel.uc_kume","govde":"Bir sınıftaki 109 öğrenciden 53 tanesi tiyatro, 45 tanesi münazara, 38 tanesi müzik kulübüne üyedir. Tiyatro ve münazara kulüplerinin ikisine birden 25, tiyatro ve müzik kulüplerine 21, münazara ve müzik kulüplerine 15 öğrenci üyedir. Üç kulübe birden üye olan öğrenci sayısı 10'dur. Buna göre en az bir kulübe üye olan kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"136","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"24","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"C","metin":"85","dogru":true,"yanilgi":null},{"harf":"D","metin":"44","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"75","dogru":false,"yanilgi":"kume_uc_kume_kesisim"}],"cozum":[{"aciklama":"İçler-dışlar ilkesi: tekli toplamlardan ikili kesişimler düşülür, üçlü kesişim geri eklenir.","ifade":"|A∪B∪C| = |A|+|B|+|C| − |A∩B| − |A∩C| − |B∩C| + |A∩B∩C|"},{"aciklama":"Değerleri yerine koy:","ifade":"53 + 45 + 38 − 25 − 21 − 15 + 10 = 85"},{"aciklama":"Sınıf mevcudu bu hesaba girmez; geri kalan 24 öğrenci hiçbir kulübe üye değildir.","ifade":null},{"aciklama":"En az bir kulübe üye olan öğrenci sayısı:","ifade":"85"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":3.145,"gorsel":null},{"kimlik":"03f692caf102","sablon":"sayilar.mutlak.kokler_toplami","govde":"|6x − 57| = 21 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"19","dogru":true,"yanilgi":null},{"harf":"B","metin":"−19","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"13","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"D","metin":"6","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"E","metin":"7","dogru":false,"yanilgi":"mutlak_deger_dagitildi"}],"cozum":[{"aciklama":"Mutlak değer 21'e eşitse içerideki ifade 21 ya da −21 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"6x − 57 = 21 ⟹ x = 13"},{"aciklama":"İkinci durum:","ifade":"6x − 57 = −21 ⟹ x = 6"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"13 + 6 = 2 × 57 / 6 = 19"},{"aciklama":"Köklerin toplamı:","ifade":"19"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":2.091,"gorsel":null},{"kimlik":"2db142e73fae","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Antalya'nın yıllık toplam satışı, Ankara'nın yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"655 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"B","metin":"185 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"C","metin":"1.420 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"420 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"920 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Antalya satırını topla:","ifade":"385 + 45 + 255 + 235 = 920"},{"aciklama":"Ankara satırını topla:","ifade":"165 + 190 + 90 + 55 = 500"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"920 − 500 = 420"},{"aciklama":"Aradaki fark:","ifade":"420 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.297,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[265,320,310,255]},{"ad":"Antalya","degerler":[385,45,255,235]},{"ad":"Ankara","degerler":[165,190,90,55]},{"ad":"Eskişehir","degerler":[75,135,95,110]}]}},{"kimlik":"79304c7c3729","sablon":"oran.temel.oran_ve_toplam","govde":"Ayşe'nin parasının Mustafa'nın parasına oranı 9/7'dir. İkisinin parası toplam 8.640 TL olduğuna göre Ayşe kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"3.780 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"4.860 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"38.880 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"D","metin":"540 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"4.320 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Ayşe 9k, Mustafa 7k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"9k + 7k = 16k = 8.640"},{"aciklama":"Birim payı bul:","ifade":"k = 8.640 / 16 = 540"},{"aciklama":"Ayşe için:","ifade":"9 × 540 = 4.860"},{"aciklama":"Ayşe'nin parası:","ifade":"4.860 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.332,"gorsel":null},{"kimlik":"e4dce7b129e8","sablon":"yuzde.faiz.getiri_farki","govde":"18.000 TL, yıllık %45 faizle 3 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %40 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"5 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"900 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"2.025 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"225 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"300 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"45 − 40 = 5 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"5/100 × 3/12"},{"aciklama":"Anaparayla çarp:","ifade":"18.000 × 5/100 × 3/12 = 225 TL"},{"aciklama":"Getiri farkı:","ifade":"225 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.31,"gorsel":null},{"kimlik":"00574d297717","sablon":"mantik.esleme.yerlestirme","govde":"4, 5, 7, 9, 11 ve 15 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ + □ = □ × □ − □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"11","dogru":false,"yanilgi":null},{"harf":"B","metin":"7","dogru":false,"yanilgi":null},{"harf":"C","metin":"9","dogru":false,"yanilgi":null},{"harf":"D","metin":"4","dogru":true,"yanilgi":null},{"harf":"E","metin":"5","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Sağdaki çarpımdan bir sayı çıkınca, soldaki iki sayının toplamı kalmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"9 + 11 = 5 × 7 − 15"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"4"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null,"cevap_uzayi":true},{"kimlik":"d40306a29a31","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan üzüm, kiraz ve soğanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 210 kilogram satılmış ve toplam 162 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram kiraz ve soğan satılmıştır?","secenekler":[{"harf":"A","metin":"140","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"150","dogru":true,"yanilgi":null},{"harf":"C","metin":"180","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"190","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Üzüm: 6,2 − 5 = 1,2 TL, Kiraz: 3,1 − 2,5 = 0,6 TL, Soğan: 3,6 − 3 = 0,6 TL.","ifade":null},{"aciklama":"Kiraz ile soğanın kilogram kârı aynı. Hepsi 0,6 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"210 · 0,6 = 126 TL"},{"aciklama":"Fazladan 36 TL yalnızca üzüm yüzünden: onun her kilogramı 0,6 TL fazla kazandırıyor.","ifade":"üzüm = 36 ÷ 0,6 = 60 kg"},{"aciklama":"İstenen: 210 − 60 =","ifade":"150"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Üzüm","degerler":[5.0,6.2]},{"ad":"Kiraz","degerler":[2.5,3.1]},{"ad":"Soğan","degerler":[3.0,3.6]}]}},{"kimlik":"dfac061b76f5-1","sablon":"veri.blok.tablo_iki_soru","govde":"Bursa şubesinin satışı, toplam satışın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%65","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"%21","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"%74","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"%26","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bursa şubesinin satışını tablodan oku:","ifade":"156 adet"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam satış.","ifade":"600 adet"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"156 / 600 × 100 = %26"},{"aciklama":"Toplam içindeki pay:","ifade":"%26"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.378,"gorsel":{"tur":"tablo","baslik":"Şubelere göre aylık satış","etiketler":["Eskişehir","Bursa","Trabzon","Kon