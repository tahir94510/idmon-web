lse,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"E","metin":"ANFV","dogru":false,"yanilgi":"sifreleme_yonu_ters"}],"cozum":[{"aciklama":"Örnekten kaydırma miktarını bul; bütün harflerde aynı çıkmalı:","ifade":"O→Ü , K→S , U→Ç , L→Ş  ⟹ 8 sıra ileri"},{"aciklama":"Şifreyi çözmek, kuralı **ters** yönde uygulamaktır: her harf 8 sıra geri alınır.","ifade":null},{"aciklama":"Harfleri geri al:","ifade":"S→K , Ğ→A , Y→P , Ö→I"},{"aciklama":"Aranan kelime:","ifade":"KAPI"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":1.545,"gorsel":null},{"kimlik":"3d80067c3415","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Konya ile Bursa arasındaki yolu giderken 105 km/sa, dönerken 45 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"31,5 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"B","metin":"63 km/sa","dogru":true,"yanilgi":null},{"harf":"C","metin":"150 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"D","metin":"105 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"E","metin":"75 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/105 + x/45 = x·(150)/(105·45)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·150/(105·45)] = 2·105·45/150 = 63 km/sa"},{"aciklama":"Ortalama hız:","ifade":"63 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.629,"gorsel":null},{"kimlik":"485124c8334c","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 10 kişilik A grubunun puan ortalaması 46, 18 kişilik B grubunun puan ortalaması 60 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"55","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.540","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"154","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"53","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"106","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 10 × 46","ifade":"460"},{"aciklama":"B grubu: 18 × 60","ifade":"1.080"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"1.540 / 28 = 55"},{"aciklama":"Ortak ortalama:","ifade":"55"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.42,"gorsel":null},{"kimlik":"2d0738039ac7","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 19 ile bölümünden elde edilen bölüm 32, kalan ise 14'tür. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"608","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"B","metin":"594","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"C","metin":"622","dogru":true,"yanilgi":null},{"harf":"D","metin":"874","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"E","metin":"298","dogru":false,"yanilgi":"kalan_bolen_karisimi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"19 × 32 + 14 = 608 + 14 = 622"},{"aciklama":"Kalan (14) bölenden (19) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"622"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.536,"gorsel":null},{"kimlik":"f5b0d1febcb4","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 33 kişilik bir grubun yaş ortalaması 30, ikinci bir grubun yaş ortalaması ise 45'tir. İki grup birleştiğinde yaş ortalaması 36 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"33 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"42 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"22 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"15 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"55 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"33·30 + n·45"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(33·30 + n·45) / (33 + n) = 36"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"33·(30 − 36) = n·(36 − 45)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"22 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.304,"gorsel":null},{"kimlik":"2694485c6e01","sablon":"oran.paylastirma.artan_pay","govde":"870 TL paranın bir kısmı Kaan'a ve Mustafa'ya 3 : 2 oranında dağıtılmış, Kaan'ın payı 465 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"95 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"30 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"1.645 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"174 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"465 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kaan'ın payından birim payı çöz:","ifade":"3k = 465 → k = 155"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(3 + 2) × 155 = 775 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"870 − 775 = 95 TL"},{"aciklama":"Geriye kalan:","ifade":"95 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.091,"gorsel":null},{"kimlik":"b0ec14d0f10b","sablon":"yuzde.artis.zam","govde":"Fiyatı 3.100 TL olan bir halı, %35 zamlanmıştır. Zamdan sonra halının fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"4.185 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.085 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"3.135 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"2.015 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"111.600 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"3.100 × 35/100 = 1.085 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"3.100 + 1.085 = 4.185 TL"},{"aciklama":"Zamlı fiyat:","ifade":"4.185 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.818,"gorsel":null},{"kimlik":"4ad9a34948e2","sablon":"kume.olasilik.geri_koymadan","govde":"Bir torbada 6 tane mavi, 11 tane siyah top vardır. Torbadan rastgele çekilen bir top geri konulmadan ikinci bir top çekiliyor. Çekilen iki topun da mavi olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"12/17","dogru":false,"yanilgi":"olasilik_toplam_bir_asildi"},{"harf":"B","metin":"15/136","dogru":true,"yanilgi":null},{"harf":"C","metin":"81/136","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"D","metin":"36/289","dogru":false,"yanilgi":"olasilik_bagimsiz_sanildi"},{"harf":"E","metin":"30/289","dogru":false,"yanilgi":"olasilik_ornek_uzay"}],"cozum":[{"aciklama":"Birinci topun mavi olma olasılığı:","ifade":"6/17"},{"aciklama":"Top geri konulmadığı için ikinci çekilişte hem torbadaki toplam hem mavi sayısı birer azalır:","ifade":"5/16"},{"aciklama":"Peş peşe gerçekleşen olayların olasılıkları çarpılır:","ifade":"6/17 × 5/16 = 30/272 = 15/136"},{"aciklama":"İstenen olasılık:","ifade":"15/136"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":[],"zorluk":2.422,"gorsel":null},{"kimlik":"47253dd6b094","sablon":"veri.ortalama.medyan_tek","govde":"176, 152, 86, 60, 178, 62, 28 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"103","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"86","dogru":true,"yanilgi":null},{"harf":"C","metin":"60","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"D","metin":"106","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"152","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"28 < 60 < 62 < 86 < 152 < 176 < 178"},{"aciklama":"Terim sayısı 7, yani tek: ortada tek bir terim var.","ifade":"7 → 4. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"86"},{"aciklama":"Ortanca:","ifade":"86"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.413,"gorsel":null},{"kimlik":"472c6c4b7cef-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Kaan'ın payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"28.000 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"3.500 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"4.000 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"5.500 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"500 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"6 + 7 + 11 = 24"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"12.000 / 24 = 500 TL"},{"aciklama":"Kaan bu paylardan 7 tane alır:","ifade":"7 × 500 = 3.500 TL"},{"aciklama":"Kaan'ın payı:","ifade":"3.500 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.575,"gorsel":null,"grup":"472c6c4b7cef","grup_govde":"Bir ikramiye Elif, Kaan ve Deniz arasında sırasıyla 6, 7 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 12.000 TL'dir."},{"kimlik":"472c6c4b7cef-2","sablon":"oran.blok.paylastirma_uc_soru","govde":"Deniz'in payı, Elif'in payından kaç TL fazladır?","secenekler":[{"harf":"A","metin":"5.500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"8.500 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"500 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"D","metin":"4.000 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"2.500 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"6 + 7 + 11 = 24"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"12.000 / 24 = 500 TL"},{"aciklama":"İki pay arasındaki fark, katsayı farkı kadar paydır:","ifade":"(11 − 6) × 500 = 2.500 TL"},{"aciklama":"Aradaki fark:","ifade":"2.500 TL"}],"mikrobeceriler":["oran.paylastirma"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.229,"gorsel":null,"grup":"472c6c4b7cef","grup_govde":"Bir ikramiye Elif, Kaan ve Deniz arasında sırasıyla 6, 7 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 12.000 TL'dir."},{"kimlik":"472c6c4b7cef-3","sablon":"oran.blok.paylastirma_uc_soru","govde":"Elif, kendi payının %40'ını bağışlamıştır. Buna göre Elif'in elinde kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"1.800 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"3.300 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"4.200 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"1.200 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"7.200 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"6 + 7 + 11 = 24"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"12.000 / 24 = 500 TL"},{"aciklama":"Elif'in payı:","ifade":"6 × 500 = 3.000 TL"},{"aciklama":"Bağıştan sonra kalan, payın %60'ıdır:","ifade":"3.000 × 60/100 = 1.800 TL"},{"aciklama":"Elinde kalan:","ifade":"1.800 TL"}],"mikrobeceriler":["oran.paylastirma","yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.187,"gorsel":null,"grup":"472c6c4b7cef","grup_govde":"Bir ikramiye Elif, Kaan ve Deniz arasında sırasıyla 6, 7 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 12.000 TL'dir."},{"kimlik":"4b22f857902c","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede DEFTER kelimesi IZJOİL biçiminde yazılmaktadır. Aynı kurala göre YASTIK kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"DFYANP","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"B","metin":"STMODG","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"C","metin":"SFMADP","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"D","metin":"EUZÖOĞ","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"E","metin":"DTYONG","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"D→I (+6) , E→Z (−6) , F→J (+6) , T→O (−6) , E→İ (+6) , R→L (−6)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 6 ileri, çift sıradakiler 6 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı YASTIK kelimesine uygula:","ifade":"Y→D , A→T , S→Y , T→O , I→N , K→G"},{"aciklama":"Şifrelenmiş kelime:","ifade":"DTYONG"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"b6a6e5e56766","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 33 km sabit hızla yola çıkmıştır. 6 saat sonra aynı noktadan aynı yöne, saatte 66 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"6 saat","dogru":true,"yanilgi":null},{"harf":"B","metin":"3 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"C","metin":"4 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"2 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"198 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"33 × 6 = 198 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"66 − 33 = 33 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"198 / 33 = 6"},{"aciklama":"Yetişme süresi:","ifade":"6 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"764dd64e41f4","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"236 ile 1.031 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 24'e tam bölünür?","secenekler":[{"harf":"A","metin":"99","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"66","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"C","metin":"33","dogru":true,"yanilgi":null},{"harf":"D","metin":"265","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"E","metin":"273/8","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"24'e bölünen sayılar 24'ün katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"240 ve 1.008"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(1.008 − 240) / 24 + 1 = 33"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"33"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":0.058,"gorsel":null},{"kimlik":"4db8cac5b8b0","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 11 kişinin yaş ortalaması 61. Gruba bir kişi daha katılınca ortalama 63'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"85","dogru":true,"yanilgi":null},{"harf":"B","metin":"22","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"63","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"83","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"62","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"11 × 61 = 671"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"12 × 63 = 756"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"756 − 671 = 85"},{"aciklama":"Katılan kişinin yaşı:","ifade":"85"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.532,"gorsel":null},{"kimlik":"d1a80080e390","sablon":"oran.paylastirma.fark","govde":"4.950 TL tutarındaki bir ödül, Burak ile Ali arasında 3/8 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.475 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"4.950 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"2.250 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.350 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"3.600 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"3 + 8 = 11"},{"aciklama":"Bir parçanın değeri:","ifade":"4.950 / 11 = 450 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(8 − 3) × 450 = 2.250 TL"},{"aciklama":"Aradaki fark:","ifade":"2.250 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":0.862,"gorsel":null},{"kimlik":"3d4b872ba242","sablon":"yuzde.faiz.anapara","govde":"Yıllık %16 basit faiz oranıyla 4 ay vadeye yatırılan bir anapara 1.984 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"39.184 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"3.100 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"9.300 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"D","metin":"12.400 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"E","metin":"37.200 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"4 ay için faiz katsayısı:","ifade":"16/100 × 4/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"1.984 / (16 × 4/1200) = 37.200 TL"},{"aciklama":"Anapara:","ifade":"37.200 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.527,"gorsel":null},{"kimlik":"ccab6a961d54","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Samsun'un Sonbahar satışı silinmiş, yerine 0 yazılmıştır. Samsun satırının gerçek yıllık toplamı 420 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"765 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"420 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"110 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"75 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"105 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Samsun satırında görünen üç değeri topla:","ifade":"275 + 35 + 35 = 345"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"420 − 345 = 75"},{"aciklama":"Silinen değer:","ifade":"75 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.755,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Samsun","degerler":[275,35,0,35]},{"ad":"Trabzon","degerler":[320,205,25,75]},{"ad":"Ankara","degerler":[85,165,280,60]},{"ad":"Antalya","degerler":[125,295,140,360]}]}},{"kimlik":"248ad4329a69","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"440A4 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"10","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"B","metin":"6","dogru":true,"yanilgi":null},{"harf":"C","metin":"18","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"E","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A4 sayısı 4'ün katı olmalı ⟹ 4 ve 64"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"4 + 4 + 0 + A + 4 = 12 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"0 ve 6"},{"aciklama":"Bu rakamları topla:","ifade":"0 + 6 = 6"},{"aciklama":"Rakamların toplamı:","ifade":"6"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.836,"gorsel":null},{"kimlik":"a2dc46991f63","sablon":"cebir.esitsizlik.negatif_katsayi","govde":"−9(x − 9) > −20 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"12","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"B","metin":"11","dogru":true,"yanilgi":null},{"harf":"C","metin":"1","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"D","metin":"6","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"10","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−9x + 81 > −20"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−9x > −101"},{"aciklama":"Her iki tarafı −9 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner: büyüktür işareti küçüktür olur:","ifade":"x < 101/9"},{"aciklama":"Sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"11"},{"aciklama":"En büyük tam sayı:","ifade":"11"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":["cebir.ozdeslik"],"zorluk":2.107,"gorsel":null},{"kimlik":"ae11d28faca4","sablon":"mantik.dizi.artan_fark","govde":"40, 45, 51, 58, 66, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"71","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"B","metin":"57","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"C","metin":"66","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"74","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"75","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"45−40=5 , 51−45=6 , 58−51=7 , 66−58=8"},{"aciklama":"Farklar sabit değil; her adımda 1 artıyor. Sıradaki fark:","ifade":"8 + 1 = 9"},{"aciklama":"Son terime bu farkı ekle:","ifade":"66 + 9 = 75"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"75"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"250ae7f54a65","sablon":"problem.isci.birlikte","govde":"Bir işi Fatma tek başına 160 günde, Onur tek başına 96 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"60 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"256 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"64 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"D","metin":"128 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"E","metin":"96 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/160 + 1/96 = 256/15360"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"15360/256 = 60 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"60 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.005,"gorsel":null},{"kimlik":"da74f643d9dc","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"110 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"260 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"60 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"320 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"200 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"Konya: 140 − 100 = 40 · Eskişehir: 260 − 60 = 200 · Bursa: 105 − 45 = 60 · Samsun: 370 − 260 = 110"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Eskişehir, 200 adet"},{"aciklama":"En büyük artış:","ifade":"200 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":-0.013,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[100,30,140,365]},{"ad":"Eskişehir","degerler":[60,295,260,295]},{"ad":"Bursa","degerler":[45,215,105,360]},{"ad":"Samsun","degerler":[260,155,370,395]}]}},{"kimlik":"d8b2ed98f107","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Onur, Buse ve Ali arasında sırasıyla 8, 10 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 21.750 TL olduğuna göre, Onur'un payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"7.250 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"8.250 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"6.000 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"15.750 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"750 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"8 + 10 + 11 = 29"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"21.750 / 29 = 750 TL"},{"aciklama":"Onur bu paylardan 8 tane alır:","ifade":"8 × 750 = 6.000 TL"},{"aciklama":"Onur'un payı:","ifade":"6.000 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.352,"gorsel":null},{"kimlik":"281b26d7f14c","sablon":"yuzde.faiz.basit_ay","govde":"12.000 TL tutarındaki bir anapara, yıllık %10 basit faiz oranıyla 15 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"18.000 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"1.500 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"80 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"D","metin":"1.200 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"E","metin":"13.500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"15 ay, yıl cinsinden:","ifade":"15/12"},{"aciklama":"Faiz tutarı:","ifade":"12.000 × 10/100 × 15/12 = 1.500 TL"},{"aciklama":"Elde edilen faiz:","ifade":"1.500 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"4853a2ac42c5","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 6'ya bölümünden kalan 2, 9'a bölümünden kalan 5'tir. Bu koşulu sağlayan ve 433'ten büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"434","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"436","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"437","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"D","metin":"446","dogru":true,"yanilgi":null},{"harf":"E","metin":"482","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 4 eksik. Demek ki sayıya 4 eklenirse sayı hem 6 hem 9 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(6, 9) = 18"},{"aciklama":"Sayı 18'in katından 4 eksiktir. 433'ten büyük ilk böyle sayı:","ifade":"446"},{"aciklama":"Aranan sayı:","ifade":"446"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.24,"gorsel":null},{"kimlik":"ef329afa5332","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"150 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"130 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"65 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"75 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"16 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Bursa: 65/30 · Antalya: 130/28 · Konya: 150/56 · Ankara: 75/16"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Ankara satırında:","ifade":"75/16"},{"aciklama":"O satırın satış sayısı:","ifade":"75 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":-0.064,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Bursa","degerler":[65,30]},{"ad":"Antalya","degerler":[130,28]},{"ad":"Konya","degerler":[150,56]},{"ad":"Ankara","degerler":[75,16]}]}},{"kimlik":"9f97c4e42eaf","sablon":"oran.temel.oran_ve_fark","govde":"Mustafa'nın parasının Zeynep'in parasına oranı 7/3'tür. Aralarındaki fark 2.240 TL olduğuna göre Mustafa kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"5.600 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"3.920 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.680 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"1.568 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"E","metin":"560 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Mustafa 7k, Zeynep 3k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"7k − 3k = 4k = 2.240"},{"aciklama":"Birim payı bul:","ifade":"k = 2.240 / 4 = 560"},{"aciklama":"Mustafa için:","ifade":"7 × 560 = 3.920"},{"aciklama":"Mustafa'nın parası:","ifade":"3.920 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.125,"gorsel":null},{"kimlik":"7d28bc66228a","sablon":"yuzde.faiz.getiri_farki","govde":"3.000 TL, yıllık %20 faizle 8 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %12 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"240 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"160 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"8 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"30 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"20 − 12 = 8 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"8/100 × 8/12"},{"aciklama":"Anaparayla çarp:","ifade":"3.000 × 8/100 × 8/12 = 160 TL"},{"aciklama":"Getiri farkı:","ifade":"160 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.589,"gorsel":null},{"kimlik":"42256f3cb177","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Yaz mevsiminde Antalya'nın yaptığı satışın Konya'nın yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":true,"yanilgi":null},{"harf":"B","metin":"1,4","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"1","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"0,25","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"90","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Yaz sütunundan iki değeri oku:","ifade":"Antalya: 120 · Konya: 30"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"120 / 30 = 4"},{"aciklama":"Aranan oran:","ifade":"4"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.013,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[40,120,70,120]},{"ad":"Konya","degerler":[20,30,50,20]},{"ad":"Trabzon","degerler":[20,90,30,90]},{"ad":"Eskişehir","degerler":[110,30,80,80]}]}},{"kimlik":"ce65ffc2cce0","sablon":"mantik.dizi.carpansal","govde":"4, 18, 60, 186, 564, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"564","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"942","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"186","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"1.692","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"1.698","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimlerin farkları sabit değil; oran da tam çıkmıyor. Kural iki işlemli olabilir.","ifade":null},{"aciklama":"Her terim bir öncekinin katının sabitle toplamıdır:","ifade":"aₙ₊₁ = 3 · aₙ + 6"},{"aciklama":"Kuralı son terime uygula:","ifade":"3 × 564 + 6 = 1.698"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"1.698"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"b5619d7e4c6e","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 3 dakikada bir, B hattı 24 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"27 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"72 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"C","metin":"48 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"3 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"24 dakika","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"3 ve 24 sayılarının EKOK'u:","ifade":"EKOK(3, 24) = 24"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"24 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"da0845463b0a","sablon":"problem.isci.ek_isci","govde":"8 işçi bir işi 22 günde bitirmektedir. Aynı iş 11 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"16 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"4 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"C","metin":"8 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"11 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"E","metin":"19 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"8 × 22 = 176"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"176 / 11 = 16"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"16 − 8 = 8"},{"aciklama":"Gereken ek işçi:","ifade":"8 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.44,"gorsel":null},{"kimlik":"5a8dcf71f744","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon'un yıllık toplam satışı, Eskişehir'in yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"160 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"435 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"760 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"320 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"205 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"Trabzon satırını topla:","ifade":"350 + 175 + 120 + 115 = 760"},{"aciklama":"Eskişehir satırını topla:","ifade":"25 + 115 + 150 + 150 = 440"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"760 − 440 = 320"},{"aciklama":"Aradaki fark:","ifade":"320 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.472,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[370,130,355,240]},{"ad":"Trabzon","degerler":[350,175,120,115]},{"ad":"Eskişehir","degerler":[25,115,150,150]},{"ad":"Bursa","degerler":[20,290,245,395]}]}},{"kimlik":"a5a683e74749","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"175² − 155² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"6.600","dogru":true,"yanilgi":null},{"harf":"B","metin":"−6.600","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"400","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"3.500","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"54.650","dogru":false,"yanilgi":"iki_kare_farki_toplam"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(175 − 155)(175 + 155) = 20 × 330"},{"aciklama":"Çarpımı yap:","ifade":"20 × 330 = 6.600"},{"aciklama":"İşlemin sonucu:","ifade":"6.600"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"29d5188e4725-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Ayşe ile Ali birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"250 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"B","metin":"100 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"50 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"D","metin":"60 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"125 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/150 + 1/100 = 5/300"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"300/5 = 60 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"60 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.875,"gorsel":null,"grup":"29d5188e4725","grup_govde":"Bir işi Ayşe tek başına 150 günde, Ali tek başına 100 günde bitirmektedir."},{"kimlik":"29d5188e4725-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Ayşe işe başlayıp 3 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Ali tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"250 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"B","metin":"125 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"100 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"D","metin":"2 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"98 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ayşe bir günde işin 1/150'sini yapıyor; 3 gün çalışınca yaptığı iş:","ifade":"3/150"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(150 − 3)/150 = 49/50"},{"aciklama":"Ali işin tamamını 100 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"49/50 × 100 = 98"},{"aciklama":"Kalan iş için gereken süre:","ifade":"98 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.051,"gorsel":null,"grup":"29d5188e4725","grup_govde":"Bir işi Ayşe tek başına 150 günde, Ali tek başına 100 günde bitirmektedir."},{"kimlik":"6ecbf3275195","sablon":"oran.temel.oran_ve_toplam","govde":"Kerem'in parasının Mustafa'nın parasına oranı 8/5'tir. İkisinin parası toplam 7.020 TL olduğuna göre Kerem kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"540 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"4.320 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"18.720 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"D","metin":"3.510 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"2.700 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Kerem 8k, Mustafa 5k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"8k + 5k = 13k = 7.020"},{"aciklama":"Birim payı bul:","ifade":"k = 7.020 / 13 = 540"},{"aciklama":"Kerem için:","ifade":"8 × 540 = 4.320"},{"aciklama":"Kerem'in parası:","ifade":"4.320 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.174,"gorsel":null},{"kimlik":"999dff8d4afb","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 2.700 TL olan bir buzdolabı %30 kârla, maliyeti 2.800 TL olan bir kol saati ise %20 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"250 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"10 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"550 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"810 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"1.370 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"2.700 × 30/100 = 810 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"2.800 × 20/100 = 560 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"810 − 560 = 250 TL"},{"aciklama":"Net kâr:","ifade":"250 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.291,"gorsel":null},{"kimlik":"51e6a1a0a878","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan mandalina, kiraz ve patatesin kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 150 kilogram satılmış ve toplam 114 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram kiraz ve patates satılmıştır?","secenekler":[{"harf":"A","metin":"135","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"90","dogru":true,"yanilgi":null},{"harf":"C","metin":"126","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"100","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Mandalina: 5 − 4 = 1 TL, Kiraz: 2,6 − 2 = 0,6 TL, Patates: 4,1 − 3,5 = 0,6 TL.","ifade":null},{"aciklama":"Kiraz ile patatesin kilogram kârı aynı. Hepsi 0,6 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"150 · 0,6 = 90 TL"},{"aciklama":"Fazladan 24 TL yalnızca mandalina yüzünden: onun her kilogramı 0,4 TL fazla kazandırıyor.","ifade":"mandalina = 24 ÷ 0,4 = 60 kg"},{"aciklama":"İstenen: 150 − 60 =","ifade":"90"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Mandalina","degerler":[4.0,5.0]},{"ad":"Kiraz","degerler":[2.0,2.6]},{"ad":"Patates","degerler":[3.5,4.1]}]}},{"kimlik":"931efe523116","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 12 cm ve 8 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"5 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"4 cm","dogru":true,"yanilgi":null},{"harf":"C","metin":"20 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"D","metin":"2 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"},{"harf":"E","metin":"24 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"12 = 4·3   ve   8 = 4·2"},{"aciklama":"Ortak çarpan 4; kalan çarpanlar (3 ve 2) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(12, 8) = 4"},{"aciklama":"En büyük parça uzunluğu:","ifade":"4 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":-0.054,"gorsel":null},{"kimlik":"7401d21a5a81","sablon":"kume.olasilik.iki_torba","govde":"Birinci torbada 3 beyaz, 7 siyah top; ikinci torbada 8 beyaz, 9 siyah top vardır. Her torbadan rastgele birer top çekildiğine göre, çekilen iki topun da beyaz olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"107/170","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"B","metin":"12/85","dogru":true,"yanilgi":null},{"harf":"C","metin":"131/170","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"D","metin":"85/12","dogru":false,"yani