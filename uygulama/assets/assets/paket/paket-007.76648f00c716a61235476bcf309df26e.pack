n_ters"},{"harf":"B","metin":"%150","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"C","metin":"%250","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%60","dogru":true,"yanilgi":null},{"harf":"E","metin":"%960","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"1.600 − 640 = 960 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"960 / 1.600 × 100 = %60"},{"aciklama":"Zarar oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.862,"gorsel":null},{"kimlik":"b084fc3a8be1","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Kitap sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"285 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"380 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"275 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"1.140 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"228 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Ocak: 275 · Şubat: 280 · Mart: 290 · Nisan: 295"},{"aciklama":"Dördünü topla:","ifade":"275 + 280 + 290 + 295 = 1.140"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"1.140/4 = 285"},{"aciklama":"Dönem ortalaması:","ifade":"285 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.595,"gorsel":{"tur":"cizgi","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[275,280,290,295]}]}},{"kimlik":"a99784fa9a19-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Ece ile Merve birlikte çalışırsa aynı iş kaç günde biter?","secenekle