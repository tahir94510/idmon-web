47 ve a · b = 335 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"1.539","dogru":true,"yanilgi":null},{"harf":"B","metin":"869","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"2.879","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"D","metin":"1.874","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"E","metin":"2.209","dogru":false,"yanilgi":"tam_kare_orta_terim"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"47² − 2 × 335 = 2.209 − 670 = 1.539"},{"aciklama":"a² + b² değeri:","ifade":"1.539"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.383,"gorsel":null},{"kimlik":"a887820faa5f","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 13| = 5 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"−144","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"144","dogru":true,"yanilgi":null},{"harf":"C","metin":"194","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"18","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"8","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 13 + 5 = 18 ve x = 13 − 5 = 8"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(13 + 5) × (13 − 5) = 13² − 5² = 144"},{"aciklama":"Köklerin çarpımı:","ifade":"144"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.532,"gorsel":null},{"kimlik":"b9dea7ef329f","sablon":"oran.temel.zincir","govde":"Onur'un parasının Elif'in parasına oranı 13/12, Elif'in parasının Ali'nin parasına oranı 2/5 olarak veriliyor. Buna göre Onur'un parasının Ali'nin parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"65/24","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B",