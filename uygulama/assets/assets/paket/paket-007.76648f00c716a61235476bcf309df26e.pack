ir","Eskişehir","Ankara","Bursa"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[500,300,150,50]}]}},{"kimlik":"2803a818e3a8","sablon":"oran.ters.hiz_sure","govde":"Bir araç Trabzon ile İzmir arasını saatte 50 km hızla 12 saatte almaktadır. Aynı yolu saatte 30 km hızla giden bir araç kaç saatte alır?","secenekler":[{"harf":"A","metin":"7,2 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"12 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"C","metin":"10 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"D","metin":"20 saat","dogru":true,"yanilgi":null},{"harf":"E","metin":"14 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"Sabit yolda hız ile süre ters orantılıdır; yol çarpımlarıdır:","ifade":"50 × 12 = 600 km"},{"aciklama":"Yeni süre, aynı yolun yeni hıza bölümüdür:","ifade":"600 / 30 = 20 saat"},{"aciklama":"Geçen süre:","ifade":"20 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.036,"gorsel":null},{"kimlik":"73008527b1e8","sablon":"yuzde.kar_zarar.maliyet_bulma","govde":"Bir ürün %20 kârla 2.640 TL fiyatına satılmıştır. Ürünün maliyeti kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.620 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"440 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"2.112 TL","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"D","metin":"2.200 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"3.300 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Kâr her zaman maliyet üzerinden hesaplanır; satış fiyatı maliyetin %120'sidir:","ifade":"maliyet × 120/100 = 2.640"},{"aciklama":"Maliyet, satış fiyatının bu orana bölümüdür:","ifade":"2.640 × 100/120 = 2.200 TL"},{"aciklama":"Maliyet:","ifade":"2.200 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.836,"gorsel":null},{"kimlik":"854181048992","sablon":"mantik.esleme.yanlis_ifade","govde":"Ahmet, Ali, Burak, Kaan ve Onur adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ali, Kaan adlı kişinin solunda oturmaktadır.\n• Ahmet ile Burak yan yana oturmamaktadır.\n• Ahmet, Ali adlı kişinin solunda oturmaktadır.\n• Onur ile Kaan yan yana oturmamaktadır.\n• Burak, Ali adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Ali, Burak adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"B","metin":"Burak ortadaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"C","metin":"Burak, Onur adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"D","metin":"Ahmet, Onur adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"E","metin":"Onur, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ahmet − Onur − Burak − Ali − Kaan"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Ahmet, Onur adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"350819d80c0e","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 8| = 5 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"89","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"13","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"39","dogru":true,"yanilgi":null},{"harf":"D","metin":"3","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":