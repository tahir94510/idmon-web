false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"336 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"420 kişi","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"1.680 kişi","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Beş yılın üye sayılarını topla:","ifade":"300 + 320 + 360 + 380 + 320 = 1.680"},{"aciklama":"Ortalama, toplamın yıl sayısına bölümüdür:","ifade":"1.680 / 5 = 336"},{"aciklama":"Yıllık ortalama:","ifade":"336 kişi"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":{"tur":"cizgi","baslik":"Üye sayısı","etiketler":["2018","2019","2020","2021","2022"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[300,320,360,380,320]}]},"grup":"3e81e7f73c33","grup_govde":"İzmir şubesinin 2018–2022 yılları arasındaki üye sayısı yukarıdaki çizgi grafiğinde verilmiştir."},{"kimlik":"a78f29097552","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Merve, Mustafa, Serkan ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ahmet, Serkan adlı kişinin solunda oturmaktadır.\n• Ahmet, Yusuf adlı kişinin solunda oturmaktadır.\n• Serkan, Yusuf adlı kişinin solunda oturmaktadır.\n• Yusuf uçtaki koltuklarda oturmamaktadır.\n• Mustafa, Yusuf adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Mustafa, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Serkan, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Yusuf, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Ahmet, Serkan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"E","metin":"Merve, Serkan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"}],"