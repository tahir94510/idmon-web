"},{"harf":"C","metin":"64/13","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"D","metin":"184/143","dogru":true,"yanilgi":null},{"harf":"E","metin":"80/143","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 11) = 143"},{"aciklama":"Her kesri, paydası 143 olacak biçimde genişlet:","ifade":"12/13 = 132/143  (payı da paydayı da 11 ile çarptık)\n4/11 = 52/143  (payı da paydayı da 13 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"132/143 + 52/143 = 184/143"},{"aciklama":"İşlemin sonucu:","ifade":"184/143"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.313,"gorsel":null},{"kimlik":"ea08d678ce2e","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 500 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Otobüs tercih edenler, Otomobil tercih edenlerden kaç kişi fazladır?","secenekler":[{"harf":"A","metin":"150 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"125 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"25 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"D","metin":"225 kişi","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"1.250 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Dilimler yüzdedir; önce ikisinin yüzde farkını al:","ifade":"%35 − %10 = %25"},{"aciklama":"Yüzde farkını kişi sayısına çevir:","ifade":"500 × 25 / 100 = 125"},{"aciklama":"Aradaki fark:","ifade":"125 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.55,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Yürüyüş","Bisiklet","Otobüs","Otomobil"],"birim":"%","seriler":[{"ad":"Pay","degerler":[5,50,35,10]}]}},{"kimlik":"738ec07a9186","sablon":"mantik.dizi.toplamsal","govde":"2, 30, 32, 62, 94, ?\n\