":2.37,"gorsel":null},{"kimlik":"5a814213e94f","sablon":"problem.isci.kalan_is","govde":"Bir işi Selin tek başına 12 günde, Elif tek başına 4 günde bitirmektedir. Selin işe başlayıp 9 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Elif tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"3 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"16 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"8 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"4 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"E","metin":"1 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Selin günde işin 1/12'sini yapıyor; 9 günde:","ifade":"9/12"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 9/12 = 0,25"},{"aciklama":"Elif işin tamamını 4 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"0,25 × 4 = 1"},{"aciklama":"Kalan iş için gereken süre:","ifade":"1 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":0.957,"gorsel":null},{"kimlik":"1812430b638d","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 5/6 katı ile 2/3 katı arasındaki fark 30'dur.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"5","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"B","metin":"270/7","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"C","metin":"20","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"E","metin":"180","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(5/6 − 2/3) · x = 30"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(6, 3) = 6"},{"aciklama":"Her kesri, paydası 6 olacak biçimde genişlet:","ifade":"5/6  (paydası zaten 6)\n2/3 = 4/6