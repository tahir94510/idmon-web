dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"5 kamyon","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"D","metin":"8 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"E","metin":"20 kamyon","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Taşınan yük değişmiyor; değişen yalnızca onu kaç araca böldüğümüz. Araç sayısı ile kapasite **ters** orantılıdır, yani çarpımları sabittir.","ifade":null},{"aciklama":"Toplam yükü bul:","ifade":"10 × 4 = 40 ton"},{"aciklama":"Yeni kapasiteye böl:","ifade":"40 / 2 = 20"},{"aciklama":"Gereken kamyon sayısı:","ifade":"20 kamyon"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.322,"gorsel":null},{"kimlik":"0dd67442def4","sablon":"yuzde.kar_zarar.zarar_orani","govde":"Maliyeti 2.900 TL olan bir ürün 2.320 TL fiyatına satılmıştır. Bu satışta zarar yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%580","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"%20","dogru":true,"yanilgi":null},{"harf":"C","metin":"%25","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"D","metin":"%125","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%80","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"2.900 − 2.320 = 580 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"580 / 2.900 × 100 = %20"},{"aciklama":"Zarar oranı:","ifade":"%20"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.14,"gorsel":null},{"kimlik":"1bafae042097","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 21, s(B) = 23 ve s(A ∪ B) = 27'dir. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"21","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"4","dogru":true,"yanilgi":null},{"harf":"C","metin":"10","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"D","metin":"6","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"E","metin":"17","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 21 + 23 − 27 = 17"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"21 − 17 = 4"},{"aciklama":"s(A ∖ B):","ifade":"4"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.626,"gorsel":null},{"kimlik":"8f5f537cd121","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Bisiklet sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Bisiklet sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"235 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"200 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"150 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"600 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"120 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Mayıs: 235 · Haziran: 170 · Temmuz: 130 · Ağustos: 65"},{"aciklama":"Dördünü topla:","ifade":"235 + 170 + 130 + 65 = 600"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"600/4 = 150"},{"aciklama":"Dönem ortalaması:","ifade":"150 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-1.228,"gorsel":{"tur":"cizgi","baslik":"Bisiklet satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[235,170,130,65]}]}},{"kimlik":"8a3f68e93f68","sablon":"sayilar.rasyonel.toplama","govde":"8/9 + 6/7 işleminin sonucu kaçtır?","s