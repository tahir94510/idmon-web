m"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"d6d6bfc67062","sablon":"kume.sayma.iki_gruptan_secim","govde":"6 kadın ve 9 erkekten oluşan bir ekipten, 2 kadın ve 3 erkek içeren bir komite kurulacaktır. Bu komite kaç farklı biçimde kurulabilir?","secenekler":[{"harf":"A","metin":"99","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"B","metin":"1.260","dogru":true,"yanilgi":null},{"harf":"C","metin":"3.465","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"D","metin":"15.120","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"E","metin":"3.003","dogru":false,"yanilgi":"sayma_ozdes_nesne"}],"cozum":[{"aciklama":"Komitede görev ayrımı yok; kimin önce seçildiği sonucu değiştirmez. Böyle sırasız seçimlere kombinasyon denir ve C(n, r) ile yazılır: n kişiden r kişiyi seçme sayısı.","ifade":null},{"aciklama":"Kadınları seç. 6 kişiden 2 kişi:","ifade":"C(6, 2) = (6×5) / (2×1) = 15"},{"aciklama":"Erkekleri seç. 9 kişiden 3 kişi:","ifade":"C(9, 3) = (9×8×7) / (3×2×1) = 84"},{"aciklama":"İki seçim peş peşe yapıldığı için sayılar çarpılır:","ifade":"15 × 84 = 1.260"},{"aciklama":"Farklı komite sayısı:","ifade":"1.260"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"121eb97ff21a","sablon":"sayilar.uslu.us_kurallari","govde":"(2³)⁴ · (2²)⁵ : 2⁸ işleminin sonucu, 2 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"112","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"B","metin":"30","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"14","dogru":true,"yanilgi":null},{"harf":"D","metin":"6","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"E","metin":"−22","dogru":false,"yanilgi":"negatif_us_isaret"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(2³)⁴ = 2¹² , (2²)⁵ = 2¹⁰"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2¹² · 2¹⁰ = 2²²"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"2²² : 2⁸ = 2¹⁴