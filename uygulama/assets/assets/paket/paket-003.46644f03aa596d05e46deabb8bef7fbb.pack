iklama":"Zeynep'in sayısına x dersek Onur'unki x + 4 olur. İkinci koşulda Zeynep 12 tane verir, Onur 12 tane alır:","ifade":"x + 4 + 12 = 3·(x − 12)"},{"aciklama":"Denklemi çöz:","ifade":"x = 26"},{"aciklama":"Toplam x + (x + 4) olduğuna göre:","ifade":"56"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"6e231a5a36da","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Ankara şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"190 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"90 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"730 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"D","metin":"380 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"170 kişi","dogru":false,"yanilgi":"grafik_artis_egim"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 60 · 2021→2022: −130 · 2022→2023: −190 · 2023→2024: 170"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2022 → 2023: 730 − 540 = 190 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"190 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.663,"gorsel":{"tur":"cizgi","baslik":"Ankara şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[800,860,730,540,710]}]}},{"kimlik":"a59b77d25520","sablon":"oran.ters.uc_makine","govde":"Bir iş 12 işçiyle 60 günde, 3 işçiyle 240 günde bitmektedir. Aynı iş 5 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"150 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"},{"harf":"B","metin":"28,8 gün","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"C","metin":"144 gün","dogru"