de**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Otomobil diliminin payı:","ifade":"%15"},{"aciklama":"Kişi sayısı:","ifade":"1.560 × 15 / 100 = 234"},{"aciklama":"Kişi sayısı:","ifade":"234 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.141,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Yürüyüş","Bisiklet","Otobüs","Otomobil"],"birim":"%","seriler":[{"ad":"Pay","degerler":[40,25,20,15]}]}},{"kimlik":"31e77a0cd396","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 36| = 17 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"1.007","dogru":true,"yanilgi":null},{"harf":"B","metin":"19","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"C","metin":"−1.007","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"1.585","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"53","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 36 + 17 = 53 ve x = 36 − 17 = 19"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(36 + 17) × (36 − 17) = 36² − 17² = 1.007"},{"aciklama":"Köklerin çarpımı:","ifade":"1.007"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":2.07,"gorsel":null},{"kimlik":"b710c5e9d0f1","sablon":"problem.yas.toplam_iliskisi","govde":"Kaan ile Emre'nin bugünkü yaşları toplamı 40'tır, aralarındaki yaş farkı ise 20'dir.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"46","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"B","metin":"60","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"C","metin":"10","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"30","dogru":true,"yanilgi":null},{"harf":"E","metin":"38","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(40 + 20) / 2 = 30"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"40 − 30 = 10"},{"aciklama":"Büyük olanın yaşı:","ifade":"30"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-0.971,"gorsel":null},{"kimlik":"787a45a15f0e","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/1.500.000 olan bir haritada İzmir ile Eskişehir arasındaki uzaklık 12 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"1.800 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"27 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"C","metin":"12 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"180 km","dogru":true,"yanilgi":null},{"harf":"E","metin":"18 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"12 × 1.500.000 = 18.000.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"18.000.000 / 100.000 = 180 km"},{"aciklama":"Kısayol: ölçek 1/1.500.000 olduğunda haritadaki 1 cm, 15 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"180 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":1.039,"gorsel":null},{"kimlik":"17d9f0b02bb2","sablon":"yuzde.artis.azalma_orani","govde":"Bir atölyenin aylık üretimi 3.420 adetten 855 adede düşmüştür. Üretimdeki azalma yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%855","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"%300","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%2.565","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%75","dogru":true,"ya