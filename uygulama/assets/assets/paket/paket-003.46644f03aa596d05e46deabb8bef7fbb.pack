rk"},{"harf":"E","metin":"%250","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"5.400 − 2.160 = 3.240 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"3.240 / 5.400 × 100 = %60"},{"aciklama":"Zarar oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.862,"gorsel":null},{"kimlik":"dc4c185fc218","sablon":"mantik.dizi.terim_sirasi","govde":"24, 28, 32, 36, ... biçiminde devam eden dizide 168 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"38","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"B","metin":"42","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"36","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"168","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"37","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"28 − 24 = 4"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 24 + (n − 1)·4"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"168 = 24 + (n − 1)·4 → n = 37"},{"aciklama":"Terimin sırası:","ifade":"37"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.545,"gorsel":null},{"kimlik":"284e5368c278","sablon":"problem.sayi.ardisik_tek_cift","govde":"Ardışık 6 çift sayının toplamı 270'tir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"50","dogru":true,"yanilgi":null},{"harf":"B","metin":"45","dogru":false,"yanilgi":"ardisik_ortalama_terim_sayisi"},{"harf":"C","metin":"40","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"90","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"48","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"6 ardışık çift sayının toplamı, ortadaki iki sayının ortalamasının terim sayısıyla çarpım