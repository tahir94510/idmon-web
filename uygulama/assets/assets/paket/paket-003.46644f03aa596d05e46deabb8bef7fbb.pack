[55,90,50,40]},{"ad":"Tablet","degerler":[65,65,150,145]}]}},{"kimlik":"24ccfba1b6f0","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 14 litre yakıt tüketmektedir.\n\nBu araç İzmir'e yapılan 2.100 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"14 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"150 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"294 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.940 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"21 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"14/100 = x/2.100"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.100 × 14/100 = 294"},{"aciklama":"Tüketilen yakıt:","ifade":"294 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.222,"gorsel":null},{"kimlik":"256721e9c48b","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 3.220 TL olan bir termos %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"B","metin":"%37,5","dogru":true,"yanilgi":null},{"harf":"C","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"3.220 × 160/100 = 5.152 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"5.152 − 3.220 = 1.932 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"1.932/5.152 × 100 = 37,5"},{"aciklama":"Gereken indirim:","ifade":"%37,5"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.746,"gorsel":null},{"kimlik":"90eb8ce9208f","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 50 ve a · b = 238 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"2.024","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.548","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"2.500","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"2.976","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"E","metin":"2.262","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"50² − 2 × 238 = 2.500 − 476 = 2.024"},{"aciklama":"a² + b² değeri:","ifade":"2.024"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"13675334b932","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört ayda sattığı Kitap sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Ocak ayında satılan Kitap sayısı, dört ayda satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%100","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"%55","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"%2.250","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"%45","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"2.250 + 750 + 500 + 1.500 = 5.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"2.250 / 5.000 × 100 = %45"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%45"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":3.296,"gorsel":{"tur":"sutun","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[2250,750,500,1500]}]}},{"kimlik":"e2cd5237ed60","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 5/6 katı ile 2/3 katı arasındaki fark 6'dır.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"12","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"1","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"C","metin":"36","dogru":true,"yanilgi":null},{"harf":"D","metin":"4","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"54/7","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(5/6 − 2/3) · x = 6"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(6, 3) = 6"},{"aciklama":"Her kesri, paydası 6 olacak biçimde genişlet:","ifade":"5/6  (paydası zaten 6)\n2/3 = 4/6  (payı da paydayı da 2 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"5/6 − 4/6 = 1/6"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 6 × 6 = 36"},{"aciklama":"Aranan sayı:","ifade":"36"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":0.873,"gorsel":null},{"kimlik":"e4eac0c88a72","sablon":"mantik.dizi.toplamsal","govde":"14, 20, 34, 54, 88, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"230","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"142","dogru":true,"yanilgi":null},{"harf":"C","metin":"88","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"122","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"176","dogru":false,"yanilgi":"dizi_kurali_eksik"}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"14 + 20 = 34"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"20 + 34 = 54"},{"aciklama":"Son iki terimi topla:","ifade":"54 + 88 = 142"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"142"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"d26bad677322","sablon":"problem.yas.toplam_iliskisi","govde":"Fatma ile Ayşe'nin bugünkü yaşları toplamı 58'dir, aralarındaki yaş farkı ise 4'tür.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"27","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"31","dogru":true,"yanilgi":null},{"harf":"C","metin":"36","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"D","metin":"62","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"E","metin":"41","dogru":false,"yanilgi":"yas_farki_degisti"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(58 + 4) / 2 = 31"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"58 − 31 = 27"},{"aciklama":"Büyük olanın yaşı:","ifade":"31"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.38,"gorsel":null},{"kimlik":"067a1ef66336","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 20 kız öğrencinin matematik notu ortalaması 40, 12 erkek öğrencinin ortalaması ise 80'dir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"88","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"55","dogru":true,"yanilgi":null},{"harf":"C","metin":"65","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"1.760","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"20 × 40 + 12 × 80 = 1.760"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"20 + 12 = 32"},{"aciklama":"Sınıf ortalaması:","ifade":"1.760 / 32 = 55"},{"aciklama":"Sınıfın ortalaması:","ifade":"55"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"b270587f00de","sablon":"oran.paylastirma.artan_pay","govde":"950 TL paranın bir kısmı Mehmet'e ve Merve'ye 2 : 3 oranında dağıtılmış, Mehmet'in payı 360 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"115 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"1.850 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"50 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"190 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"540 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Mehmet'in payından birim payı çöz:","ifade":"2k = 360 → k = 180"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(2 + 3) × 180 = 900 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"950 − 900 = 50 TL"},{"aciklama":"Geriye kalan:","ifade":"50 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.291,"gorsel":null},{"kimlik":"6c7ecc384bf3","sablon":"yuzde.artis.indirim","govde":"Fiyatı 1.200 TL olan bir gömlek, %20 indirimle satılmaktadır. Gömleğin indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.440 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"1.180 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"240 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"768 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"960 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"1.200 × 20 / 100 = 240"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"1.200 − 240 = 960"},{"aciklama":"İndirimli fiyat:","ifade":"960 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.682,"gorsel":null},{"kimlik":"cfe94964b554","sablon":"sayilar.rasyonel.toplama","govde":"7/12 + 1/7 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"2/3","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"19/12","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"C","metin":"37/84","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"61/84","dogru":true,"yanilgi":null},{"harf":"E","metin":"8/19","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(12, 7) = 84"},{"aciklama":"Her kesri, paydası 84 olacak biçimde genişlet:","ifade":"7/12 = 49/84  (payı da paydayı da 7 ile çarptık)\n1/7 = 12/84  (payı da paydayı da 12 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"49/84 + 12/84 = 61/84"},{"aciklama":"İşlemin sonucu:","ifade":"61/84"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.072,"gorsel":null},{"kimlik":"b9351f0e3073","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 61. Öğrencilerden 3'ü sırasıyla 76, 45 ve 62 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"183","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"61","dogru":true,"yanilgi":null},{"harf":"C","metin":"122","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"244","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"123","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"61 × 4 = 244"},{"aciklama":"Bilinen notların toplamı:","ifade":"76 + 45 + 62 = 183"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"244 − 183 = 61"},{"aciklama":"Kalan öğrencinin notu:","ifade":"61"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"0824e543195a","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Fatma, Kaan, Onur ve Serkan adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Serkan, Fatma adlı kişinin solunda oturmaktadır.\n• Fatma uçtaki koltuklarda oturmamaktadır.\n• Ahmet, Onur adlı kişinin hemen solundadır.\n• Onur, Kaan adlı kişinin hemen solundadır.\n• Fatma ile Onur yan yana oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Onur, Kaan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"B","metin":"Fatma, Kaan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"C","metin":"Fatma, Serkan adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"D","metin":"Serkan, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"E","metin":"Serkan, Kaan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Serkan − Fatma − Ahmet − Onur − Kaan"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Fatma, Serkan adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"c561e48988b8","sablon":"problem.hareket.karsilikli","govde":"Aralarındaki uzaklık 960 km olan Trabzon ve Antalya şehirlerinden aynı anda birbirine doğru iki araç hareket ediyor. Araçların hızları sırasıyla 20 km/sa ve 100 km/sa olduğuna göre, araçlar kaç saat sonra karşılaşır?","secenekler":[{"harf":"A","metin":"16 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"B","metin":"8 saat","dogru":true,"yanilgi":null},{"harf":"C","metin":"9,6 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"D","metin":"12 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"48 saat","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Zıt yönde hareket eden araçlar için yaklaşma hızı, hızların toplamıdır:","ifade":"20 + 100 = 120 km/sa"},{"aciklama":"Karşılaşma süresi, aradaki uzaklığın yaklaşma hızına bölümüdür:","ifade":"960 / 120 = 8 saat"},{"aciklama":"Karşılaşma süresi:","ifade":"8 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":4.685,"gorsel":null},{"kimlik":"7e7863fac54d","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 7 kişinin yaş ortalaması 33. Gruptan bir kişi ayrılınca ortalama 34 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"27","dogru":true,"yanilgi":null},{"harf":"B","metin":"7","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"204","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"435","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"1","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 7 × 33","ifade":"231"},{"aciklama":"Ayrıldıktan sonra grup 6 kişi: 6 × 34","ifade":"204"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"231 − 204 = 27"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"27"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.163,"gorsel":null},{"kimlik":"cf4ccb945e9f","sablon":"oran.paylastirma.fark","govde":"4.800 TL tutarındaki bir ödül, Kaan ile Merve arasında 7/13 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.440 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"3.120 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"2.400 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"240 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"1.680 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"7 + 13 = 20"},{"aciklama":"Bir parçanın değeri:","ifade":"4.800 / 20 = 240 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(13 − 7) × 240 = 1.440 TL"},{"aciklama":"Aradaki fark:","ifade":"1.440 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"e3213841dfb6","sablon":"yuzde.artis.zam","govde":"Fiyatı 1.400 TL olan bir termos, %4 zamlanmıştır. Zamdan sonra termosun fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"1.344 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"56 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"7.000 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"1.404 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"1.456 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"1.400 × 4/100 = 56 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"1.400 + 56 = 1.456 TL"},{"aciklama":"Zamlı fiyat:","ifade":"1.456 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.813,"gorsel":null},{"kimlik":"2484d04fa964","sablon":"sayilar.uslu.negatif_us","govde":"(4⁻⁴)³ · 4¹⁰ işleminin sonucu, 4 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−120","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"B","metin":"−2","dogru":true,"yanilgi":null},{"harf":"C","metin":"2","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"22","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"E","metin":"3","dogru":false,"yanilgi":"us_us_toplandi"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(4⁻⁴)³ = 4⁻¹²"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"4⁻¹² · 4¹⁰ = 4⁻²"},{"aciklama":"Aranan kuvvet:","ifade":"−2"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.07,"gorsel":null},{"kimlik":"26814826d9d6","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 20 kişilik A grubunun puan ortalaması 72, 24 kişilik B grubunun puan ortalaması 50 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"61","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"122","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"60","dogru":true,"yanilgi":null},{"harf":"D","metin":"132","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"2.640","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 20 × 72","ifade":"1.440"},{"aciklama":"B grubu: 24 × 50","ifade":"1.200"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"2.640 / 44 = 60"},{"aciklama":"Ortak ortalama:","ifade":"60"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.524,"gorsel":null},{"kimlik":"b1f8c70860af","sablon":"cebir.ozdeslik.katsayi","govde":"(10x + 5) · (4x + 6) çarpımı düzenlendiğinde x'li terimin katsayısı kaç olur?","secenekler":[{"harf":"A","metin":"150","dogru":false,"yanilgi":"terimleri_toplayip_carpma"},{"harf":"B","metin":"70","dogru":false,"yanilgi":"carpraz_terim_eslesmesi"},{"harf":"C","metin":"60","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"D","metin":"40","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"80","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Parantezleri dağıt; her terim öbürünün her terimiyle çarpılır:","ifade":"10x · 4x + 10x · 6 + 5 · 4x + 5 · 6"},{"aciklama":"x'li terimler ortadaki iki çarpımdan gelir:","ifade":"10 · 6 · x + 5 · 4 · x"},{"aciklama":"Katsayıları topla:","ifade":"60 + 20 = 80"},{"aciklama":"x'li terimin katsayısı:","ifade":"80"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"25fdd0a8bf62","sablon":"kume.sayma.yol_gidis_donus","govde":"Bursa ile Ankara arasında 3, Ankara ile Antalya arasında 10, Antalya ile Trabzon arasında 4 farklı yol vardır. Bir yolcu Bursa şehrinden Trabzon şehrine gidip, dönüşte gidişte kullandığı yolların hiçbirini kullanmadan geri dönecektir. Bu yolculuk kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"1.680","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"B","metin":"12.960","dogru":false,"yanilgi":"gidis_donus_ayri_sayildi"},{"harf":"C","metin":"14.280","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"D","metin":"14.400","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"E","metin":"6.480","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Gidişte her ayakta bağımsız seçim yapılır; sayılar çarpılır:","ifade":"3 × 10 × 4 = 120"},{"aciklama":"Dönüşte her ayakta bir yol kullanılmış durumdadır:","ifade":"2 × 9 × 3 = 54"},{"aciklama":"Gidiş ve dönüş peş peşe yapıldığı için çarpılır:","ifade":"120 × 54 = 6.480"},{"aciklama":"Yolculuğun yapılabileceği biçim sayısı:","ifade":"6.480"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":2.272,"gorsel":null},{"kimlik":"b3133d58750e","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Mustafa, Serkan ve Buse arasında sırasıyla 4, 7 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 5.280 TL olduğuna göre, Buse'nin payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.640 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"240 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"960 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"19.360 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"1.760 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"4 + 7 + 11 = 22"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"5.280 / 22 = 240 TL"},{"aciklama":"Buse bu paylardan 11 tane alır:","ifade":"11 × 240 = 2.640 TL"},{"aciklama":"Buse'nin payı:","ifade":"2.640 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.677,"gorsel":null},{"kimlik":"40baefed8913","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 14 kişilik bir grubun yaş ortalaması 35, ikinci bir grubun yaş ortalaması ise 85'tir. İki grup birleştiğinde yaş ortalaması 57 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"14 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"11 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"50 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"25 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"42 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"14·35 + n·85"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(14·35 + n·85) / (14 + n) = 57"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"14·(35 − 57) = n·(57 − 85)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"11 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.135,"gorsel":null},{"kimlik":"aaa7839edd07","sablon":"yuzde.faiz.anapara","govde":"Yıllık %20 basit faiz oranıyla 3 ay vadeye yatırılan bir anapara 840 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"16.800 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"17.640 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"4.200 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"D","metin":"1.400 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"E","metin":"5.600 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"3 ay için faiz katsayısı:","ifade":"20/100 × 3/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"840 / (20 × 3/1200) = 16.800 TL"},{"aciklama":"Anapara:","ifade":"16.800 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.589,"gorsel":null},{"kimlik":"95d0dbc0b7d8","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"10 · 2² · 2⁵ · 9⁰ + 2⁵ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"1.312","dogru":true,"yanilgi":null},{"harf":"B","metin":"32","dogru":false,"yanilgi":"sifir_us"},{"harf":"C","metin":"10.272","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"40.960","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"E","metin":"1.248","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"9⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2² · 2⁵ = 2⁷ = 128"},{"aciklama":"Katsayıyla çarp:","ifade":"10 × 128 = 1.280"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"1.280 + 32 = 1.312"},{"aciklama":"İşlemin sonucu:","ifade":"1.312"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.079,"gorsel":null},{"kimlik":"801a26e8cad7","sablon":"mantik.esleme.yanlis_ifade","govde":"Ali, Fatma, Mehmet, Onur ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ali, Mehmet adlı kişinin solunda oturmaktadır.\n• Yusuf uçtaki koltuklarda oturmamaktadır.\n• Fatma, Mehmet adlı kişinin solunda oturmaktadır.\n• Mehmet uçtaki koltuklarda oturmamaktadır.\n• Yusuf, Fatma adlı kişinin solunda oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Ali, Yusuf adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"B","metin":"Mehmet, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"C","metin":"Fatma ortadaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"D","metin":"Onur, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Yusuf, Ali adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ali − Yusuf − Fatma − Mehmet − Onur"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Ali, Yusuf adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"22dc6f20b654","sablon":"veri.ortalama.medyan_tek","govde":"28, 92, 134, 172, 34, 188, 154, 32, 66 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"134","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"100","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"92","dogru":true,"yanilgi":null},{"harf":"D","metin":"34","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"E","metin":"108","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"28 < 32 < 34 < 66 < 92 < 134 < 154 < 172 < 188"},{"aciklama":"Terim sayısı 9, yani tek: ortada tek bir terim var.","ifade":"9 → 5. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"92"},{"aciklama":"Ortanca:","ifade":"92"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.267,"gorsel":null},{"kimlik":"2c0f24ca6349","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Antalya'ya giderken yolun ilk bölümünü saatte 100 km hızla 1 saatte, kalan bölümünü saatte 50 km hızla 2 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"150 km","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"B","metin":"250 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"C","metin":"200 km","dogru":true,"yanilgi":null},{"harf":"D","metin":"100 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"225 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"100 × 1 = 100 km"},{"aciklama":"İkinci bölüm:","ifade":"50 × 2 = 100 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"100 + 100 = 200 km"},{"aciklama":"Toplam yol:","ifade":"200 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"e7a4383c5d74","sablon":"oran.temel.oran_ve_fark","govde":"Merve'nin parasının Emre'nin parasına oranı 9/7'dir. Aralarındaki fark 720 TL olduğuna göre Merve kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"360 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"2.520 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"5.760 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"3.240 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"405 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Merve 9k, Emre 7k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"9k − 7k = 2k = 720"},{"aciklama":"Birim payı bul:","ifade":"k = 720 / 2 = 360"},{"aciklama":"Merve için:","ifade":"9 × 360 = 3.240"},{"aciklama":"Merve'nin parası:","ifade":"3.240 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":2.793,"gorsel":null},{"kimlik":"dd7c29f3be5f","sablon":"yuzde.faiz.basit_ay","govde":"19.200 TL tutarındaki bir anapara, yıllık %45 basit faiz oranıyla 18 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"155.520 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"32.160 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"8.640 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"D","metin":"480 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"12.960 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"18 ay, yıl cinsinden:","ifade":"18/12"},{"aciklama":"Faiz tutarı:","ifade":"19.200 × 45/100 × 18/12 = 12.960 TL"},{"aciklama":"Elde edilen faiz:","ifade":"12.960 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.566,"gorsel":null},{"kimlik":"998adb709be3","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 14 kişinin yaş ortalaması 80. Gruba bir kişi daha katılınca ortalama 84'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"140","dogru":true,"yanilgi":null},{"harf":"B","metin":"84","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"82","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"136","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"56","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"14 × 80 = 1.120"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"15 × 84 = 1.260"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"1.260 − 1.120 = 140"},{"aciklama":"Katılan kişinin yaşı:","ifade":"140"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.711,"gorsel":null},{"kimlik":"e95130ee7a12","sablon":"sayilar.uslu.us_kurallari","govde":"(7²)⁵ · (7²)² : 7¹⁰ işleminin sonucu, 7 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"1","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"B","metin":"24","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"4","dogru":true,"yanilgi":null},{"harf":"D","metin":"−14","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"E","metin":"30","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(7²)⁵ = 7¹⁰ , (7²)² = 7⁴"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"7¹⁰ · 7⁴ = 7¹⁴"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"7¹⁴ : 7¹⁰ = 7⁴"},{"aciklama":"Aranan kuvvet:","ifade":"4"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.495,"gorsel":null},{"kimlik":"490efb047c14","sablon":"mantik.esleme.yerlestirme","govde":"2, 6, 7, 10, 11 ve 14 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ + □ + □ = □ × □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"7","dogru":false,"yanilgi":null},{"harf":"B","metin":"6","dogru":true,"yanilgi":null},{"harf":"C","metin":"10","dogru":false,"yanilgi":null},{"harf":"D","metin":"14","dogru":false,"yanilgi":null},{"harf":"E","metin":"11","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Sağdaki iki sayının çarpımı, soldaki üç sayının toplamına eşit olmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"7 + 10 + 11 = 2 × 14"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"6"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.537,"gorsel":null,"cevap_uzayi":true},{"kimlik":"1c8699fbf4b8","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Bursa'nın Sonbahar satışı silinmiş, yerine 0 yazılmıştır. Bursa satırının gerçek yıllık toplamı 740 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"740 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"265 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"C","metin":"180 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"185 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"125 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bursa satırında görünen üç değeri topla:","ifade":"355 + 120 + 140 = 615"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"740 − 615 = 125"},{"aciklama":"Silinen değer:","ifade":"125 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.613,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Bursa","degerler":[355,120,0,140]},{"ad":"Trabzon","degerler":[390,365,180,305]},{"ad":"Antalya","degerler":[180,345,295,370]},{"ad":"Eskişehir","degerler":[210,105,385,365]}]}},{"kimlik":"c9359c8fc604","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Bursa ile Konya arasındaki yolu giderken 40 km/sa, dönerken 88 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"40 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"128 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"C","metin":"55 km/sa","dogru":true,"yanilgi":null},{"harf":"D","metin":"64 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"27,5 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/40 + x/88 = x·(128)/(40·88)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·128/(40·88)] = 2·40·88/128 = 55 km/sa"},{"aciklama":"Ortalama hız:","ifade":"55 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.47,"gorsel":null},{"kimlik":"6dd57a8afab0","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 7 tek doğal sayının toplamı 203'tür.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"35","dogru":true,"yanilgi":null},{"harf":"B","metin":"33","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"C","metin":"23","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"},{"harf":"D","metin":"29","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"32","dogru":false,"yanilgi":"ardisik_adim_hatasi"}],"cozum":[{"aciklama":"Ardışık 7 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"203 / 7 = 29"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 3 adım ileridedir:","ifade":"29 + 2 × 3 = 35"},{"aciklama":"En büyük sayı:","ifade":"35"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"ec570101e3c0","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 12/x = 19 olduğuna göre x² + 12²/x² kaçtır?","secenekler":[{"harf":"A","metin":"337","dogru":true,"yanilgi":null},{"harf":"B","metin":"385","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"313","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"D","metin":"349","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"361","dogru":false,"yanilgi":"tam_kare_orta_terim"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 12/x)² = x² + 2 · x · 12/x + 12²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 12 kalır:","ifade":"19² = x² + 12²/x² + 24"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 12²/x² = 361 − 24 = 337"},{"aciklama":"İstenen değer:","ifade":"337"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.665,"gorsel":null},{"kimlik":"42816202d566","sablon":"oran.temel.oran_ve_toplam","govde":"Ayşe'nin parasının Ece'nin parasına oranı 13/7'dir. İkisinin parası toplam 6.000 TL olduğuna göre Ayşe kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"300 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"3.900 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"3.000 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"13.000 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"E","metin":"2.100 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Ayşe 13k, Ece 7k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"13k + 7k = 20k = 6.000"},{"aciklama":"Birim payı bul:","ifade":"k = 6.000 / 20 = 300"},{"aciklama":"Ayşe için:","ifade":"13 × 300 = 3.900"},{"aciklama":"Ayşe'nin parası:","ifade":"3.900 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.035,"gorsel":null},{"kimlik":"d98eecefe5f2","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"55 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"100 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"295 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"155 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"225 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"Antalya: 240 − 100 = 140 · Trabzon: 325 − 270 = 55 · Samsun: 225 − 70 = 155 · Konya: 195 − 95 = 100"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Samsun, 155 adet"},{"aciklama":"En büyük artış:","ifade":"155 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":-0.096,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[100,55,240,365]},{"ad":"Trabzon","degerler":[270,315,325,285]},{"ad":"Samsun","degerler":[70,270,225,60]},{"ad":"Konya","degerler":[95,225,195,140]}]}},{"kimlik":"dd3c5716acb5","sablon":"yuzde.faiz.getiri_farki","govde":"6.000 TL, yıllık %20 faizle 4 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %18 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"30 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"B","metin":"40 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"2 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"120 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"20 − 18 = 2 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"2/100 × 4/12"},{"aciklama":"Anaparayla çarp:","ifade":"6.000 × 2/100 × 4/12 = 40 TL"},{"aciklama":"Getiri farkı:","ifade":"40 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.711,"gorsel":null},{"kimlik":"0a82bb5c8f57","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"305 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"45 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"20 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"350 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"340 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Eskişehir: 350/50 · Bursa: 305/20 · Konya: 340/24 · Trabzon: 45/50"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Bursa satırında:","ifade":"305/20"},{"aciklama":"O satırın satış sayısı:","ifade":"305 adet