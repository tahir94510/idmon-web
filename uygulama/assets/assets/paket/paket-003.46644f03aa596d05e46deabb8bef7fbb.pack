ifade":"z = 2"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"3x + y = 26 , x − y = 14"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 10 , y = −4"},{"aciklama":"İstenen toplam, x + y:","ifade":"6"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"8d0b453bf303","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"150 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"260 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"40 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"10 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"25 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Dergi ilk kez Mart döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Kitap 110, Dergi 150","ifade":"150 − 110 = 40"},{"aciklama":"Aradaki fark:","ifade":"40 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.187,"gorsel":{"tur":"cizgi","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[170,140,110,80]},{"ad":"Dergi","degerler":[80,115,150,185]}]}},{"kimlik":"7dc698e8a214","sablon":"mantik.sifreleme.artan_kaydirma","govde":"Bir şifrelemede ARABA kelimesi CTDFF biçiminde yazılmaktadır. Aynı kurala göre DUVAR kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"IABÇŞ","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"B","metin":"FVZCŞ","dogru":false,"yanilgi":"sifreleme_sabit_kaydirma"},{"harf":"C","metin":"GZCFY","dogru":false,"yanilgi":"harf_sira_kaydi"},{"h