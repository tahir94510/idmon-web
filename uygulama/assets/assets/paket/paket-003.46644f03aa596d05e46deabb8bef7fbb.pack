{"surum":1,"uretim":"2026-10-03","taksonomi_parmak_izi":"28288b59e581cdfa","motor_parmak_izi":"89f6a7c03067ceb5","tohum":20260902,"dilim":3,"madde_sayisi":500,"maddeler":[{"kimlik":"5630659a5f35","sablon":"mantik.esleme.yanlis_ifade","govde":"Ahmet, Emre, Onur, Serkan ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ahmet ile Yusuf yan yana oturmamaktadır.\n• Onur en baştaki ya da en sondaki koltukta oturmaktadır.\n• Onur ile Yusuf yan yana oturmamaktadır.\n• Onur, Ahmet adlı kişinin solunda oturmaktadır.\n• Serkan, Emre adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Onur, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"B","metin":"Ahmet, Onur adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"C","metin":"Serkan, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"D","metin":"Emre, Serkan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Yusuf, Emre adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Onur − Ahmet − Serkan − Emre − Yusuf"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Onur, Ahmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"b50324162756","sablon":"problem.karisim.tuz_orani","govde":"105 gram su ile 45 gram tuzdan oluşan bir karışıma 90 gram tuz daha ekleniyor. Yeni karışımın yüzde kaçı tuzdur?","sece