Ankara","degerler":[65,350,95,360]}]}},{"kimlik":"544e2e4f5e0e","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 11 tek doğal sayının toplamı 1.265'tir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"105","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"},{"harf":"B","metin":"120","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"C","metin":"115","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"123","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"E","metin":"125","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık 11 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"1.265 / 11 = 115"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 5 adım ileridedir:","ifade":"115 + 2 × 5 = 125"},{"aciklama":"En büyük sayı:","ifade":"125"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"6481a98b57d5","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|x + 3y − 38| + z = 6\n|x − y + 10| = 2z − 12\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"−24","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"6","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"11","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"D","metin":"14","dogru":true,"yanilgi":null},{"harf":"E","metin":"−10","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 6 − |…| ≤ 6"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 12 ≥ 0 , yani z ≥ 6"},{"aciklama":"İkisi birlikte:","ifade":"z = 6"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"x + 3y = 38 , x − y = −10"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 2 , y = 12"},{"aciklama":"İstenen toplam, x + y:","ifade":"14"}],"mikrobeceril