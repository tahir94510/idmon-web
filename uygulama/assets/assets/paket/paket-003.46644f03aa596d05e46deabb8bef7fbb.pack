gi":"hareket_yavas_arac"},{"harf":"E","metin":"90 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"90 × 1 = 90 km"},{"aciklama":"İkinci bölüm:","ifade":"110 × 3 = 330 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"90 + 330 = 420 km"},{"aciklama":"Toplam yol:","ifade":"420 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.537,"gorsel":null},{"kimlik":"6577cf769417","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 19| = 8 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"297","dogru":true,"yanilgi":null},{"harf":"B","metin":"−297","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"11","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"27","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"425","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 19 + 8 = 27 ve x = 19 − 8 = 11"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(19 + 8) × (19 − 8) = 19² − 8² = 297"},{"aciklama":"Köklerin çarpımı:","ifade":"297"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.635,"gorsel":null},{"kimlik":"3757d30d0645","sablon":"veri.grafik.sutun_ortalama","govde":"Bir işletmenin dört şubede sattığı Telefon sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört şubede satılan Telefon sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"84 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"B","metin":"110 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"105 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"140 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"70 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"c