ade":"28 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.296,"gorsel":null,"grup":"d26a07ceb41e","grup_govde":"Bir işi Zeynep tek başına 90 günde, Mehmet tek başına 60 günde bitirmektedir."},{"kimlik":"5aaab2a8bc5b","sablon":"cebir.esitsizlik.iki_taraf_bilinmeyen","govde":"4x − 23 > 8x + 19 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"−10","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"B","metin":"3","dogru":false,"yanilgi":"esitsizlikte_sabitler_ayni_tarafta"},{"harf":"C","metin":"1","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−11","dogru":true,"yanilgi":null},{"harf":"E","metin":"−12","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"x'li terimleri bir tarafta, sabitleri öbür tarafta topla:","ifade":"4x − 8x > 19 + 23"},{"aciklama":"Katsayıları sadeleştir:","ifade":"−4x > 42"},{"aciklama":"Her iki tarafı −4 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner:","ifade":"x < −10,5"},{"aciklama":"Eşitsizliği sağlayan en büyük tam sayı:","ifade":"−11"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.107,"gorsel":null},{"kimlik":"eeb95bfacd74","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 3/8 katı ile 1/16 katı arasındaki fark 70'tir.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"175/8","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"B","metin":"224","dogru":true,"yanilgi":null},{"harf":"C","metin":"280","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"D","metin":"160","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"420","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(3/8 − 1/16) · x = 70"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(8, 16) = 16"},{"aciklama":"Her kesri, paydası 16 olacak biçimde genişlet:","ifade":"3/8 = 6/16  (payı da paydayı da 2 ile çarptık)\n1/16  (paydası zaten 16)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"6/16 − 1/16 = 5/16"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 70 × 16/5 = 224"},{"aciklama":"Aranan sayı:","ifade":"224"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"801245194489","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 5 litre yakıt tüketmektedir.\n\nBu araç Bursa'ya yapılan 1.500 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"15 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"750 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"75 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"300 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"5 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"5/100 = x/1.500"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 1.500 × 5/100 = 75"},{"aciklama":"Tüketilen yakıt:","ifade":"75 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.788,"gorsel":null},{"kimlik":"995c28ca9da1","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört bölgede sattığı Çay sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Kuzey bölgesinde satılan Çay sayısı, dört bölgede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%40","dogru":true,"yanilgi":null},{"harf":"B","metin":"%100","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%800","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"D","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"%60","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"800 + 500 + 300 + 400 = 2.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"800 / 2.000 × 100 = %40"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%40"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":{"tur":"sutun","baslik":"Çay satışları (adet)","etiketler":["Kuzey","Güney","Doğu","Batı"],"birim":"adet","seriler":[{"ad":"Çay","degerler":[800,500,300,400]}]}},{"kimlik":"27261fb91e2e","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 780 TL olan bir valiz %25 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"C","metin":"%80","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"%31,25","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%20","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"780 × 125/100 = 975 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"975 − 780 = 195 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"195/975 × 100 = 20"},{"aciklama":"Gereken indirim:","ifade":"%20"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.458,"gorsel":null},{"kimlik":"514f2fffddae","sablon":"mantik.dizi.ikili_orgu","govde":"38, 18, 50, 13, 62, 8, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gel