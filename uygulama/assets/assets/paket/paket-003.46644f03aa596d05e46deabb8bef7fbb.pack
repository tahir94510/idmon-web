750 / 25 = 150 TL"},{"aciklama":"Mehmet bu paylardan 12 tane alır:","ifade":"12 × 150 = 1.800 TL"},{"aciklama":"Mehmet'in payı:","ifade":"1.800 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":null},{"kimlik":"615928f9ea5e","sablon":"yuzde.faiz.anapara","govde":"Yıllık %12 basit faiz oranıyla 4 ay vadeye yatırılan bir anapara 96 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"600 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"B","metin":"800 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"200 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"D","metin":"2.400 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.496 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"4 ay için faiz katsayısı:","ifade":"12/100 × 4/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"96 / (12 × 4/1200) = 2.400 TL"},{"aciklama":"Anapara:","ifade":"2.400 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.416,"gorsel":null},{"kimlik":"18cdf8b6e40c","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 40 kişilik A grubunun puan ortalaması 78, 20 kişilik B grubunun puan ortalaması 54 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"66","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"132","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"105","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"70","dogru":true,"yanilgi":null},{"harf":"E","metin":"4.200","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 40 × 78","ifade":"3.120"},{"aciklama":"B grubu: 20 × 54","ifade":"1.080"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"4.200 / 60 = 70"},{"aciklama":"Ortak ortalama:","ifade":"70"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.537,"gorsel":null},{"kimlik":"a0f3d08c0651","sablon":"mantik.dizi.carpansal","govde":"8, 23, 83, 323, 1.283, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"5.123","dogru":true,"yanilgi":null},{"harf":"B","metin":"20.483","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"C","metin":"5.132","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"D","metin":"1.283","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"2.243","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimlerin farkları sabit değil; oran da tam çıkmıyor. Kural iki işlemli olabilir.","ifade":null},{"aciklama":"Her terim bir öncekinin katının sabitle toplamıdır:","ifade":"aₙ₊₁ = 4 · aₙ − 9"},{"aciklama":"Kuralı son terime uygula:","ifade":"4 × 1.283 − 9 = 5.123"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"5.123"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"375694cf5bce","sablon":"problem.isci.birlikte","govde":"Bir işi Merve tek başına 132 günde, Burak tek başına 110 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"110 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"B","metin":"60 gün","dogru":true,"yanilgi":null},{"harf":"C","metin":"121 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"242 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"E","metin":"22 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/132 + 1/110 = 242/14520"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"14520/242 = 60 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"60 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.785,"gorsel":null},{"kimlik":"c5b390a6ca24","sablon":"sayilar.uslu.negatif_us","govde":"(4⁻⁵)³ · 4¹⁰ işleminin sonucu, 4 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"25","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"B","metin":"−5","dogru":true,"yanilgi":null},{"harf":"C","metin":"2","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"D","metin":"5","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−150","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(4⁻⁵)³ = 4⁻¹⁵"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"4⁻¹⁵ · 4¹⁰ = 4⁻⁵"},{"aciklama":"Aranan kuvvet:","ifade":"−5"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.291,"gorsel":null},{"kimlik":"d125d4ad821e","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 33 kişilik bir grubun yaş ortalaması 75, ikinci bir grubun yaş ortalaması ise 40'tır. İki grup birleştiğinde yaş ortalaması 61 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"33 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"35 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"22 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"55 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"54 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"33·75 + n·40"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(33·75 + n·40) / (33 + n) = 61"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"33·(75 − 61) = n·(61 − 40)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"22 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.304,"gorsel":null},{"kimlik":"29230cc3310c","sablon":"cebir.esitsizlik.cift_tarafli","govde":"−42 < 6x − 20 < 15 eşitsizliğini sağlayan x'in en büyük tam sayı değeri kaçtır?","secenekler":[{"harf":"A","metin":"6","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"B","metin":"−3","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"2","dogru":false,"yanilgi":"esitsizlik_ucu_ayrilmadi"},{"harf":"D","metin":"−1","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"5","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Çift taraflı eşitsizlikte yapılan işlem her üç bölüme birden uygulanır. Önce sabit terimi at:","ifade":"−22 < 6x < 35"},{"aciklama":"Her bölümü 6 ile böl:","ifade":"−11/3 < x < 35/6"},{"aciklama":"Üst sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"5"},{"aciklama":"En büyük tam sayı değer:","ifade":"5"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":1.515,"gorsel":null},{"kimlik":"dbd23b50cb3d","sablon":"oran.temel.oran_ve_fark","govde":"Elif'in parasının Burak'ın parasına oranı 14/9'dur. Aralarındaki fark 2.300 TL olduğuna göre Elif kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"1.400 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"B","metin":"460 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"4.140 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"6.440 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"10.580 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Elif 14k, Burak 9k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"14k − 9k = 5k = 2.300"},{"aciklama":"Birim payı bul:","ifade":"k = 2.300 / 5 = 460"},{"aciklama":"Elif için:","ifade":"14 × 460 = 6.440"},{"aciklama":"Elif'in parası:","ifade":"6.440 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.945,"gorsel":null},{"kimlik":"d001a30d44a2","sablon":"yuzde.faiz.basit_ay","govde":"20.400 TL tutarındaki bir anapara, yıllık %30 basit faiz oranıyla 9 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"680 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"B","metin":"55.080 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"6.120 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"D","metin":"4.590 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"24.990 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"9 ay, yıl cinsinden:","ifade":"9/12"},{"aciklama":"Faiz tutarı:","ifade":"20.400 × 30/100 × 9/12 = 4.590 TL"},{"aciklama":"Elde edilen faiz:","ifade":"4.590 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"33ea2741a10f","sablon":"veri.ortalama.medyan_tek","govde":"178, 154, 184, 160, 64 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"148","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"B","metin":"184","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"C","metin":"124","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"178","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"160","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"64 < 154 < 160 < 178 < 184"},{"aciklama":"Terim sayısı 5, yani tek: ortada tek bir terim var.","ifade":"5 → 3. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"160"},{"aciklama":"Ortanca:","ifade":"160"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.643,"gorsel":null},{"kimlik":"d1138452c33c","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"7 · 2³ · 2³ · 5⁰ + 2⁶ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"28.672","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"B","metin":"3.648","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"C","metin":"64","dogru":false,"yanilgi":"sifir_us"},{"harf":"D","metin":"384","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"512","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"5⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2³ · 2³ = 2⁶ = 64"},{"aciklama":"Katsayıyla çarp:","ifade":"7 × 64 = 448"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"448 + 64 = 512"},{"aciklama":"İşlemin sonucu:","ifade":"512"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.036,"gorsel":null},{"kimlik":"79eb6d7b6407","sablon":"mantik.dizi.ikili_orgu","govde":"15, 38, 22, 42, 29, 46, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"43","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"63","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"36","dogru":true,"yanilgi":null},{"harf":"D","metin":"50","dogru":false,"yanilgi":"dizi_yanlis_altdizi"},{"harf":"E","metin":"22","dogru":false,"yanilgi":"dizi_yon_ters"}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 7 artıyor:","ifade":"15, 22, 29"},{"aciklama":"Çift sıradakiler 4 değişiyor:","ifade":"38, 42, 46"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"29 + 7 = 36"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"36"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.272,"gorsel":null},{"kimlik":"fabd74a22cad","sablon":"problem.isci.ek_isci","govde":"10 işçi bir işi 34 günde bitirmektedir. Aynı iş 20 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"17 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"30 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"C","metin":"14 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"D","metin":"100/17 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"7 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"10 × 34 = 340"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"340 / 20 = 17"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"17 − 10 = 7"},{"aciklama":"Gereken ek işçi:","ifade":"7 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.42,"gorsel":null},{"kimlik":"51e3748cfeb4","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 9 kişinin yaş ortalaması 87. Gruba bir kişi daha katılınca ortalama 91'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"127","dogru":true,"yanilgi":null},{"harf":"B","metin":"910","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"91","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"89","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"36","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"9 × 87 = 783"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"10 × 91 = 910"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"910 − 783 = 127"},{"aciklama":"Katılan kişinin yaşı:","ifade":"127"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.383,"gorsel":null},{"kimlik":"ad30bddb2f49","sablon":"kume.temel.uc_kume","govde":"Bir sınıftaki 99 öğrenciden 61 tanesi münazara, 41 tanesi tiyatro, 50 tanesi satranç kulübüne üyedir. Münazara ve tiyatro kulüplerinin ikisine birden 28, münazara ve satranç kulüplerine 30, tiyatro ve satranç kulüplerine 20 öğrenci üyedir. Üç kulübe birden üye olan öğrenci sayısı 14'tür. Buna göre en az bir kulübe üye olan kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"152","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"38","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"C","metin":"88","dogru":true,"yanilgi":null},{"harf":"D","metin":"74","dogru":false,"yanilgi":"kume_uc_kume_kesisim"},{"harf":"E","metin":"11","dogru":false,"yanilgi":"kume_tumleyen_karisimi"}],"cozum":[{"aciklama":"İçler-dışlar ilkesi: tekli toplamlardan ikili kesişimler düşülür, üçlü kesişim geri eklenir.","ifade":"|A∪B∪C| = |A|+|B|+|C| − |A∩B| − |A∩C| − |B∩C| + |A∩B∩C|"},{"aciklama":"Değerleri yerine koy:","ifade":"61 + 41 + 50 − 28 − 30 − 20 + 14 = 88"},{"aciklama":"Sınıf mevcudu bu hesaba girmez; geri kalan 11 öğrenci hiçbir kulübe üye değildir.","ifade":null},{"aciklama":"En az bir kulübe üye olan öğrenci sayısı:","ifade":"88"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":3.071,"gorsel":null},{"kimlik":"0cb8533c43d3","sablon":"oran.temel.oran_ve_toplam","govde":"Ece'nin parasının Elif'in parasına oranı 17/9'dur. İkisinin parası toplam 3.640 TL olduğuna göre Ece kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"1.820 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"1.260 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"2.380 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"7.735 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"E","metin":"140 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Ece 17k, Elif 9k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"17k + 9k = 26k = 3.640"},{"aciklama":"Birim payı bul:","ifade":"k = 3.640 / 26 = 140"},{"aciklama":"Ece için:","ifade":"17 × 140 = 2.380"},{"aciklama":"Ece'nin parası:","ifade":"2.380 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":1.635,"gorsel":null},{"kimlik":"6c2b9887eb74","sablon":"yuzde.faiz.getiri_farki","govde":"2.000 TL, yıllık %45 faizle 4 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %24 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"140 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"21 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"105 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"D","metin":"420 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"E","metin":"300 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"45 − 24 = 21 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"21/100 × 4/12"},{"aciklama":"Anaparayla çarp:","ifade":"2.000 × 21/100 × 4/12 = 140 TL"},{"aciklama":"Getiri farkı:","ifade":"140 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.545,"gorsel":null},{"kimlik":"8ec20a1a4206","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Antalya'nın Kış satışı silinmiş, yerine 0 yazılmıştır. Antalya satırının gerçek yıllık toplamı 1.280 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"330 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.280 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"650 adet"