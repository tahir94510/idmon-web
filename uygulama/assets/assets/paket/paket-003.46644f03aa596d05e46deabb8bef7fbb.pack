orulani_degil_arayi_verme"},{"harf":"C","metin":"104 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"650 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"26 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"4/100 = x/2.600"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.600 × 4/100 = 104"},{"aciklama":"Tüketilen yakıt:","ifade":"104 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.749,"gorsel":null},{"kimlik":"6bbd7ed7ba80","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 3.020 TL olan bir kulaklık %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%37,5","dogru":true,"yanilgi":null},{"harf":"E","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"3.020 × 160/100 = 4.832 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"4.832 − 3.020 = 1.812 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"1.812/4.832 × 100 = 37,5"},{"aciklama":"Gereken indirim:","ifade":"%37,5"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.746,"gorsel":null},{"kimlik":"e05fc1b0a481","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört şubede satılan toplam Telefon sayısı, toplam Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"115 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"B","metin":"20 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"70 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"395 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"5 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"}],"cozum":[{"aciklama":"Soru tek bir şube değil, dördünün toplamını istiyor. Önce Telefon sütunlarını topla:","ifade":"45 + 145 + 110 + 95 = 395"},{"aciklama":"Sonra Tablet sütunlarını topla:","ifade":"85 + 155 + 110 + 25 = 375"},{"aciklama":"İki toplamın farkını al:","ifade":"395 − 375 = 20"},{"aciklama":"Aradaki fark:","ifade":"20 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.719,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[45,145,110,95]},{"ad":"Tablet","degerler":[85,155,110,25]}]}},{"kimlik":"e056d2572d17","sablon":"sayilar.mutlak.kokler_toplami","govde":"|x − 15| = 33 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"−30","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"66","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"−18","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"30","dogru":true,"yanilgi":null},{"harf":"E","metin":"48","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değer 33'e eşitse içerideki ifade 33 ya da −33 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"x − 15 = 33 ⟹ x = 48"},{"aciklama":"İkinci durum:","ifade":"x − 15 = −33 ⟹ x = −18"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"48 + (−18) = 2 × 15 = 30"},{"aciklama":"Köklerin toplamı:","ifade":"30"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"03e9f7bc4e04","sablon":"kume.temel.hicbiri","govde":"Bir okulda 55 öğrenci vardır. Bu öğrencilerin 31 tanesi voleybol, 8 tanesi tenis kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 4'tür. Buna göre bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"51","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"B","metin":"16","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"20","dogru":true,"yanilgi":null},{"harf":"D","metin":"24","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"35","dogru":false,"yanilgi":"kume_hicbiri_atlandi"}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"31 + 8 − 4 = 35"},{"aciklama":"Evrensel küme, hiçbir kursa gitmeyenleri de içerir:","ifade":"55 − 35 = 20"},{"aciklama":"Hiçbir kursa gitmeyen öğrenci sayısı:","ifade":"20"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"a359e1b0ba7a","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede SİLGİ kelimesi BCTYR biçiminde yazılmaktadır. Aynı kurala göre ŞAPKA kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"KRIDR","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"B","metin":"CHZŞH","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"C","metin":"CRZDH","dogru":true,"yanilgi":null},{"harf":"D","metin":"KHIŞR","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"E","metin":"ÇSAEI","dogru":false,"yanilgi":"harf_sira_kaydi"}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"S→B (+9) , İ→C (−9) , L→T (+9) , G→Y (−9) , İ→R (+9)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 9 ileri, çift sıradakiler 9 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı ŞAPKA kelimesine uygula:","ifade":"Ş→C , A→R , P→Z , K→D , A→H"},{"aciklama":"Şifrelenmiş kelime:","ifade":"CRZDH"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.629,"gorsel":null},{"kimlik":"c21674d6ada5","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört bölgede sattığı Çay ve Kahve sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre iki ürünün toplam satışının en yüksek olduğu bölge için bu toplam kaç adettir?","secenekler":[{"harf":"A","metin":"590 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"295 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"225 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"140 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"235 adet","dogru":false,"yanilgi":"komsu_kategori_okundu"}],"cozum":[{"aciklama":"Soru tek bir seriyi değil, iki serinin toplamını istiyor; her bölge için iki sütunu topla:","ifade":"Kuzey: 220 , Güney: 240 , Doğu: 145 , Batı: 295"},{"aciklama":"Toplamların en büyüğü:","ifade":"Batı için 295"},{"aciklama":"En yüksek toplam satış:","ifade":"295 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["veri.tablo"],"zorluk":0.873,"gorsel":{"tur":"sutun","baslik":"Çay ve Kahve satışları (adet)","etiketler":["Kuzey","Güney","Doğu","Batı"],"birim":"adet","seriler":[{"ad":"Çay","degerler":[110,85,50,140]},{"ad":"Kahve","degerler":[110,155,95,155]}]}},{"kimlik":"c03d7fd61647","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Bursa ile Ankara arasındaki yolu giderken 120 km/sa, dönerken 105 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"225 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"B","metin":"112,5 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"112 km/sa","dogru":true,"yanilgi":null},{"harf":"D","metin":"56 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"E","metin":"120 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/120 + x/105 = x·(225)/(120·105)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·225/(120·105)] = 2·120·105/225 = 112 km/sa"},{"aciklama":"Ortalama hız:","ifade":"112 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.964,"gorsel":null},{"kimlik":"2be961451d16","sablon":"oran.paylastirma.artan_pay","govde":"1.440 TL paranın bir kısmı Fatma'ya ve Yusuf'a 7 : 2 oranında dağıtılmış, Fatma'nın payı 1.050 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"2.790 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"90 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"330 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"1.050 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"160 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Fatma'nın payından birim payı çöz:","ifade":"7k = 1.050 → k = 150"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(7 + 2) × 150 = 1.350 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"1.440 − 1.350 = 90 TL"},{"aciklama":"Geriye kalan:","ifade":"90 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":3.025,"gorsel":null},{"kimlik":"342ac8233867","sablon":"yuzde.artis.indirim","govde":"Fiyatı 4.800 TL olan bir termos, %70 indirimle satılmaktadır. Termosun indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.360 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"432 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"8.160 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"1.440 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"4.730 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"4.800 × 70 / 100 = 3.360"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"4.800 − 3.360 = 1.440"},{"aciklama":"İndirimli fiyat:","ifade":"1.440 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":null},{"kimlik":"7e1b19e45ca9","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört mağazada sattığı Ekmek sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Vadi mağazasında satılan Ekmek sayısı, dört mağazada satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%60","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"%100","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%40","dogru":true,"yanilgi":null},{"harf":"D","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"%400","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"150 + 100 + 350 + 400 = 1.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"400 / 1.000 × 100 = %40"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%40"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":{"tur":"sutun","baslik":"Ekmek satışları (adet)","etiketler":["Merkez","Sahil","Yayla","Vadi"],"birim":"adet","seriler":[{"ad":"Ekmek","degerler":[150,100,350,400]}]}},{"kimlik":"57124ccc0507","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(6/13 + 1/6) : 1/3 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"23/26","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"21/19","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"C","metin":"21/13","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"D","metin":"49/234","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"E","metin":"49/26","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 6) = 78"},{"aciklama":"Her kesri, paydası 78 olacak biçimde genişlet:","ifade":"6/13 = 36/78  (payı da paydayı da 6 ile çarptık)\n1/6 = 13/78  (payı da paydayı da 13 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"36/78 + 13/78 = 49/78"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"49/78 × 3"},{"aciklama":"Çarpımı yap:","ifade":"49 × 3 / 78 = 49/26"},{"aciklama":"İşlemin sonucu:","ifade":"49/26"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.325,"gorsel":null},{"kimlik":"320fae045671","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 6 kız öğrencinin matematik notu ortalaması 95, 24 erkek öğrencinin ortalaması ise 40'tır. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"51","dogru":true,"yanilgi":null},{"harf":"B","metin":"255","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"67,5","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"1.530","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"84","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"6 × 95 + 24 × 40 = 1.530"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"6 + 24 = 30"},{"aciklama":"Sınıf ortalaması:","ifade":"1.530 / 30 = 51"},{"aciklama":"Sınıfın ortalaması:","ifade":"51"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.566,"gorsel":null},{"kimlik":"aff9940b4afb","sablon":"cebir.denklem.sistem","govde":"2x + 8y = −8 ve 3x + 5y = 9 olduğuna göre 6x + 5y kaçtır?","secenekler":[{"harf":"A","metin":"33","dogru":true,"yanilgi":null},{"harf":"B","metin":"22","dogru":false,"yanilgi":"katsayi_yer_degistirme"},{"harf":"C","metin":"63","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"5","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"45","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"İki denklemi yok etme yöntemiyle çöz:","ifade":"x = 8 , y = −3"},{"aciklama":"Sorulan ifade x ve y'nin kendisi değil, katsayılı birleşimidir:","ifade":"6 × 8 + 5 × (−3)"},{"aciklama":"Değeri hesapla:","ifade":"48 − 15 = 33"},{"aciklama":"İstenen değer:","ifade":"33"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.976,"gorsel":null},{"kimlik":"55c72cb62ce9-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Mustafa ile Fatma birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"112 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"33 gün","dogru":true,"yanilgi":null},{"harf":"C","metin":"196 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"98 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"E","metin":"42 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/154 + 1/42 = 14/462"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"462/14 = 33 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"33 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.534,"gorsel":null,"grup":"55c72cb62ce9","grup_govde":"Bir işi Mustafa tek başına 154 günde, Fatma tek başına 42 günde bitirmektedir."},{"kimlik":"55c72cb62ce9-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Mustafa işe başlayıp 110 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Fatma tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"30 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"98 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"196 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"12 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"42 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Mustafa bir günde işin 1/154'ünü yapıyor; 110 gün çalışınca yaptığı iş:","ifade":"110/154"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(154 − 110)/154 = 2/7"},{"aciklama":"Fatma işin tamamını 42 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"2/7 × 42 = 12"},{"aciklama":"Kalan iş için gereken süre:","ifade":"12 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.604,"gorsel":null,"grup":"55c72cb62ce9","grup_govde":"Bir işi Mustafa tek başına 154 günde, Fatma tek başına 42 günde bitirmektedir."},{"kimlik":"fa3fd8923df8","sablon":"mantik.dizi.artan_fark","govde":"32, 42, 57, 77, 102, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"112","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"B","metin":"132","dogru":true,"yanilgi":null},{"harf":"C","metin":"102","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"127","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"131","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"42−32=10 , 57−42=15 , 77−57=20 , 102−77=25"},{"aciklama":"Farklar sabit değil; her adımda 5 artıyor. Sıradaki fark:","ifade":"25 + 5 = 30"},{"aciklama":"Son terime bu farkı ekle:","ifade":"102 + 30 = 132"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"132"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"081f514f539d","sablon":"sayilar.rasyonel.islem_onceligi","govde":"16 + 3/7 × 1/6 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"223/14","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"115/42","dogru":false,"yanilgi":"islem_onceligi_toplama_once"},{"harf":"C","metin":"130/7","dogru":false,"yanilgi":"kesir_carpimda_ters_cevrildi"},{"harf":"D","metin":"115/7","dogru":false,"yanilgi":"kesir_carpimda_payda_carpilmadi"},{"harf":"E","metin":"225/14","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İşlem önceliği: çarpma toplamadan önce yapılır.","ifade":null},{"aciklama":"Kesirlerin çarpımında paylar payla, paydalar paydayla çarpılır:","ifade":"3/7 × 1/6 = 3/42 = 1/14"},{"aciklama":"Tam sayıyı ekle:","ifade":"16 + 1/14 = 225/14"},{"aciklama":"İşlemin sonucu:","ifade":"225/14"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.14,"gorsel":null},{"kimlik":"3689c14ebbce","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 84 km sabit hızla yola çıkmıştır. 2 saat sonra aynı noktadan aynı yöne, saatte 98 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"12/13 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"B","metin":"12 saat","dogru":true,"yanilgi":null},{"harf":"C","metin":"168 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"12/7 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"E","metin":"24/13 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"84 × 2 = 168 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"98 − 84 = 14 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"168 / 14 = 12"},{"aciklama":"Yetişme süresi:","ifade":"12 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"49988eea2be1","sablon":"veri.ortalama.eksik_terim","govde":"5 öğrencinin sınav notu ortalaması 67. Öğrencilerden 4'ü sırasıyla 93, 75, 89 ve 47 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"31","dogru":true,"yanilgi":null},{"harf":"B","metin":"98","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"304","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"78","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"76","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"67 × 5 = 335"},{"aciklama":"Bilinen notların toplamı:","ifade":"93 + 75 + 89 + 47 = 304"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"335 − 304 = 31"},{"aciklama":"Kalan öğrencinin notu:","ifade":"31"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":null},{"kimlik":"5027df4ec2cb","sablon":"oran.paylastirma.fark","govde":"4.400 TL tutarındaki bir ödül, Fatma ile Mehmet arasında 3/8 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.200 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"2.000 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.200 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"3.200 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"400 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"3 + 8 = 11"},{"aciklama":"Bir parçanın değeri:","ifade":"4.400 / 11 = 400 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(8 − 3) × 400 = 2.000 TL"},{"aciklama":"Aradaki fark:","ifade":"2.000 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":0.862,"gorsel":null},{"kimlik":"fc4512297daa","sablon":"yuzde.artis.zam","govde":"Fiyatı 1.500 TL olan bir güneş gözlüğü, %10 zamlanmıştır. Zamdan sonra güneş gözlüğünün fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"1.650 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.350 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"150 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"16.500 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"E","metin":"1.510 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"1.500 × 10/100 = 150 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"1.500 + 150 = 1.650 TL"},{"aciklama":"Zamlı fiyat:","ifade":"1.650 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.483,"gorsel":null},{"kimlik":"c90bf34fbd09","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 7 kişinin yaş ortalaması 28. Gruptan bir kişi ayrılınca ortalama 29 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"370","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"1","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"22","dogru":true,"yanilgi":null},{"harf":"D","metin":"174","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"7","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 7 × 28","ifade":"196"},{"aciklama":"Ayrıldıktan sonra grup 6 kişi: 6 × 29","ifade":"174"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"196 − 174 = 22"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"22"}],"