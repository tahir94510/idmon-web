:","ifade":"1 − 343/729 = 386/729"},{"aciklama":"İstenen olasılık:","ifade":"386/729"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":[],"zorluk":2.465,"gorsel":null},{"kimlik":"89563e386767","sablon":"mantik.dizi.sabit_oran","govde":"70, 140, 280, 560, 1.120, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"2.240","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.680","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"560","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"1.120","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"4.480","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farklar sabit değil; oranlara bak:","ifade":"140÷70=2 , 280÷140=2 , 560÷280=2 , 1.120÷560=2"},{"aciklama":"Oran her adımda aynı, yani her terim bir öncekinin katı:","ifade":"oran = 2"},{"aciklama":"Son terimi bu oranla çarp:","ifade":"1.120 × 2 = 2.240"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"2.240"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"22a41281ace0","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 2, onlar basamağındaki rakam 7'dir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"21","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"B","metin":"208","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"C","metin":"172","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"D","metin":"271","dogru":true,"yanilgi":null},{"harf":"E","metin":"217","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (2 − b) = 99 ⟹ 2 − b = 1 ⟹ b = 1"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 2 + 10 × 7 + 1 = 271"},{"aciklama":"Aranan sayı:","ifade":"271"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"66523ebb352c","sablon":"veri.tablo.satir_toplami","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Samsun'un yıl boyunca yaptığı toplam satış kaç adettir?","secenekler":[{"harf":"A","metin":"3.505 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"355 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"1.145 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"995 adet","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"790 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Tabloda sorulan satırı bul: Samsun satırı.","ifade":null},{"aciklama":"O satırdaki dört mevsim değerini sırayla oku:","ifade":"İlkbahar: 75 · Yaz: 125 · Sonbahar: 235 · Kış: 355"},{"aciklama":"Dördünü topla:","ifade":"75 + 125 + 235 + 355 = 790"},{"aciklama":"Yıl boyunca yapılan toplam satış:","ifade":"790 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":[],"zorluk":-1.003,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Samsun","degerler":[75,125,235,355]},{"ad":"Konya","degerler":[35,50,395,50]},{"ad":"Antalya","degerler":[385,230,140,295]},{"ad":"Eskişehir","degerler":[200,245,395,295]}]}},{"kimlik":"5d6f2e7245a9","sablon":"problem.karisim.tuz_orani","govde":"275 gram su ile 165 gram tuzdan oluşan bir karışıma 110 gram tuz daha ekleniyor. Yeni karışımın yüzde kaçı tuzdur?","secenekler":[{"harf":"A","metin":"%20","dogru":false,"yanilgi":"toplam_yerine_