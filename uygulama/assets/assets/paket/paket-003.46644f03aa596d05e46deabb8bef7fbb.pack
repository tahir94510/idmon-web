ni çevirir:","ifade":"7x + 112 − 9x + 81 = 183"},{"aciklama":"Benzer terimleri topla:","ifade":"−2x + 193 = 183"},{"aciklama":"Sabit terimi karşıya geçir, yani iki taraftan da 193 çıkar:","ifade":"−2x = 183 − 193 = −10"},{"aciklama":"İki tarafı −2 sayısına böl; x değeri:","ifade":"5"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":0.985,"gorsel":null},{"kimlik":"c772aa99e2b6-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Ece'nin payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.500 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"3.000 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"21.000 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"6.500 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"500 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 6 + 13 = 21"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"10.500 / 21 = 500 TL"},{"aciklama":"Ece bu paylardan 6 tane alır:","ifade":"6 × 500 = 3.000 TL"},{"aciklama":"Ece'nin payı:","ifade":"3.000 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.719,"gorsel":null,"grup":"c772aa99e2b6","grup_govde":"Bir ikramiye Deniz, Ece ve Serkan arasında sırasıyla 2, 6 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 10.500 TL'dir."},{"kimlik":"c772aa99e2b6-2","sablon":"oran.blok.paylastirma_uc_soru","govde":"Serkan'ın payı, Deniz'in payından kaç TL fazladır?","secenekler":[{"harf":"A","metin":"500 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"5.500 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"3.500 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"7.500 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"6.500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 6 + 13 = 21"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"10.500 / 21 = 500 TL"},{"aciklama":"İki pay arasındaki fark, katsayı farkı kadar paydır:","ifade":"(13 − 2) × 500 = 5.500 TL"},{"aciklama":"Aradaki fark:","ifade":"5.500 TL"}],"mikrobeceriler":["oran.paylastirma"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.297,"gorsel":null,"grup":"c772aa99e2b6","grup_govde":"Bir ikramiye Deniz, Ece ve Serkan arasında sırasıyla 2, 6 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 10.500 TL'dir."},{"kimlik":"c772aa99e2b6-3","sablon":"oran.blok.paylastirma_uc_soru","govde":"Deniz, kendi payının %10'unu bağışlamıştır. Buna göre Deniz'in elinde kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"900 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.100 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"5.850 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"100 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"9.450 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 6 + 13 = 21"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"10.500 / 21 = 500 TL"},{"aciklama":"Deniz'in payı:","ifade":"2 × 500 = 1.000 TL"},{"aciklama":"Bağıştan sonra kalan, payın %90'ıdır:","ifade":"1.000 × 90/100 = 900 TL"},{"aciklama":"Elinde kalan:","ifade":"900 TL"}],"mikrobeceriler":["oran.paylastirma","yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.036,"gorsel":null,"grup":"c772aa99e2b6","grup_govde":"Bir ikramiye Deniz, Ece ve Serkan arasında sırasıyla 2, 6 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 10.500 TL'dir."},{"kimlik":"047afcafa345","sablon":"kume.temel.herkes_en_az_bir","govde":"Bir grupta 30 kişi vardır ve herkes bu iki dilden en az birini bilmektedir. İngilizce bilen 23, Almanca bilen 13 kişi olduğuna göre, her iki dili de bilen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"36","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"7","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"C","metin":"17","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"6","dogru":true,"yanilgi":null},{"harf":"E","metin":"24","dogru":false,"yanilgi":"kume_hicbiri_atlandi"}],"cozum":[{"aciklama":"Herkes en az birini bildiği için birleşim grubun tamamıdır:","ifade":"s(A ∪ B) = 30"},{"aciklama":"Birleşim formülünü kesişim için çöz:","ifade":"s(A ∩ B) = 23 + 13 − 30 = 6"},{"aciklama":"Her iki dili de bilen kişi sayısı:","ifade":"6"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"5fd159749b18","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 8'e bölümünden kalan 1, 12'ye bölümünden kalan 5'tir. Bu koşulu sağlayan ve 315'ten büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"321","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"319","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"377","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"329","dogru":true,"yanilgi":null},{"harf":"E","metin":"317","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 7 eksik. Demek ki sayıya 7 eklenirse sayı hem 8 hem 12 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(8, 12) = 24"},{"aciklama":"Sayı 24'ün katından 7 eksiktir. 315'ten büyük ilk böyle sayı:","ifade":"329"},{"aciklama":"Aranan sayı:","ifade":"329"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.325,"gorsel":null},{"kimlik":"0878f3d87d5d","sablon":"veri.grafik.daire_aciyla_sayi","govde":"Toplam 1.600 kişinin katıldığı bir ankette verilen cevapların merkez açıları yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Basketbol seçeneğini işaretleyen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"400 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"1.728 kişi","dogru":false,"yanilgi":"aciyi_yuzde_sanma"},{"harf":"C","metin":"240 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"480 kişi","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.120 kişi","dogru":false,"yanilgi":"tumleyeni_verme"}],"cozum":[{"aciklama":"Grafikte Basketbol diliminin merkez açısını oku:","ifade":"108°"},{"aciklama":"Açıyı orana çevir: dairenin tamamı 360°, dağılımın tamamı 100'dür.","ifade":"108/360 = 0,3"},{"aciklama":"Bulunan oranı toplam kişi sayısıyla çarp:","ifade":"1.600 × 0,3 = 480"},{"aciklama":"Dereceyi doğrudan sayıya oranlamak iki adımdan birini atlamak olurdu; önce yüzde, sonra sayı.","ifade":null},{"aciklama":"Bu dilimi seçen kişi sayısı:","ifade":"480 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":{"tur":"daire","baslik":"Tercihlerin merkez açıları","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"derece","seriler":[{"ad":"Açı","degerler":[18,108,144,90]}]}},{"kimlik":"aa62646845a0","sablon":"oran.bilesik.makine_uretim","govde":"8 makine 4 günde 1.600 parça üretmektedir. Aynı hızla çalışan 12 makine 5 günde kaç parça üretir?","secenekler":[{"harf":"A","metin":"50 parça","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"4.000/3 parça","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"C","metin":"2.000/3 parça","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"3.000 parça","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.400 parça","dogru":false,"yanilgi":"bilesik_o