rden sağlayan rakamlar:","ifade":"2 ve 8"},{"aciklama":"Bu rakamları topla:","ifade":"2 + 8 = 10"},{"aciklama":"Rakamların toplamı:","ifade":"10"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"080c140658e3","sablon":"oran.bilesik.isci_ucret","govde":"3 işçi 10 günde çalışarak toplam 12.000 TL kazanmaktadır. Aynı günlük ücretle çalışan 10 işçi 4 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"16.000 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"9.000 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"C","metin":"40.000 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"D","metin":"4.800 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"12.000 / (3 × 10) = 400 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"10 × 4 = 40"},{"aciklama":"Toplam ücret:","ifade":"40 × 400 = 16.000 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"16.000 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":1.149,"gorsel":null},{"kimlik":"a368f35ace99","sablon":"yuzde.temel.ters_yuzde","govde":"Bir koltuk fiyatına %60 zam yapıldıktan sonra fiyatı 1.440 TL olmuştur. Koltuğun zamdan önceki fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.600 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"540 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"1.380 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"900 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"576 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Zamlı fiyat, eski fiyatın %160'ıdır:","ifade":"eski × 160/100 = 1.440"},{"aciklama":"Eski fiyat, zamlı f