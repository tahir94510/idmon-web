 sayıdır:","ifade":"10 × 954 = 9.540"},{"aciklama":"Yeni sayı:","ifade":"9.540"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.363,"gorsel":null},{"kimlik":"deeca76b700a","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede OKUL kelimesi ŞĞAH biçiminde yazılmaktadır. Aynı kurala göre HALI kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"LUPE","dogru":true,"yanilgi":null},{"harf":"B","metin":"MÜRF","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"C","metin":"DEHM","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"D","metin":"LEPM","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"E","metin":"DUHE","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"O→Ş (+5) , K→Ğ (−5) , U→A (+5) , L→H (−5)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 5 ileri, çift sıradakiler 5 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı HALI kelimesine uygula:","ifade":"H→L , A→U , L→P , I→E"},{"aciklama":"Şifrelenmiş kelime:","ifade":"LUPE"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"2290e4083802","sablon":"problem.isci.kalan_is","govde":"Bir işi Mehmet tek başına 36 günde, Kaan tek başına 18 günde bitirmektedir. Mehmet işe başlayıp 24 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Kaan tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"27 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"6 gün","dogru":true,"yanilgi":null},{"harf":"C","metin":"12 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"18 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"E","metin":"54 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Mehmet günde işin 1/36'sını yapıyor; 24 günde:","ifade":"24/36"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 2