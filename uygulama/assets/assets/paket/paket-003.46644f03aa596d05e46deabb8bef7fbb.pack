arkı ekle:","ifade":"73 + 25 = 98"},{"aciklama":"Sıradaki terim:","ifade":"98"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.346,"gorsel":null},{"kimlik":"e8f33e1a13ad","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 2 : 3 : 12 oranındadır. İkinci arkadaşın parası 108 TL olduğuna göre birinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"72 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"162 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"36 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"204 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"2 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"2k : 3k : 12k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"3k = 108 → k = 36"},{"aciklama":"Sorulan payı k ile çarp (birinci arkadaş):","ifade":"2 × 36 = 72"},{"aciklama":"Birinci arkadaşın parası:","ifade":"72 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.079,"gorsel":null},{"kimlik":"ba5b7e099aed","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 2.200 TL olan bir ayakkabı %20 kârla, maliyeti 1.300 TL olan bir halı ise %10 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"350 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"440 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"570 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"310 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"10 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"2.200 × 20/100 = 440 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"1.300 × 10/100 = 130 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"440 − 130 = 310 TL"},{"aciklama":"Net kâr:","ifade":"310 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.775,"gorsel":null},{"kimlik":"15c809e78db3","sablon":"problem.isci.kalan_is","govde":"Bir işi Onur tek başına 192 günde, Kerem tek başına 96 günde bitirmektedir. Onur işe başlayıp 10 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Kerem tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"5 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"96 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"288 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"144 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"E","metin":"91 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Onur günde işin 1/192'sini yapıyor; 10 günde:","ifade":"10/192"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 10/192 = 91/96"},{"aciklama":"Kerem işin tamamını 96 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"91/96 × 96 = 91"},{"aciklama":"Kalan iş için gereken süre:","ifade":"91 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.453,"gorsel":null},{"kimlik":"e5fee2f2dd7a","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"155 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"110 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"195 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"8 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"190 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Trabzon: 190/18 · 