":"toplam_fark_ikiye_bolunmedi"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(60 + 16) / 2 = 38"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"60 − 38 = 22"},{"aciklama":"Büyük olanın yaşı:","ifade":"38"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.069,"gorsel":null},{"kimlik":"1ae8d960beba","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 32 dakikada bir, B hattı 40 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"1.280 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"B","metin":"8 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"C","metin":"320 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"160 dakika","dogru":true,"yanilgi":null},{"harf":"E","metin":"72 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"32 ve 40 sayılarının EKOK'u:","ifade":"EKOK(32, 40) = 160"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"160 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":2.997,"gorsel":null},{"kimlik":"ba80ac311041","sablon":"veri.grafik.daire_iki_dilim","govde":"2.500 kişiyle yapılan bir ankette tercihler yukarıdaki daire grafiğindeki gibi dağılmıştır. Buna göre Şiir ve Öykü seçeneklerini işaretleyen toplam kaç kişi vardır?","secenekler":[{"harf":"A","metin":"1.125 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"45 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"C","metin":"875 kişi","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"1.375 kişi","dogru":false,"yanilgi":"ver