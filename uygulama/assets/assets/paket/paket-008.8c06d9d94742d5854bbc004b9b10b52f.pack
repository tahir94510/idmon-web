li_olan_belirler"},{"harf":"B","metin":"648 gün","dogru":false,"yanilgi":"isci_hizlari_carpma"},{"harf":"C","metin":"12 gün","dogru":true,"yanilgi":null},{"harf":"D","metin":"54 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"E","metin":"27 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/36 + 1/18 = 54/648"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"648/54 = 12 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"12 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":2.007,"gorsel":null},{"kimlik":"56897a726e9f","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 73. Öğrencilerden 3'ü sırasıyla 32, 90 ve 88 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"82","dogru":true,"yanilgi":null},{"harf":"B","metin":"155","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"210","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"170","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"292","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"73 × 4 = 292"},{"aciklama":"Bilinen notların toplamı:","ifade":"32 + 90 + 88 = 210"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"292 − 210 = 82"},{"aciklama":"Kalan öğrencinin notu:","ifade":"82"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"2a005cbf4e1c","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 58| = 19 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"19,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"B","metin":"−58","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"19","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D"