,"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":1.991,"gorsel":null},{"kimlik":"7c1f6958b438","sablon":"yuzde.artis.azalma_orani","govde":"Bir atölyenin aylık üretimi 5.860 adetten 2.344 adede düşmüştür. Üretimdeki azalma yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%150","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%40","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"%60","dogru":true,"yanilgi":null},{"harf":"D","metin":"%3.516","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%2.344","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Azalma yüzdesi, azalma miktarının **eski** değere oranıdır.","ifade":null},{"aciklama":"Azalma miktarı:","ifade":"5.860 − 2.344 = 3.516"},{"aciklama":"Bunu eski değere oranla ve 100 ile çarp:","ifade":"3.516 / 5.860 × 100 = 60"},{"aciklama":"Azalma oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":-0.154,"gorsel":null},{"kimlik":"3c98973611c0","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 5 kişinin yaş ortalaması 28. Gruptan bir kişi ayrılınca ortalama 30 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"120","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"2","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"20","dogru":true,"yanilgi":null},{"harf":"D","metin":"260","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"10","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 5 × 28","ifade":"140"},{"aciklama":"Ayrıldıktan sonra grup 4 kişi: 4 × 30","ifade":"120"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"140 − 120 = 20"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"20"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.11,"gorsel":null},{"kimlik":"2ba07f4f484d","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Ayşe, Buse, Mustafa ve Onur adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Buse, Mustafa adlı kişinin solunda oturmaktadır.\n• Ayşe, Onur adlı kişinin hemen solundadır.\n• Buse ile Mustafa yan yana oturmamaktadır.\n• Mustafa ortadaki koltukta oturmamaktadır.\n• Mustafa, Ahmet adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Ayşe, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Ayşe, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Mustafa, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"D","metin":"Mustafa, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Buse, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Buse − Ayşe − Onur − Mustafa − Ahmet"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Ayşe, Buse adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"a16d88c5d458","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|3x + 4| < 18 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"12","dogru":true,"yanilgi":null},{"harf":"B","metin":"6","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"11","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"D","metin":"9","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"14","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"|A| < 18 eşitsizliği, A'nın −18 ile 18 arasında olması demektir:","ifade":"−18 < 3x + 4 < 18"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−22/3 < x < 14/3"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"12 tane"},{"aciklama":"Tam sayı adedi:","ifade":"12"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":1.711,"gorsel":null},{"kimlik":"c790c20b1451","sablon":"problem.karisim.birlestirme","govde":"Tuz oranı %35 olan 10 litre çözelti ile tuz oranı %15 olan 90 litre çözelti karıştırılıyor. Elde edilen karışımın tuz oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%17","dogru":true,"yanilgi":null},{"harf":"B","metin":"%50","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"C","metin":"%170","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"D","metin":"%33","dogru":false,"yanilgi":"karisim_agirlik_capraz"},{"harf":"E","metin":"%25","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Önce her çözeltideki saf tuz miktarını bul:","ifade":"10·35/100 + 90·15/100 = 17 litre"},{"aciklama":"Karışımın toplam miktarı:","ifade":"10 + 90 = 100 litre"},{"aciklama":"Yeni oran, saf tuzun yeni toplam miktara bölümüdür:","ifade":"17 / 100 = %17"},{"aciklama":"Karışımın tuz oranı:","ifade":"%17"}],"mikrobeceriler":["problem.karisim","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"ec65c3fb9255","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 36 kişilik A grubunun puan ortalaması 54, 12 kişilik B grubunun puan ortalaması 78 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"60","dogru":true,"yanilgi":null},{"harf":"B","metin":"2.880","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"132","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"66","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"80","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 36 × 54","ifade":"1.944"},{"aciklama":"B grubu: 12 × 78","ifade":"936"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"2.880 / 48 = 60"},{"aciklama":"Ortak ortalama:","ifade":"60"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.537,"gorsel":null},{"kimlik":"b972538a67d1","sablon":"kume.temel.hicbiri","govde":"Bir okulda 38 öğrenci vardır. Bu öğrencilerin 16 tanesi yüzme, 13 tanesi atletizm kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 4'tür. Buna göre bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"9","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"25","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"C","metin":"13","dogru":true,"yanilgi":null},{"harf":"D","metin":"34","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"E","metin":"17","dogru":false,"yanilgi":"kume_yalnizca_biri"}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"16 + 13 − 4 = 25"},{"aciklama":"Evrensel küme, hiçbir kursa gitmeyenleri de içerir:","ifade":"38 − 25 = 13"},{"aciklama":"Hiçbir kursa gitmeyen öğrenci sayısı:","ifade":"13"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.44,"gorsel":null},{"kimlik":"32446b2c5ca6","sablon":"oran.dogru.tarif_olcekleme","govde":"7 kişilik bir tarifte 860 gram un kullanılmaktadır. Aynı tarif 2