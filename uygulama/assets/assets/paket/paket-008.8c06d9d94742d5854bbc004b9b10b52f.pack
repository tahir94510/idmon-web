kişidir?","secenekler":[{"harf":"A","metin":"20 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"40 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"45 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"30 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"10 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"30·60 + n·80"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(30·60 + n·80) / (30 + n) = 65"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"30·(60 − 65) = n·(65 − 80)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"10 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.097,"gorsel":null},{"kimlik":"9041e743b6e6","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 13| = 7 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"218","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−120","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"20","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"D","metin":"6","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"E","metin":"120","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 13 + 7 = 20 ve x = 13 − 7 = 6"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(13 + 7) × (13 − 7) = 13² − 7² = 120"},{"aciklama":"Köklerin çarpımı:","ifade":"120"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.532,"gorsel":null},{"kimlik":"0d67252b46a0","sablon":"mantik.esleme.yanlis_ifade","govde":"Burak, Buse, Elif, Mehmet ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Yusuf ile Burak yan yana oturmamaktadır.\n• Mehmet, Burak adlı kişinin hemen solundadır.\n• Buse, Elif adlı kişinin solun