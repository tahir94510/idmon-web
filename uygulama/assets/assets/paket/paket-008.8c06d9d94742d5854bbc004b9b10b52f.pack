ılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%150","dogru":true,"yanilgi":null},{"harf":"B","metin":"%250","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"C","metin":"%25","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"D","metin":"%60","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"%100","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"100 − 40 = 60"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"60 / 40 × 100 = %150"},{"aciklama":"Yüzde artış:","ifade":"%150"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"cizgi","baslik":"Ankara mağazasının yıllık cirosu (bin TL)","etiketler":["2017","2018","2019","2020","2021"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[60,40,80,100,50]}]}},{"kimlik":"661a6a046848","sablon":"oran.ters.isci_gun","govde":"Bir inşaat işini 14 işçi 24 günde bitirmektedir. Aynı işi, aynı hızda çalışan 7 işçi kaç günde bitirir?","secenekler":[{"harf":"A","metin":"17 gün","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"B","metin":"336 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"31 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"D","metin":"48 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"12 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"İşçi sayısı ile süre ters orantılıdır; çarpımları toplam iş yükünü verir:","ifade":"14 × 24 = 336 işçi-gün"},{"aciklama":"Aynı iş yükü 7 işçiye bölündüğünde süre:","ifade":"336 / 7 = 48 gün"},{"aciklama":"İşin biteceği süre:","ifade":"48 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.123,"gorsel":null},{"kimlik":"be43772568f4","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, 