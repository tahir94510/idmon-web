"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[395,185,45,310]},{"ad":"Ankara","degerler":[85,240,270,110]},{"ad":"Samsun","degerler":[300,205,250,90]},{"ad":"İzmir","degerler":[65,25,95,230]}]}},{"kimlik":"817ce76b91e1","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 10/x = 31 olduğuna göre x² + 10²/x² kaçtır?","secenekler":[{"harf":"A","metin":"961","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"B","metin":"921","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"941","dogru":true,"yanilgi":null},{"harf":"D","metin":"951","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"E","metin":"981","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 10/x)² = x² + 2 · x · 10/x + 10²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 10 kalır:","ifade":"31² = x² + 10²/x² + 20"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 10²/x² = 961 − 20 = 941"},{"aciklama":"İstenen değer:","ifade":"941"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":3.015,"gorsel":null},{"kimlik":"38a1cfdad691","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 5/7 katı ile 1/3 katı arasındaki fark 8'dir.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"21","dogru":true,"yanilgi":null},{"harf":"B","metin":"40/3","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"C","metin":"84/11","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"64/21","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"E","metin":"14","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(5/7 − 1/3) · x = 8"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(7, 3) = 21"},{"aciklama":