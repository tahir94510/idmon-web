akika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"E","metin":"4 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"4 ve 44 sayılarının EKOK'u:","ifade":"EKOK(4, 44) = 44"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"44 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"71e3c69bc842","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 6 kişinin yaş ortalaması 35. Gruptan bir kişi ayrılınca ortalama 38 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"20","dogru":true,"yanilgi":null},{"harf":"B","metin":"400","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"18","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"3","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"190","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 6 × 35","ifade":"210"},{"aciklama":"Ayrıldıktan sonra grup 5 kişi: 5 × 38","ifade":"190"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"210 − 190 = 20"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"20"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.14,"gorsel":null},{"kimlik":"c3f4493dfdd6","sablon":"problem.sayi.verme_alma","govde":"Serkan, Mustafa'ya kalemlerinin 4 tanesini verirse ikisinin kalem sayıları eşit olmaktadır. Mustafa, Serkan'a kalemlerinin 5 tanesini verirse Serkan'ın kalem sayısı Mustafa'nınkinin 2 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç kalemi vardır?","secenekler":[{"harf":"A","metin":"31","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"27","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"54","dogru":true,"yanilgi":null},{"harf":"D","metin":"34","dogru":false,"yanilgi":"verme_tek_taraf"},{"harf":"E","metin":"42","dogru":false,"yanilgi":"verme_farki_tek_sayildi"}],"cozum":[{"aciklama":"Serkan 4 tane verince kendisi 4 azalır, Mustafa 4 artar: aradaki fark 8 kapanır. Eşitlendiklerine göre baştaki fark 8'dir.","ifade":null},{"aciklama":"Mustafa'nın sayısına x dersek Serkan'ınki x + 8 olur. İkinci koşulda Mustafa 5 tane verir, Serkan 5 tane alır:","ifade":"x + 8 + 5 = 2·(x − 5)"},{"aciklama":"Denklemi çöz:","ifade":"x = 23"},{"aciklama":"Toplam x + (x + 8) olduğuna göre:","ifade":"54"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"4f7a13437b00","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 40 litre yakıt tüketmektedir.\n\nBu araç Antalya'ya yapılan 200 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"800 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"80 litre","dogru":true,"yanilgi":null},{"harf":"C","metin":"40 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"5 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"2 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"40/100 = x/200"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 200 × 40/100 = 80"},{"aciklama":"Tüketilen yakıt:","ifade":"80 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":1.034,"gorsel":null},{"kimlik":"80752f67d6e4","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 2.660 TL olan bir termos %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%37,5","dogru":true,"yanilgi":null},{"harf":"B","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"2.660 × 160/100 = 4.256 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"4.256 − 2.660 = 1.596 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"1.596/4.256 × 100 = 37,5"},{"aciklama":"Gereken indirim:","ifade":"%37,5"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.746,"gorsel":null},{"kimlik":"e5f3464fd31b","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 12 kişilik bir grubun yaş ortalaması 35, ikinci bir grubun yaş ortalaması ise 55'tir. İki grup birleştiğinde yaş ortalaması 50 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"48 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"17 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"20 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"36 kişi","dogru":true,"yanilgi":null},{"harf":"E","metin":"12 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"12·35 + n·55"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(12·35 + n·55) / (12 + n) = 50"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"12·(35 − 50) = n·(50 − 55)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"36 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.589,"gorsel":null},{"kimlik":"b72ae5875b57","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 66 cm ve 18 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"84 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"6 cm","dogru":true,"yanilgi":null},{"harf":"C","metin":"14 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"198 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"3 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"66 = 6·11   ve   18 = 6·3"},{"aciklama":"Ortak çarpan 6; kalan çarpanlar (11 ve 3) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(66, 18) = 6"},{"aciklama":"En büyük parça uzunluğu:","ifade":"6 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.036,"gorsel":null},{"kimlik":"99525ae5545d","sablon":"veri.ortalama.medyan_tek","govde":"38, 18, 104, 58, 164, 150, 112 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"92","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"B","metin":"112","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"58","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"D","metin":"91","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"104","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"18 < 38 < 58 < 104 < 112 < 150 < 164"},{"aciklama":"Terim sayısı 7, yani tek: ortada tek bir terim var.","ifade":"7 → 4. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"104"},{"aciklama":"Ortanca:","ifade":"104"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.413,"gorsel":null},{"kimlik":"10e0fcc3e647","sablon":"oran.paylastirma.artan_pay","govde":"1.810 TL paranın bir kısmı Emre'ye ve Kerem'e 7 : 3 oranında dağıtılmış, Emre'nin payı 1.015 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"360 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.015 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"110 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"3.260 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"181 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Emre'nin payından birim payı çöz:","ifade":"7k = 1.015 → k = 145"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(7 + 3) × 145 = 1.450 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"1.810 − 1.450 = 360 TL"},{"aciklama":"Geriye kalan:","ifade":"360 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":3.261,"gorsel":null},{"kimlik":"daf3f3bf4cf9","sablon":"yuzde.artis.indirim","govde":"Fiyatı 500 TL olan bir battaniye, %80 indirimle satılmaktadır. Battaniyenin indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"900 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"20 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"100 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"420 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"E","metin":"400 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"500 × 80 / 100 = 400"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"500 − 400 = 100"},{"aciklama":"İndirimli fiyat:","ifade":"100 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.322,"gorsel":null},{"kimlik":"e38a00492089","sablon":"mantik.dizi.ikili_orgu","govde":"36, 35, 48, 27, 60, 19, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"11","dogru":false,"yanilgi":"dizi_yanlis_altdizi"},{"harf":"B","metin":"48","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"C","metin":"72","dogru":true,"yanilgi":null},{"harf":"D","metin":"−22","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"84","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 12 artıyor:","ifade":"36, 48, 60"},{"aciklama":"Çift sıradakiler −8 değişiyor:","ifade":"35, 27, 19"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"60 + 12 = 72"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"72"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.422,"gorsel":null},{"kimlik":"324a8f2bdf73","sablon":"problem.yas.kat_iliskisi","govde":"Ali'nin yaşı bugün Onur'un yaşının 11 katıdır. 12 yıl sonra Ali'nin yaşı Onur'un yaşının 5 katı olacaktır. Buna göre Ali bugün kaç yaşındadır?","secenekler":[{"harf":"A","metin":"100","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"B","metin":"88","dogru":true,"yanilgi":null},{"harf":"C","metin":"96","dogru":false,"yanilgi":"yas_toplam_fark_karisimi"},{"harf":"D","metin":"110","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"E","metin":"80","dogru":false,"yanilgi":"fark_verildi_deger_istendi"}],"cozum":[{"aciklama":"Onur'un bugünkü yaşına x dersek, Ali'nin yaşı 11x olur.","ifade":null},{"aciklama":"12 yıl sonra ikisi de 12 yaş büyür; fark değişmez:","ifade":"11x + 12 = 5·(x + 12)"},{"aciklama":"Denklemi çöz:","ifade":"11x + 12 = 5x + 60  ⟹  6x = 48  ⟹  x = 8"},{"aciklama":"Ali'nin bugünkü yaşı bunun 11 katıdır:","ifade":"11 × 8 = 88"},{"aciklama":"Ali bugün:","ifade":"88"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":2.331,"gorsel":null},{"kimlik":"34b140fefd27","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 14 kişinin yaş ortalaması 67. Gruba bir kişi daha katılınca ortalama 71'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"69","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"123","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"71","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"127","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.065","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"14 × 67 = 938"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"15 × 71 = 1.065"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"1.065 − 938 = 127"},{"aciklama":"Katılan kişinin yaşı:","ifade":"127"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.711,"gorsel":null},{"kimlik":"a24abb961bfb","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|3x − 16| < 38 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"15","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"12","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"24","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"D","metin":"25","dogru":true,"yanilgi":null},{"harf":"E","metin":"27","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"|A| < 38 eşitsizliği, A'nın −38 ile 38 arasında olması demektir:","ifade":"−38 < 3x − 16 < 38"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−22/3 < x < 18"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"25 tane"},{"aciklama":"Tam sayı adedi:","ifade":"25"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.034,"gorsel":null},{"kimlik":"b2947ef3349c","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 48 ve a · b = 19 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"2.266","dogru":true,"yanilgi":null},{"harf":"B","metin":"2.285","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"C","metin":"2.228","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"D","metin":"2.304","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"2.342","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"48² − 2 × 19 = 2.304 − 38 = 2.266"},{"aciklama":"a² + b² değeri:","ifade":"2.266"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.398,"gorsel":null},{"kimlik":"c395ac1c2ccf","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda İzmir'in Yaz satışı silinmiş, yerine 0 yazılmıştır. İzmir satırının gerçek yıllık toplamı 1.180 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"180 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"295 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"465 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"1.180 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"2.180 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"İzmir satırında görünen üç değeri topla:","ifade":"345 + 285 + 370 = 1.000"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"1.180 − 1.000 = 180"},{"aciklama":"Silinen değer:","ifade":"180 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.511,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Trabzon","degerler":[25,100,205,200]},{"ad":"İzmir","degerler":[345,0,285,370]},{"ad":"Samsun","degerler":[100,55,190,125]},{"ad":"Konya","degerler":[250,170,300,170]}]}},{"kimlik":"587a3e39bb92","sablon":"oran.paylastirma.fark","govde":"3.900 TL tutarındaki bir ödül, Merve ile Buse arasında 11/15 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.900 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"150 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"1.950 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"600 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.650 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"11 + 15 = 26"},{"aciklama":"Bir parçanın değeri:","ifade":"3.900 / 26 = 150 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(15 − 11) × 150 = 600 TL"},{"aciklama":"Aradaki fark:","ifade":"600 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":3.062,"gorsel":null},{"kimlik":"9f8a394a5bae","sablon":"yuzde.artis.zam","govde":"Fiyatı 2.000 TL olan bir ayakkabı, %8 zamlanmıştır. Zamdan sonra ayakkabının fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"2.008 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"1.840 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"18.000 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"160 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.160 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"2.000 × 8/100 = 160 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"2.000 + 160 = 2.160 TL"},{"aciklama":"Zamlı fiyat:","ifade":"2.160 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.54,"gorsel":null},{"kimlik":"22016ecb14dc","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 35| = 7 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"42","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"B","metin":"1.274","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"28","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"1.176","dogru":true,"yanilgi":null},{"harf":"E","metin":"−1.176","dogru":false,"yanilgi":"mutlak_deger_dagitildi"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 35 + 7 = 42 ve x = 35 − 7 = 28"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(35 + 7) × (35 − 7) = 35² − 7² = 1.176"},{"aciklama":"Köklerin çarpımı:","ifade":"1.176"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":2.034,"gorsel":null},{"kimlik":"c5537f4a0b66","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"280 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"105 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"C","metin":"430 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"10 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"130 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"Bursa: 280 − 150 = 130 · Konya: 60 − 50 = 10 · Eskişehir: 70 − 50 = 20 · İzmir: 350 − 245 = 105"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Bursa, 130 adet"},{"aciklama":"En büyük artış:","ifade":"130 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":-0.143,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Bursa","degerler":[150,300,280,170]},{"ad":"Konya","degerler":[50,190,60,190]},{"ad":"Eskişehir","degerler":[50,225,70,195]},{"ad":"İzmir","degerler":[245,355,350,300]}]}},{"kimlik":"4a47fbb22dbd","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n34, 39, 59, 104, 184, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"209","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"B","metin":"264","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"184","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"309","dogru":true,"yanilgi":null},{"harf":"E","metin":"308","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"5, 20, 45, 80"},{"aciklama":"Farklar ardışık sayıların karelerinin **5 katı**: 5·1², 5·2², 5·3², 5·4². Sıradaki fark 5·5²:","ifade":"125"},{"aciklama":"Son terime bu farkı ekle:","ifade":"184 + 125 = 309"},{"aciklama":"Sıradaki terim:","ifade":"309"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.775,"gorsel":null},{"kimlik":"e9b70c8f27d1","sablon":"problem.yas.toplam_iliskisi","govde":"Elif ile Ayşe'nin bugünkü yaşları toplamı 66'dır, aralarındaki yaş farkı ise 14'tür.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"26","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"54","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"C","metin":"47","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"D","metin":"40","dogru":true,"yanilgi":null},{"harf":"E","metin":"80","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(66 + 14) / 2 = 40"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"66 − 40 = 26"},{"aciklama":"Büyük olanın yaşı:","ifade":"40"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.124,"gorsel":null},{"kimlik":"0b238eb4b85b","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Kaan, Merve ve Ali arasında sırasıyla 2, 6 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 11.400 TL olduğuna göre, Ali'nin payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"41.800 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"6.600 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"600 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"D","metin":"3.800 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"4.800 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 6 + 11 = 19"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"11.400 / 19 = 600 TL"},{"aciklama":"Ali bu paylardan 11 tane alır:","ifade":"11 × 600 = 6.600 TL"},{"aciklama":"Ali'nin payı:","ifade":"6.600 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.807,"gorsel":null},{"kimlik":"bb9944b7cf79","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"305 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"10 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"215 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"280 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"225 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Bursa: 225/10 · İzmir: 305/52 · Ankara: 215/52 · Samsun: 280/20"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Bursa satırında:","ifade":"225/10"},{"aciklama":"O satırın satış sayısı:","ifade":"225 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.327,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Bursa","degerler":[225,10]},{"ad":"İzmir","degerler":[305,52]},{"ad":"Ankara","degerler":[215,52]},{"ad":"Samsun","degerler":[280,20]}]}},{"kimlik":"bb3dc9e690e6","sablon":"yuzde.faiz.anapara","govde":"Yıllık %10 basit faiz oranıyla 4 ay vadeye yatırılan bir anapara 640 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"19.200 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.600 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"19.840 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"4.800 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"6.400 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"4 ay için faiz katsayısı:","ifade":"10/100 × 4/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"640 / (10 × 4/1200) = 19.200 TL"},{"aciklama":"Anapara:","ifade":"19.200 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.398,"gorsel":null},{"kimlik":"174ca52c82f9","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 8| = 25 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"16,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"B","metin":"−8,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"C","metin":"8","dogru":true,"yanilgi":null},{"harf":"D","metin":"−8","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"25","dogru":false,"yanilgi":"mutlak_deger_dagitildi"}],"cozum":[{"aciklama":"Mutlak değer 25'e eşitse içerideki ifade 25 ya da −25 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 8 = 25 ⟹ x = 16,5"},{"aciklama":"İkinci durum:","ifade":"2x − 8 = −25 ⟹ x = −8,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"16,5 + (−8,5) = 2 × 8 / 2 = 8"},{"aciklama":"Köklerin toplamı:","ifade":"8"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.048,"gorsel":null},{"kimlik":"57c2fed0837e","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Yaz mevsiminde Eskişehir'in yaptığı satışın Antalya'nın yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"2","dogru":true,"yanilgi":null},{"harf":"B","metin":"0,25","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"0,8","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"0,5","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"40","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Yaz sütunundan iki değeri oku:","ifade":"Eskişehir: 80 · Antalya: 40"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"80 / 40 = 2"},{"aciklama":"Aranan oran:","ifade":"2"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Trabzon","degerler":[50,110,30,50]},{"ad":"Eskişehir","degerler":[70,80,40,110]},{"ad":"Antalya","degerler":[120,40,50,110]},{"ad":"İzmir","degerler":[20,90,120,80]}]}},{"kimlik":"8b58db295749","sablon":"cebir.ozdeslik.katsayi","govde":"(4x + 11) · (3x + 5) çarpımı düzenlendiğinde x'li terimin katsayısı kaç olur?","secenekler":[{"harf":"A","metin":"−13","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"53","dogru":true,"yanilgi":null},{"harf":"C","metin":"67","dogru":false,"yanilgi":"carpraz_terim_eslesmesi"},{"harf":"D","metin":"20","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"120","dogru":false,"yanilgi":"terimleri_toplayip_carpma"}],"cozum":[{"aciklama":"Parantezleri dağıt; her terim öbürünün her terimiyle çarpılır:","ifade":"4x · 3x + 4x · 5 + 11 · 3x + 11 · 5"},{"aciklama":"x'li terimler ortadaki iki çarpımdan gelir:","ifade":"4 · 5 · x + 11 · 3 · x"},{"aciklama":"Katsayıları topla:","ifade":"20 + 33 = 53"},{"aciklama":"x'li terimin katsayısı:","ifade":"53"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.312,"gorsel":null},{"kimlik":"156024e62f08","sablon":"mantik.dizi.sabit_fark","govde":"36, 53, 70, 87, 104, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"104","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"138","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"C","metin":"87","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"121","dogru":true,"yanilgi":null},{"harf":"E","metin":"120","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"53−36=17 , 70−53=17 , 87−70=17 , 104−87=17"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerliyor:","ifade":"fark = 17"},{"aciklama":"Son terime bu farkı ekle:","ifade":"104 + 17 = 121"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"121"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.85,"gorsel":null},{"kimlik":"0fe6b985239f","sablon":"problem.hareket.karsilikli","govde":"Aralarındaki uzaklık 420 km olan Ankara ve Konya şehirlerinden aynı anda birbirine doğru iki araç hareket ediyor. Araçların hızları sırasıyla 120 km/sa ve 20 km/sa olduğuna göre, araçlar kaç saat sonra karşılaşır?","secenekler":[{"harf":"A","metin":"4,2 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"B","metin":"21 saat","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"C","metin":"3,5 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"D","metin":"6 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"3 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Zıt yönde hareket eden araçlar için yaklaşma hızı, hızların toplamıdır:","ifade":"120 + 20 = 140 km/sa"},{"aciklama":"Karşılaşma süresi, aradaki uzaklığın yaklaşma hızına bölümüdür:","ifade":"420 / 140 = 3 saat"},{"aciklama":"Karşılaşma süresi:","ifade":"3 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.858,"gorsel":null},{"kimlik":"57802c8fa6b0","sablon":"oran.temel.oran_ve_fark","govde":"Kerem'in parasının Yusuf'un parasına oranı 13/3'tür. Aralarındaki fark 800 TL olduğuna göre Kerem kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"650 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"B","metin":"1.040 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"80 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"240 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"1.280 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Kerem 13k, Yusuf 3k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"13k − 3k = 10k = 800"},{"aciklama":"Birim payı bul:","ifade":"k = 800 / 10 = 80"},{"aciklama":"Kerem için:","ifade":"13 × 80 = 1.040"},{"aciklama":"Kerem'in parası:","ifade":"1.040 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.537,"gorsel":null},{"kimlik":"2dd66c472005","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Ankara'nın yıllık toplam satışı, Konya'nın yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"25 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"B","metin":"100 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"110 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"15 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"185 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"}],"cozum":[{"aciklama":"Ankara satırını topla:","ifade":"250 + 335 + 290 + 85 = 960"},{"aciklama":"Konya satırını topla:","ifade":"75 + 295 + 175 + 315 = 860"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"960 − 860 = 100"},{"aciklama":"Aradaki fark:","ifade":"100 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.971,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[55,110,250,345]},{"ad":"Ankara","degerler":[250,335,290,85]},{"ad":"Samsun","degerler":[100,370,80,255]},{"ad":"Konya","degerler":[75,295,175,315]}]}},{"kimlik":"097a6579ffff","sablon":"yuzde.faiz.basit_ay","govde":"2.400 TL tutarındaki bir anapara, yıllık %8 basit faiz oranıyla 8 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.536 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"24 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"2.528 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"128 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"192 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"8 ay, yıl cinsinden:","ifade":"8/12"},{"aciklama":"Faiz tutarı:","ifade":"2.400 × 8/100 × 8/12 = 128 TL"},{"aciklama":"Elde edilen faiz:","ifade":"128 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":0.862,"gorsel":null},{"kimlik":"6743c07f1623","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(5/7 + 9/14) : 6/11 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"209/84","dogru":true,"yanilgi":null},{"harf":"B","metin":"57/77","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"C","metin":"11/84","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"11/9","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"11/3","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(7, 14) = 14"},{"aciklama":"Her kesri, paydası 14 olacak biçimde genişlet:","ifade":"5/7 = 10/14  (payı da paydayı da 2 ile çarptık)\n9/14  (paydası zaten 14)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"10/14 + 9/14 = 19/14"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"19/14 × 11/6"},{"aciklama":"Çarpımı yap:","ifade":"19 × 11 / (14 × 6) = 209/84"},{"aciklama":"İşlemin sonucu:","ifade":"209/84"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.746,"gorsel":null},{"kimlik":"94620eaa64b1","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan üzüm, elma ve patatesin kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 300 kilogram satılmış ve toplam 84 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram üzüm ve patates satılmıştır?","secenekler":[{"harf":"A","metin":"200","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"260","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},{"harf":"C","metin":"270","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"240","dogru":true,"yanilgi":null},{"harf":"E","metin":"60","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Üzüm: 4,7 − 4,5 = 0,2 TL, Elma: 3,6 − 3 = 0,6 TL, Patates: 2,2 − 2 = 0,2 TL.","ifade":null},{"aciklama":"Üzüm ile patatesin kilogram kârı aynı. Hepsi 0,2 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"300 · 0,2 = 60 TL"},{"aciklama":"Fazladan 24 TL yalnızca elma yüzünden: onun her kilogramı 0,4 TL fazla kazandırıyor.","ifade":"elma = 24 ÷ 0,4 = 60 kg"},{"aciklama":"İstenen: 300 − 60 =","ifade":"240"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Üzüm","degerler":[4.5,4.7]},{"ad":"Elma","degerler":[3.0,3.6]},{"ad":"Patates","degerler":[2.0,2.2]}]}},{"kimlik":"cb86830c2af4","sablon":"kume.olasilik.kume_uzerinden","govde":"Bir sınıftaki 51 öğrenciden 37 tanesi tiyatro, 19 tanesi fotoğrafçılık kulübüne, 13 tanesi ise her iki kulübe birden üyedir. Bu sınıftan rastgele seçilen bir öğrencinin en az bir kulübe üye olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"43/56","dogru":false,"yanilgi":"olasilik_ornek_uzay"},{"harf":"B","metin":"8/51","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"C","metin":"56/51","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"51/43","dogru":false,"yanilgi":"olasilik_istenen_tum_ters"},{"harf":"E","metin":"43/51","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce en az bir kulübe üye olanları say; ortak üyeler bir kez düşülür:","ifade":"37 + 19 − 13 = 43"},{"aciklama":"Örnek uzay sınıfın tamamıdır:","ifade":"51 öğrenci"},{"aciklama":"Olasılık, istenen durum sayısının tüm durumlara oranıdır:","ifade":"43/51"},{"aciklama":"İstenen olasılık:","ifade":"43/51"}],"mikrobeceriler":["kume.olasilik","kume.temel"],"yanilgi_alanlari":[],"zorluk":2.393,"gorsel":null},{"kimlik":"43aceac5b840","sablon":"oran.temel.oran_ve_toplam","govde":"Merve'nin parasının Ece'nin parasına oranı 6/5'tir. İkisinin parası toplam 4.180 TL olduğuna göre Merve kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"1.900 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"380 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"2.280 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.090 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"25.080 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Merve 6k, Ece 5k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"6k + 5k = 11k = 4.180"},{"aciklama":"Birim payı bul:","ifade":"k = 4.180 / 11 = 380"},{"aciklama":"Merve için:","ifade":"6 × 380 = 2.280"},{"aciklama":"Merve'nin parası:","ifade":"2.280 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":1.545,"gorsel":null},{"kimlik":"fc794f5216d8","sablon":"yuzde.faiz.getiri_farki","govde":"5.000 TL, yıllık %36 faizle 4 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %18 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"900 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"225 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"18 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"600 TL","dogru":false,"yanilg