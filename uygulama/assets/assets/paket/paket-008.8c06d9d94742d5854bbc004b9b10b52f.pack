":"kume_yalnizca_biri"},{"harf":"E","metin":"4","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bir kursa giden öğrenci sayısı, iki kursa da gidenleri de içerir.","ifade":"matematik kursuna giden: 16"},{"aciklama":"Yalnızca matematik kursuna gidenleri bulmak için iki kursa da gidenleri çıkar:","ifade":"16 − 12 = 4"},{"aciklama":"Yalnızca o kursa gidenler:","ifade":"4"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.44,"gorsel":null,"grup":"77097d772772","grup_govde":"Bir sınıfta 60 öğrenci vardır. Bu öğrencilerin 16 tanesi matematik, 38 tanesi satranç kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 12'dir."},{"kimlik":"77097d772772-2","sablon":"kume.blok.iki_kurs_uc_soru","govde":"Bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"30","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"B","metin":"48","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"C","metin":"42","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"D","metin":"6","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"E","metin":"18","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"16 + 38 − 12 = 42"},{"aciklama":"Sınıfın tamamından bu sayıyı çıkar:","ifade":"60 − 42 = 18"},{"aciklama":"Hiçbir kursa gitmeyenler:","ifade":"18"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.738,"gorsel":null,"grup":"77097d772772","grup_govde":"Bir sınıfta 60 öğrenci vardır. Bu öğrencilerin 16 tanesi matematik, 38 tanesi satranç kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 12'dir."},{"kimlik":"77097d772772-3","sablon":"kume.blok.iki_kurs_uc_soru","govde":"İki kursa da giden öğrenciler, sınıfın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%80","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"%50","dogru":false,"yanilgi