verilmiştir.\n\nBuna göre dört mağazada satılan Ekmek sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"84 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"B","metin":"140 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"115 adet","dogru":false,"yanilgi":"ortalama_uc_degerlerden"},{"harf":"D","metin":"420 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"105 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Dört sütunun değerlerini topla:","ifade":"65 + 170 + 60 + 125 = 420"},{"aciklama":"Ortalama, toplamın sütun sayısına bölümüdür:","ifade":"420 / 4 = 105"},{"aciklama":"Ortalama satış:","ifade":"105 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":{"tur":"sutun","baslik":"Ekmek satışları (adet)","etiketler":["Merkez","Sahil","Yayla","Vadi"],"birim":"adet","seriler":[{"ad":"Ekmek","degerler":[65,170,60,125]}]}},{"kimlik":"b3527bfd3e1e","sablon":"oran.bilesik.isci_ucret","govde":"6 işçi 11 günde çalışarak toplam 39.600 TL kazanmaktadır. Aynı günlük ücretle çalışan 11 işçi 5 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"18.000 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"600 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"47.520 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"D","metin":"72.600 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"E","metin":"33.000 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"39.600 / (6 × 11) = 600 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"11 × 5 = 55"},{"aciklama":"Toplam ücret:","ifade":"55 × 600 = 33.000 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"33.000 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_a