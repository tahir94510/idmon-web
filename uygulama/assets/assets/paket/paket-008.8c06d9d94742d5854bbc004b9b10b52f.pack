0","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"D","metin":"946","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"E","metin":"8.424","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 8.424"},{"aciklama":"İlk sayı:","ifade":"x = 8.424 / 9 = 936"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 936 = 9.360"},{"aciklama":"Yeni sayı:","ifade":"9.360"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.369,"gorsel":null},{"kimlik":"2f24aa4aedbf","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Kitap sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"200 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"125 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"600 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"120 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"E","metin":"150 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Ocak: 125 · Şubat: 155 · Mart: 145 · Nisan: 175"},{"aciklama":"Dördünü topla:","ifade":"125 + 155 + 145 + 175 = 600"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"600/4 = 150"},{"aciklama":"Dönem ortalaması:","ifade":"150 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-1.228,"gorsel":{"tur":"cizgi","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[125,155,145,175]}]}},{"kimlik":"13f9d4d5f63a","sablon":"mantik.sifreleme.artan_kaydirma","govde":"Bir şifrelemede TABAK