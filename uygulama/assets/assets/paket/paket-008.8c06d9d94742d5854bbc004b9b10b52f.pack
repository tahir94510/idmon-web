:","ifade":"2x ÷ [x·100/(72·28)] = 2·72·28/100 = 40,32 km/sa"},{"aciklama":"Ortalama hız:","ifade":"40,32 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"a12ff9cc1fda","sablon":"oran.temel.zincir","govde":"Fatma'nın parasının Ali'nin parasına oranı 12/13, Ali'nin parasının Deniz'in parasına oranı 5/4 olarak veriliyor. Buna göre Fatma'nın parasının Deniz'in parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"15/13","dogru":true,"yanilgi":null},{"harf":"B","metin":"48/65","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"13/15","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"D","metin":"113/52","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"12/13","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ortadaki terim ortak olduğu için oranlar zincirlenir:","ifade":"(12/13) × (5/4)"},{"aciklama":"Çarpım sadeleştirilir:","ifade":"60/52 = 15/13"},{"aciklama":"Aranan oran:","ifade":"15/13"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.dogru"],"zorluk":2.034,"gorsel":null},{"kimlik":"0d3d31197468","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 2.720 TL olan bir klavye 6.800 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%4.080","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%250","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"C","metin":"%60","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%40","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"%150","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"6.800 TL − 2.720 TL = 4.080 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"4.080 / 2.720 × 100 = 150"},{"aciklama":"Kâr oranı:","ifade":"%150"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":