e.temel"],"yanilgi_alanlari":[],"zorluk":-0.322,"gorsel":{"tur":"tablo","baslik":"Şubelere göre personel sayısı","etiketler":["İzmir","Ankara","Bursa","Konya"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[320,240,160,80]}]}},{"kimlik":"18bd3a8805c5","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 7 : 4 : 2 oranındadır. İkinci arkadaşın parası 216 TL olduğuna göre üçüncü arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"2 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"432 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"234 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"54 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"108 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"7k : 4k : 2k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"4k = 216 → k = 54"},{"aciklama":"Sorulan payı k ile çarp (üçüncü arkadaş):","ifade":"2 × 54 = 108"},{"aciklama":"Üçüncü arkadaşın parası:","ifade":"108 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.086,"gorsel":null},{"kimlik":"f703ec812617","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 5.920 TL olan bir battaniye 9.472 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%160","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"B","metin":"%62,5","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"%37,5","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%60","dogru":true,"yanilgi":null},{"harf":"E","metin":"%3.552","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"9.472 TL − 5.920 TL = 3.552 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"3.552 / 5.920 × 100 = 60"},{"aciklama":"Kâr oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"acf632380ebf","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|4x + y − 34| + z = 8\n|2x − y − 20| = 4z − 32\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"7","dogru":true,"yanilgi":null},{"harf":"B","metin":"8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"27","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"D","metin":"13","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−27","dogru":false,"yanilgi":"taraf_degistirirken_toplama"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 8 − |…| ≤ 8"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"4z − 32 ≥ 0 , yani z ≥ 8"},{"aciklama":"İkisi birlikte:","ifade":"z = 8"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"4x + y = 34 , 2x − y = 20"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 9 , y = −2"},{"aciklama":"İstenen toplam, x + y:","ifade":"7"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null}]}