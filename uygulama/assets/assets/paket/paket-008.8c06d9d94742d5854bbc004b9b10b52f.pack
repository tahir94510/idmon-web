 8.046 / 9 = 894"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 894 = 8.940"},{"aciklama":"Yeni sayı:","ifade":"8.940"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.457,"gorsel":null},{"kimlik":"9c9f840959fe","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n41, 43, 51, 69, 101, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"101","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"151","dogru":true,"yanilgi":null},{"harf":"C","metin":"133","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"D","metin":"111","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"150","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"2, 8, 18, 32"},{"aciklama":"Farklar ardışık sayıların karelerinin **2 katı**: 2·1², 2·2², 2·3², 2·4². Sıradaki fark 2·5²:","ifade":"50"},{"aciklama":"Son terime bu farkı ekle:","ifade":"101 + 50 = 151"},{"aciklama":"Sıradaki terim:","ifade":"151"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"e3df07a75aef","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Bursa ile İzmir arasındaki yolu giderken 39 km/sa, dönerken 117 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"156 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"B","metin":"78 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"29,25 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"D","metin":"58,5 km/sa","dogru":true,"yanilgi":null},{"harf":"E","metin":"39 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/39 + x/117 = x·(156)/(39·117)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·156/(39·117)] = 2·39·117/156 = 58,5 km/sa"},{"aciklama":"Ortalama hız:","ifade":"58,5 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.658,"gorsel":null},{"kimlik":"e6da96b54442","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 1.400 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Kiraz tercih edenler, Üzüm tercih edenlerden kaç kişi fazladır?","secenekler":[{"harf":"A","metin":"560 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"210 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"5.600 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"40 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"840 kişi","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Dilimler yüzdedir; önce ikisinin yüzde farkını al:","ifade":"%50 − %10 = %40"},{"aciklama":"Yüzde farkını kişi sayısına çevir:","ifade":"1.400 × 40 / 100 = 560"},{"aciklama":"Aradaki fark:","ifade":"560 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":1.366,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[35,5,50,10]}]}},{"kimlik":"280f98c88a45","sablon":"oran.ters.kapasite_arac","govde":"Bir depodaki yükün tamamı, her biri 4 ton taşıyan 22 kamyonla bir seferde taşınmaktadır. Aynı yük, her biri 2 ton taşıyan kamyonlarla bir seferde taşınsaydı kaç kamyon gerekirdi?","secenekler":[{"harf":"A","metin":"88 kamyon","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"24 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"20 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"D","metin":"44 kamyon","dogru":true,"yanilgi":null},{"harf":"E","metin":"11 kamyon","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"Taşınan yük değişmiyor; değişen yalnızca onu kaç araca böldüğümüz. Araç sayısı ile kapasite **ters** orantılıdır, yani çarpımları sabittir.","ifade":null},{"aciklama":"Toplam yükü bul:","ifade":"22 × 4 = 88 ton"},{"aciklama":"Yeni kapasiteye böl:","ifade":"88 / 2 = 44"},{"aciklama":"Gereken kamyon sayısı:","ifade":"44 kamyon"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.079,"gorsel":null},{"kimlik":"9bfbc5d234e1","sablon":"yuzde.kar_zarar.zarar_orani","govde":"Maliyeti 3.800 TL olan bir ürün 1.520 TL fiyatına satılmıştır. Bu satışta zarar yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%60","dogru":true,"yanilgi":null},{"harf":"B","metin":"%250","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%150","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"D","metin":"%2.280","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%40","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"3.800 − 1.520 = 2.280 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"2.280 / 3.800 × 100 = %60"},{"aciklama":"Zarar oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.862,"gorsel":null},{"kimlik":"3042f723d7db","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 396 azalmaktadır. Bu sayının yüzler basamağındaki rakam 9, onlar basamağındaki rakam 7'dir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"975","dogru":true,"yanilgi":null},{"harf":"B","metin":"912","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"C","metin":"957","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"D","metin":"579","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"95","dogru":false,"yanilgi":"sifir_basamak_atlandi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (9 − b) = 396 ⟹ 9 − b = 4 ⟹ b = 5"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 9 + 10 × 7 + 5 = 975"},{"aciklama":"Aranan sayı:","ifade":"975"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"4e5287094bf0","sablon":"veri.grafik.daire_iki_dilim","govde":"700 kişiyle yapılan bir ankette tercihler yukarıdaki daire grafiğindeki gibi dağılmıştır. Buna göre Elma ve Üzüm seçeneklerini işaretleyen toplam kaç kişi vardır?","secenekler":[{"harf":"A","metin":"245 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"455 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"175 kişi","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"350 kişi","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"35 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"İki dilimin yüzdelerini topla:","ifade":"%25 + %10 = %35"},{"aciklama":"Bu yüzdeyi toplam kişi sayısıyla çarp:","ifade":"700 × 35/100 = 245 kişi"},{"aciklama":"Toplam kişi:","ifade":"245 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.17,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[25,15,50,10]}]}},{"kimlik":"41723cf6f51f","sablon":"mantik.dizi.sabit_fark","govde":"36, 48, 60, 72, 84, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"96","dogru":true,"yanilgi":null},{"harf":"B","metin":"108","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"C","metin":"84","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"95","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"E","metin":"72","dogru":false,"yanilgi":"dizi_yon_ters"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"48−36=12 , 60−48=12 , 72−60=12 , 84−72=12"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerliyor:","ifade":"fark = 12"},{"aciklama":"Son terime bu farkı ekle:","ifade":"84 + 12 = 96"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"96"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.724,"gorsel":null},{"kimlik":"1061b39ffe61","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 40 km sabit hızla yola çıkmıştır. 3 saat sonra aynı noktadan aynı yöne, saatte 55 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"24/19 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"B","metin":"48/19 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"8 saat","dogru":true,"yanilgi":null},{"harf":"D","metin":"24/11 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"E","metin":"120 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"40 × 3 = 120 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"55 − 40 = 15 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"120 / 15 = 8"},{"aciklama":"Yetişme süresi:","ifade":"8 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"f2bf89589167","sablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Voleybol dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"36 derece","dogru":true,"yanilgi":null},{"harf":"B","metin":"324 derece","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"108 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"18 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"10 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Voleybol diliminin payı:","ifade":"%10"},{"aciklama":"Merkez açısı:","ifade":"360 × 10 / 100 = 36"},{"aciklama":"Merkez açısı:","ifade":"36 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.066,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"%","seriler":[{"ad":"Pay","degerler":[5,55,10,30]}]}},{"kimlik":"368c83d2c6e9","sablon":"oran.ters.musluk_havuz","govde":"Özdeş 3 musluk bir havuzu 20 saatte doldurmaktadır. Aynı havuz özdeş 6 muslukla kaç saatte dolar?","secenekler":[{"harf":"A","metin":"23 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"B","metin":"17 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"C","metin":"10 saat","dogru":true,"yanilgi":null},{"harf":"D","metin":"40 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"40/3 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"}],"cozum":[{"aciklama":"Musluk sayısı ile süre ters orantılıdır; çarpımları sabittir:","ifade":"3 × 20 = 60"},{"aciklama":"6 muslukta süre, bu sabitin musluk sayısına bölümüdür:","ifade":"60 / 6 = 10 saat"},{"aciklama":"Dolma süresi:","ifade":"10 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.123,"gorsel":null},{"kimlik":"38a47737570a","sablon":"yuzde.temel.iki_yuzde_farki","govde":"1.950 sayısının %40'ı ile %24'ü arasındaki fark kaçtır?","secenekler":[{"harf":"A","metin":"312","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.248","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"3.120","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"780","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"16","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Sayının %40'ını al:","ifade":"1.950 × 40/100 = 780"},{"aciklama":"Sayının %24'ünü al:","ifade":"1.950 × 24/100 = 468"},{"aciklama":"İki sonucun farkını al (yüzdelerin farkı doğrudan cevap değil, o farkın sayıdaki karşılığı sorulmuş):","ifade":"780 − 468 = 312"},{"aciklama":"Aradaki fark:","ifade":"312"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.844,"gorsel":null},{"kimlik":"742f179b0857","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 19 ile bölümünden elde edilen bölüm 22, kalan ise 1'dir. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"418","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"B","metin":"437","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"C","metin":"419","dogru":true,"yanilgi":null},{"harf":"D","metin":"417","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"E","metin":"41","dogru":false,"yanilgi":"kalan_bolen_karisimi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"19 × 22 + 1 = 418 + 1 = 419"},{"aciklama":"Kalan (1) bölenden (19) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"419"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.536,"gorsel":null},{"kimlik":"74c75df9db38","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 860 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Kiraz tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"516 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"258 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"3.440 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"344 kişi","dogru":true,"yanilgi":null},{"harf":"E","metin":"40 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Kiraz diliminin payı:","ifade":"%40"},{"aciklama":"Kişi sayısı:","ifade":"860 × 40 / 100 = 344"},{"aciklama":"Kişi sayısı:","ifade":"344 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.097,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[20,10,40,30]}]}},{"kimlik":"c7584955df23","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 4/x = 36 olduğuna göre x² + 4²/x² kaçtır?","secenekler":[{"harf":"A","metin":"1.304","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"B","metin":"1.280","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"1.292","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"D","metin":"1.288","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.296","dogru":false,"yanilgi":"tam_kare_orta_terim"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 4/x)² = x² + 2 · x · 4/x + 4²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 4 kalır:","ifade":"36² = x² + 4²/x² + 8"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 4²/x² = 1.296 − 8 = 1.288"},{"aciklama":"İstenen değer:","ifade":"1.288"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":3.095,"gorsel":null},{"kimlik":"028377e81138","sablon":"kume.temel.herkes_en_az_bir","govde":"Bir grupta 71 kişi vardır ve herkes bu iki dilden en az birini bilmektedir. İngilizce bilen 56, Almanca bilen 42 kişi olduğuna göre, her iki dili de bilen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"44","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"B","metin":"15","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"C","metin":"29","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"27","dogru":true,"yanilgi":null},{"harf":"E","metin":"98","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"}],"cozum":[{"aciklama":"Herkes en az birini bildiği için birleşim grubun tamamıdır:","ifade":"s(A ∪ B) = 71"},{"aciklama":"Birleşim formülünü kesişim için çöz:","ifade":"s(A ∩ B) = 56 + 42 − 71 = 27"},{"aciklama":"Her iki dili de bilen kişi sayısı:","ifade":"27"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.701,"gorsel":null},{"kimlik":"050f6c5e57de","sablon":"oran.ters.uc_makine","govde":"Bir iş 2 işçiyle 180 günde, 8 işçiyle 45 günde bitmektedir. Aynı iş 3 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"120 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"40 gün","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"C","metin":"179 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"D","metin":"270 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"112,5 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"}],"cozum":[{"aciklama":"Ters orantıda çokluklar birlikte artmaz; **çarpımları** sabit kalır. İki durumdan sabiti çıkar:","ifade":"2 × 180 = 360"},{"aciklama":"İkinci durum da aynı sabiti veriyor, yani kural doğrulanıyor:","ifade":"8 × 45 = 360"},{"aciklama":"Üçüncü durumda gün sayısını sabitten çöz:","ifade":"360/3 = 120"},{"aciklama":"Gereken süre:","ifade":"120 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":["oran.bilesik"],"zorluk":0.738,"gorsel":null},{"kimlik":"d3666f0c6081","sablon":"veri.grafik.sutun_en_cok_dusen","govde":"Bir işletmenin dört şubede sattığı Telefon sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre **ardışık** iki şube arasındaki en büyük düşüş kaç adettir