"Eksik not, iki toplamın farkıdır:","ifade":"348 − 325 = 23"},{"aciklama":"Kalan öğrencinin notu:","ifade":"23"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.495,"gorsel":null},{"kimlik":"b015f1b63b8f","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"45² − 42² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"3.789","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"135","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"9","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"261","dogru":true,"yanilgi":null},{"harf":"E","metin":"−261","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(45 − 42)(45 + 42) = 3 × 87"},{"aciklama":"Çarpımı yap:","ifade":"3 × 87 = 261"},{"aciklama":"İşlemin sonucu:","ifade":"261"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":-0.143,"gorsel":null},{"kimlik":"6acb5e5fe66a","sablon":"kume.olasilik.iki_torba","govde":"Birinci torbada 4 siyah, 3 sarı top; ikinci torbada 6 siyah, 4 sarı top vardır. Her torbadan rastgele birer top çekildiğine göre, çekilen iki topun da siyah olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"10/17","dogru":false,"yanilgi":"olasilik_ornek_uzay"},{"harf":"B","metin":"35/12","dogru":false,"yanilgi":"olasilik_istenen_tum_ters"},{"harf":"C","metin":"29/35","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"D","metin":"41/35","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"E","metin":"12/35","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Birinci torbadan siyah çekme olasılığı:","ifade":"4/7"},{"aciklama":"İkinci torbadan siyah çekme olasılığı:","ifade":"6/10"},{"aciklama":"Torbalar birbirinden bağımsız olduğu için olasılıklar çarpılır:","ifade":"4/7 × 6/10 = 24/70 = 12/35"},{"aciklama":"İstenen olası