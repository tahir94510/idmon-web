e":"Bir araç 100 kilometrede 20 litre yakıt tüketmektedir.\n\nBu araç Bursa'ya yapılan 2.900 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"5.800 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"145 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"580 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"20 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"29 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"20/100 = x/2.900"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.900 × 20/100 = 580"},{"aciklama":"Tüketilen yakıt:","ifade":"580 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":0.213,"gorsel":null},{"kimlik":"3f0274279d4e","sablon":"veri.ortalama.medyan_tek","govde":"106, 144, 16, 84, 160, 50, 168 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"104","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"B","metin":"144","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"92","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"106","dogru":true,"yanilgi":null},{"harf":"E","metin":"84","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"16 < 50 < 84 < 106 < 144 < 160 < 168"},{"aciklama":"Terim sayısı 7, yani tek: ortada tek bir terim var.","ifade":"7 → 4. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"106"},{"aciklama":"Ortanca:","ifade":"106"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0