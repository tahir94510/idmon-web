rue,"yanilgi":null},{"harf":"B","metin":"401","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"391","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"3.519","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"E","metin":"39.100","dogru":false,"yanilgi":"basamak_yer_degistirme"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 3.519"},{"aciklama":"İlk sayı:","ifade":"x = 3.519 / 9 = 391"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 391 = 3.910"},{"aciklama":"Yeni sayı:","ifade":"3.910"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-1.139,"gorsel":null},{"kimlik":"7f86442788d7","sablon":"veri.grafik.daire_iki_dilim","govde":"3.700 kişiyle yapılan bir ankette tercihler yukarıdaki daire grafiğindeki gibi dağılmıştır. Buna göre Kiraz ve Elma seçeneklerini işaretleyen toplam kaç kişi vardır?","secenekler":[{"harf":"A","metin":"35 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"B","metin":"185 kişi","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"2.405 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"1.850 kişi","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"1.295 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki dilimin yüzdelerini topla:","ifade":"%5 + %30 = %35"},{"aciklama":"Bu yüzdeyi toplam kişi sayısıyla çarp:","ifade":"3.700 × 35/100 = 1.295 kişi"},{"aciklama":"Toplam kişi:","ifade":"1.295 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.17,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[30,40,5,25]}]}},{"kimlik":"ade1ad91f6ac","sablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Voleybol dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"40 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"B","metin":"144 derece","dogru":true,"yanilgi":null},{"harf":"C","metin":"216 derece","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"18 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"72 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Voleybol diliminin payı:","ifade":"%40"},{"aciklama":"Merkez açısı:","ifade":"360 × 40 / 100 = 144"},{"aciklama":"Merkez açısı:","ifade":"144 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.455,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"%","seriler":[{"ad":"Pay","degerler":[45,10,40,5]}]}},{"kimlik":"22bafb876dbe","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 2, onlar basamağındaki rakam 2'dir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"203","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"B","metin":"21","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"C","metin":"122","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"D","metin":"221","dogru":true,"yanilgi":null},{"harf":"E","metin":"212","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (2 − b) = 99 ⟹ 2 − b = 1 ⟹ b = 1"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 2 + 10 × 2 + 1 = 221"},{"aciklama":"Aranan sayı:","ifade":"221"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"389030b4ab08","sablon":"oran.ters.uc_makine","govde":"Bir iş 8 işçiyle 36 günde, 3 işçiyle 96 günde bitmektedir. Aynı iş 2 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"9 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"72 gün","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"C","metin":"66 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"},{"harf":"D","metin":"144 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"42 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"Ters orantıda çokluklar birlikte artmaz; **çarpımları** sabit kalır. İki durumdan sabiti çıkar:","ifade":"8 × 36 = 288"},{"aciklama":"İkinci durum da aynı sabiti veriyor, yani kural doğrulanıyor:","ifade":"3 × 96 = 288"},{"aciklama":"Üçüncü durumda gün sayısını sabitten çöz:","ifade":"288/2 = 144"},{"aciklama":"Gereken süre:","ifade":"144 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":["oran.bilesik"],"zorluk":0.724,"gorsel":null},{"kimlik":"89d343c65915","sablon":"yuzde.temel.orandan_oran","govde":"Bir sayının %5'i 210'dur.\n\nBuna göre aynı sayının %30'u kaçtır?","secenekler":[{"harf":"A","metin":"4.200","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"1.260","dogru":true,"yanilgi":null},{"harf":"C","metin":"63","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"35","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"235","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Sayının %5'i biliniyorsa sayının kendisi bulunur:","ifade":"210 / (5/100) = 4.200"},{"aciklama":"Sayının %30'u:","ifade":"4.200 × 30/100 = 1.260"},{"aciklama":"Aranan değer:","ifade":"1.260"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["oran.temel","yuzde.artis_azalis"],"zorluk":-0.765,"gorsel":null},{"kimlik":"95dd46a9927d-1","sablon":"kume.blok.iki_kurs_uc_soru","govde":"Yalnızca fen kursuna giden kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"15","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"3","dogru":true,"yanilgi":null},{"harf":"C","metin":"7","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"D","metin":"10","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"12","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"}],"cozum":[{"aciklama":"Bir kursa giden öğrenci sayısı, iki kursa da gidenleri de içerir.","ifade":"fen kursuna giden: 15"},{"aciklama":"Yalnızca fen kursuna gidenleri bulmak için iki kursa da gidenleri çıkar:","ifade":"15 − 12 = 3"},{"aciklama":"Yalnızca o kursa gidenler:","ifade":"3"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.254,"gorsel":null,"grup":"95dd46a9927d","grup_govde":"Bir sınıfta 50 öğrenci vardır. Bu öğrencilerin 15 tanesi fen, 19 tanesi resim kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 12'dir."},{"kimlik":"95dd46a9927d-2","sablon":"kume.blok.iki_kurs_uc_soru","govde":"Bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"22","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"B","metin":"40","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"C","metin":"38","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"D","metin":"28","dogru":true,"yanilgi":null},{"harf":"E","metin":"16","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"15 + 19 − 12 = 22"},{"aciklama":"Sınıfın tamamından bu sayıyı çıkar:","ifade":"50 − 22 = 28"},{"aciklama":"Hiçbir kursa gitmeyenler:","ifade":"28"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.592,"gorsel":null,"grup":"95dd46a9927d","grup_govde":"Bir sınıfta 50 öğrenci vardır. Bu öğrencilerin 15 tanesi fen, 19 tanesi resim kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 12'dir."},{"kimlik":"95dd46a9927d-3","sablon":"kume.blok.iki_kurs_uc_soru","govde":"İki kursa da giden öğrenciler, sınıfın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%20","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"B","metin":"%76","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"%68","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"%24","dogru":true,"yanilgi":null},{"harf":"E","metin":"%80","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"İki kursa da gidenlerin sayısı soruda verilmiş:","ifade":"12"},{"aciklama":"Payda, sorunun tanımladığı bütündür: sınıfın tamamı.","ifade":"50"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"12 / 50 × 100 = %24"},{"aciklama":"Sınıf içindeki pay:","ifade":"%24"}],"mikrobeceriler":["kume.temel","yuzde.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.799,"gorsel":null,"grup":"95dd46a9927d","grup_govde":"Bir sınıfta 50 öğrenci vardır. Bu öğrencilerin 15 tanesi fen, 19 tanesi resim kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 12'dir."},{"kimlik":"cec3076a2848","sablon":"mantik.esleme.yerlestirme","govde":"4, 5, 8, 11, 14 ve 15 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ × □ − □ = □ + □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":true,"yanilgi":null},{"harf":"B","metin":"11","dogru":false,"yanilgi":null},{"harf":"C","metin":"15","dogru":false,"yanilgi":null},{"harf":"D","metin":"5","dogru":false,"yanilgi":null},{"harf":"E","metin":"14","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Soldaki çarpımdan bir sayı çıkınca, sağdaki iki sayının toplamı kalmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"5 × 8 − 11 = 14 + 15"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"4"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null,"cevap_uzayi":true},{"kimlik":"9e8be8cd0221","sablon":"problem.isci.kalan_is","govde":"Bir işi Kerem tek başına 168 günde, Zeynep tek başına 56 günde bitirmektedir. Kerem işe başlayıp 123 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Zeynep tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"41 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"224 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"15 gün","dogru":true,"yanilgi":null},{"harf":"D","metin":"112 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"E","metin":"56 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Kerem günde işin 1/168'ini yapıyor; 123 günde:","ifade":"123/168"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 123/168 = 15/56"},{"aciklama":"Zeynep işin tamamını 56 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"15/56 × 56 = 15"},{"aciklama":"Kalan iş için gereken süre:","ifade":"15 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"a676112dd504","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 300 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Öykü tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"45 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"240 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"20 kişi","dogru":false,"yanilg