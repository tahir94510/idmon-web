ablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 73. Öğrencilerden 3'ü sırasıyla 45, 94 ve 71 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"82","dogru":true,"yanilgi":null},{"harf":"B","metin":"210","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"153","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"155","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"292","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"73 × 4 = 292"},{"aciklama":"Bilinen notların toplamı:","ifade":"45 + 94 + 71 = 210"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"292 − 210 = 82"},{"aciklama":"Kalan öğrencinin notu:","ifade":"82"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"33410dd0c676","sablon":"cebir.esitsizlik.cift_tarafli","govde":"−52 < 4x − 25 < 37 eşitsizliğini sağlayan x'in en büyük tam sayı değeri kaçtır?","secenekler":[{"harf":"A","metin":"−6","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"9","dogru":false,"yanilgi":"esitsizlik_ucu_ayrilmadi"},{"harf":"C","metin":"3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"15","dogru":true,"yanilgi":null},{"harf":"E","metin":"16","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"Çift taraflı eşitsizlikte yapılan işlem her üç bölüme birden uygulanır. Önce sabit terimi at:","ifade":"−27 < 4x < 62"},{"aciklama":"Her bölümü 4 ile böl:","ifade":"−6,75 < x < 15,5"},{"aciklama":"Üst sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"15"},{"aciklama":"En büyük tam sayı değer:","ifade":"15"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":1.398,"gorsel":null},{"kimlik":"05efa22e303f","sablon":"oran.dogru.tarif_olcekleme","govde":"7 kişilik bir tarifte 540 gram un kullanılmaktadır. Aynı tarif 21 kişi için hazırlanacağına göre kaç gram un gerekir?","secenekler":[{"harf":"A","metin":"554 gram","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"B","metin":"1.080 gram","dogru":false,"yanilgi":"yalniz_eklenen_kisim"},{"harf":"C","metin":"1.620 gram","dogru":true,"yanilgi":null},{"harf":"D","metin":"180 gram","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"E","metin":"540/7 gram","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kişi sayısı ile malzeme **doğru orantılıdır**: kişi kaç kat artarsa malzeme de o kat artar.","ifade":null},{"aciklama":"Kaç kat arttığını bul:","ifade":"21 / 7 = 3"},{"aciklama":"Malzemeyi aynı katla çarp:","ifade":"540 × 3 = 1.620"},{"aciklama":"Gereken un:","ifade":"1.620 gram"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.paylastirma","oran.ters"],"zorluk":-1.408,"gorsel":null},{"kimlik":"a6c3f72d9822","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 24 kişilik A grubunun puan ortalaması 46, 18 kişilik B grubunun puan ortalaması 60 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"106","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"91","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"53","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"52","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.184","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 24 × 46","ifade":"1.104"},{"aciklama":"B grubu: 18 × 60","ifade":"1.080"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"2.184 / 42 = 52"},{"aciklama":"Ortak ortalama:","ifade":"52"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.42,"gorsel":null},{"kimlik":"0f2d60bf2f97","sablon":"yuzde.artis.degisim_orani","govde":"Bir atölyenin aylık üretimi 2.700 adetten 3.375 adede çıkmıştır. Üretimdeki artış yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%80","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"%675","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"%25","dogru":true,"yanilgi":null},{"harf":"D","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Artış miktarı bulunur:","ifade":"3.375 − 2.700 = 675 adet"},{"aciklama":"Yüzde artış, artışın **eski** değere oranıdır:","ifade":"675 / 2.700 × 100 = %25"},{"aciklama":"Artış oranı:","ifade":"%25"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-0.193,"gorsel":null},{"kimlik":"00c3e71b1f89","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 105 cm ve 60 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"420 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"B","metin":"11 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"165 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"D","metin":"5 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"},{"harf":"E","metin":"15 cm","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"105 = 15·7   ve   60 = 15·4"},{"aciklama":"Ortak çarpan 15; kalan çarpanlar (7 ve 4) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(105, 60) = 15"},{"aciklama":"En büyük parça uzunluğu:","ifade":"15 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.495,"gorsel":null},{"kimlik":"7c54d36e255c","sablon":"kume.sayma.rakamlarla_sayi","govde":"0, 1, 6, 7 ve 8 rakamları kullanılarak, rakamları birbirinden farklı kaç üç basamaklı sayı yazılabilir?","secenekler":[{"harf":"A","metin":"12","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"B","metin":"10","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"C","metin":"48","dogru":true,"yanilgi":null},{"harf":"D","metin":"60","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"E","metin":"100","dogru":false,"yanilgi":"sayma_tekrarli_secim"}],"cozum":[{"aciklama":"Basamaklar soldan sağa doldurulur ve her adımda kullanılan rakam havuzdan çıkar.","ifade":null},{"aciklama":"Bir sayı 0 ile başlayamaz; ilk basamak için 5 rakamdan 0 hariç 4 seçenek vardır.","ifade":null},{"aciklama":"Kalan basamaklar için seçenekler:","ifade":"4 × 4 × 3 = 48"},{"aciklama":"Yazılabilecek sayı adedi:","ifade":"48"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"d11fa02a88d4","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 22 kişilik bir grubun yaş ortalaması 30, ikinci bir grubun yaş ortalaması ise 60'tır. İki grup birleştiğinde yaş ortalaması 49 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"33 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"B","metin":"22 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"30 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"60 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"38 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"22·30 + n·60"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(22·30 + n·60) / (22 + n) = 49"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"22·(30 − 49) = n·(49 − 60)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"38 kişi"}],"mikr