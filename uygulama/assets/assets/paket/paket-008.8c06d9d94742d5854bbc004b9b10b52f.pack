"259/156","dogru":true,"yanilgi":null},{"harf":"C","metin":"77/156","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"63/64","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"148/273","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 3) = 39"},{"aciklama":"Her kesri, paydası 39 olacak biçimde genişlet:","ifade":"8/13 = 24/39  (payı da paydayı da 3 ile çarptık)\n1/3 = 13/39  (payı da paydayı da 13 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"24/39 + 13/39 = 37/39"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"37/39 × 7/4"},{"aciklama":"Çarpımı yap:","ifade":"37 × 7 / (39 × 4) = 259/156"},{"aciklama":"İşlemin sonucu:","ifade":"259/156"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.366,"gorsel":null},{"kimlik":"2c93c0ffd728","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 21 kişilik bir grubun yaş ortalaması 65, ikinci bir grubun yaş ortalaması ise 50'dir. İki grup birleştiğinde yaş ortalaması 57 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"24 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"21 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"45 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"15 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"28 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"21·65 + n·50"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(21·65 + n·50) / (21 + n) = 57"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"21·(65 − 57) = n·(57 − 50)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"24 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.325,"gorsel":null},{"kimlik":"69079e30365b","sablon":"oran.dogru.tarif_olcekleme","govde":"4 kişilik bir tarifte 480 gram un kullanılmaktadır. Aynı tarif 20 kişi için hazırlanacağına göre kaç gram un gerekir?","secenekler":[{"harf":"A","metin":"120 gram","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"2.400 gram","dogru":true,"yanilgi":null},{"harf":"C","metin":"496 gram","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"D","metin":"1.920 gram","dogru":false,"yanilgi":"yalniz_eklenen_kisim"},{"harf":"E","metin":"9.600 gram","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Kişi sayısı ile malzeme **doğru orantılıdır**: kişi kaç kat artarsa malzeme de o kat artar.","ifade":null},{"aciklama":"Kaç kat arttığını bul:","ifade":"20 / 4 = 5"},{"aciklama":"Malzemeyi aynı katla çarp:","ifade":"480 × 5 = 2.400"},{"aciklama":"Gereken un:","ifade":"2.400 gram"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.paylastirma","oran.ters"],"zorluk":-1.023,"gorsel":null},{"kimlik":"fb80b3bc775c","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 520 TL olan bir şemsiye %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"C","metin":"%37,5","dogru":true,"yanilgi":null},{"harf":"D","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"520 × 160/100 = 832 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"832 − 520 = 312 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indiri