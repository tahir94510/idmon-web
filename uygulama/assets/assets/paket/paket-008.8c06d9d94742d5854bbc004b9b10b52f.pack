ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.458,"gorsel":null},{"kimlik":"f3b0e729fff8","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 12 kişinin yaş ortalaması 72. Gruba bir kişi daha katılınca ortalama 74'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"96","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"74","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"98","dogru":true,"yanilgi":null},{"harf":"D","metin":"24","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"73","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"12 × 72 = 864"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"13 × 74 = 962"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"962 − 864 = 98"},{"aciklama":"Katılan kişinin yaşı:","ifade":"98"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.589,"gorsel":null},{"kimlik":"1e5ff3e35102","sablon":"cebir.esitsizlik.iki_taraf_bilinmeyen","govde":"2x + 7 > 9x − 24 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":true,"yanilgi":null},{"harf":"B","metin":"−3","dogru":false,"yanilgi":"esitsizlikte_sabitler_ayni_tarafta"},{"harf":"C","metin":"2","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"5","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"E","metin":"3","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"x'li terimleri bir tarafta, sabitleri öbür tarafta topla:","ifade":"2x − 9x > −24 − 7"},{"aciklama":"Katsayıları sadeleştir:","ifade":"−7x > −31"},{"aciklama":"Her iki tarafı −7 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner:","ifade":"x < 31/7"},{"aciklama":"Eşitsizliği sağlayan en büyük tam sayı:","ifade":"4"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.272,"gorsel":null},{"kimlik":"ba0ead43c70a","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 19| = 10 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"−261","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"461","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"9","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"29","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"261","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 19 + 10 = 29 ve x = 19 − 10 = 9"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(19 + 10) × (19 − 10) = 19² − 10² = 261"},{"aciklama":"Köklerin çarpımı:","ifade":"261"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.635,"gorsel":null},{"kimlik":"002ffdeac365","sablon":"oran.paylastirma.artan_pay","govde":"780 TL paranın bir kısmı Emre'ye ve Deniz'e 2 : 3 oranında dağıtılmış, Emre'nin payı 290 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"55 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"435 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"156 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"D","metin":"1.505 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"100 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Emre'nin payından birim payı çöz:","ifade":"2k = 290 → k = 145"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(2 + 3) × 145 = 725 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"780 − 725 = 55 TL"},{"aciklama":"Geriye kalan:","ifade":"55 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":1.826,"gorsel":null},{"kimlik":"7f8095970ee0","sablon":"yuzde.artis.indirim","govde":"Fiyatı 1.700 TL olan bir buzdolabı, %70 indirimle satılmaktadır. Buzdolabının indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.890 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"510 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"153 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"1.190 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"1.630 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"1.700 × 70 / 100 = 1.190"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"1.700 − 1.190 = 510"},{"aciklama":"İndirimli fiyat:","ifade":"510 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":null},{"kimlik":"1389949e56c8","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Antalya'nın Yaz satışı silinmiş, yerine 0 yazılmıştır. Antalya satırının gerçek yıllık toplamı 740 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"405 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"310 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"740 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"185 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"215 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"}],"cozum":[{"aciklama":"Antalya satırında görünen üç değeri topla:","ifade":"265 + 95 + 70 = 430"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"740 − 430 = 310"},{"aciklama":"Silinen değer:","ifade":"310 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[350,380,135,55]},{"ad":"Antalya","degerler":[265,0,9