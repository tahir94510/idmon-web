"ifade":"x = 16 / −1 = −16"},{"aciklama":"x değeri:","ifade":"−16"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":2.449,"gorsel":null},{"kimlik":"39e849e3a7fd","sablon":"mantik.esleme.yanlis_ifade","govde":"Ahmet, Ali, Ece, Mustafa ve Onur adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ahmet uçtaki koltuklarda oturmamaktadır.\n• Mustafa, Ali adlı kişinin hemen solundadır.\n• Onur, Ahmet adlı kişinin solunda oturmaktadır.\n• Ahmet, Ece adlı kişinin hemen solundadır.\n• Ece uçtaki koltuklarda oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Ece ortadaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"B","metin":"Onur, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Ece, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Ahmet, Onur adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"E","metin":"Mustafa, Ece adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Onur − Ahmet − Ece − Mustafa − Ali"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Onur, Ahmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"a369927ff23d","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 1.520 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Otobüs tercih edenler, Yürüyüş tercih edenlerden kaç kişi fazladır?","secenekler":[{"h