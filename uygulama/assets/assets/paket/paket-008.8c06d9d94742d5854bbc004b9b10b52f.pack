eceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"e790aa2e2a0e","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Trabzon şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"90 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"B","metin":"400 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"890 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"D","metin":"250 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"200 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 250 · 2021→2022: 50 · 2022→2023: −200 · 2023→2024: −90"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2022 → 2023: 890 − 690 = 200 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"200 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":{"tur":"cizgi","baslik":"Trabzon şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[590,840,890,690,600]}]}},{"kimlik":"45f9dac99d54","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 51 ve a · b = 638 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"3.877","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"B","metin":"49","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"1.325","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.601","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"1.963","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"51² − 2 × 638 = 2.601 − 1.276 = 1.325"},{"aciklama":"a² + b² değeri:","ifade":"1.325"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.503,"gorsel":null},{"kimlik":"3ef6f11557b0","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 14, s(B) = 24 ve s(A ∪ B) = 34'tür. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"B","metin":"14","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"10","dogru":true,"yanilgi":null},{"harf":"D","metin":"30","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"20","dogru":false,"yanilgi":"kume_tumleyen_karisimi"}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 14 + 24 − 34 = 4"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"14 − 4 = 10"},{"aciklama":"s(A ∖ B):","ifade":"10"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"4992c559f649","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 5 tek doğal sayının toplamı 75'tir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"17","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"B","metin":"11","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"},{"harf":"C","metin":"21","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"D","metin":"15","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"19","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık 5 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"75 / 5 = 15"},{"aciklama"