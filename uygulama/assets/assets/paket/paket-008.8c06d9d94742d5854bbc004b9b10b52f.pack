 + 44 − 11x + 121 = 74"},{"aciklama":"Benzer terimleri topla:","ifade":"−7x + 165 = 74"},{"aciklama":"Sabit terimi karşıya geçir, yani iki taraftan da 165 çıkar:","ifade":"−7x = 74 − 165 = −91"},{"aciklama":"İki tarafı −7 sayısına böl; x değeri:","ifade":"13"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"f0cfdaa47c4d","sablon":"oran.ters.hiz_sure","govde":"Bir araç Konya ile İzmir arasını saatte 50 km hızla 3 saatte almaktadır. Aynı yolu saatte 30 km hızla giden bir araç kaç saatte alır?","secenekler":[{"harf":"A","metin":"2 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"1 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"3 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"D","metin":"1,8 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"5 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sabit yolda hız ile süre ters orantılıdır; yol çarpımlarıdır:","ifade":"50 × 3 = 150 km"},{"aciklama":"Yeni süre, aynı yolun yeni hıza bölümüdür:","ifade":"150 / 30 = 5 saat"},{"aciklama":"Geçen süre:","ifade":"5 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.036,"gorsel":null},{"kimlik":"851423c420de","sablon":"yuzde.kar_zarar.maliyet_bulma","govde":"Bir ürün %50 kârla 3.450 TL fiyatına satılmıştır. Ürünün maliyeti kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.400 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"6.900 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"1.725 TL","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"D","metin":"2.300 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.150 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kâr her zaman maliyet üzerinden hesaplanır; satış fiyatı maliyetin %150'sidir:","ifade":"maliyet × 150/100 = 3.450"},{"aciklama":"Maliyet, satış fiyatının bu orana bölümüdür:","ifade":"3.450 × 100/150 = 2.300 TL"},{"aciklama":"Maliyet:","ifade":"2.300 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.274,"gorsel":null},{"kimlik":"9aa01355a18a","sablon":"mantik.dizi.toplamsal","govde":"22, 29, 51, 80, 131, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"131","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"182","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"342","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"211","dogru":true,"yanilgi":null},{"harf":"E","metin":"262","dogru":false,"yanilgi":"dizi_kurali_eksik"}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"22 + 29 = 51"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"29 + 51 = 80"},{"aciklama":"Son iki terimi topla:","ifade":"80 + 131 = 211"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"211"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"1d60aeb1f4ab","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Antalya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"110 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"890 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"C","metin":"140 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"60 kişi","dogru":true,"yanilgi":null},{"harf":"E","metin":"120 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 140 · 2021→2022: 10 · 2022→2023: 20 · 2023→2024: −60"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2023 → 2024: 890 − 830 = 60 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"60 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.405,"gorsel":{"tur":"cizgi","baslik":"Antalya şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[720,860,870,890,830]}]}},{"kimlik":"342cf35fb734","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 24 km sabit hızla yola çıkmıştır. 6 saat sonra aynı noktadan aynı yöne, saatte 42 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"144 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"24/11 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"C","metin":"48/11 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"24/7 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"E","metin":"8 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"24 × 6 = 144 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"42 − 24 = 18 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"144 / 18 = 8"},{"aciklama":"Yetişme süresi:","ifade":"8 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"85168c0cffc6","sablon":"sayilar.uslu.us_kurallari","govde":"(4⁴)⁵ · (4³)⁴ : 4⁵ işleminin sonucu, 4 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"235","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"B","metin":"−32","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"C","metin":"37","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"27","dogru":true,"yanilgi":null},{"harf":"E","metin":"11","dogru":false,"yanilgi":"us_us_toplandi"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(4⁴)⁵ = 4²⁰ , (4³)⁴ = 4¹²"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"4²⁰ · 4¹² = 4³²"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"4³² : 4⁵ = 4²⁷"},{"aciklama":"Aranan kuvvet:","ifade":"27"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.824,"gorsel":null},{"kimlik":"255170c6e747","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"190 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"5 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"20 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"40 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"360 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Dergi ilk kez Nisan döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Kitap 170, Dergi 190","ifade":"190 − 170 = 20"},{"aciklama":"Aradaki fark:","ifade":"20 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.079,"gorsel":{"tur":"cizgi","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[230,210,190,170]},{"ad":"Dergi","degerler":[70,110,150,190]}]}},{"kimlik":"82970805805a","sablon":"kume.sayma.en_az_bir_kosullu","govde":"9 kadın ve 7 erkeğin bulunduğu bir ekipten 2 kişilik bir çalışma grubu seçilecektir. Grupta en az bir kadın bulunması koşuluyla, bu seçim kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"135","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"B","metin":"198","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"C","metin":"21","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"D","metin":"120","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"E","metin":"99","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: önce hiçbir kısıt koymadan say, sonra **istenmeyen** durumları düş. Burada istenmeyen durum, hiç kadın olmaması.","ifade":null},{"aciklama":"Önce koşulsuz seçim sayısı. C(n, r), n kişiden r kişiyi sırasız seçme sayısıdır; burada 16 kişiden 2 kişi:","ifade":"C(16, 2) = (16×15) / (2×1) = 120"},{"aciklama":"Hiç kadın içermeyen seçimler yalnızca erkeklerden kurulur:","ifade":"C(7, 2) = (7×6) / (2×1) = 21"},{"aciklama":"Farkı al:","ifade":"120 − 21 = 99"},{"aciklama":"Farklı seçim sayısı:","ifade":"99"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":["kume.olasilik"],"zorluk":1.902,"gorsel":null},{"kimlik":"7d7ac20c85ff","sablon":"oran.ters.isci_gun","govde":"Bir inşaat işini 18 işçi 30 günde bitirmektedir. Aynı işi, aynı hızda çalışan 12 işçi kaç günde bitirir?","secenekler":[{"harf":"A","metin":"45 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"540 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"24 gün","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"D","metin":"20 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"36 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"İşçi sayısı ile süre ters orantılıdır; çarpımları toplam iş yükünü verir:","ifade":"18 × 30 = 540 işçi-gün"},{"aciklama":"Aynı iş yükü 12 işçiye bölündüğünde süre:","ifade":"540 / 12 = 45 gün"},{"aciklama":"İşin biteceği süre:","ifade":"45 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.079,"gorsel":null},{"kimlik":"5785760d1d2e","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, tanesini 1.800 TL maliyetle aldığı bir güneş gözlüğü çeşidini %5 kârla satmaktadır. Buna göre güneş gözlüğünün satış fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.805 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"10.800 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"90 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.710 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"1.890 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr yüzdesi her zaman maliyet üzerinden hesaplanır:","ifade":"1.800 × 5/100 = 90 TL"},{"aciklama":"Satış fiyatı maliyet ile kârın toplamıdır:","ifade":"1.800 + 90 = 1.890 TL"},{"aciklama":"Satış fiyatı:","ifade":"1.890 TL"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-1.782,"gorsel":null},{"kimlik":"1cdfaa6292c6","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Kitap sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"85 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"55 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"60 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"80 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"48 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Ocak: 85 · Şubat: 80 · Mart: 50 · Nisan: 25"},{"aciklama":"Dördünü topla:","ifade":"85 + 80 + 50 + 25 = 240"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"240/4 = 60"},{"aciklama":"Dönem ortalaması:","ifade":"60 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-1.631,"gorsel":{"tur":"cizgi","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[85,80,50,25]}]}},{"kimlik":"7442808cac7c","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 13 tek doğal sayının toplamı 1.625'tir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"113","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"},{"harf":"B","metin":"131","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"C","metin":"125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"137","dogru":true,"yanilgi":null},{"harf":"E","metin":"135","dogru":false,"yanilgi":"sayimda_bir_eksik"}],"cozum":[{"aciklama":"Ardışık 13 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"1.625 / 13 = 125"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 6 adım ileridedir:","ifade":"125 + 2 × 6 = 137"},{"aciklama":"En büyük sayı:","ifade":"137"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"056662569526","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Buse, Ece, Merve ve Zeynep adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Merve, Zeynep adlı kişinin hemen solundadır.\n• Ahmet ile Buse yan yana oturmamaktadır.\n• Ece ile Merve yan yana oturmamaktadır.\n• Ece, Merve adlı kişinin solunda oturmaktadır.\n• Ece ile Buse yan yana oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Ahmet, Zeynep adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"B","metin":"Merve, Zeynep adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"C","metin":"Merve, Ece adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"D","metin":"Merve, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"E","metin":"Ahmet, Ece adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ece − Ahmet − Merve − Zeynep − Buse"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Ahmet, Ece adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"6629aa294b2c","sablon":"problem.isci.birlikte","govde":"Bir işi Onur tek başına 104 günde, Emre tek başına 65 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"169 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"B","metin":"84,5 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"39 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"D","metin":"40 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"65 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/104 + 1/65 = 169/6760"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"6760/169 = 40 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"40 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.358,"gorsel":null},{"kimlik":"2e3f1472a88c","sablon":"veri.grafik.cizgi_yuzde_artis","govde":"Trabzon mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2019 yılından 2020 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%40","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"%100","dogru":true,"yanilgi":null},{"harf":"C","metin":"%200","dogru":false,"yani