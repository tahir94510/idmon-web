"dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Armut: 3,7 − 3,5 = 0,2 TL, Ayva: 2,2 − 2 = 0,2 TL, Erik: 4,5 − 4 = 0,5 TL.","ifade":null},{"aciklama":"Armut ile ayvanın kilogram kârı aynı. Hepsi 0,2 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"120 · 0,2 = 24 TL"},{"aciklama":"Fazladan 21 TL yalnızca erik yüzünden: onun her kilogramı 0,3 TL fazla kazandırıyor.","ifade":"erik = 21 ÷ 0,3 = 70 kg"},{"aciklama":"İstenen: 120 − 70 =","ifade":"50"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Armut","degerler":[3.5,3.7]},{"ad":"Ayva","degerler":[2.0,2.2]},{"ad":"Erik","degerler":[4.0,4.5]}]}},{"kimlik":"477f49dc3198","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"3 · 2² · 2³ · 3⁰ + 2⁴ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"112","dogru":true,"yanilgi":null},{"harf":"B","metin":"16","dogru":false,"yanilgi":"sifir_us"},{"harf":"C","metin":"208","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"1.536","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"E","metin":"80","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"3⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2² · 2³ = 2⁵ = 32"},{"aciklama":"Katsayıyla çarp:","ifade":"3 × 32 = 96"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"96 + 16 = 112"},{"aciklama":"İşlemin sonucu:","ifade":"112"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.013,"gorsel":null},{"kimlik":"39670c110278","sablon":"yuzde.faiz.basit_ay","govde":"18.000 TL tutarındaki bir anapara, yıllık %12 basit faiz oranıyla 8 ay vadeli olarak yatırılmıştır. Vad