3 = 1/2"},{"aciklama":"Paranın 1/2'si 50 TL ediyor:","ifade":"X · 1/2 = 50"},{"aciklama":"Baştaki para:","ifade":"100"}],"mikrobeceriler":["problem.sayi","sayilar.rasyonel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"3d5fd7554d44","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"30 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"210 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"270 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"240 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"205 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"Samsun: 340 − 310 = 30 · Konya: 240 − 55 = 185 · Bursa: 240 − 30 = 210 · Eskişehir: 300 − 95 = 205"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Bursa, 210 adet"},{"aciklama":"En büyük artış:","ifade":"210 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":0.019,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Samsun","degerler":[310,40,340,205]},{"ad":"Konya","degerler":[55,90,240,220]},{"ad":"Bursa","degerler":[30,320,240,180]},{"ad":"Eskişehir","degerler":[95,55,300,70]}]}},{"kimlik":"c27e457256fb-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Mustafa ile Emre birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"48 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"192 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"45 gün","dogru":true,"yanilgi":null},{"harf":"D","metin":"96 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"E","metin":"72 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/120 + 1/72 = 8/360"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"360/8 = 45 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"45 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.503,"gorsel":null,"grup":"c27e457256fb","grup_govde":"Bir işi Mustafa tek başına 120 günde, Emre tek başına 72 günde bitirmektedir."},{"kimlik":"c27e457256fb-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Mustafa işe başlayıp 110 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Emre tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"6 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"66 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"192 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"72 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"E","metin":"96 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"}],"cozum":[{"aciklama":"Mustafa bir günde işin 1/120'sini yapıyor; 110 gün çalışınca yaptığı iş:","ifade":"110/120"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(120 − 110)/120 = 1/12"},{"aciklama":"Emre işin tamamını 72 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"1/12 × 72 = 6"},{"aciklama":"Kalan iş için gereken süre:","ifade":"6 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.575,"gorsel":null,"grup":"c27e457256fb","grup_govde":"Bir işi Mustafa tek başına 120 günde, Emre tek başına 72 günde bitirmektedir."},{"kimlik":"657e9e7d04d7","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 16| = 25 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"−4,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"B","metin":"16","dogru":true,"yanilgi":null},{"harf":"C","metin":"25","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"−16","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"20,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değer 25'e eşitse içerideki ifade 25 ya da −25 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 16 = 25 ⟹ x = 20,5"},{"aciklama":"İkinci durum:","ifade":"2x − 16 = −25 ⟹ x = −4,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"20,5 + (−4,5) = 2 × 16 / 2 = 16"},{"aciklama":"Köklerin toplamı:","ifade":"16"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.218,"gorsel":null},{"kimlik":"0e8c95eede94","sablon":"oran.paylastirma.fark","govde":"2.100 TL tutarındaki bir ödül, Merve ile Mehmet arasında 3/4 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"300 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.050 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"2.100 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"1.200 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"900 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"3 + 4 = 7"},{"aciklama":"Bir parçanın değeri:","ifade":"2.100 / 7 = 300 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(4 − 3) × 300 = 300 TL"},{"aciklama":"Aradaki fark:","ifade":"300 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":0.14,"gorsel":null},{"kimlik":"c11d04ef0be8","sablon":"yuzde.artis.zam","govde":"Fiyatı 2.200 TL olan bir kol saati, %10 zamlanmıştır. Zamdan sonra kol saatinin fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"220 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"24.200 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"2.420 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.210 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"1.980 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"2.200 × 10/100 = 220 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"2.200 + 220 = 2.420 TL"},{"aciklama":"Zamlı fiyat:","ifade":"2.420 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.483,"gorsel":null},{"kimlik":"c7fbc9a82f52","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"285 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"205 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"260 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"230 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"4 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Ankara: 205/4 · Trabzon: 285/44 · İzmir: 230/58 · Samsun: 260/18"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Ankara satırında:","ifade":"205/4"},{"aciklama":"O satırın satış sayısı:","ifade":"205 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.294,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Ankara","degerler":[205,4]},{"ad":"Trabzon","degerler":[285,44]},{"ad":"İzmir","degerler":[230,58]},{"ad":"Samsun","degerler":[260,18]}]}},{"kimlik":"d2e6624b4adc","sablon":"mantik.sifreleme.cozme","govde":"Bir şifrelemede ORMAN kelimesi RTÖÇP biçiminde yazılmaktadır. Aynı kurala göre GĞPLC biçiminde yazılan kelime aşağıdakilerden hangisidir?","secenekler":[{"harf":"A","metin":"EFOJA","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"B","metin":"ÇDMIY","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"C","metin":"IİŞOE","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"D","metin":"DENİZ","dogru":true,"yanilgi":null},{"harf":"E","metin":"DDLĞU","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"}],"cozum":[{"aciklama":"Örnekten kaydırma miktarını bul; bütün harflerde aynı çıkmalı:","ifade":"O→R , R→T , M→Ö , A→Ç , N→P  ⟹ 3 sıra ileri"},{"aciklama":"Şifreyi çözmek, kuralı **ters** yönde uygulamaktır: her harf 3 sıra geri alınır.","ifade":null},{"aciklama":"Harfleri geri al:","ifade":"G→D , Ğ→E , P→N , L→İ , C→Z"},{"aciklama":"Aranan kelime:","ifade":"DENİZ"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":1.253,"gorsel":null},{"kimlik":"4fca4d610590","sablon":"problem.sayi.verme_alma","govde":"Kerem, Fatma'ya boncuklarının 16 tanesini verirse ikisinin boncuk sayıları eşit olmaktadır. Fatma, Kerem'e boncuklarının 14 tanesini verirse Kerem'in boncuk sayısı Fatma'nınkinin 3 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç boncuğu vardır?","secenekler":[{"harf":"A","metin":"120","dogru":true,"yanilgi":null},{"harf":"B","metin":"78","dogru":false,"yanilgi":"verme_tek_taraf"},{"harf":"C","metin":"88","dogru":false,"yanilgi":"verme_farki_tek_sayildi"},{"harf":"D","metin":"76","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"60","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kerem 16 tane verince kendisi 16 azalır, Fatma 16 artar: aradaki fark 32 kapanır. Eşitlendiklerine göre baştaki fark 32'dir.","ifade":null},{"aciklama":"Fatma'nın sayısına x dersek Kerem'inki x + 32 olur. İkinci koşulda Fatma 14 tane verir, Kerem 14 tane alır:","ifade":"x + 32 + 14 = 3·(x − 14)"},{"aciklama":"Denklemi çöz:","ifade":"x = 44"},{"aciklama":"Toplam x + (x + 32) olduğuna göre:","ifade":"120"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"10f6628884ea","sablon":"sayilar.rasyonel.islem_onceligi","govde":"6 + 3/13 × 1/6 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"157/26","dogru":true,"yanilgi":null},{"harf":"B","metin":"27/26","dogru":false,"yanilgi":"islem_onceligi_toplama_once"},{"harf":"C","metin":"96/13","dogru":false,"yanilgi":"kesir_carpimda_ters_cevrildi"},{"harf":"D","metin":"81/13","dogru":false,"yanilgi":"kesir_carpimda_payda_carpilmadi"},{"harf":"E","metin":"155/26","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"İşlem önceliği: çarpma toplamadan önce yapılır.","ifade":null},{"aciklama":"Kesirlerin çarpımında paylar payla, paydalar paydayla çarpılır:","ifade":"3/13 × 1/6 = 3/78 = 1/26"},{"aciklama":"Tam sayıyı ekle:","ifade":"6 + 1/26 = 157/26"},{"aciklama":"İşlemin sonucu:","ifade":"157/26"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.44,"gorsel":null},{"kimlik":"e9b2ded46b9d","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Yaz mevsiminde Trabzon'un yaptığı satışın Bursa'nın yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"0,7","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"80","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"0,2","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"0,5","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"5","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yaz sütunundan iki değeri oku:","ifade":"Trabzon: 100 · Bursa: 20"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"100 / 20 = 5"},{"aciklama":"Aranan oran:","ifade":"5"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":0.11,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Trabzon","degerler":[40,100,70,30]},{"ad":"Ankara","degerler":[40,90,100,90]},{"ad":"Konya","degerler":[30,70,70,90]},{"ad":"Bursa","degerler":[40,20,100,40]}]}},{"kimlik":"2f829bb278ab","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Onur, Ayşe ve Yusuf arasında sırasıyla 3, 4 ve 9 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 4.800 TL olduğuna göre, Yusuf'un payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"14.400 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"900 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"2.700 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.100 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"1.600 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"3 + 4 + 9 = 16"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"4.800 / 16 = 300 TL"},{"aciklama":"Yusuf bu paylardan 9 tane alır:","ifade":"9 × 300 = 2.700 TL"},{"aciklama":"Yusuf'un payı:","ifade":"2.700 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.923,"gorsel":null},{"kimlik":"822405bec2ee","sablon":"yuzde.faiz.anapara","govde":"Yıllık %15 basit faiz oranıyla 20 ay vadeye yatırılan bir anapara 9.000 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"60.000 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"1.800 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"3.000 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"D","metin":"45.000 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"36.000 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"20 ay için faiz katsayısı:","ifade":"15/100 × 20/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"9.000 / (15 × 20/1200) = 36.000 TL"},{"aciklama":"Anapara:","ifade":"36.000 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.515,"gorsel":null},{"kimlik":"e35772a1d67c","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Antalya'nın yıllık toplam satışı, Bursa'nın yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"215 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"665 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"175 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"110 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"440 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Antalya satırını topla:","ifade":"195 + 390 + 265 + 225 = 1.075"},{"aciklama":"Bursa satırını topla:","ifade":"50 + 255 + 110 + 220 = 635"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"1.075 − 635 = 440"},{"aciklama":"Aradaki fark:","ifade":"440 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.284,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Bursa","degerler":[50,255,110,220]},{"ad":"Antalya","degerler":[195,390,265,225]},{"ad":"İzmir","degerler":[380,310,310,290]},{"ad":"Samsun","degerler":[245,90,345,65]}]}},{"kimlik":"612f16eff49f","sablon":"cebir.esitsizlik.negatif_katsayi","govde":"−4(x − 24) > −23 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"29","dogru":true,"yanilgi":null},{"harf":"B","metin":"28","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"C","metin":"30","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"D","metin":"−1","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"18","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−4x + 96 > −23"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−4x > −119"},{"aciklama":"Her iki tarafı −4 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner: büyüktür işareti küçüktür olur:","ifade":"x < 29,75"},{"aciklama":"Sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"29"},{"aciklama":"En büyük tam sayı:","ifade":"29"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":["cebir.ozdeslik"],"zorluk":1.826,"gorsel":null},{"kimlik":"9274a263c311","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 2/3 katı ile 1/12 katı arasındaki fark 196'dır.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"784/3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"588","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"C","metin":"343/3","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"D","metin":"980","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"336","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(2/3 − 1/12) · x = 196"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(3, 12) = 12"},{"aciklama":"Her kesri, paydası 12 olacak biçimde genişlet:","ifade":"2/3 = 8/12  (payı da paydayı da 4 ile çarptık)\n1/12  (paydası zaten 12)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"8/12 − 1/12 = 7/12"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 196 × 12/7 = 336"},{"aciklama":"Aranan sayı:","ifade":"336"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"ddaa3da29f9e","sablon":"kume.sayma.yol_gidis_donus","govde":"Eskişehir ile İzmir arasında 9, İzmir ile Konya arasında 5, Konya ile Samsun arasında 9 farklı yol vardır. Bir yolcu Eskişehir şehrinden Samsun şehrine gidip, dönüşte gidişte kullandığı yolların hiçbirini kullanmadan geri dönecektir. Bu yolculuk kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"8.100","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"B","metin":"164.025","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"C","metin":"207.360","dogru":false,"yanilgi":"gidis_donus_ayri_sayildi"},{"harf":"D","metin":"103.680","dogru":true,"yanilgi":null},{"harf":"E","metin":"163.620","dogru":false,"yanilgi":"sayma_ozdes_nesne"}],"cozum":[{"aciklama":"Gidişte her ayakta bağımsız seçim yapılır; sayılar çarpılır:","ifade":"9 × 5 × 9 = 405"},{"aciklama":"Dönüşte her ayakta bir yol kullanılmış durumdadır:","ifade":"8 × 4 × 8 = 256"},{"aciklama":"Gidiş ve dönüş peş peşe yapıldığı için çarpılır:","ifade":"405 × 256 = 103.680"},{"aciklama":"Yolculuğun yapılabileceği biçim sayısı:","ifade":"103.680"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":2.449,"gorsel":null},{"kimlik":"00a2bc019604","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan kiraz, portakal ve soğanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 150 kilogram satılmış ve toplam 78 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram kiraz ve portakal satılmıştır?","secenekler":[{"harf":"A","metin":"70","dogru":true,"yanilgi":null},{"harf":"B","metin":"100","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"102","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"80","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"90","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Kiraz: 3,7 − 3,5 = 0,2 TL, Portakal: 2,7 − 2,5 = 0,2 TL, Soğan: 2,8 − 2 = 0,8 TL.","ifade":null},{"aciklama":"Kiraz ile portakalın kilogram kârı aynı. Hepsi 0,2 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"150 · 0,2 = 30 TL"},{"aciklama":"Fazladan 48 TL yalnızca soğan yüzünden: onun her kilogramı 0,6 TL fazla kazandırıyor.","ifade":"soğan = 48 ÷ 0,6 = 80 kg"},{"aciklama":"İstenen: 150 − 80 =","ifade":"70"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Kiraz","degerler":[3.5,3.7]},{"ad":"Portakal","degerler":[2.5,2.7]},{"ad":"Soğan","degerler":[2.0,2.8]}]}},{"kimlik":"ab84d75b80eb","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede KİTAP kelimesi SÇCSY biçiminde yazılmaktadır. Aynı kurala göre ŞEKER kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"BKSKZ","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"B","metin":"BVSVZ","dogru":true,"yanilgi":null},{"harf":"C","metin":"LKEKJ","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"D","metin":"CYŞYA","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"E","metin":"LVEVJ","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"K→S (+8) , İ→Ç (−8) , T→C (+8) , A→S (−8) , P→Y (+8)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 8 ileri, çift sıradakiler 8 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı ŞEKER kelimesine u