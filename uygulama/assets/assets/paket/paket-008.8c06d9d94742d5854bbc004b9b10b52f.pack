2 ve 92"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"9 + 5 + 5 + A + 2 = 21 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"3 ve 9"},{"aciklama":"Bu rakamları topla:","ifade":"3 + 9 = 12"},{"aciklama":"Rakamların toplamı:","ifade":"12"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.957,"gorsel":null},{"kimlik":"7947cd16d075","sablon":"mantik.dizi.terim_sirasi","govde":"18, 26, 34, 42, ... biçiminde devam eden dizide 202 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"202","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"25","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"C","metin":"24","dogru":true,"yanilgi":null},{"harf":"D","metin":"25,25","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"23","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"26 − 18 = 8"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 18 + (n − 1)·8"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"202 = 18 + (n − 1)·8 → n = 24"},{"aciklama":"Terimin sırası:","ifade":"24"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.048,"gorsel":null},{"kimlik":"4d2f05f4f705","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan toplam Bisiklet sayısı, toplam Scooter sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"205 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"B","metin":"25 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"100 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"390 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"45 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Soru tek bir ay değil, dördünün toplamını istiyor. Önce Bisiklet sütunlarını topla:","ifade":"135 + 80 + 70 + 105 = 390"},{"aciklama":"Sonra Scooter sütunlarını topla:","ifade":"115 + 40 + 75 + 60 = 290"},{"aciklama":"İki toplamın farkını al:","ifade":"390 − 290 = 100"},{"aciklama":"Aradaki fark:","ifade":"100 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.519,"gorsel":{"tur":"sutun","baslik":"Bisiklet ve Scooter satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[135,80,70,105]},{"ad":"Scooter","degerler":[115,40,75,60]}]}},{"kimlik":"02f30ef70124","sablon":"problem.isci.ek_isci","govde":"16 işçi bir işi 20 günde bitirmektedir. Aynı iş 5 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"64 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"21 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"C","metin":"48 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"15 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"E","metin":"4 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"16 × 20 = 320"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"320 / 5 = 64"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"64 − 16 = 48"},{"aciklama":"Gereken ek işçi:","ifade":"48 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":1.24,"gorsel":null},{"kimlik":"e3d6771b406d","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 9'a bölümünden kalan 2, 12'ye bölümünden kalan 5'tir. Bu koşulu sağlayan ve 428'den büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"439","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"461","dogru":true,"yanilgi":null},{"harf":"C","metin":"434","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"D","metin":"533","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"E","metin":"437","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 7 eksik. Demek ki sayıya 7 eklenirse sayı hem 9 hem 12 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(9, 12) = 36"},{"aciklama":"Sayı 36'nın katından 7 eksiktir. 428'den büyük ilk böyle sayı:","ifade":"461"},{"aciklama":"Aranan sayı:","ifade":"461"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.325,"gorsel":null},{"kimlik":"99466b941709","sablon":"cebir.denklem.dagitmali","govde":"2(x + 7) − 5(x − 13) = 64 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"5","dogru":true,"yanilgi":null},{"harf":"B","metin":"−15/7","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"C","metin":"12","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−37/3","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"−115/3","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Parantezleri dağıt; ikinci parantezin önündeki eksi, içerideki her terimin işaretini çevirir:","ifade":"2x + 14 − 5x + 65 = 64"},{"aciklama":"Benzer terimleri topla:","ifade":"−3x + 79 = 64"},{"aciklama":"Sabit terimi karşıya geçir, yani iki taraftan da 79 çıkar:","ifade":"−3x = 64 − 79 = −15"},{"aciklama":"İki tarafı −3 sayısına böl; x değeri:","ifade":"5"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"f83272476d5b","sablon":"oran.bilesik.makine_uretim","govde":"3 makine 6 günde 1.350 parça üretmektedir. Aynı hızla çalışan 2 makine 4 günde kaç parça üretir?","secenekler":[{"harf":"A","metin":"1.350 parça","dogru":false,"yan