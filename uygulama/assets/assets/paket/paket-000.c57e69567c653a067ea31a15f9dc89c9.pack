f":"A","metin":"380 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"352 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"350 kişi","dogru":false,"yanilgi":"ortalama_uc_degerlerden"},{"harf":"D","metin":"1.760 kişi","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"440 kişi","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Beş yılın üye sayılarını topla:","ifade":"320 + 340 + 360 + 380 + 360 = 1.760"},{"aciklama":"Ortalama, toplamın yıl sayısına bölümüdür:","ifade":"1.760 / 5 = 352"},{"aciklama":"Yıllık ortalama:","ifade":"352 kişi"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":{"tur":"cizgi","baslik":"Üye sayısı","etiketler":["2018","2019","2020","2021","2022"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[320,340,360,380,360]}]},"grup":"8c22a4382df2","grup_govde":"Eskişehir şubesinin 2018–2022 yılları arasındaki üye sayısı yukarıdaki çizgi grafiğinde verilmiştir."},{"kimlik":"5c413d33367a","sablon":"mantik.dizi.ikili_orgu","govde":"12, 34, 15, 29, 18, 24, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"24","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"15","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"C","metin":"30","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"D","metin":"19","dogru":false,"yanilgi":"dizi_yanlis_altdizi"},{"harf":"E","metin":"21","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 3 artıyor:","ifade":"12, 15, 18"},{"aciklama":"Çift sıradakiler −5 değişiyor:","ifade":"34, 29, 24"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"18 + 3 = 21"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"21"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"z