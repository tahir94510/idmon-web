":"10x − x = 9x = 7.245"},{"aciklama":"İlk sayı:","ifade":"x = 7.245 / 9 = 805"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 805 = 8.050"},{"aciklama":"Yeni sayı:","ifade":"8.050"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.561,"gorsel":null},{"kimlik":"badcd2a503b5","sablon":"veri.grafik.cizgi_yuzde_artis","govde":"Konya mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2017 yılından 2021 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%300","dogru":true,"yanilgi":null},{"harf":"B","metin":"%180","dogru":false,"yanilgi":"artis_miktari_yuzde_sanildi"},{"harf":"C","metin":"%400","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"D","metin":"%140","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"E","metin":"%75","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"240 − 60 = 180"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"180 / 60 × 100 = %300"},{"aciklama":"Yüzde artış:","ifade":"%300"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":2.997,"gorsel":{"tur":"cizgi","baslik":"Konya mağazasının yıllık cirosu (bin TL)","etiketler":["2017","2018","2019","2020","2021"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[60,100,125,160,240]}]}},{"kimlik":"6ad93a219309","sablon":"oran.dogru.birim_fiyat","govde":"Bir ürünün 3 litre için 72 TL ödenmektedir. Aynı üründen 6 litre alan biri kaç TL öder?","secenekler":[{"harf":"A","metin":"36 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"B","metin":"72 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"144 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"216 TL","dogru":false,"yanilgi":"ikinci_alim_ek_sanildi"},{"harf":"E","metin":"75 TL","dogru":