klemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(7, 9) = 63"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"9(x + 7) − 7(x − 7) = 126"},{"aciklama":"Benzer terimleri topla:","ifade":"2x + 112 = 126"},{"aciklama":"x'i yalıt:","ifade":"x = 14 / 2 = 7"},{"aciklama":"x değeri:","ifade":"7"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":3.466,"gorsel":null},{"kimlik":"fb501a5c40a6-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Burak ile Selin birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"150 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"120 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"C","metin":"300 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"63 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"90 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/210 + 1/90 = 10/630"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"630/10 = 63 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"63 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.65,"gorsel":null,"grup":"fb501a5c40a6","grup_govde":"Bir işi Burak tek başına 210 günde, Selin tek başına 90 günde bitirmektedir."},{"kimlik":"fb501a5c40a6-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Burak işe başlayıp 35 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Selin tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"150 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"75 gün","dogru":true,"yanilgi":null},{"harf":"C","metin":"90 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"D","metin":"15 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"300 gün","d