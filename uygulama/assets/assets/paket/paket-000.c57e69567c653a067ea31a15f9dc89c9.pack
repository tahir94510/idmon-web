,"ifade":"70 − 50 = 20 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"200 / 20 = 10"},{"aciklama":"Yetişme süresi:","ifade":"10 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"db3215599bcf","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 1.560 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Elma tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"234 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"5 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"C","metin":"1.482 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"78 kişi","dogru":true,"yanilgi":null},{"harf":"E","metin":"780 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Elma diliminin payı:","ifade":"%5"},{"aciklama":"Kişi sayısı:","ifade":"1.560 × 5 / 100 = 78"},{"aciklama":"Kişi sayısı:","ifade":"78 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.362,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[5,15,30,50]}]}},{"kimlik":"bd1ea3e0f933","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|x + 5y − 61| + z = 6\n|x − 3y + 19| = 4z − 24\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"12","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"B","metin":"−40","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"C","metin":"6","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−99","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"21","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 6 − |…| ≤ 6"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"4z − 24 ≥ 0 , yani z ≥ 6"},{"aciklama":"İkisi birlikte:","ifade":"z = 6"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"x + 5y = 61 , x − 3y = −19"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 11 , y = 10"},{"aciklama":"İstenen toplam, x + y:","ifade":"21"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"6527b2a8c491","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 4 litre yakıt tüketmektedir.\n\nBu araç Ankara'ya yapılan 2.000 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"4 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"800 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"80 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"500 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"20 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"4/100 = x/2.000"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.000 × 4/100 = 80"},{"aciklama":"Tüketilen yakıt:","ifade":"80 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.792,"gorsel":null},{"kimlik":"e1ca66448ea7","sablon":"yuzde.artis.indirim","govde":"Fiyatı 2.600 TL olan bir kulaklık, %20 indirimle satılmaktadır. Kulaklığın indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.664 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"2.580 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"52