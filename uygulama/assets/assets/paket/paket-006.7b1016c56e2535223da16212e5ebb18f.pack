ktadır.\n• Burak uçtaki koltuklarda oturmamaktadır.\n• Elif uçtaki koltuklarda oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Elif, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"B","metin":"Burak, Yusuf adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"C","metin":"Selin, Yusuf adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"D","metin":"Elif, Yusuf adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Selin, Elif adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ahmet − Elif − Burak − Selin − Yusuf"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Elif, Ahmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"18f7afda292d","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 60 km sabit hızla yola çıkmıştır. 6 saat sonra aynı noktadan aynı yöne, saatte 120 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"4 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"B","metin":"360 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"3 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"D","metin":"2 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"6 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"60 × 6 = 360 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"120 − 60 = 60 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"360 / 60 = 6"},{"aciklama":"Yetişme süresi:","ifade":"6 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"6d6ac3a14822","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 48| = 25 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"36,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"B","metin":"−48","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"11,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"48","dogru":true,"yanilgi":null},{"harf":"E","metin":"25","dogru":false,"yanilgi":"mutlak_deger_dagitildi"}],"cozum":[{"aciklama":"Mutlak değer 25'e eşitse içerideki ifade 25 ya da −25 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 48 = 25 ⟹ x = 36,5"},{"aciklama":"İkinci durum:","ifade":"2x − 48 = −25 ⟹ x = 11,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"36,5 + 11,5 = 2 × 48 / 2 = 48"},{"aciklama":"Köklerin toplamı:","ifade":"48"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.826,"gorsel":null},{"kimlik":"35007738dc21","sablon":"veri.grafik.cizgi_yuzde_artis","govde":"Konya mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2021 yılından 2023 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%100","dogru":true,"yanilgi":null},{"harf":"B","metin":"%240","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"%120","dogru":false,"yanilgi":"artis_miktari_yuzde_sanildi"},{"harf":"D","metin":"%200","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"E","metin":"%50","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"240 − 120 = 120"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"120 / 120 × 100 = %100"},{"aciklama":"Yüzde artış:","ifade":"%100"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":{"tur":"cizgi","baslik":"Konya mağazasının yıllık cirosu (bin TL)","etiketler":["2019","2020","2021","2022","2023"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[50,80,120,160,240]}]}},{"kimlik":"180de3e28d81","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 11/x = 19 olduğuna göre x² + 11²/x² kaçtır?","secenekler":[{"harf":"A","metin":"317","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"350","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"339","dogru":true,"yanilgi":null},{"harf":"D","metin":"361","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"383","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 11/x)² = x² + 2 · x · 11/x + 11²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 11 kalır:","ifade":"19² = x² + 11²/x² + 22"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 11²/x² = 361 − 22 = 339"},{"aciklama":"İstenen değer:","ifade":"339"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.665,"gorsel":null},{"kimlik":"0e07682593bf","sablon":"oran.ters.uc_makine","govde":"Bir iş 3 işçiyle 120 günde, 5 işçiyle 72 günde bitmektedir. Aynı iş 15 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"1,6 gün","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"B","metin":"108 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"C","metin":"96 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"},{"harf":"D","metin":"600 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"24 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ters orantıda çokluklar birlikte artmaz; **çarpımları** sabit kalır. İki durumdan sabiti çıkar:","ifade":"3 × 120 = 360"},{"aciklama":"İkinci durum da aynı sabiti veriyor, yani kural doğrulanıyor:","ifade":"5 × 72 = 360"},{"aciklama":"Üçüncü durumda gün sayısını sabitten çöz:","ifade":"360/15 = 24"},{"aciklama":"Gereken süre:","ifade":"24 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":["oran.bilesik"],"zorluk":1.006,"gorsel":null},{"kimlik":"3a2360b8e7d5","sablon":"yuzde.temel.orandan_oran","govde":"Bir sayının %20'si 920'dir.\n\nBuna göre aynı sayının %50'si kaçtır?","secenekler":[{"harf":"A","metin":"4.600","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"368","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"460","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"950","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"2.300","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayının %20'si biliniyorsa sayının kendisi bulunur:","ifade":"920 / (20/100) = 4.600"},{"aciklama":"Sayının %50'si:","ifade":"4.600 × 50/100 = 2.300"},{"aciklama":"Aranan değer:","ifade":"2.300"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["oran.temel","yuzde.artis_azalis"],"zorluk":-0.322,"gorsel":null},{"kimlik":"c3934f648142","sablon":"veri.grafik.daire_aciyla_sayi","govde":"Toplam 1.000 kişinin katıldığı bir ankette verilen cevapların merkez açıları yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Basketbol seçeneğini işaretleyen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"1.440 kişi","dogru":false,"yanilgi":"aciyi_yuzde_sanma"},{"harf":"B","metin":"600 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"200 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"250 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"400 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Grafikte Basketbol diliminin merkez açısını oku:","ifade":"144°"},{"aciklama":"Açıyı orana çevir: dairenin tamamı 360°, dağılımın tamamı 100'dür.","ifade":"144/360 = 0,4"},{"aciklama":"Bulunan oranı toplam kişi sayısıyla çarp:","ifade":"1.000 × 0,4 = 400"},{"aciklama":"Dereceyi doğrudan sayıya oranlamak iki adımdan birini atlamak olurdu; önce yüzde, sonra sayı.","ifade":null},{"aciklama":"Bu dilimi seçen kişi sayısı:","ifade":"400 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":{"tur":"daire","baslik":"Tercihlerin merkez açıları","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"derece","seriler":[{"ad":"Açı","degerler":[108,144,36,72]}]}},{"kimlik":"26cbb070b066","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(4/7 + 2/11) : 7/13 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"78/49","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"390/539","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"58/143","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"D","metin":"13/21","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"754/539","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(7, 11) = 77"},{"aciklama":"Her kesri, paydası 77 olacak biçimde genişlet:","ifade":"4/7 = 44/77  (payı da paydayı da 11 ile çarptık)\n2/11 = 14/77  (payı da paydayı da 7 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"44/77 + 14/77 = 58/77"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"58/77 × 13/7"},{"aciklama":"Çarpımı yap:","ifade":"58 × 13 / (77 × 7) = 754/539"},{"aciklama":"İşlemin sonucu:","ifade":"754/539"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.711,"gorsel":null},{"kimlik":"c530ad77fab8","sablon":"kume.temel.uc_kume","govde":"Bir sınıftaki 84 öğrenciden 37 tanesi tiyatro, 44 tanesi satranç, 33 tanesi müzik kulübüne üyedir. Tiyatro ve satranç kulüplerinin ikisine birden 19, tiyatro ve müzik kulüplerine 14, satranç ve müzik kulüplerine 12 öğrenci üyedir. Üç kulübe birden üye olan öğrenci sayısı 4'tür. Buna göre en az bir kulübe üye olan kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"69","dogru":false,"yanilgi":"kume_uc_kume_kesisim"},{"harf":"B","metin":"114","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"11","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"D","metin":"36","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"73","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İçler-dışlar ilkesi: tekli toplamlardan ikili kesişimler düşülür, üçlü kesişim geri eklenir.","ifade":"|A∪B∪C| = |A|+|B|+|C| − |A∩B| − |A∩C| − |B∩C| + |A∩B∩C|"},{"aciklama":"Değerleri yerine koy:","ifade":"37 + 44 + 33 − 19 − 14 − 12 + 4 = 73"},{"aciklama":"Sınıf mevcudu bu hesaba girmez; geri kalan 11 öğrenci hiçbir kulübe üye değildir.","ifade":null},{"aciklama":"En az bir kulübe üye olan öğrenci sayısı:","ifade":"73"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":2.928,"gorsel":null},{"kimlik":"76800d657a11","sablon":"mantik.esleme.yanlis_ifade","govde":"Ece, Elif, Emre, Merve ve Selin adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Selin, Elif adlı kişinin solunda oturmaktadır.\n• Ece ile Merve yan yana oturmamaktadır.\n• Ece, Merve adlı kişinin solunda oturmaktadır.\n• Merve ile Elif yan yana oturmamaktadır.\n• Emre, Selin adlı kişinin solunda oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Elif, Selin adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"B","metin":