 / 100 = 92"},{"aciklama":"Kişi sayısı:","ifade":"92 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.34,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[25,20,50,5]}]}},{"kimlik":"b8ef4cae48db","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 3/8 katı ile 1/12 katı arasındaki fark 28'dir.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"112","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"96","dogru":true,"yanilgi":null},{"harf":"C","metin":"49/6","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"D","metin":"140","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"672/11","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(3/8 − 1/12) · x = 28"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(8, 12) = 24"},{"aciklama":"Her kesri, paydası 24 olacak biçimde genişlet:","ifade":"3/8 = 9/24  (payı da paydayı da 3 ile çarptık)\n1/12 = 2/24  (payı da paydayı da 2 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"9/24 − 2/24 = 7/24"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 28 × 24/7 = 96"},{"aciklama":"Aranan sayı:","ifade":"96"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"2b120aa7561b","sablon":"cebir.denklem.sistem","govde":"3x + 5y = −12 ve 6x + 4y = 48 olduğuna göre 3x + 6y kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"60","dogru":false,"yanilgi":"katsayi_yer_degistirme"},{"harf":"C","metin":"−24","dogru":true,"yanilgi":null},{"harf":"D","metin"