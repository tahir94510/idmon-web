enin dört bölgede sattığı Çay sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Kuzey bölgesinde satılan Çay sayısı, dört bölgede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%55","dogru":true,"yanilgi":null},{"harf":"B","metin":"%1.375","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"C","metin":"%50","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"%45","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"%100","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"1.375 + 250 + 125 + 750 = 2.500"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"1.375 / 2.500 × 100 = %55"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%55"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":{"tur":"sutun","baslik":"Çay satışları (adet)","etiketler":["Kuzey","Güney","Doğu","Batı"],"birim":"adet","seriler":[{"ad":"Çay","degerler":[1375,250,125,750]}]}},{"kimlik":"7f13dc16ddca","sablon":"mantik.dizi.ikili_orgu","govde":"34, 6, 41, 10, 48, 14, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"62","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"−20","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"41","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"55","dogru":true,"yanilgi":null},{"harf":"E","metin":"18","dogru":false,"yanilgi":"dizi_yanlis_altdizi"}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 7 artıyor:","ifade":"34, 41, 48"},{"aciklama":"Çift sıradakiler 4 değişiyor:","ifade":"6, 10, 14"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"48 + 7 = 55"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"55"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.272,"gorsel":null},{"kimlik":"c40c70dc385a","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 22 km sabit hızla yola çıkmıştır. 2 saat sonra aynı noktadan aynı yöne, saatte 44 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"4/3 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"B","metin":"2/3 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"C","metin":"44 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"E","metin":"2 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"22 × 2 = 44 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"44 − 22 = 22 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"44 / 22 = 2"},{"aciklama":"Yetişme süresi:","ifade":"2 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"476796279288","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 9 tek doğal sayının toplamı 369'dur.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"47","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"B","metin":"41","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"49","dogru":true,"yanilgi":null},{"harf":"D","metin":"45","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"E","metin":"33","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"}],"cozum":[{"aciklama":"Ardışık 9 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"369 / 9 = 41"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 4 adım ileridedir:","ifade":"41 + 2 × 4 = 49"},{"aciklama":"En büyük sayı:","ifade":"49"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"e22c33c74956","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"162² − 138² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"−7.200","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"B","metin":"45.288","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"576","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"3.888","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"7.200","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(162 − 138)(162 + 138) = 24 × 300"},{"aciklama":"Çarpımı yap:","ifade":"24 × 300 = 7.200"},{"aciklama":"İşlemin sonucu:","ifade":"7.200"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"88b09fb52ad5","sablon":"oran.dogru.tarif_olcekleme","govde":"7 kişilik bir tarifte 340 gram un kullanılmaktadır. Aynı tarif 28 kişi için hazırlanacağına göre kaç gram un gerekir?","secenekler":[{"harf":"A","metin":"85 gram","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"B","metin":"1.360 gram","dogru":true,"yanilgi":null},{"harf":"C","metin":"361 gram","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"D","metin":"1.020 gram","dogru":false,"yanilgi":"yalniz_eklenen_kisim"},{"harf":"E","metin":"9.520 gram","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Kişi sayısı ile malzeme **doğru orantılıdır**: kişi kaç kat artarsa malzeme de o kat artar.","ifade":null},{"aciklama":"Kaç kat arttığını bul:","ifade":"28 / 7 = 4"},{"aciklama":"Malzemeyi aynı katla çarp:","ifade":"340 × 4 = 1.360"},{"aciklama":"Gereken un:","ifade":"1.360 gram"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.paylastirma","oran.ters"],"zorluk":-1.529,"gorsel":null},{"kimlik":"8d365dae0ddd","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 36 kız öğrencinin matematik notu ortalaması 65, 24 erkek öğrencinin ortalaması ise 90'dır. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"4.500","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"125","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"75","dogru":true,"yanilgi":null},{"harf":"D","metin":"80","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"77,5","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"36 × 65 + 24 × 90 = 4.500"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"36 + 24 = 60"},{"aciklama":"Sınıf ortalaması:","ifade":"4.500 / 60 = 75"},{"aciklama":"Sınıfın ortalaması:","ifade":"75"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"baad26ab77b8","sablon":"yuzde.artis.degisim_orani","govde":"Bir atölyenin aylık üretimi 1.400 adetten 1.750 adede çıkmıştır. Üretimdeki artış yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%25","dogru":true,"yanilgi":null},{"harf":"C","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%80","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"%350","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Artış miktarı bulunur:","ifade":"1.750 − 1.400 = 350 adet"},{"aciklama":"Yüzde artış, artışın **eski** değere oranıdır:","ifade":"350 / 1.400 × 100 = %25"},{"aciklama":"Artış oranı:","ifade":"%25"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-0.193,"gorsel":null},{"kimlik":"de5a897595a5","sablon":"veri.ortalama.eksik_terim","govde":"8 öğrencinin sınav notu ortalaması 61. Öğrencilerden 7'yi sırasıyla 91, 34, 65, 54, 91, 48 ve 72 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"65","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"94","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"455","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"33","dogru":true,"yanilgi":null},{"harf":"E","metin":"105","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"61 × 8 = 488"},{"aciklama":"Bilinen notların toplamı:","ifade":"91 + 34 + 65 + 54 + 91 + 48 + 72 = 455"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"488 − 455 = 33"},{"aciklama":"Kalan öğrencinin notu:","ifade":"33"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"59d72fb62639","sablon":"sayilar.basamak.deger_toplami","govde":"459 sayısında onlar basamağındaki rakamın basamak değeri ile birler basamağındaki rakamın sayı değerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"95","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"14","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"C","metin":"59","dogru":true,"yanilgi":null},{"harf":"D","metin":"140","dogru":false,"yanilgi":"rakam_sayi_karisimi"},{"harf":"E","metin":"509","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"}],"cozum":[{"aciklama":"Basamak değeri, rakamın kendisi değil; rakam ile basamağın ağırlığının çarpımıdır.","ifade":null},{"aciklama":"Onlar basamağındaki 5 rakamının basamak değeri:","ifade":"5 × 10 = 50"},{"aciklama":"Birler basamağındaki rakamın sayı değeri rakamın kendisidir:","ifade":"9"},{"aciklama":"İkisini topla:","ifade":"50 + 9 = 59"},{"aciklama":"Aranan toplam:","ifade":"59"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.575,"gorsel":null},{"kimlik":"0c631c07aaeb","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 4 litre yakıt tüketmektedir.\n\nBu araç Ankara'ya yapılan 2.300 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"920 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"4 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"23 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"92 litre","dogru":true,"yanilgi":null},{"harf":"E","metin":"575 litre","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"4/100 = x/2.300"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.300 × 4/100 = 92"},{"aciklama":"Tüketilen yakıt:","ifade":"92 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.782,"gorsel":null},{"kimlik":"58ad9054c5a3","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 3.520 TL olan bir bisiklet %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"C","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"%37,5","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"3.520 × 160/100 = 5.632 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"5.632 − 3.520 = 2.112 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"2.112/5.632 × 100 = 37,5"},{"aciklama":"Gereken indirim:","ifade":"%37,5"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.746,"gorsel":null},{"kimlik":"e4dc6bf14e92","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n56, 60, 76, 112, 176, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"240","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"B","metin":"176","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"275","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"D","metin":"196","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"276","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"4, 16, 36, 64"},{"aciklama":"Farklar ardışık sayıların karelerinin **4 katı**: 4·1², 4·2², 4·3², 4·4². Sıradaki fark 4·5²:","ifade":"100"},{"aciklama":"Son terime bu farkı ekle:","ifade":"176 + 100 = 276"},{"aciklama":"Sıradaki terim:","ifade":"276"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"91d428d121eb","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 6 kişinin yaş ortalaması 45. Gruptan bir kişi ayrılınca ortalama 49 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"25","dogru":true,"yanilgi":null},{"harf":"B","metin":"4","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"24","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"515","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"245","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 6 × 45","ifade":"270"},{"aciklama":"Ayrıldıktan sonra grup 5 kişi: 5 × 49","ifade":"245"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"270 − 245 = 25"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"25"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.14,"gorsel":null},{"kimlik":"1cca83bf12d8","sablon":"problem.isci.birlikte","govde":"Bir işi Zeynep tek başına 170 günde, Selin tek başına 119 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"70 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"144,5 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"51 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"D","metin":"119 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"E","metin":"289 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/170 + 1/119 = 289/20230"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"20230/289 = 70 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"70 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.258,"gorsel":null},{"kimlik":"ab69d434b09b","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 7.488 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"832","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"8.320","dogru":true,"yanilgi":null},{"harf":"C","metin":"7.488","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"D","metin":"83.200","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"842","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 7.488"},{"aciklama":"İlk sayı:","ifade":"x = 7.488 / 9 = 832"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 832 = 8.320"},{"aciklama":"Yeni sayı:","ifade":"8.320"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.552,"gorsel":null}]}