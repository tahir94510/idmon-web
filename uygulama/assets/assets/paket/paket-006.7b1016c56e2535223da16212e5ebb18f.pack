erkez açısı:","ifade":"18 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.134,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Roman","Şiir","Deneme","Öykü"],"birim":"%","seriler":[{"ad":"Pay","degerler":[35,40,20,5]}]}},{"kimlik":"df807202f082","sablon":"cebir.denklem.dagitmali","govde":"11(x + 14) − 8(x − 16) = 294 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"124/3","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"B","metin":"18","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"4","dogru":true,"yanilgi":null},{"harf":"D","metin":"268/3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"12/19","dogru":false,"yanilgi":"taraf_degistirirken_toplama"}],"cozum":[{"aciklama":"Parantezleri dağıt; ikinci parantezin önündeki eksi, içerideki her terimin işaretini çevirir:","ifade":"11x + 154 − 8x + 128 = 294"},{"aciklama":"Benzer terimleri topla:","ifade":"3x + 282 = 294"},{"aciklama":"Sabit terimi karşıya geçir, yani iki taraftan da 282 çıkar:","ifade":"3x = 294 − 282 = 12"},{"aciklama":"İki tarafı 3 sayısına böl; x değeri:","ifade":"4"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"0c8b0c26a781","sablon":"mantik.esleme.yerlestirme","govde":"4, 7, 8, 10, 13 ve 15 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ × □ − □ = □ + □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"13","dogru":true,"yanilgi":null},{"harf":"B","metin":"8","dogru":false,"yanilgi":null},{"harf":"C","metin":"10","dogru":false,"yanilgi":null},{"harf":"D","metin":"15","dogru":false,"yanilgi":null},{"harf":"E","metin":"7","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Soldaki çarpımdan bir sayı çıkınca, sağdaki iki sayının toplamı kalmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"4 × 8 − 7 = 10 + 15"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"13"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null,"cevap_uzayi":true},{"kimlik":"d8c5dc11ba9b","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 5/6 katı ile 3/14 katı arasındaki fark 52'dir.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"84","dogru":true,"yanilgi":null},{"harf":"B","metin":"546/11","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"130","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"D","metin":"156","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"E","metin":"676/21","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(5/6 − 3/14) · x = 52"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(6, 14) = 42"},{"aciklama":"Her kesri, paydası 42 olacak biçimde genişlet:","ifade":"5/6 = 35/42  (payı da paydayı da 7 ile çarptık)\n3/14 = 9/42  (payı da paydayı da 3 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"35/42 − 9/42 = 26/42"},{"aciklama":"Payı ve paydayı ortak bölenleri 2 ile sadeleştir:","ifade":"26/42 = 13/21"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 52 × 21/13 = 84"},{"aciklama":"Aranan sayı:","ifade":"84"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"6531a076e7de","sablon":"problem.isci.ek_isci","govde":"24 işçi bir işi 8 günde bitirmektedir. Aynı iş 6 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"8 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"32 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"18 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"D","metin":"30 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"E","metin":"2 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"24 × 8 = 192"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"192 / 6 = 32"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"32 − 24 = 8"},{"aciklama":"Gereken ek işçi:","ifade":"8 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.44,"gorsel":null},{"kimlik":"a9ef7fdaa589","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 720 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Otomobil tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"2.880 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"36 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"288 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"432 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"40 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Otomobil diliminin payı:","ifade":"%40"},{"aciklama":"Kişi sayısı:","ifade":"720 × 40 / 100 = 288"},{"aciklama":"Kişi sayısı:","ifade":"288 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.043,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Yürüyüş","Bisiklet","Otobüs","Otomobil"],"birim":"%","seriler":[{"ad":"Pay","degerler":[5,30,25,40]}]}},{"kimlik":"b4e24