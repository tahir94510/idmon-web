:"3x · 5x + 3x · 11 + 12 · 5x + 12 · 11"},{"aciklama":"x'li terimler ortadaki iki çarpımdan gelir:","ifade":"3 · 11 · x + 12 · 5 · x"},{"aciklama":"Katsayıları topla:","ifade":"33 + 60 = 93"},{"aciklama":"x'li terimin katsayısı:","ifade":"93"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.261,"gorsel":null},{"kimlik":"42fb98b7694b","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|3x − 11| < 62 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"41","dogru":true,"yanilgi":null},{"harf":"B","metin":"33","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"40","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"D","metin":"21","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"43","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"|A| < 62 eşitsizliği, A'nın −62 ile 62 arasında olması demektir:","ifade":"−62 < 3x − 11 < 62"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−17 < x < 73/3"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"41 tane"},{"aciklama":"Tam sayı adedi:","ifade":"41"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.393,"gorsel":null},{"kimlik":"0f840fe516dc","sablon":"mantik.dizi.toplamsal","govde":"18, 38, 56, 94, 150, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"244","dogru":true,"yanilgi":null},{"harf":"B","metin":"300","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"206","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"D","metin":"150","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"394","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"18 + 38 = 56"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"38 + 56 = 94"},{"aciklama":"Son iki terimi topla:","ifade":"94 + 150 = 244"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"244"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"5d36d030b88a","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Antalya ile Eskişehir arasındaki yolu giderken 31 km/sa, dönerken 19 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"23,56 km/sa","dogru":true,"yanilgi":null},{"harf":"B","metin":"11,78 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"C","metin":"31 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"D","metin":"50 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"25 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/31 + x/19 = x·(50)/(31·19)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·50/(31·19)] = 2·31·19/50 = 23,56 km/sa"},{"aciklama":"Ortalama hız:","ifade":"23,56 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.034,"gorsel":null},{"kimlik":"fe8f470a9f14","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Trabzon şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"190 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"380 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"120 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"D","metin":"290 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"30 kişi","dogru":false,"yanilgi":"grafik_artis_egim"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 30 · 2021→2022: −190 · 2022→2023: −120 · 2023→2024: −10"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2021 → 2022: 440 − 250 = 190 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"190 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.663,"gorsel":{"tur":"cizgi","baslik":"Trabzon şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[410,440,250,130,120]}]}},{"kimlik":"716925f8188e","sablon":"oran.ters.kapasite_arac","govde":"Bir depodaki yükün tamamı, her biri 3 ton taşıyan 18 kamyonla bir seferde taşınmaktadır. Aynı yük, her biri 6 ton taşıyan kamyonlarla bir seferde taşınsaydı kaç kamyon gerekirdi?","secenekler":[{"harf":"A","metin":"21 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"B","metin":"9 kamyon","dogru":true,"yanilgi":null},{"harf":"C","metin":"54 kamyon","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"15 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"E","metin":"36 kamyon","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"Taşınan yük değişmiyor; değişen yalnızca onu kaç araca böldüğümüz. Araç sayısı ile kapasite **ters** orantılıdır, yani çarpımları sabittir.","ifade":null},{"aciklama":"Toplam yükü bul:","ifade":"18 × 3 = 54 ton"},{"aciklama":"Yeni kapasiteye böl:","ifade":"54 / 6 = 9"},{"aciklama":"Gereken kamyon sayısı:","ifade":"9 kamyon"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.557,"gorsel":null},{"kimlik":"bb9ac74dce8c","sablon":"yuzde.kar_zarar.zarar_orani","govde":"Maliyeti 2.500 TL olan bir ürün 800 TL fiyatına satılmıştır. Bu satışta zarar yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%212,5","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"B","metin":"%312,5","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%1.700","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"%32","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"%68","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"2.500 − 800 = 1.700 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"1.700 / 2.500 × 100 = %68"},{"aciklama":"Zarar oranı:","ifade":"%68"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.994,"gorsel":null},{"kimlik":"af575acd48fe","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 7| = 1 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"−48","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"50","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"48","dogru":true,"yanilgi":null},{"harf":"D","metin":"8","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"6","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 7 + 1 = 8 ve x = 7 − 1 = 6"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(7 + 1) × (7 − 1) = 7² − 1² = 48"},{"aciklama":"Köklerin çarpımı:","ifade":"48"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.383,"gorsel":null},{"kimlik":"a330343d8832","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"130 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"220 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"40 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"25 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"10 adet","dogru":false,"ya