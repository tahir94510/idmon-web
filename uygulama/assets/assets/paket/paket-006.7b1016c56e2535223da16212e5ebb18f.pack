.kar_zarar","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-0.923,"gorsel":null},{"kimlik":"144e2c7c3f89","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Trabzon şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"120 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"240 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"130 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"10 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"420 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: −100 · 2021→2022: 80 · 2022→2023: 130 · 2023→2024: −120"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2023 → 2024: 420 − 300 = 120 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"120 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.537,"gorsel":{"tur":"cizgi","baslik":"Trabzon şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[310,210,290,420,300]}]}},{"kimlik":"066f7794c1b1","sablon":"mantik.dizi.ikili_orgu","govde":"31, 9, 42, 5, 53, 1, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"−3","dogru":false,"yanilgi":"dizi_yanlis_altdizi"},{"harf":"B","metin":"42","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"C","metin":"64","dogru":true,"yanilgi":null},{"harf":"D","metin":"−51","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"75","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 11 artıyor:","ifade":"31, 42, 53"},{"aciklama":"Çift sıradakiler −4 değişiyor:","ifade":"9, 5, 1"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"53 + 11 = 64"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"64"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.402,"gorsel":null},{"kimlik":"98965c3d98ac","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 10| = 2 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"96","dogru":true,"yanilgi":null},{"harf":"B","metin":"12","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"104","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−96","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"8","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 10 + 2 = 12 ve x = 10 − 2 = 8"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(10 + 2) × (10 − 2) = 10² − 2² = 96"},{"aciklama":"Köklerin çarpımı:","ifade":"96"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"eab7c06e495a-1","sablon":"veri.blok.cizgi_iki_soru","govde":"2019 yılından 2021 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"20 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"40 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"C","metin":"380 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"D","metin":"120 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"60 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2019 değeri:","ifade":"320 kişi"},{"aciklama":"2021 değeri:","ifade":"380 kişi"},{"aciklama":"Farkı al:","ifade":"380 − 320 = 60"},{"aciklama":"Artış miktarı:","ifade":"60 kişi