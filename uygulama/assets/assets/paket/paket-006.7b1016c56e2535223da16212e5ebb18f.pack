krobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":4.005,"gorsel":null},{"kimlik":"7da83364945b","sablon":"yuzde.faiz.getiri_farki","govde":"6.000 TL, yıllık %45 faizle 3 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %20 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"675 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"1.500 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"375 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"25 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"500 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"45 − 20 = 25 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"25/100 × 3/12"},{"aciklama":"Anaparayla çarp:","ifade":"6.000 × 25/100 × 3/12 = 375 TL"},{"aciklama":"Getiri farkı:","ifade":"375 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.711,"gorsel":null},{"kimlik":"ca66f55a7290","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"439A8 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"},{"harf":"B","metin":"6","dogru":true,"yanilgi":null},{"harf":"C","metin":"18","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"E","metin":"4","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A8 sayısı 4'ün katı olmalı ⟹ 8 ve 68"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"4 + 3 + 9 + A + 8 = 24 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"0 ve 6"},{"aciklama":"Bu rakamları topla:","ifade":"0 + 6 = 6"},{"aciklama":"Rakamların toplamı:","ifade":"6"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.836,"gorsel":null},{"kimlik":"4ccc75c07daf","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Samsun'un yıllık toplam satışı, Eskişehir'in yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"595 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"B","metin":"220 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"180 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"1.040 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"1.860 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Samsun satırını topla:","ifade":"210 + 80 + 375 + 375 = 1.040"},{"aciklama":"Eskişehir satırını topla:","ifade":"95 + 350 + 220 + 155 = 820"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"1.040 − 820 = 220"},{"aciklama":"Aradaki fark:","ifade":"220 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.719,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[365,180,205,280]},{"ad":"Eskişehir","degerler":[95,350,220,155]},{"ad":"Samsun","degerler":[210,80,375,375]},{"ad":"Antalya","degerler":[260,140,130,235]}]}},{"kimlik":"369b6face17e","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede DEFTER kelimesi JVLMKJ biçiminde yazılmaktadır. Aynı kurala göre BARDAK kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"ŞĞJJSS","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"B","metin":"HSZÜĞE","dogru":true,"yanilgi":null},{"harf":"C","metin":"ŞSJÜSE","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"D","metin":"IŞAVHF","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"E","metin":"HĞZJĞS","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"D→J (+8) , E→V (−8) , F→L (+8) , T→M (−8) , E→K (+8) , R→J (−8)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 8 ileri, çift sıradakiler 8 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı BARDAK kelimesine uygula:","ifade":"B→H , A→S , R→Z , D→Ü , A→Ğ , K→E"},{"aciklama":"Şifrelenmiş kelime:","ifade":"HSZÜĞE"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"e897468e642c","sablon":"problem.sayi.verme_alma","govde":"Burak, Deniz'e defterlerinin 11 tanesini verirse ikisinin defter sayıları eşit olmaktadır. Deniz, Burak'a defterlerinin 15 tanesini verirse Burak'ın defter sayısı Deniz'inkinin 2 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç defteri vardır?","secenekler":[{"harf":"A","metin":"123","dogru":false,"yanilgi":"verme_farki_tek_sayildi"},{"harf":"B","metin":"156","dogru":true,"yanilgi":null},{"harf":"C","metin":"96","dogru":false,"yanilgi":"verme_tek_taraf"},{"harf":"D","metin":"78","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"89","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Burak 11 tane verince kendisi 11 azalır, Deniz 11 artar: aradaki fark 22 kapanır. Eşitlendiklerine göre baştaki fark 22'dir.","ifade":null},{"aciklama":"Deniz'in sayısına x dersek Burak'ınki x + 22 olur. İkinci koşulda Deniz 15 tane verir, Burak 15 tane alır:","ifade":"x + 22 + 15 = 2·(x − 15)"},{"aciklama":"Denklemi çöz:","ifade":"x = 67"},{"aciklama":"Toplam x + (x + 22) olduğuna göre:","ifade":"156"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"65d189a4cf5d","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 2 : 3 : 9 oranındadır. İkinci arkadaşın parası 144 TL olduğuna göre birinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"216 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"48 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"224 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"96 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"2 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"2k : 3k : 9k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"3k = 144 → k = 48"},{"aciklama":"Sorulan payı k ile çarp (birinci arkadaş):","ifade":"2 × 48 = 96"},{"aciklama":"Birinci arkadaşın parası:","ifade":"96 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.054,"gorsel":null},{"kimlik":"c7a1c65427d7","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan armut, portakal ve ayvanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 210 kilogram satılmış ve toplam 180 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram armut ve portakal satılmıştır?","secenekler":[{"harf":"A","metin":"200","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},{"harf":"B","metin":"30","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"140","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"204","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"180","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Armut: 4,3 − 3,5 = 0,8 TL, Portakal: 4,8 − 4 = 0,8 TL, Ayva: 5,7 − 4,5 = 1,2 TL.","ifade":null},{"aciklama":"Armut ile portakalın kilogram kârı aynı. Hepsi 0,8 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"210 · 0,8 = 168 TL"},{"aciklama":"Fazladan 12 TL yalnızca ayva yüzünden: onun her kilogramı 0,4 TL fazla kazandırıyor.","ifade":"ayva = 12 ÷ 0,4 = 30 kg"},{"aciklama":"İstenen: 210 − 30 =","ifade":"180"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Armut","degerler":[3.5,4.3]},{"ad":"Portakal","degerler":[4.0,4.8]},{"ad":"Ayva","degerler":[4.5,5.7]}]}},{"kimlik":"d22fb749ad4a","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 1.900 TL olan bir koltuk %20 kârla, maliyeti 900 TL olan bir bisiklet ise %15 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"515 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"140 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"245 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"380 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"5 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"1.900 × 20/100 = 380 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"900 × 15/100 = 135 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"380 − 135 = 245 TL"},{"aciklama":"Net kâr:","ifade":"245 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.619,"gorsel":null},{"kimlik":"72f70a45931a","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 8'e bölümünden kalan 4, 12'ye bölümünden kalan 8'dir. Bu koşulu sağlayan ve 414'ten büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"436","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"428","dogru"