gru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"%125","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%25","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"3.100 − 2.480 = 620 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"620 / 3.100 × 100 = %20"},{"aciklama":"Zarar oranı:","ifade":"%20"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.14,"gorsel":null},{"kimlik":"4c0a8a0208a8","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Scooter satışının Bisiklet satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"170 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"15 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"5 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"60 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"280 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Scooter ilk kez Ağustos döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Bisiklet 110, Scooter 170","ifade":"170 − 110 = 60"},{"aciklama":"Aradaki fark:","ifade":"60 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.313,"gorsel":{"tur":"cizgi","baslik":"Bisiklet ve Scooter satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[200,170,140,110]},{"ad":"Scooter","degerler":[65,100,135,170]}]}},{"kimlik":"c802a062a212","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 48| = 29 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"38,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"B","metin":"48","dogru":true,"yanilgi":null},{"harf":"C","metin":"29","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"−48","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"9,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değer 29'a eşitse içerideki ifade 29 ya da −29 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 48 = 29 ⟹ x = 38,5"},{"aciklama":"İkinci durum:","ifade":"2x − 48 = −29 ⟹ x = 9,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"38,5 + 9,5 = 2 × 48 / 2 = 48"},{"aciklama":"Köklerin toplamı:","ifade":"48"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.826,"gorsel":null},{"kimlik":"3b988d976da3","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Kitap sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"240 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"168 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"C","metin":"165 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"280 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"210 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Ocak: 240 · Şubat: 225 · Mart: 195 · Nisan: 180"},{"aciklama":"Dördünü topla:","ifade":"240 + 225 + 195 + 180 = 840"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"840/4 = 210"},{"aciklama":"Dönem ortalaması:","ifade":"210 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.923,"gorsel":{"tur":"cizgi","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[2