mlik":"22202474bbd3","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"5 · 2⁴ · 2³ · 7⁰ + 2⁶ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"20.544","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"B","metin":"40.960","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"C","metin":"704","dogru":true,"yanilgi":null},{"harf":"D","metin":"576","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"64","dogru":false,"yanilgi":"sifir_us"}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"7⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2⁴ · 2³ = 2⁷ = 128"},{"aciklama":"Katsayıyla çarp:","ifade":"5 × 128 = 640"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"640 + 64 = 704"},{"aciklama":"İşlemin sonucu:","ifade":"704"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.079,"gorsel":null},{"kimlik":"720303b681b5","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 48, s(B) = 31 ve s(A ∪ B) = 66'dır. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"13","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"B","metin":"48","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"35","dogru":true,"yanilgi":null},{"harf":"D","metin":"18","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"E","metin":"53","dogru":false,"yanilgi":"kume_yalnizca_biri"}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 48 + 31 − 66 = 13"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"48 − 13 = 35"},{"aciklama":"s(A ∖ B):","ifade":"35"}],"mikrobeceriler":["kume.temel"],"yanilgi