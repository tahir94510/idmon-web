etin":"250 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"E","metin":"100 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Selin bir günde işin 1/150'sini yapıyor; 81 gün çalışınca yaptığı iş:","ifade":"81/150"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(150 − 81)/150 = 23/50"},{"aciklama":"Yusuf işin tamamını 100 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"23/50 × 100 = 46"},{"aciklama":"Kalan iş için gereken süre:","ifade":"46 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.051,"gorsel":null,"grup":"4446f6eae9e1","grup_govde":"Bir işi Selin tek başına 150 günde, Yusuf tek başına 100 günde bitirmektedir."},{"kimlik":"c4425032b848","sablon":"problem.yas.toplam_iliskisi","govde":"Deniz ile Emre'nin bugünkü yaşları toplamı 82'dir, aralarındaki yaş farkı ise 6'dır.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"62","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"B","metin":"44","dogru":true,"yanilgi":null},{"harf":"C","metin":"38","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"88","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"E","metin":"53","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(82 + 6) / 2 = 44"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"82 − 44 = 38"},{"aciklama":"Büyük olanın yaşı:","ifade":"44"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.323,"gorsel":null},{"kimlik":"d66f3a529101","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon şubesindeki personel sayısı, toplam 200 personelin yüzde kaçıdır