0 − 3.640 = 5.460 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"5.460/9.100 × 100 = 60"},{"aciklama":"Gereken indirim:","ifade":"%60"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.526,"gorsel":null},{"kimlik":"76059be11093","sablon":"problem.karisim.su_ekleme","govde":"950 gram %12 tuzlu su çözeltisine 300 gram saf su eklenmiştir. Yeni çözeltinin tuz oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%9,12","dogru":true,"yanilgi":null},{"harf":"B","metin":"%24","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%6","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"D","metin":"%12","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"E","metin":"%38","dogru":false,"yanilgi":"karisim_agirlik_capraz"}],"cozum":[{"aciklama":"Su eklemek tuz miktarını değiştirmez; önce tuzu bul:","ifade":"950 × 12/100 = 114 gram"},{"aciklama":"Yeni toplam miktar:","ifade":"950 + 300 = 1.250 gram"},{"aciklama":"Yeni oran, tuzun yeni toplama oranıdır:","ifade":"114 / 1.250 × 100 = %9,12"},{"aciklama":"Yeni tuz oranı:","ifade":"%9,12"}],"mikrobeceriler":["problem.karisim"],"yanilgi_alanlari":[],"zorluk":3.192,"gorsel":null},{"kimlik":"9ca97de86132","sablon":"veri.ortalama.eksik_terim","govde":"5 öğrencinin sınav notu ortalaması 75. Öğrencilerden 4'ü sırasıyla 95, 94, 49 ve 70 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"77","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"137","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"C","metin":"375","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"67","dogru":true,"yanilgi":null},{"harf":"E","metin":"142","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"75 × 5 = 375"},{"aciklama":"Bilinen notların toplamı:","ifade":"95 + 94 + 49 + 70 = 308"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"375 − 308 = 67"},{"aciklama":"Kalan öğrencinin notu:","ifade":"67"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":null},{"kimlik":"ac7088d83524","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 5 tek doğal sayının toplamı 475'tir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"101","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"B","metin":"95","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"99","dogru":true,"yanilgi":null},{"harf":"D","metin":"97","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"E","metin":"91","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"}],"cozum":[{"aciklama":"Ardışık 5 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"475 / 5 = 95"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 2 adım ileridedir:","ifade":"95 + 2 × 2 = 99"},{"aciklama":"En büyük sayı:","ifade":"99"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"05440f84fa9a","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|3x + 2y − 32| + z = 8\n|x − 2y − 16| = 2z − 16\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"15","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"B","metin":"12","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"10","dogru":true,"yanilgi":null},{"harf":"D","metin":"−14","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"E","metin":"8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 8 − |…| ≤ 8"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 16 ≥ 0 , yani z ≥ 8"},{"aciklama":"İkisi birlikte:","ifade":"z = 8"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"3x + 2y = 32 , x − 2y = 16"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 12 , y = −2"},{"aciklama":"İstenen toplam, x + y:","ifade":"10"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"72933a430e36","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 5 kişinin yaş ortalaması 42. Gruptan bir kişi ayrılınca ortalama 44 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"34","dogru":true,"yanilgi":null},{"harf":"B","metin":"2","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"386","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"176","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"10","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 5 × 42","ifade":"210"},{"aciklama":"Ayrıldıktan sonra grup 4 kişi: 4 × 44","ifade":"176"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"210 − 176 = 34"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"34"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.11,"gorsel":null},{"kimlik":"ad38cb8fb721","sablon":"oran.paylastirma.artan_pay","govde":"1.120 TL paranın bir kısmı Kerem'e ve Ahmet'e 5 : 2 oranında dağıtılmış, Kerem'in payı 675 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"175 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"115 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"2.065 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"160 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"675 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kerem'in payından birim payı çöz:","ifade":"5k = 675 → k = 135"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(5 + 2) × 135 = 945 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"1.120 − 945 = 175 TL"},{"aciklama":"Geriye kalan:","ifade":"175 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.592,"gorsel":null},{"kimlik":"9117866d9cee","sablon":"yuzde.artis.indirim","govde":"Fiyatı 400 TL olan bir halı, %30 indirimle satılmaktadır. Halının indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"120 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"370 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"196 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"280 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"520 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"400 × 30 / 100 = 120"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"400 − 120 = 280"},{"aciklama":"İndirimli fiyat:","ifade":"280 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.47,"gorsel":null},{"kimlik":"6ecd9f8c0c64","sablon":"sayilar.basamak.deger_toplami","govde":"836 sayısında onlar basamağındaki rakamın basamak değeri ile birler basamağındaki rakamın sayı değerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"90","dogru":false,"yanilgi":"rakam_sayi_karisimi"},{"harf":"B","metin":"306","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"36","dogru":true,"yanilgi":null},{"harf":"D","metin":"63","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"9","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"}],"cozum":[{"aciklama":"Basamak değeri, rakamın kendisi değil; rakam ile basamağın ağırlığının çarpımıdır.","ifade":null},{"aciklama":"Onlar basamağındaki 3 rakamının basamak değeri:","ifade":"3 × 10 = 30"},{"aciklama":"Birler basamağındaki rakamın sayı değeri rakamın kendisidir:","ifade":"6"},{"aciklama":"İkisini topla:","ifade":"30 + 6 = 36"},{"aciklama":"Aranan toplam:","ifade":"36"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-1.631,"gorsel":null},{"kimlik":"cc2be8d707fe","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 30 kişilik A grubunun puan ortalaması 70, 10 kişilik B grubunun puan ortalaması 66 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"68","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"2.760","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"136","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"69","dogru":true,"yanilgi":null},{"harf":"E","metin":"92","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 30 × 70","ifade":"2.100"},{"aciklama":"B grubu: 10 × 66","ifade":"660"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"2.760 / 40 = 69"},{"aciklama":"Ortak ortalama:","ifade":"69"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.313,"gorsel":null},{"kimlik":"2f8ed72d4c55","sablon":"mantik.ozel_islem.ters_cozum","govde":"x ⊕ y = 6x + 3y biçiminde tanımlanan bir işlem için a ⊕ 13 = 99 olduğuna göre a kaçtır?","secenekler":[{"harf":"A","metin":"39","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"7","dogru":false,"yanilgi":"ozel_islem_sira"},{"harf":"C","metin":"16,5","dogru":false,"yanilgi":"ozel_islem_terim_atlandi"},{"harf":"D","metin":"23","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"10","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Tanımı olduğu gibi yaz; **sıra önemli**, ilk terim x'in yerinde:","ifade":"a ⊕ 13 = 6a + 3·13"},{"aciklama":"Sonuca eşitle:","ifade":"6a + 39 = 99"},{"aciklama":"a'yı yalnız bırak:","ifade":"6a = 60 → a = 10"},{"aciklama":"Aranan a değeri:","ifade":"10"}],"mikrobeceriler":["mantik.ozel_islem"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.048,"gorsel":null},{"kimlik":"d79eb9afe2af","sablon":"problem.karisim.tuz_orani","govde":"130 gram su ile 30 gram tuzdan oluşan bir karışıma 40 gram tuz daha ekleniyor. Yeni karışımın yüzde kaçı tuzdur?","secenekler":[{"harf":"A","metin":"%43,75","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"B","metin":"%38,75","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"C","metin":"%18,75","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%20","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"%35","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Tuz eklendiğinde hem tuz miktarı hem toplam miktar büyür; ikisini de ayrı ayrı yaz.","ifade":null},{"aciklama":"Karışımın eski toplamı (su + tuz):","ifade":"130 + 30 = 160 gram"},{"aciklama":"Yeni tuz miktarı (eski tuz + eklenen):","ifade":"30 + 40 = 70 gram"},{"aciklama":"Yeni toplam (eski toplam + eklenen):","ifade":"160 + 40 = 200 gram"},{"aciklama":"Oran, yeni tuzun yeni toplama bölümüdür:","ifade":"70/200 × 100 = 35"},{"aciklama":"Yeni karışımdaki tuz oranı:","ifade":"%35"}],"mikrobeceriler":["problem.karisim"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":1.398,"gorsel":null},{"kimlik":"de7385de5660","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 36 kişilik bir grubun yaş ortalaması 85, ikinci bir grubun yaş ortalaması ise 45'tir. İki grup birleştiğinde yaş ortalaması 77 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"9 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"68 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"40 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"36 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"45 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"36·85 + n·45"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(36·85 + n·45) / (36 + n) = 77"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"36·(85 − 77) = n·(77 − 45)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"9 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.059,"gorsel":null},{"kimlik":"2141530b9761","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 8.487 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"953","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"B","metin":"8.487","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"C","metin":"94.300","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"D","metin":"9.430","dogru":true,"yanilgi":null},{"harf":"E","metin":"943","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 8.487"},{"aciklama":"İlk sayı:","ifade":"x = 8.487 / 9 = 943"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 943 = 9.430"},{"aciklama":"Yeni sayı:","ifade":"9.430"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.368,"gorsel":null},{"kimlik":"0100fae9c4fe","sablon":"oran.paylastirma.fark","govde":"8.500 TL tutarındaki bir ödül, Fatma ile Selin arasında 3/14 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"8.500 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"7.000 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"4.250 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"1.500 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"5.500 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"3 + 14 = 17"},{"aciklama":"Bir parçanın değeri:","ifade":"8.500 / 17 = 500 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(14 − 3) × 500 = 5.500 TL"},{"aciklama":"Aradaki fark:","ifade":"5.500 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":1.796,"gorsel":null},{"kimlik":"f2389a34374e","sablon":"yuzde.artis.zam","govde":"Fiyatı 4.000 TL olan bir güneş gözlüğü, %20 zamlanmıştır. Zamdan sonra güneş gözlüğünün fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"4.020 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"84.000 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"4.800 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"800 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"3.200 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"4.000 × 20/100 = 800 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"4.000 + 800 = 4.800 TL"},{"aciklama":"Zamlı fiyat:","ifade":"4.800 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.142,"gorsel":null},{"kimlik":"8ad90bff1165","sablon":"veri.ortalama.medyan_tek","govde":"84, 42, 120, 20, 174, 16, 24, 118, 140 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"174","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"B","metin":"118","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C"