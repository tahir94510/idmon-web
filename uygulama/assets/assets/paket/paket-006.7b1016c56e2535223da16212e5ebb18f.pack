 / 50 = 66"},{"aciklama":"Ortak ortalama:","ifade":"66"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.495,"gorsel":null},{"kimlik":"b08c65b84673","sablon":"sayilar.basamak.deger_toplami","govde":"121 sayısında onlar basamağındaki rakamın basamak değeri ile birler basamağındaki rakamın sayı değerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"3","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"B","metin":"21","dogru":true,"yanilgi":null},{"harf":"C","metin":"201","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"D","metin":"12","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"30","dogru":false,"yanilgi":"rakam_sayi_karisimi"}],"cozum":[{"aciklama":"Basamak değeri, rakamın kendisi değil; rakam ile basamağın ağırlığının çarpımıdır.","ifade":null},{"aciklama":"Onlar basamağındaki 2 rakamının basamak değeri:","ifade":"2 × 10 = 20"},{"aciklama":"Birler basamağındaki rakamın sayı değeri rakamın kendisidir:","ifade":"1"},{"aciklama":"İkisini topla:","ifade":"20 + 1 = 21"},{"aciklama":"Aranan toplam:","ifade":"21"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-2.385,"gorsel":null},{"kimlik":"7679111f5585","sablon":"oran.paylastirma.fark","govde":"5.100 TL tutarındaki bir ödül, Merve ile Emre arasında 5/12 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.550 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"1.500 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"5.100 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"300 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"2.100 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"5 + 12 = 17"},{"aciklama":"Bir parçanın değeri:","ifade":"5.100 / 17 = 300 TL"},{"ac