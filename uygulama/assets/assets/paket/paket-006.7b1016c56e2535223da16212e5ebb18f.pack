.090"},{"aciklama":"Yıl boyunca yapılan toplam satış:","ifade":"1.090 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":[],"zorluk":-0.341,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Samsun","degerler":[165,205,330,315]},{"ad":"Bursa","degerler":[230,320,85,110]},{"ad":"Ankara","degerler":[280,245,365,200]},{"ad":"Konya","degerler":[255,205,125,350]}]}},{"kimlik":"23d01307fa9c","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 16 ve a · b = 61 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"195","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"B","metin":"134","dogru":true,"yanilgi":null},{"harf":"C","metin":"12","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"D","metin":"256","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"378","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"16² − 2 × 61 = 256 − 122 = 134"},{"aciklama":"a² + b² değeri:","ifade":"134"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.836,"gorsel":null},{"kimlik":"879a33421aa5","sablon":"kume.temel.hicbiri","govde":"Bir okulda 60 öğrenci vardır. Bu öğrencilerin 33 tanesi futbol, 26 tanesi yüzme kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 16'dır. Buna göre bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"43","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"B","metin":"44","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"C","metin":"1","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"17","dogru":true,"yanilgi":null},{"harf":"E","metin":"33","dogru":false,"yanilgi":"kume_yalnizca_biri"}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"33 + 26 − 16 = 43"},{"aciklama":"Evrensel küme, hiçbir kursa gitmeyenleri de içerir:","ifade":"60 − 43 = 17"},{"aciklama":"Hiçbir kursa gitmeyen öğrenci sayısı:","ifade":"17"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"b5eca8eee46b","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 42 dakikada bir, B hattı 24 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"168 dakika","dogru":true,"yanilgi":null},{"harf":"B","metin":"6 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"C","metin":"336 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.008 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"E","metin":"66 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"42 ve 24 sayılarının EKOK'u:","ifade":"EKOK(42, 24) = 168"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"168 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":3.062,"gorsel":null},{"kimlik":"174787bd571e","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin İlkbahar mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"201 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"B","metin":"208 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"156 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"245 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"111 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"İlkbahar sütunundaki dört değeri oku:","ifade":"Bursa: 148 · Trabzon: 276 · İzmir: 20 · Samsun: 180"},{"aciklama":"Dördünü topla:","ifade":"148 + 276 + 20 + 180 = 624"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölünmesidir; burada dört şehir var:","ifade":"624 / 4 = 156"},{"aciklama":"Ortalama satış:","ifade":"156 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-1.086,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Bursa","degerler":[148,365,225,295]},{"ad":"Trabzon","degerler":[276,75,360,335]},{"ad":"İzmir","degerler":[20,365,265,380]},{"ad":"Samsun","degerler":[180,175,360,225]}]}},{"kimlik":"2830c1b09193","sablon":"oran.ters.hiz_sure","govde":"Bir araç Antalya ile Trabzon arasını saatte 50 km hızla 18 saatte almaktadır. Aynı yolu saatte 180 km hızla giden bir araç kaç saatte alır?","secenekler":[{"harf":"A","metin":"31 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"B","metin":"13 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"5 saat","dogru":true,"yanilgi":null},{"harf":"D","metin":"18 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"E","metin":"64,8 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"Sabit yolda hız ile süre ters orantılıdır; yol çarpımlarıdır:","ifade":"50 × 18 = 900 km"},{"aciklama":"Yeni süre, aynı yolun yeni hıza bölümüdür:","ifade":"900 / 180 = 5 saat"},{"aciklama":"Geçen süre:","ifade":"5 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":1.304,"gorsel":null},{"kimlik":"5c743bd82a30","sablon":"yuzde.kar_zarar.maliyet_bulma","govde":"Bir ürün %40 kârla 7.980 TL fiyatına satılmıştır. Ürünün maliyeti kaç TL'dir?","secenekler":[{"harf":"A","metin":"13.300 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"5.700 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"2.280 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"4.788 TL","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"7.940 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Kâr her zaman maliyet üzerinden hesaplanır; satış fiyatı maliyetin %140'ıdır:","ifade":"maliyet × 140/100 = 7.980"},{"aciklama":"Maliyet, satış fiyatının bu orana bölümüdür:","ifade":"7.980 × 100/140 = 5.700 TL"},{"aciklama":"Maliyet:","ifade":"5.700 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.149,"gorsel":null},{"kimlik":"bd5813f40280","sablon":"mantik.dizi.terim_sirasi","govde":"29, 34, 39, 44, ... biçiminde devam eden dizide 184 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"36,8","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"B","metin":"33","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"C","metin":"184","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"32","dogru":true,"yanilgi":null},{"harf":"E","metin":"31","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"34 − 29 = 5"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 29 + (n − 1)·5"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"184 = 29 + (n − 1)·5 → n = 32"},{"aciklama":"Terimin sırası:","ifade":"32"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.325,"gorsel":null},{"kimlik":"ff7bfbcb39dd","sablon":"veri.tablo.sutun_yuzde_degisim","govde":"Bir kulübün dört şehirdeki şubelerinin 2024 ve 2025 yıllarındaki üye sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Bursa'da üye sayısı 2024'ten 2025'e yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%80","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%75","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"%25","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bursa satırındaki iki değeri oku:","ifade":"2024: 320 · 2025: 400"},{"aciklama":"Artış miktarını bul:","ifade":"400 − 320 = 80"},{"aciklama":"Artış oranı **eski** değere bölünür, yeniye değil:","ifade":"80/320 × 100"},{"aciklama":"Artış oranı:","ifade":"%25"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.254,"gorsel":{"tur":"tablo","baslik":"Yıllara göre üye sayısı (kişi)","etiketler":["2024","2025"],"birim":"kişi","seriler":[{"ad":"Konya","degerler":[80,140]},{"ad":"Trabzon","degerler":[300,420]},{"ad":"Samsun","degerler":[200,290]},{"ad":"Bursa","degerler":[320,400]}]}},{"kimlik":"14917720230c","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Antalya'ya giderken yolun ilk bölümünü saatte 40 km hızla 3 saatte, kalan bölümünü saatte 120 km hızla 1 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"320 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"B","metin":"120 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"240 km","dogru":true,"yanilgi":null},{"harf":"D","metin":"160 km","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"E","metin":"400 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"40 × 3 = 120 km"},{"aciklama":"İkinci bölüm:","ifade":"120 × 1 = 120 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"120 + 120 = 240 km"},{"aciklama":"Toplam yol:","ifade":"240 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.079,"gorsel":null},{"kimlik":"659d7c8f401e","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 252 cm ve 56 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"308 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"11 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"14 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"},{"harf":"D","metin":"504 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"28 cm","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"252 = 28·9   ve   56 = 28·2"},{"aciklama":"Ortak çarpan 28; kalan çarpanlar (9 ve 2) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(252, 56) = 28"},{"aciklama":"En büyük parça uzunluğu:","ifade":"28 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"03ebbbfc7a4b","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Samsun şubesindeki personel sayısı, toplam 400 personelin yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%10","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"%95","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%50","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"%5","dogru":true,"yanilgi":null},{"harf":"E","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Samsun şubesinin personel sayısı:","ifade":"20"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam personel.","ifade":"400"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"20 / 400 × 100 = %5"},{"aciklama":"Toplam içindeki pay:","ifade":"%5"}],"mikrobeceriler":["veri.yuzde_pay","veri.tablo","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.643,"gorsel":{"tur":"tablo","baslik":"Şubelere göre personel sayısı","etiketler":["Antalya","İzmir","Bursa","Samsun"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[200,140,40,20]}]}},{"kimlik":"9f15cdbd6c76","sablon":"oran.ters.isci_gun","govde":"Bir inşaat işini 8 işçi 10 günde bitirmektedir. Aynı işi, aynı hızda çalışan 4 işçi kaç günde bitirir?","secenekler":[{"harf":"A","metin":"20 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"14 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"C","metin":"80 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"6 gün","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"E","metin":"5 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"İşçi sayısı ile süre ters orantılıdır; çarpımları toplam iş yükünü verir:","ifade":"8 × 10 = 80 işçi-gün"},{"aciklama":"Aynı iş yükü 4 işçiye bölündüğünde süre:","ifade":"80 / 4 = 20 gün"},{"aciklama":"İşin biteceği süre:","ifade":"20 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.229,"gorsel":null},{"kimlik":"522b293a8449","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, tanesini 800 TL maliyetle aldığı bir tablet çeşidini %45 kârla satmaktadır. Buna göre tabletin satış fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.160 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"845 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"440 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"36.800 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"E","metin":"360 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kâr yüzdesi her zaman maliyet üzerinden hesaplanır:","ifade":"800 × 45/100 = 360 TL"},{"aciklama":"Satış fiyatı maliyet ile kârın 