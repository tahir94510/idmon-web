ne_fark"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"2.300 × 40/100 = 920 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"4.000 × 10/100 = 400 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"920 − 400 = 520 TL"},{"aciklama":"Net kâr:","ifade":"520 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.412,"gorsel":null},{"kimlik":"dfa368d7675c-1","sablon":"veri.blok.tablo_iki_soru","govde":"İzmir şubesinin satışı, toplam satışın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%12","dogru":true,"yanilgi":null},{"harf":"B","metin":"%30","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%88","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"%19","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"İzmir şubesinin satışını tablodan oku:","ifade":"72 adet"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam satış.","ifade":"600 adet"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"72 / 600 × 100 = %12"},{"aciklama":"Toplam içindeki pay:","ifade":"%12"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.719,"gorsel":{"tur":"tablo","baslik":"Şubelere göre aylık satış","etiketler":["Bursa","Samsun","Antalya","İzmir"],"birim":"adet","seriler":[{"ad":"Satış","degerler":[240,174,114,72]}]},"grup":"dfa368d7675c","grup_govde":"Bir şirketin dört şubesinin bir aylık satış adetleri yukarıdaki tabloda verilmiştir. Şubelerin toplam satışı 600 adettir."},{"kimlik":"dfa368d7675c-2","sablon":"veri.blok.tablo_iki_soru","govde":"Dört şubenin satış ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"600 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"150 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"24