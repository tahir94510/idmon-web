"},{"harf":"E","metin":"256 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/160 + 1/96 = 8/480"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"480/8 = 60 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"60 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.005,"gorsel":null,"grup":"068003308b5b","grup_govde":"Bir işi Merve tek başına 160 günde, Deniz tek başına 96 günde bitirmektedir."},{"kimlik":"068003308b5b-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Merve işe başlayıp 40 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Deniz tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"24 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"128 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"256 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"96 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"E","metin":"72 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Merve bir günde işin 1/160'ını yapıyor; 40 gün çalışınca yaptığı iş:","ifade":"40/160"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(160 − 40)/160 = 3/4"},{"aciklama":"Deniz işin tamamını 96 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"3/4 × 96 = 72"},{"aciklama":"Kalan iş için gereken süre:","ifade":"72 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.131,"gorsel":null,"grup":"068003308b5b","grup_govde":"Bir işi Merve tek başına 160 günde, Deniz tek başına 96 günde bitirmektedir."},{"kimlik":"cba3813ec48c","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre iki ürünün toplam satışının en yüksek olduğu ay için bu toplam kaç a