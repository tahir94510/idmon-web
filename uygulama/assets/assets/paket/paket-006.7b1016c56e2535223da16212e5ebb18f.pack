anımı sağlar:","ifade":"(32·65 + n·50) / (32 + n) = 60"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"32·(65 − 60) = n·(60 − 50)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"16 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.218,"gorsel":null},{"kimlik":"ceecc8e0259f","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 1.998 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"22.200","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"2.220","dogru":true,"yanilgi":null},{"harf":"C","metin":"232","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"D","metin":"1.998","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"E","metin":"222","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 1.998"},{"aciklama":"İlk sayı:","ifade":"x = 1.998 / 9 = 222"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 222 = 2.220"},{"aciklama":"Yeni sayı:","ifade":"2.220"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-1.399,"gorsel":null},{"kimlik":"fca2b6b2a6c0","sablon":"veri.ortalama.medyan_tek","govde":"114, 142, 122, 118, 176, 148, 12, 152, 186 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"176","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"B","metin":"142","dogru":true,"yanilgi":null},{"harf":"C","metin":"148","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"130","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"99","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifa