,{"aciklama":"Ortalama hız:","ifade":"33,18 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"f6a7cdf549c8","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört şubede satılan toplam Telefon sayısı, toplam Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"135 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"430 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"210 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"515 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"320 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Soru tek bir şube değil, dördünün toplamını istiyor. Önce Telefon sütunlarını topla:","ifade":"75 + 160 + 170 + 110 = 515"},{"aciklama":"Sonra Tablet sütunlarını topla:","ifade":"25 + 25 + 50 + 95 = 195"},{"aciklama":"İki toplamın farkını al:","ifade":"515 − 195 = 320"},{"aciklama":"Aradaki fark:","ifade":"320 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.154,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[75,160,170,110]},{"ad":"Tablet","degerler":[25,25,50,95]}]}},{"kimlik":"6538eaef04bb","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/800.000 olan bir haritada Samsun ile İzmir arasındaki uzaklık 24 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"192 km","dogru":true,"yanilgi":null},{"harf":"B","metin":"32 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"C","metin":"19,2 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"24 km","dogru":false,"yanilgi":"sorulani_d