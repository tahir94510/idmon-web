ı:","ifade":"24"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.048,"gorsel":null},{"kimlik":"ef31fb78d1c3","sablon":"problem.isci.birlikte","govde":"Bir işi Onur tek başına 99 günde, Kaan tek başına 22 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"22 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"B","metin":"121 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"60,5 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"18 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"77 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/99 + 1/22 = 121/2178"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"2178/121 = 18 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"18 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.092,"gorsel":null},{"kimlik":"aac60124cd13","sablon":"veri.grafik.sutun_ortalama","govde":"Bir işletmenin dört ayda sattığı Kitap sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"160 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"90 adet","dogru":false,"yanilgi":"ortalama_uc_degerlerden"},{"harf":"C","metin":"84 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"D","metin":"140 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"105 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Dört sütunun değerlerini topla:","ifade":"160 + 110 + 20 + 130 = 420"},{"aciklama":"Ortalama, toplamın sütun sayısına bölümüdür:","ifade":"420 / 4 = 105"},{"aciklama":"Ortalama satış:","ifade":"105 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":{"tur":"