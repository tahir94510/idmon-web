lasilik_bagimsiz_sanildi"},{"harf":"D","metin":"15/13","dogru":false,"yanilgi":"olasilik_toplam_bir_asildi"},{"harf":"E","metin":"21/65","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Birinci topun siyah olma olasılığı:","ifade":"15/26"},{"aciklama":"Top geri konulmadığı için ikinci çekilişte hem torbadaki toplam hem siyah sayısı birer azalır:","ifade":"14/25"},{"aciklama":"Peş peşe gerçekleşen olayların olasılıkları çarpılır:","ifade":"15/26 × 14/25 = 210/650 = 21/65"},{"aciklama":"İstenen olasılık:","ifade":"21/65"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":[],"zorluk":2.793,"gorsel":null},{"kimlik":"c72431cf94b6","sablon":"mantik.sifreleme.artan_kaydirma","govde":"Bir şifrelemede HALI kelimesi MGŞP biçiminde yazılmaktadır. Aynı kurala göre KUTU kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"RÇÇE","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"B","metin":"PCCD","dogru":true,"yanilgi":null},{"harf":"C","metin":"ŞÇBB","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"D","metin":"PBAB","dogru":false,"yanilgi":"sifreleme_sabit_kaydirma"},{"harf":"E","metin":"GOMM","dogru":false,"yanilgi":"sifreleme_yonu_ters"}],"cozum":[{"aciklama":"Örnekteki harfleri tek tek karşılaştır ve her harfin alfabede kaç sıra ilerlediğini yaz:","ifade":"H→M (6) , A→G (7) , L→Ş (8) , I→P (9)"},{"aciklama":"Kaydırma sabit değil; her harfte bir artıyor:","ifade":"6, 7, 8, 9"},{"aciklama":"Aynı kaydırmaları KUTU kelimesine uygula:","ifade":"K→P , U→C , T→C , U→D"},{"aciklama":"Şifrelenmiş kelime:","ifade":"PCCD"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"ccaa328d6862","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 2, onlar basamağındaki rakam 3'tür. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"132","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"204","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"C","metin":"21","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"D","metin":"231","dogru":true,"yanilgi":null},{"harf":"E","metin":"213","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (2 − b) = 99 ⟹ 2 − b = 1 ⟹ b = 1"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 2 + 10 × 3 + 1 = 231"},{"aciklama":"Aranan sayı:","ifade":"231"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"b29a8cb97d6d","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 4 kişinin yaş ortalaması 59. Gruba bir kişi daha katılınca ortalama 63'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"75","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"63","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"61","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"79","dogru":true,"yanilgi":null},{"harf":"E","metin":"16","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"4 × 59 = 236"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"5 × 63 = 315"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"315 − 236 = 79"},{"aciklama":"Katılan kişinin yaşı:","ifade":"79"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.149,"gorsel":null},{"kimlik":"3e94eb1dea7d","sablon":"problem.sayi.ardisik_tek_cift","govde":"Ardışık 6 sayının toplamı 39'dur.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"13","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"8","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"C","metin":"6,5","dogru":false,"yanilgi":"ardisik_ortalama_terim_sayisi"},{"harf":"D","metin":"4","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"9","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"6 ardışık sayının toplamı, ortadaki iki sayının ortalamasının terim sayısıyla çarpımıdır.","ifade":null},{"aciklama":"Sayıları yaz:","ifade":"4 + 5 + 6 + 7 + 8 + 9 = 39"},{"aciklama":"En büyüğü seç:","ifade":"9"},{"aciklama":"En büyük sayı:","ifade":"9"}],"mikrobeceriler":["problem.sayi"],"yanilgi_alanlari":["sayilar.ardisik","veri.ortalama"],"zorluk":0.906,"gorsel":null},{"kimlik":"a7d43e57e8b2","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Elif, Fatma ve Serkan arasında sırasıyla 2, 9 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 19.200 TL olduğuna göre, Elif'in payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"17.600 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"6.400 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"800 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"D","metin":"12.800 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"1.600 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 9 + 13 = 24"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"19.200 / 24 = 800 TL"},{"aciklama":"Elif bu paylardan 2 tane alır:","ifade":"2 × 800 = 1.600 TL"},{"aciklama":"Elif'in payı:","ifade":"1.600 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.575,"gorsel":null},{"kimlik":"864384b066fe","sablon":"yuzde.faiz.anapara","govde":"Yıllık %24 basit faiz oranıyla 15 ay vadeye yatırılan bir anapara 2.880 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","m