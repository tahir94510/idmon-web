"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"ee483ec8b1b7","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört şubede sattığı Telefon sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre B şubesinde satılan Telefon sayısı, dört şubede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%100","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"%45","dogru":true,"yanilgi":null},{"harf":"C","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"%450","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"%55","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"350 + 450 + 150 + 50 = 1.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"450 / 1.000 × 100 = %45"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%45"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":{"tur":"sutun","baslik":"Telefon satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[350,450,150,50]}]}},{"kimlik":"7ccbb36900a4","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(9/13 + 5/9) : 7/12 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"24/13","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"64/273","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"511/702","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"D","metin":"12/11","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"584/273","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 9) = 117"},{"aciklama":"Her kesri, paydası 117 olacak biçimde genişlet:","ifade":"9/13 = 81/1