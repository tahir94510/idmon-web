fade":"1.000 − 200 = 800 adet"},{"aciklama":"Yüzde artış, artışın **eski** değere oranıdır:","ifade":"800 / 200 × 100 = %400"},{"aciklama":"Artış oranı:","ifade":"%400"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":3.875,"gorsel":null},{"kimlik":"4ca3d948f880","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|3x − 23| < 88 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"60","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"B","metin":"29","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"43","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"57","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"E","metin":"58","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"|A| < 88 eşitsizliği, A'nın −88 ile 88 arasında olması demektir:","ifade":"−88 < 3x − 23 < 88"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−65/3 < x < 37"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"58 tane"},{"aciklama":"Tam sayı adedi:","ifade":"58"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.665,"gorsel":null},{"kimlik":"0c77fd1a75a4","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n44, 45, 49, 58, 74, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"74","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"98","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"C","metin":"99","dogru":true,"yanilgi":null},{"harf":"D","metin":"79","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"90","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"1, 4, 9, 16"},{"aciklama":"Farklar ardışık sayıların **kareleri**: 1², 2², 3², 4². Sıradaki fark 5²:","ifade":"25"},{"aciklama":"Son terime bu farkı ekle:","ifade":"74 + 25 = 99"},{"aciklama":"Sıradaki terim:","ifade":"99"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.346,"gorsel":null},{"kimlik":"64ec154a2ff7","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 84 km sabit hızla yola çıkmıştır. 1 saat sonra aynı noktadan aynı yöne, saatte 96 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"7/8 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"14/15 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"84 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"7 saat","dogru":true,"yanilgi":null},{"harf":"E","metin":"7/15 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"84 × 1 = 84 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"96 − 84 = 12 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"84 / 12 = 7"},{"aciklama":"Yetişme süresi:","ifade":"7 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"0d6fbfbba167","sablon":"veri.grafik.sutun_fark","govde":"Bir işletmenin dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Ağustos ayında satılan Bisiklet sayısı, aynı ayda satılan Scooter sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"250 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"125 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"90 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"255 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"15 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Önce sorunun istediği ay işaretle: Ağustos.","i