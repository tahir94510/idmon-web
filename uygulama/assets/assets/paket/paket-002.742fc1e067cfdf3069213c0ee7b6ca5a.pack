:"45 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"20 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"16 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"13 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"4 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"4·80 + n·35"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(4·80 + n·35) / (4 + n) = 44"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"4·(80 − 44) = n·(44 − 35)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"16 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.218,"gorsel":null},{"kimlik":"f925d64f967b","sablon":"sayilar.rasyonel.islem_onceligi","govde":"9 + 2/11 × 5/6 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"302/33","dogru":true,"yanilgi":null},{"harf":"B","metin":"505/66","dogru":false,"yanilgi":"islem_onceligi_toplama_once"},{"harf":"C","metin":"292/33","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"507/55","dogru":false,"yanilgi":"kesir_carpimda_ters_cevrildi"},{"harf":"E","metin":"109/11","dogru":false,"yanilgi":"kesir_carpimda_payda_carpilmadi"}],"cozum":[{"aciklama":"İşlem önceliği: çarpma toplamadan önce yapılır.","ifade":null},{"aciklama":"Kesirlerin çarpımında paylar payla, paydalar paydayla çarpılır:","ifade":"2/11 × 5/6 = 10/66 = 5/33"},{"aciklama":"Tam sayıyı ekle:","ifade":"9 + 5/33 = 302/33"},{"aciklama":"İşlemin sonucu:","ifade":"302/33"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.356,"gorsel":null},{"kimlik":"2a5b9ce7b4c5","sablon":"oran.temel.oran_ve_fark","govde":"Deniz'in parasının Kaan'ın parasına oranı 10/9'dur. Aralarındaki fark 380 TL olduğuna göre Deniz kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"200 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"B","metin":"3.800 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"380 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"7.220 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"3.420 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Deniz 10k, Kaan 9k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"10k − 9k = 1k = 380"},{"aciklama":"Birim payı bul:","ifade":"k = 380 / 1 = 380"},{"aciklama":"Deniz için:","ifade":"10 × 380 = 3.800"},{"aciklama":"Deniz'in parası:","ifade":"3.800 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.082,"gorsel":null},{"kimlik":"6611b184b41a","sablon":"yuzde.faiz.getiri_farki","govde":"7.000 TL, yıllık %30 faizle 8 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %18 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"12 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"840 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"560 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"105 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"1.400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"30 − 18 = 12 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"12/100 × 8/12"},{"aciklama":"Anaparayla çarp:","ifade":"7.000 × 12/100 × 8/12 = 560 TL"},{"aciklama":"Getiri farkı:","ifade":"560 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.746,"gorsel":null},{"kimlik":"14e6497b26dd","sablon":"veri.ortalama.medyan_tek","govde":"18, 144, 192, 30, 190, 174, 134 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"144","dogru":true,"yanilgi":null},{"harf":"B","metin":"174","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"126","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"105","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"30","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"18 < 30 < 134 < 144 < 174 < 190 < 192"},{"aciklama":"Terim sayısı 7, yani tek: ortada tek bir terim var.","ifade":"7 → 4. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"144"},{"aciklama":"Ortanca:","ifade":"144"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.413,"gorsel":null},{"kimlik":"e74e92733595","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 7/12 katı ile 1/6 katı arasındaki fark 20'dir.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"45","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"B","metin":"80/3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"40","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"D","metin":"48","dogru":true,"yanilgi":null},{"harf":"E","metin":"25/3","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(7/12 − 1/6) · x = 20"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(12, 6) = 12"},{"aciklama":"Her kesri, paydası 12 olacak biçimde genişlet:","ifade":"7/12  (paydası zaten 12)\n1/6 = 2/12  (payı da paydayı da 2 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"7/12 − 2/12 = 5/12"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 20 × 12/5 = 48"},{"aciklama":"Aranan sayı:","ifade":"48"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.048,"gorsel":null},{"kimlik":"72a2caa7f4a8","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 7 kişinin yaş ortalaması 65. Gruba bir kişi daha katılınca ortalama 69'a çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"93","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"67","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"28","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"97","dogru":true,"yanilgi":null},{"harf":"E","metin":"69","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"7 × 65 = 455"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"8 × 69 = 552"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"552 − 455 = 97"},{"aciklama":"Katılan kişinin yaşı:","ifade":"97"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.295,"gorsel":null},{"kimlik":"84f27f39d54e","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|4x + y + 5| + z = 8\n|2x − y + 19| = 2z − 16\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"12","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"−26","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"7","dogru":true,"yanilgi":null},{"harf":"E","metin":"19","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 8 − |…| ≤ 8"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 16 ≥ 0 , yani z ≥ 8"},{"aciklama":"İkisi birlikte:","ifade":"z = 8"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"4x + y = −5 , 2x − y = −19"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = −4 , y = 11"},{"aciklama":"İstenen toplam, x + y:","ifade":"7"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"5eba020a8f2e","sablon":"mantik.dizi.artan_fark","govde":"4, 6, 11, 19, 30, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"41","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"B","metin":"32","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"43","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"D","metin":"44","dogru":true,"yanilgi":null},{"harf":"E","metin":"30","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"6−4=2 , 11−6=5 , 19−11=8 , 30−19=11"},{"aciklama":"Farklar sabit değil; her adımda 3 artıyor. Sıradaki fark:","ifade":"11 + 3 = 14"},{"aciklama":"Son terime bu farkı ekle:","ifade":"30 + 14 = 44"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"44"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"616817dd069c","sablon":"problem.sayi.verme_alma","govde":"Mustafa, Emre'ye defterlerinin 12 tanesini verirse ikisinin defter sayıları eşit olmaktadır. Emre, Mustafa'ya defterlerinin 11 tanesini verirse Mustafa'nın defter sayısı Emre'ninkinin 2 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç defteri vardır?","secenekler":[{"harf":"A","metin":"94","dogru":false,"yanilgi":"verme_tek_taraf"},{"harf":"B","metin":"102","dogru":false,"yanilgi":"verme_farki_tek_sayildi"},{"harf":"C","metin":"69","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"138","dogru":true,"yanilgi":null},{"harf":"E","metin":"81","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Mustafa 12 tane verince kendisi 12 azalır, Emre 12 artar: aradaki fark 24 kapanır. Eşitlendiklerine göre baştaki fark 24'tür.","ifade":null},{"aciklama":"Emre'nin sayısına x dersek Mustafa'nınki x + 24 olur. İkinci koşulda Emre 11 tane verir, Mustafa 11 tane alır:","ifade":"x + 24 + 11 = 2·(x − 11)"},{"aciklama":"Denklemi çöz:","ifade":"x = 57"},{"aciklama":"Toplam x + (x + 24) olduğuna göre:","ifade":"138"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"aa5bd78a778a","sablon":"oran.temel.oran_ve_toplam","govde":"Ahmet'in parasının Serkan'ın parasına oranı 15/14'tür. İkisinin parası toplam 9.280 TL olduğuna göre Ahmet kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"4.800 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"320 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"139.200 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"D","metin":"4.640 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"4.480 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Ahmet 15k, Serkan 14k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"15k + 14k = 29k = 9.280"},{"aciklama":"Birim payı bul:","ifade":"k = 9.280 / 29 = 320"},{"aciklama":"Ahmet için:","ifade":"15 × 320 = 4.800"},{"aciklama":"Ahmet'in parası:","ifade":"4.800 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.296,"gorsel":null},{"kimlik":"d113d7922976","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 4.000 TL olan bir tablet %40 kârla, maliyeti 3.900 TL olan bir halı ise %20 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.380 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"1.580 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"820 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.600 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"20 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"4.000 × 40/100 = 1.600 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"3.900 × 20/100 = 780 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"1.600 − 780 = 820 TL"},{"aciklama":"Net kâr:","ifade":"820 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.67,"gorsel":null},{"kimlik":"9bf6514882c0","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Eskişehir'in Kış satışı silinmiş, yerine 0 yazılmıştır. Eskişehir satırının gerçek yıllık toplamı 660 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"250 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"165 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"190 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"1.235 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"85 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Eskişehir satırında görünen üç değeri topla:","ifade":"165 + 205 + 205 = 575"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"660 − 575 = 85"},{"aciklama":"Silinen değer:","ifade":"85 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.732,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Ankara","degerler":[290,235,20,165]},{"ad":"Eskişehir","degerler":[165,205,205,0]},{"ad":"Antalya","degerler":[205,345,220,190]},{"ad":"Bursa","degerler":[90,275,260,265]}]}},{"kimlik":"c358abe994f8","sablon":"sayilar.rasyonel.toplama","govde":"9/13 + 1/9 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"5/11","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"B","metin":"68/117","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"22/13","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"D","metin":"94/117","dogru":true,"yanilgi":null},{"harf":"E","metin":"10/13","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 9) = 117"},{"aciklama":"Her kesri, paydası 117 olacak biçimde genişlet:","ifade":"9/13 = 81/117  (payı da paydayı da 9 ile çarptık)\n1/9 = 13/117  (payı da paydayı da 13 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"81/117 + 13/117 = 94/117"},{"aciklama":"İşlemin sonucu:","ifade":"94/117"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.14,"gorsel":null},{"kimlik":"f89234969251","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"45 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"375 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"125 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"250 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"75 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"Eskişehir: 150 − 85 = 65 · Konya: 250 − 125 = 125 · İzmir: 135 − 60 = 75 · Antalya: 380 − 335 = 45"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Konya, 125 adet"},{"aciklama":"En büyük artış:","ifade":"125 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":-0.145,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[85,85,150,125]},{"ad":"Konya","degerler":[125,40,250,20]},{"ad":"İzmir","degerler":[60,255,135,150]},{"ad":"Antalya","degerler":[335,185,380,90]}]}},{"kimlik":"db25cc8f2f98","sablon":"kume.temel.uc_kume","govde":"Bir sınıftaki 75 öğrenciden 45 tanesi satranç, 34 tanesi münazara, 35 tanesi müzik kulübüne üyedir. Satranç ve münazara kulüplerinin ikisine birden 26, satranç ve müzik kulüplerine 26, münazara ve müzik kulüplerine 16 öğrenci üyedir. Üç kulübe birden üye olan öğrenci sayısı 14'tür. Buna göre en az bir kulübe üye olan kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"15","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"B","metin":"46","dogru":false,"yanilgi":"kume_uc_kume_kesisim"},{"harf":"C","metin":"114","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"60","dogru":true,"yanilgi":null},{"harf":"E","metin":"20","dogru":false,"yanilgi":"kume_yalnizca_biri"}],"cozum":[{"aciklama":"İçler-dışlar ilkesi: tekli toplamlardan ikili kesişimler düşülür, üçlü kesişim geri eklenir.","ifade":"|A∪B∪C| = |A|+|B|+|C| − |A∩B| − |A∩C| − |B∩C| + |A∩B∩C|"},{"aciklama":"Değerleri yerine koy:","ifade":"45 + 34 + 35 − 26 − 26 − 16 + 14 = 60"},{"aciklama":"Sınıf mevcudu bu hesaba girmez; geri kalan 15 öğrenci hiçbir kulübe üye değildir.","ifade":null},{"aciklama":"En az bir kulübe üye olan öğrenci sayısı:","ifade":"60"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":2.824,"gorsel":null},{"kimlik":"f4d8b069a006","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 6 : 8 : 4 oranındadır. İkinci arkadaşın parası 368 TL olduğuna göre üçüncü arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"736 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"276 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"46 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"184 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"4 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"6k : 8k : 4k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"8k = 368 → k = 46"},{"aciklama":"Sorulan payı k ile çarp (üçüncü arkadaş):","ifade":"4 × 46 = 184"},{"aciklama":"Üçüncü arkadaşın parası:","ifade":"184 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.14,"gorsel":null},{"kimlik":"3e9c9c40bf15","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 1.140 TL olan bir sırt çantası 1.425 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%25","dogru":true,"yanilgi":null},{"harf":"B","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%80","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"%125","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"%285","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"1.425 TL − 1.140 TL = 285 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"285 / 1.140 × 100 = 25"},{"aciklama":"Kâr oranı:","ifade":"%25"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"94aa73169ef8","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"220 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"26 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"240 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"245 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"125 adet","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Bursa: 240/30 · Antalya: 220/26 · Samsun: 125/42 · Trabzon: 245/40"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Antalya satırında:","ifade":"220/26"},{"aciklama":"O satırın satış sayısı:","ifade":"220 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.313,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Bursa","degerler":[240,30]},{"ad":"Antalya","degerler":[220,26]},{"ad":"Samsun","degerler":[125,42]},{"ad":"Trabzon","degerler":[245,40]}]}},{"kimlik":"70511cbee2b1","sablon":"sayilar.uslu.negatif_us","govde":"(4⁻⁵)⁴ · 4⁸ işleminin sonucu, 4 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−1","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"B","metin":"28","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"C","metin":"12","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−12","dogru":true,"yanilgi":null},{"harf":"E","metin":"−160","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(4⁻⁵)⁴ = 4⁻²⁰"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"4⁻²⁰ · 4⁸ = 4⁻¹²"},{"aciklama":"Aranan kuvvet:","ifade":"−12"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.526,"gorsel":null},{"kimlik":"6bb6200a3a6f","sablon":"mantik.dizi.carpansal","govde":"2, 4, 8, 16, 32, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenek