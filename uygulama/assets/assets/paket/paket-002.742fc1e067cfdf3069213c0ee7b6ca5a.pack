yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"62","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"83","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"11 × 55 + 44 × 90 = 4.565"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"11 + 44 = 55"},{"aciklama":"Sınıf ortalaması:","ifade":"4.565 / 55 = 83"},{"aciklama":"Sınıfın ortalaması:","ifade":"83"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"517a2e38962e","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 15| = 30 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"15","dogru":true,"yanilgi":null},{"harf":"B","metin":"22,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"−7,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"30","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"−15","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değer 30'a eşitse içerideki ifade 30 ya da −30 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 15 = 30 ⟹ x = 22,5"},{"aciklama":"İkinci durum:","ifade":"2x − 15 = −30 ⟹ x = −7,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"22,5 + (−7,5) = 2 × 15 / 2 = 15"},{"aciklama":"Köklerin toplamı:","ifade":"15"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"9197ef0e91cc","sablon":"veri.ortalama.eksik_terim","govde":"6 öğrencinin sınav notu ortalaması 61. Öğrencilerden 5'i sırasıyla 66, 31, 72, 62 ve 94 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"41","dogru":true,"yanilgi":null},{"harf":"B","metin":"325","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"102","dogru":false,"yanilgi":"ortalama_eksik_terim"},