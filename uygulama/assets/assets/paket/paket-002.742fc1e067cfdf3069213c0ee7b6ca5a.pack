ru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"30 dakika","dogru":true,"yanilgi":null},{"harf":"D","metin":"6 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"180 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"6 ve 30 sayılarının EKOK'u:","ifade":"EKOK(6, 30) = 30"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"30 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.495,"gorsel":null},{"kimlik":"e2ef44e67c64","sablon":"mantik.dizi.ikili_orgu","govde":"8, 24, 14, 18, 20, 12, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"6","dogru":false,"yanilgi":"dizi_yanlis_altdizi"},{"harf":"B","metin":"26","dogru":true,"yanilgi":null},{"harf":"C","metin":"32","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"14","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"E","metin":"4","dogru":false,"yanilgi":"dizi_kurali_eksik"}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 6 artıyor:","ifade":"8, 14, 20"},{"aciklama":"Çift sıradakiler −6 değişiyor:","ifade":"24, 18, 12"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"20 + 6 = 26"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"26"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.247,"gorsel":null},{"kimlik":"f880946d3452","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Antalya ile Trabzon arasındaki yolu giderken 80 km/sa, dönerken 48 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"64 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"B","metin":"80 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"C","metin":"128 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"D","metin":"30 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"E","metin":"60 km/sa","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/80 + x/48 = x·(128)/(80·48)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·128/(80·48)] = 2·80·48/128 = 60 km/sa"},{"aciklama":"Ortalama hız:","ifade":"60 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.47,"gorsel":null},{"kimlik":"5da79ec3c59b","sablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Öykü dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"90 derece","dogru":true,"yanilgi":null},{"harf":"B","metin":"18 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"25 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"D","metin":"270 derece","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"45 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Öykü diliminin payı:","ifade":"%25"},{"aciklama":"Merkez açısı:","ifade":"360 × 25 / 100 = 90"},{"aciklama":"Merkez açısı:","ifade":"90 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.187,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Roman","Şiir","Deneme","Öykü"],"birim":"%","seriler":[{"ad":"Pay","degerler":[5,55,15,25]}]}},{"kimlik":"69fa37a14fcd","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/600.000 olan bir haritada Konya ile Ankara 