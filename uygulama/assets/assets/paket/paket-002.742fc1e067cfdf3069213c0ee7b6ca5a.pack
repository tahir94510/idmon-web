rf":"D","metin":"1.260 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"5.880 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Yusuf 11k, Elif 3k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"11k − 3k = 8k = 3.360"},{"aciklama":"Birim payı bul:","ifade":"k = 3.360 / 8 = 420"},{"aciklama":"Yusuf için:","ifade":"11 × 420 = 4.620"},{"aciklama":"Yusuf'un parası:","ifade":"4.620 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.321,"gorsel":null},{"kimlik":"d6725fc40cf3-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Deniz'in payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"360 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"3.600 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"4.320 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"32.400 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"3.240 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"5 + 10 + 12 = 27"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"9.720 / 27 = 360 TL"},{"aciklama":"Deniz bu paylardan 10 tane alır:","ifade":"10 × 360 = 3.600 TL"},{"aciklama":"Deniz'in payı:","ifade":"3.600 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.448,"gorsel":null,"grup":"d6725fc40cf3","grup_govde":"Bir ikramiye Burak, Deniz ve Selin arasında sırasıyla 5, 10 ve 12 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 9.720 TL'dir."},{"kimlik":"d6725fc40cf3-2","sablon":"oran.blok.paylastirma_uc_soru","govde":"Selin'in payı, Burak'ın payından kaç TL fazladır?","secenekler":[{"harf":"A","metin":"360 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"6.120 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"3.240 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"2.520 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"4.320 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"5 + 10 + 12 = 27"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"9.720 / 27 = 360 TL"},{"aciklama":"İki pay arasındaki fark, katsayı farkı kadar paydır:","ifade":"(12 − 5) × 360 = 2.520 TL"},{"aciklama":"Aradaki fark:","ifade":"2.520 TL"}],"mikrobeceriler":["oran.paylastirma"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.123,"gorsel":null,"grup":"d6725fc40cf3","grup_govde":"Bir ikramiye Burak, Deniz ve Selin arasında sırasıyla 5, 10 ve 12 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 9.720 TL'dir."},{"kimlik":"d6725fc40cf3-3","sablon":"oran.blok.paylastirma_uc_soru","govde":"Burak, kendi payının %10'unu bağışlamıştır. Buna göre Burak'ın elinde kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"8.748 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"3.888 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"1.980 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"1.620 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"180 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"5 + 10 + 12 = 27"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"9.720 / 27 = 360 TL"},{"aciklama":"Burak'ın payı:","ifade":"5 × 360 = 1.800 TL"},{"aciklama":"Bağıştan sonra kalan, payın %90'ıdır:","ifade":"1.800 × 90/100 = 1.620 TL"},{"aciklama":"Elinde kalan:","ifade":"1.620 TL"}],"mikrobeceriler":["oran.paylastirma","yuzde.temel"],"yanilgi_alan