.temel"],"zorluk":2.37,"gorsel":null},{"kimlik":"a2ae42848a03","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 5 kişinin yaş ortalaması 87. Gruba bir kişi daha katılınca ortalama 91'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"91","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"20","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"89","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"107","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"111","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"5 × 87 = 435"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"6 × 91 = 546"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"546 − 435 = 111"},{"aciklama":"Katılan kişinin yaşı:","ifade":"111"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"fc9a6f028459","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 4/x = 15 olduğuna göre x² + 4²/x² kaçtır?","secenekler":[{"harf":"A","metin":"209","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"233","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"225","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"221","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"E","metin":"217","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 4/x)² = x² + 2 · x · 4/x + 4²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 4 kalır:","ifade":"15² = x² + 4²/x² + 8"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 4²/x² = 225 − 8 = 217"},{"aciklama":"İstenen değer:","ifade":"217"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"db29a0de691e","sablon":"kume.olasilik.kume_uzerinden","govde":"Bir sınıftaki 61 öğrenci