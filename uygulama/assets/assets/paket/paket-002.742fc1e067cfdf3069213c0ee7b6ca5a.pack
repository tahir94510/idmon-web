lan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"13 × 7 + 3 = 91 + 3 = 94"},{"aciklama":"Kalan (3) bölenden (13) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"94"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.972,"gorsel":null},{"kimlik":"631ff03f96de","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|4x + 3y − 65| + z = 8\n|2x − y − 5| = 2z − 16\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"−20","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"30","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"23","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"E","metin":"19","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 8 − |…| ≤ 8"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 16 ≥ 0 , yani z ≥ 8"},{"aciklama":"İkisi birlikte:","ifade":"z = 8"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"4x + 3y = 65 , 2x − y = 5"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 8 , y = 11"},{"aciklama":"İstenen toplam, x + y:","ifade":"19"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"e8e6a022ac7b","sablon":"oran.ters.uc_makine","govde":"Bir iş 5 işçiyle 24 günde, 3 işçiyle 40 günde bitmektedir. Aynı iş 10 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"48 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"32 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"},{"harf":"C","metin":"19 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"D","metin":"12 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"1,2 gün","dogru":false,"yanilgi":"ters_orantida_c