"aciklama":"İkisini topla:","ifade":"60 + 2 = 62"},{"aciklama":"Aranan toplam:","ifade":"62"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.448,"gorsel":null},{"kimlik":"012dc5f77b4f","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 87 km sabit hızla yola çıkmıştır. 4 saat sonra aynı noktadan aynı yöne, saatte 116 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"3 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"12/7 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"C","metin":"24/7 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"348 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"12 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"87 × 4 = 348 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"116 − 87 = 29 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"348 / 29 = 12"},{"aciklama":"Yetişme süresi:","ifade":"12 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"8e238a2bbe00","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Bursa şubesindeki personel sayısı, toplam 1.700 personelin yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%30","dogru":true,"yanilgi":null},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"%70","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%20","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"%75","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Bursa şubesinin personel sayısı:","ifade":"510"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam personel.","ifade":"1.700"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"510 / 1.700 × 100 = %30"},{"aciklama":"Toplam içindeki pay:","ifade":"%30"}],"mikrobeceriler":["veri.yuzde_pay","veri.tablo","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Şubelere göre personel sayısı","etiketler":["Eskişehir","Bursa","Ankara","Konya"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[680,510,340,170]}]}},{"kimlik":"695f60185bf4","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 37, s(B) = 34 ve s(A ∪ B) = 55'tir. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"37","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"21","dogru":true,"yanilgi":null},{"harf":"C","metin":"16","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"D","metin":"39","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"18","dogru":false,"yanilgi":"kume_tumleyen_karisimi"}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 37 + 34 − 55 = 16"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"37 − 16 = 21"},{"aciklama":"s(A ∖ B):","ifade":"21"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"fa30b8439ba0","sablon":"oran.ters.musluk_havuz","govde":"Özdeş 4 musluk bir havuzu 30 saatte doldurmaktadır. Aynı havuz özdeş 12 muslukla kaç saatte dolar?","secenekler":[{"harf":"A","metin":"38 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"B","metin":"10 saat","dogru":true,"yanilgi":null},{"harf":"C","metin":"22 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"D","metin":"22,5 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"E","metin":"90 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"Musluk sayısı ile süre ters orantılıdır; çarpımları sabittir:","ifade":"4 × 30 = 120"},{"aciklama":"12 muslukta süre, bu sabitin musluk sayısına bölümüdür:","ifade":"120 / 12 = 10 saat"},{"aciklama":"Dolma süresi:","ifade":"10 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.44,"gorsel":null},{"kimlik":"6d40226e70db","sablon":"yuzde.temel.orandan_oran","govde":"Bir sayının %10'u 120'dir.\n\nBuna göre aynı sayının %60'ı kaçtır?","secenekler":[{"harf":"A","metin":"1.200","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"72","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"20","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"170","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"720","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayının %10'u biliniyorsa sayının kendisi bulunur:","ifade":"120 / (10/100) = 1.200"},{"aciklama":"Sayının %60'ı:","ifade":"1.200 × 60/100 = 720"},{"aciklama":"Aranan değer:","ifade":"720"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["oran.temel","yuzde.artis_azalis"],"zorluk":-0.193,"gorsel":null},{"kimlik":"bca7d3dfdcb8","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Ankara şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2017 yılından 2019 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"60 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"30 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"10 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"D","metin":"20 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"390 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktada