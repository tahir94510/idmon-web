ru":false,"yanilgi":"iki_kare_farki_toplam"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(75 − 59)(75 + 59) = 16 × 134"},{"aciklama":"Çarpımı yap:","ifade":"16 × 134 = 2.144"},{"aciklama":"İşlemin sonucu:","ifade":"2.144"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.14,"gorsel":null},{"kimlik":"d341157c0206","sablon":"veri.ortalama.medyan_tek","govde":"178, 22, 142, 132, 104, 126, 120, 72, 148 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"100","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"116","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"126","dogru":true,"yanilgi":null},{"harf":"D","metin":"132","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"104","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"22 < 72 < 104 < 120 < 126 < 132 < 142 < 148 < 178"},{"aciklama":"Terim sayısı 9, yani tek: ortada tek bir terim var.","ifade":"9 → 5. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"126"},{"aciklama":"Ortanca:","ifade":"126"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.267,"gorsel":null},{"kimlik":"ba19843f8445","sablon":"mantik.dizi.toplamsal","govde":"7, 39, 46, 85, 131, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"262","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"B","metin":"347","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"C","metin":"131","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"177","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"216","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"7 + 39 = 46"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"39 + 46 = 85"},{"aciklama":"Son iki terimi topla:","ifade":"85 + 131 = 216"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"216"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"9a0a43fe6850","sablon":"problem.karisim.birlestirme","govde":"Tuz oranı %35 olan 10 litre çözelti ile tuz oranı %8 olan 35 litre çözelti karıştırılıyor. Elde edilen karışımın tuz oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%14","dogru":true,"yanilgi":null},{"harf":"B","metin":"%21,5","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"%43","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"D","metin":"%29","dogru":false,"yanilgi":"karisim_agirlik_capraz"},{"harf":"E","metin":"%63","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"}],"cozum":[{"aciklama":"Önce her çözeltideki saf tuz miktarını bul:","ifade":"10·35/100 + 35·8/100 = 6,3 litre"},{"aciklama":"Karışımın toplam miktarı:","ifade":"10 + 35 = 45 litre"},{"aciklama":"Yeni oran, saf tuzun yeni toplam miktara bölümüdür:","ifade":"6,3 / 45 = %14"},{"aciklama":"Karışımın tuz oranı:","ifade":"%14"}],"mikrobeceriler":["problem.karisim","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":2.091,"gorsel":null},{"kimlik":"276972373769","sablon":"oran.temel.oran_ve_toplam","govde":"Selin'in parasının Kerem'in parasına oranı 9/5'tir. İkisinin parası toplam 6.160 TL olduğuna göre Selin kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"13.860 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"B","metin":"3.080 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"3.960 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.200 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"440 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanil