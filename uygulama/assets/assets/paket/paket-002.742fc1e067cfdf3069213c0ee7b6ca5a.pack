blem.isci.birlikte","govde":"Bir işi Yusuf tek başına 168 günde, Ahmet tek başına 24 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"24 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"B","metin":"144 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"C","metin":"96 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"21 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"192 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/168 + 1/24 = 192/4032"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"4032/192 = 21 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"21 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.503,"gorsel":null},{"kimlik":"cd43e3c86379","sablon":"sayilar.mutlak.kokler_toplami","govde":"|x − 41| = 37 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"82","dogru":true,"yanilgi":null},{"harf":"B","metin":"−82","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"4","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"74","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"78","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değer 37'ye eşitse içerideki ifade 37 ya da −37 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"x − 41 = 37 ⟹ x = 78"},{"aciklama":"İkinci durum:","ifade":"x − 41 = −37 ⟹ x = 4"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"78 + 4 = 2 × 41 = 82"},{"aciklama":"Köklerin toplamı:","ifade":"82"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.701,"gorsel":null},{"kimlik":"c8714306954d","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört bölgede sattığı Çay ve Kahve s