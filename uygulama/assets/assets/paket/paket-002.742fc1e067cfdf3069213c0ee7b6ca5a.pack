ından 2 eksiktir. 231'den büyük ilk böyle sayı:","ifade":"250"},{"aciklama":"Aranan sayı:","ifade":"250"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.178,"gorsel":null},{"kimlik":"31e7a1e3230d","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 580 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Voleybol tercih edenler, Yüzme tercih edenlerden kaç kişi fazladır?","secenekler":[{"harf":"A","metin":"464 kişi","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"1.160 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"116 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"203 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"20 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Dilimler yüzdedir; önce ikisinin yüzde farkını al:","ifade":"%50 − %30 = %20"},{"aciklama":"Yüzde farkını kişi sayısına çevir:","ifade":"580 × 20 / 100 = 116"},{"aciklama":"Aradaki fark:","ifade":"116 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.529,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"%","seriler":[{"ad":"Pay","degerler":[15,5,50,30]}]}},{"kimlik":"5f15f9d68dd7","sablon":"kume.sayma.iki_gruptan_secim","govde":"5 kadın ve 10 erkekten oluşan bir ekipten, 2 kadın ve 2 erkek içeren bir komite kurulacaktır. Bu komite kaç farklı biçimde kurulabilir?","secenekler":[{"harf":"A","metin":"450","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.365","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"C","metin":"1.800","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"D","metin":"55","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"E","metin":"825","dogru":false,"yanilgi":"sayma_tekrarli_secim"}],"cozum":[{"aciklama":"Komitede görev ayrımı yok; kimin önce seçildiği sonucu değiştirmez. Böyle sırasız seçimlere kombinasyon denir ve C(n, r) ile yazılır: n kişiden r kişiyi seçme sayısı.","ifade":null},{"aciklama":"Kadınları seç. 5 kişiden 2 kişi:","ifade":"C(5, 2) = (5×4) / (2×1) = 10"},{"aciklama":"Erkekleri seç. 10 kişiden 2 kişi:","ifade":"C(10, 2) = (10×9) / (2×1) = 45"},{"aciklama":"İki seçim peş peşe yapıldığı için sayılar çarpılır:","ifade":"10 × 45 = 450"},{"aciklama":"Farklı komite sayısı:","ifade":"450"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":1.24,"gorsel":null},{"kimlik":"3d5ae23c1ff8","sablon":"oran.dogru.birim_fiyat","govde":"Bir ürünün 3 litre için 60 TL ödenmektedir. Aynı üründen 20 litre alan biri kaç TL öder?","secenekler":[{"harf":"A","metin":"340 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"77 TL","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"C","metin":"460 TL","dogru":false,"yanilgi":"ikinci_alim_ek_sanildi"},{"harf":"D","metin":"400 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"9 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"}],"cozum":[{"aciklama":"Miktar ile tutar doğru orantılıdır; önce birim fiyat bulunur:","ifade":"60 / 3 = 20 TL"},{"aciklama":"20 litre için tutar, birim fiyatın 20 katıdır:","ifade":"20 × 20 = 400 TL"},{"aciklama":"Ödenecek tutar:","ifade":"400 TL"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.sayi"],"zorluk":-1.92,"gorsel":null},{"kimlik":"f3b41fae8278","sablon":"yuzde.ardisik.zam_indirim","govde":"Bir mağazada 4.900 TL olan halının fiyatına önce %60 zam yapılmış, ardından yeni fiyat üzerinden %75 indirim uygulanmıştır. Son fiyat kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.430 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"1.225 TL","dogru":false,"yanilgi":"ardisik_yuzde_tek_uygulama"},{"harf":"C","metin":"1.960 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"4.165 TL","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"E","metin":"7.840 TL","