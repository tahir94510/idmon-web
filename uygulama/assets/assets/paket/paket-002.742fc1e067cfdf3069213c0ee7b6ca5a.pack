","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"4.900 × 4/100 = 196 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"4.900 + 196 = 5.096 TL"},{"aciklama":"Zamlı fiyat:","ifade":"5.096 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.813,"gorsel":null},{"kimlik":"8888d320ea66","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 26| = 9 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"35","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"B","metin":"757","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"−595","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"17","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"E","metin":"595","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 26 + 9 = 35 ve x = 26 − 9 = 17"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(26 + 9) × (26 − 9) = 26² − 9² = 595"},{"aciklama":"Köklerin çarpımı:","ifade":"595"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.796,"gorsel":null},{"kimlik":"821b3b834236","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 19 kız öğrencinin matematik notu ortalaması 60, 16 erkek öğrencinin ortalaması ise 95'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"2.660","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"79","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"76","dogru":true,"yanilgi":null},{"harf":"D","metin":"77,5","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"140","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"19 × 60 + 16 × 95 = 2.660"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"19 + 16 = 35"},{"aciklama":"Sınıf ortalaması:","ifade":"2.660 / 35 = 76"},{"aciklama":"Sınıfın ortalaması:","ifade":"76"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"8c2589f55b8b","sablon":"kume.temel.hicbiri","govde":"Bir okulda 75 öğrenci vardır. Bu öğrencilerin 25 tanesi tenis, 33 tanesi voleybol kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 5'tir. Buna göre bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"70","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"B","metin":"17","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"27","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"D","metin":"22","dogru":true,"yanilgi":null},{"harf":"E","metin":"53","dogru":false,"yanilgi":"kume_hicbiri_atlandi"}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"25 + 33 − 5 = 53"},{"aciklama":"Evrensel küme, hiçbir kursa gitmeyenleri de içerir:","ifade":"75 − 53 = 22"},{"aciklama":"Hiçbir kursa gitmeyen öğrenci sayısı:","ifade":"22"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"3f4551d3be46","sablon":"oran.paylastirma.fark","govde":"3.420 TL tutarındaki bir ödül, Yusuf ile Kerem arasında 7/12 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"900 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.260 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"2.160 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.710 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"180 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"7 + 12 = 19"},{"aciklama":"Bir parçanın değeri:","ifade":"3.420 / 19 = 180 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(12 − 7) × 180 = 900 TL"},{"aciklama":"Aradaki fark:","ifade":"900 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.247,"gorsel":null},{"kimlik":"32f9791016ba","sablon":"yuzde.faiz.anapara","govde":"Yıllık %25 basit faiz oranıyla 24 ay vadeye yatırılan bir anapara 13.800 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.150 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"B","metin":"55.200 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"27.600 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"41.400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.300 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"24 ay için faiz katsayısı:","ifade":"25/100 × 24/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"13.800 / (25 × 24/1200) = 27.600 TL"},{"aciklama":"Anapara:","ifade":"27.600 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"f328727bfe1c","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 42| = 36 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"39","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"B","metin":"−42","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"36","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"3","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"E","metin":"42","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değer 36'ya eşitse içerideki ifade 36 ya da −36 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 42 = 36 ⟹ x = 39"},{"aciklama":"İkinci durum:","ifade":"2x − 42 = −36 ⟹ x = 3"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"39 + 3 = 2 × 42 / 2 = 42"},{"aciklama":"Köklerin toplamı:","ifade":"42"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.711,"gorsel":null},{"kimlik":"582f898fbab2","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 58. Öğrencilerden 3'ü sırasıyla 32, 53 ve 98 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"183","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"147","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"C","metin":"107","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"61","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"49","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"58 × 4 = 232"},{"aciklama":"Bilinen notların toplamı:","ifade":"32 + 53 + 98 = 183"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"232 − 183 = 49"},{"aciklama":"Kalan öğrencinin notu:","ifade":"49"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"7d9920845a42","sablon":"mantik.sifreleme.cozme","govde":"Bir şifrelemede FIRIN kelimesi LÖZÖU biçiminde yazılmaktadır. Aynı kurala göre SKTKZ biçiminde yazılan kelime aşağıdakilerden hangisidir?","secenekler":[{"harf":"A","metin":"KEMER","dogru":true,"yanilgi":null},{"harf":"B","metin":"JDLDP","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"C","metin":"KDKCN","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"D","metin":"LFNFS","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"E","metin":"ASCSG","dogru":false,"yanilgi":"sifreleme_yonu_ters"}],"cozum":[{"aciklama":"Örnekten kaydırma miktarını bul; bütün harflerde aynı çıkmalı:","ifade":"F→L , I→Ö , R→Z , I→Ö , N→U  ⟹ 8 sıra ileri"},{"aciklama":"Şifreyi çözmek, kuralı **ters** yönde uygulamaktır: her harf 8 sıra geri alınır.","ifade":null},{"aciklama":"Harfleri geri al:","ifade":"S→K , K→E , T→M , K→E , Z→R"},{"aciklama":"Aranan kelime:","ifade":"KEMER"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":1.545,"gorsel":null},{"kimlik":"6eea04b2514b","sablon":"problem.sayi.ardisik_tek_cift","govde":"Ardışık 3 tek sayının toplamı 183'tür.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"63","dogru":true,"yanilgi":null},{"harf":"B","metin":"122","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"62","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"D","metin":"59","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"61","dogru":false,"yanilgi":"ardisik_ortalama_terim_sayisi"}],"cozum":[{"aciklama":"3 ardışık tek sayı, ortadaki etrafında simetriktir; toplam, terim sayısı çarpı ortadaki sayıdır.","ifade":null},{"aciklama":"Sayıları yaz:","ifade":"59 + 61 + 63 = 183"},{"aciklama":"En büyüğü seç:","ifade":"63"},{"aciklama":"En büyük sayı:","ifade":"63"}],"mikrobeceriler":["problem.sayi"],"yanilgi_alanlari":["sayilar.ardisik","veri.ortalama"],"zorluk":0.254,"gorsel":null},{"kimlik":"73abe1912499","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 7 kişinin yaş ortalaması 32. Gruptan bir kişi ayrılınca ortalama 33 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"7","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"26","dogru":true,"yanilgi":null},{"harf":"C","metin":"198","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"1","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"422","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 7 × 32","ifade":"224"},{"aciklama":"Ayrıldıktan sonra grup 6 kişi: 6 × 33","ifade":"198"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"224 − 198 = 26"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"26"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.163,"gorsel":null},{"kimlik":"82b59fe29d07","sablon":"cebir.denklem.kesirli","govde":"(x + 19)/6 − (x − 8)/3 = 7 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"−39","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−7","dogru":true,"yanilgi":null},{"harf":"C","metin":"28","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"D","metin":"7/3","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"E","metin":"12","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Paydaların EKOK'u 6; denklemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(6, 3) = 6"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"1(x + 19) − 2(x − 8) = 42"},{"aciklama":"Benzer terimleri topla:","ifade":"−x + 35 = 42"},{"aciklama":"x'i yalıt:","ifade":"x = 7 / −1 = −7"},{"aciklama":"x değeri:","ifade":"−7"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":2.402,"gorsel":null},{"kimlik":"b0dd91904bfe","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(5/11 + 2/7) : 5/12 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"156/385","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"95/308","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"C","metin":"684/385","dogru":true,"yanilgi":null},{"harf":"D","metin":"14/15","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"84/55","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(11, 7) = 77"},{"aciklama":"Her kesri, paydası 77 olacak biçimde genişlet:","ifade":"5/11 = 35/77  (payı da paydayı da 7 ile çarptık)\n2/7 = 22/77  (payı da paydayı da 11 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"35/77 + 22/77 = 57/77"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"57/77 × 12/5"},{"aciklama":"Çarpımı yap:","ifade":"57 × 12 / (77 × 5) = 684/385"},{"aciklama":"İşlemin sonucu:","ifade":"684/385"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.672,"gorsel":null},{"kimlik":"ce038d07024a","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Serkan, Fatma ve Deniz arasında sırasıyla 6, 7 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 7.200 TL olduğuna göre, Serkan'ın payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.800 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"3.300 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"5.400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"2.400 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"300 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"6 + 7 + 11 = 24"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"7.200 / 24 = 300 TL"},{"aciklama":"Serkan bu paylardan 6 tane alır:","ifade":"6 × 300 = 1.800 TL"},{"aciklama":"Serkan'ın payı:","ifade":"1.800 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.575,"gorsel":null},{"kimlik":"302cba15f991","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 18 kişilik A grubunun puan ortalaması 76, 36 kişilik B grubunun puan ortalaması 82 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"240","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"79","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"80","dogru":true,"yanilgi":null},{"harf":"D","metin":"158","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"4.320","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 18 × 76","ifade":"1.368"},{"aciklama":"B grubu: 36 × 82","ifade":"2.952"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"4.320 / 54 = 80"},{"aciklama":"Ortak ortalama:","ifade":"80"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.334,"gorsel":null},{"kimlik":"9403bc09024a","sablon":"yuzde.faiz.basit_ay","govde":"10.800 TL tutarındaki bir anapara, yıllık %25 basit faiz oranıyla 4 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.700 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"11.700 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"900 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"675 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"10.800 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"4 ay, yıl cinsinden:","ifade":"4/12"},{"aciklama":"Faiz tutarı:","ifade":"10.800 × 25/100 × 4/12 = 900 TL"},{"aciklama":"Elde edilen faiz:","ifade":"900 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"cc835a32adde","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede MASA kelimesi OYTY biçiminde yazılmaktadır. Aynı kurala göre İĞNE kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"KFÖÇ","dogru":true,"yanilgi":null},{"harf":"B","metin":"LGPD","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"C","metin":"HFLÇ","dogru":fal