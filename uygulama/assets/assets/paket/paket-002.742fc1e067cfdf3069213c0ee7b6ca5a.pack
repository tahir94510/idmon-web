},{"harf":"D","metin":"129.600","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"E","metin":"129.240","dogru":false,"yanilgi":"sayma_ozdes_nesne"}],"cozum":[{"aciklama":"Gidişte her ayakta bağımsız seçim yapılır; sayılar çarpılır:","ifade":"5 × 9 × 8 = 360"},{"aciklama":"Dönüşte her ayakta bir yol kullanılmış durumdadır:","ifade":"4 × 8 × 7 = 224"},{"aciklama":"Gidiş ve dönüş peş peşe yapıldığı için çarpılır:","ifade":"360 × 224 = 80.640"},{"aciklama":"Yolculuğun yapılabileceği biçim sayısı:","ifade":"80.640"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":2.422,"gorsel":null},{"kimlik":"f53a708cfeb2","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Eskişehir'in Yaz satışı silinmiş, yerine 0 yazılmıştır. Eskişehir satırının gerçek yıllık toplamı 720 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"515 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"180 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"215 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"375 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"365 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Eskişehir satırında görünen üç değeri topla:","ifade":"130 + 150 + 75 = 355"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"720 − 355 = 365"},{"aciklama":"Silinen değer:","ifade":"365 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.05,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Ankara","degerler":[285,325,205,265]},{"ad":"Samsun","degerler":[160,150,80,80]},{"ad":"Eskişehir","degerler":[130,0,150,75]},{"ad":"Antalya","degerler":[75,375,195,105]}]}},{"kimlik":"a7ae742bab58","sablon":"mantik.esleme.kesin_dogru","govde":"Fatma, Kaan, Kerem, Merve ve Selin adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Merve, Fatma adlı kişinin solunda oturmaktadır.\n• Kerem uçtaki koltuklarda oturmamaktadır.\n• Merve uçtaki koltuklarda oturmamaktadır.\n• Fatma, Selin adlı kişinin solunda oturmaktadır.\n• Kerem, Merve adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Kerem, Kaan adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"B","metin":"Kaan, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"C","metin":"Fatma, Selin adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Kaan, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"E","metin":"Kerem, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Kaan − Kerem − Merve − Fatma − Selin"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Kerem, Kaan adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"4b4d29ed1e34","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 3 : 2 : 12 oranındadır. Birinci arkadaşın parası 36 TL olduğuna göre ikinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"2 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"12 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"54 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"68 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"24 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"3k : 2k : 12k"},{"aciklama":"Bilinen paydan k'yı çöz (birinci arkadaş):","ifade":"3k = 36 → k = 12"},{"aciklama":"Sorulan payı k ile çarp (ikinci arkadaş):","ifade":"2 × 12 = 24"},{"aciklama":"İkinci arkadaşın parası:","ifade":"24 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.079,"gorsel":null},{"kimlik":"5584845d7da9","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 3.200 TL olan bir termos %40 kârla, maliyeti 1.000 TL olan bir tablet ise %20 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.080 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.280 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"840 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"1.480 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"20 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"3.200 × 40/100 = 1.280 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"1.000 × 20/100 = 200 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"1.280 − 200 = 1.080 TL"},{"aciklama":"Net kâr:","ifade":"1.080 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.976,"gorsel":null},{"kimlik":"7a53766b7591","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":