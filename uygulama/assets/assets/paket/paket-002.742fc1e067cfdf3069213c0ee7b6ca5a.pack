arf":"B","metin":"147 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"294 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"42 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"E","metin":"126 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/168 + 1/126 = 7/504"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"504/7 = 72 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"72 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.502,"gorsel":null,"grup":"1f1429e6824d","grup_govde":"Bir işi Merve tek başına 168 günde, Deniz tek başına 126 günde bitirmektedir."},{"kimlik":"1f1429e6824d-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Merve işe başlayıp 68 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Deniz tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"294 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"B","metin":"147 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"126 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"D","metin":"75 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"51 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Merve bir günde işin 1/168'ini yapıyor; 68 gün çalışınca yaptığı iş:","ifade":"68/168"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(168 − 68)/168 = 25/42"},{"aciklama":"Deniz işin tamamını 126 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"25/42 × 126 = 75"},{"aciklama":"Kalan iş için gereken süre:","ifade":"75 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.685,"gorsel":null,"grup":"1f1429e6824d","grup_govde":"Bir işi Merve tek başına 168 günde, Deniz tek başına 126 günde bitirmektedir."},{"kimlik":"b25b74e6ca59","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Konya'ya giderken yolun ilk bölümünü saatte 100 km hızla 1 saatte, kalan bölümünü saatte 40 km hızla 4 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"440 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"B","metin":"350 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"260 km","dogru":true,"yanilgi":null},{"harf":"D","metin":"100 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"200 km","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"100 × 1 = 100 km"},{"aciklama":"İkinci bölüm:","ifade":"40 × 4 = 160 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"100 + 160 = 260 km"},{"aciklama":"Toplam yol:","ifade":"260 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.14,"gorsel":null},{"kimlik":"70bedc391dcb","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"11 · 2² · 2³ · 7⁰ + 2⁵ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"736","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"B","metin":"320","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"11.264","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"D","metin":"32","dogru":false,"yanilgi":"sifir_us"},{"harf":"E","metin":"384","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"7⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2² · 2³ = 2⁵ = 32"},{"aciklama":"Katsayıyla çarp:","ifade":"11 × 32 = 352"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"352 + 32 = 384"},{"aciklama":"İşlemin sonucu:","ifade":"384"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.013,"gorsel":null},{"kimlik":"2bbf8f6b876d","sablon":"cebir.esitsizlik.negatif_katsayi","govde":"−4(x − 16) > 33 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"6","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"B","metin":"7","dogru":true,"yanilgi":null},{"harf":"C","metin":"8","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"D","metin":"−13","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"24","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−4x + 64 > 33"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−4x > −31"},{"aciklama":"Her iki tarafı −4 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner: büyüktür işareti küçüktür olur:","ifade":"x < 7,75"},{"aciklama":"Sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"7"},{"aciklama":"En büyük tam sayı:","ifade":"7"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":["cebir.ozdeslik"],"zorluk":1.826,"gorsel":null},{"kimlik":"59131a01a687","sablon":"oran.ters.hiz_sure","govde":"Bir araç Samsun ile Bursa arasını saatte 140 km hızla 10 saatte almaktadır. Aynı yolu saatte 70 km hızla giden bir araç kaç saatte alır?","secenekler":[{"harf":"A","metin":"20 saat","dogru":true,"yanilgi":null},{"harf":"B","metin":"5 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"C","metin":"3 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"D","metin":"17 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"E","metin":"10 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"}],"cozum":[{"aciklama":"Sabit yolda hız ile süre ters orantılıdır; yol çarpımlarıdır:","ifade":"140 × 10 = 1.400 km"},{"aciklama":"Yeni süre, aynı yolun yeni hıza bölümüdür:","ifade":"1.400 / 70 = 20 saat"},{"aciklama":"Geçen süre:","ifade":"20 saat"}],"mik