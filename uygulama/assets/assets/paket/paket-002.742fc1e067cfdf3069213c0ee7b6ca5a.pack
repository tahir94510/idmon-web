arayi_verme"},{"harf":"C","metin":"680","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.720","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"1.340","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Sayının %40'ı biliniyorsa sayının kendisi bulunur:","ifade":"1.360 / (40/100) = 3.400"},{"aciklama":"Sayının %20'si:","ifade":"3.400 × 20/100 = 680"},{"aciklama":"Aranan değer:","ifade":"680"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["oran.temel","yuzde.artis_azalis"],"zorluk":-0.971,"gorsel":null},{"kimlik":"6e7082ade649","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Antalya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"210 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"220 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"230 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"450 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"E","metin":"440 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 40 · 2021→2022: −220 · 2022→2023: 160 · 2023→2024: 230"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2021 → 2022: 450 − 230 = 220 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"220 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.724,"gorsel":{"tur":"cizgi","baslik":"Antalya şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[410,450,230,390,620]}]}},{"kimlik":"e202007eef16","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 5, onlar basamağındaki rakam 2'dir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"542","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"B","metin":"54","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"C","metin":"524","dogru":true,"yanilgi":null},{"harf":"D","metin":"506","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"E","metin":"425","dogru":false,"yanilgi":"basamak_yer_degistirme"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (5 − b) = 99 ⟹ 5 − b = 1 ⟹ b = 4"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 5 + 10 × 2 + 4 = 524"},{"aciklama":"Aranan sayı:","ifade":"524"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"384717475aa0","sablon":"cebir.esitsizlik.iki_taraf_bilinmeyen","govde":"4x − 4 > 2x − 21 eşitsizliğini sağlayan en küçük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"−8","dogru":true,"yanilgi":null},{"harf":"B","metin":"−12","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"−9","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"D","metin":"−2","dogru":false,"yanilgi":"esitsizlikte_sabitler_ayni_tarafta"},{"harf":"E","metin":"−7","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"x'li terimleri bir tarafta, sabitleri öbür tarafta topla:","ifade":"4x − 2x > −21 + 4"},{"aciklama":"Katsayıları sadeleştir:","ifade":"2x > −17"},{"aciklama":"Her iki tarafı 2 ile böl:","ifade":"x > −8,5"},{"aciklama":"Eşitsizliği sağlayan en küçük tam sayı:","ifade":"−8"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.007,"gorsel":null},{"kimlik":"ed31e2457bd6","sablon":"mantik.dizi.sabit_oran","govde":"7, 21, 63, 189, 567, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"567","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"1.701","dogru":true,"yanilgi":null},{"harf":"C","metin":"945","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"D","metin":"189","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"E","metin":"5.103","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farklar sabit değil; oranlara bak:","ifade":"21÷7=3 , 63÷21=3 , 189÷63=3 , 567÷189=3"},{"aciklama":"Oran her adımda aynı, yani her terim bir öncekinin katı:","ifade":"oran = 3"},{"aciklama":"Son terimi bu oranla çarp:","ifade":"567 × 3 = 1.701"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"1.701"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"0c69ea6564b2","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Samsun ile Trabzon arasındaki yolu giderken 35 km/sa, dönerken 15 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"21 km/sa","dogru":true,"yanilgi":null},{"harf":"B","metin":"35 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"C","metin":"25 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"50 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"10,5 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/35 + x/15 = x·(50)/(35·15)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·50/(35·15)] = 2·35·15/50 = 21 km/sa"},{"aciklama":"Ortalama hız:","ifade":"21 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.034,"gorsel":null},{"kimlik":"99c4202c5dd3","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Scooter satışının Bisiklet satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"55 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"5 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"390 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"20 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"205 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Scooter ilk kez Temmuz döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Bisiklet 185, Scooter 205","ifade":"205 − 185 = 20"},{"aciklama":"Aradaki fark:","ifade":"20 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.079,"gorsel":{"tur":"cizgi","baslik":"Bisiklet ve Scooter satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[205,195,185,175]},{"ad":"Scooter","degerler":[75,140,205,270]}]}},{"kimlik":"df6045973473","sablon":"oran.bilesik.isci_ucret","govde":"5 işçi 6 günde çalışarak toplam 7.500 TL kazanmaktadır. Aynı günlük ücretle çalışan 6 işçi 3 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"9.000 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"B","metin":"4.500 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"250 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"3.750 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"12.500 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"7.500 / (5 × 6) = 250 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"6 × 3 = 18"},{"aciklama":"Toplam ücret:","ifade":"18 × 250 = 4.500 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"4.500 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":0.85,"gorsel":null},{"kimlik":"1af865f0c412","sablon":"yuzde.temel.ters_yuzde","govde":"Bir güneş gözlüğü fiyatına %75 zam yapıldıktan sonra fiyatı 9.100 TL olmuştur. Güneş gözlüğünün zamdan önceki fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"9.025 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"5.200 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"2.275 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"3.900 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"36.400 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zamlı fiyat, eski fiyatın %175'idir:","ifade":"eski × 175/100 = 9.100"},{"aciklama":"Eski fiyat, zamlı fiyatın bu orana bölümüdür:","ifade":"9.100 × 100/175 = 5.200 TL"},{"aciklama":"Zamdan önceki fiyat:","ifade":"5.200 TL"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.566,"gorsel":null},{"kimlik":"accb29f4e30a","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 11 ile bölümünden elde edilen bölüm 36, kalan ise 10'dur. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"146","dogru":false,"yanilgi":"kalan_bolen_karisimi"},{"harf":"B","metin":"396","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"C","metin":"386","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"D","metin":"506","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"E","metin":"406","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"11 × 36 + 10 = 396 + 10 = 406"},{"aciklama":"Kalan (10) bölenden (11) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"406"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-2.106,"gorsel":null},{"kimlik":"9f5b7b320a28","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Bisiklet sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Bisiklet sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"165 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"132 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"C","metin":"220 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"660 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"100 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Mayıs: 100 · Haziran: 135 · Temmuz: 195 · Ağustos: 230"},{"aciklama":"Dördünü topla:","ifade":"100 + 135 + 195 + 230 = 660"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"660/4 = 165"},{"aciklama":"Dönem ortalaması:","ifade":"165 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-1.15,"gorsel":{"tur":"cizgi","baslik":"Bisiklet satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[100,135,195,230]}]}},{"kimlik":"61d08c674be7","sablon":"oran.bilesik.makine_uretim","govde":"8 makine 7 günde 1.680 parça üretmektedir. Aynı hızla çalışan 4 makine 12 günde kaç parça üretir?","secenekler":[{"harf":"A","metin":"5.760 parça","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"5.040 parça","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"1.440 parça","dogru":true,"yanilgi":null},{"harf":"D","metin":"30 parça","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"840 parça","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"}],"cozum":[{"aciklama":"Bir makinenin bir günlük üretimi bulunur:","ifade":"1.680 / (8 × 7) = 30 parça"},{"aciklama":"Üretim hem makine sayısıyla hem gün sayısıyla doğru orantılıdır:","ifade":"30 × 4 × 12 = 1.440 parça"},{"aciklama":"Üretilen parça:","ifade":"1.440 parça"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":2.107,"gorsel":null},{"kimlik":"61163759205d","sablon":"yuzde.ardisik.iki_indirim","govde":"2.200 TL olan bir şemsiye fiyatına önce %20 indirim, ardından kalan fiyat üzerinden %40 indirim daha yapılmıştır. Son fiyat kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.696 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"1.760 TL","dogru":false,"yanilgi":"ardisik_yuzde_tek_uygulama"},{"harf":"C","metin":"1.144 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"880 TL","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"E","metin":"1.056 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İkinci indirim ilk fiyata değil, **kalan fiyata** uygulanır; bu yüzden yüzdeler toplanmaz.","ifade":null},{"aciklama":"İlk indirimden sonra:","ifade":"2.200 TL × 80/100 = 1.760 TL"},{"aciklama":"İkinci indirimden sonra:","ifade":"1.760 TL × 60/100 = 1.056 TL"},{"aciklama":"Son fiyat:","ifade":"1.056 TL"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":0.294,"gorsel":null},{"kimlik":"75e61e8d1044","sablon":"veri.grafik.cizgi_yuzde_artis","govde":"Konya mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2019 yılından 2021 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%60","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"B","metin":"%80","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"%40","dogru":false,"yanilgi":"artis_miktari_yuzde_sanildi"},{"harf":"D","metin":"%50","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"%100","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"80 − 40 = 40"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"40 / 40 × 100 = %100"},{"aciklama":"Yüzde artış:","ifade":"%100"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":{"tur":"cizgi","baslik":"Konya mağazasının yıllık cirosu (bin TL)","etiketler":["2017","2018","2019","2020","2021"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[50,60,40,50,80]}]}},{"kimlik":"b003c8401f6b","sablon":"mantik.dizi.terim_sirasi","govde":"7, 17, 27, 37, ... biçiminde devam eden dizide 377 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"39","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"B","metin":"377","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"37,7","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"D","metin":"37","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"E","metin":"38","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"17 − 7 = 10"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 7 + (n − 1)·10"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"377 = 7 + (n − 1)·10 → n = 38"},{"aciklama":"Terimin sırası:","ifade":"38"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.589,"gorsel":null},{"kimlik":"56d23cc4f85d","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"353 ile 807 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 20'ye tam bölünür?","secenekler":[{"harf":"A","metin":"91","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"B","metin":"23","dogru":true,"yanilgi":null},{"harf":"C","metin":"45","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"23,7","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"113","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"}],"cozum":[{"aciklama":"20'ye bölünen sayılar 20'nin katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"360 ve 800"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(800 − 360) / 20 + 1 = 23"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"23"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":-0.143,"gorsel":null},{"kimlik":"67e9236591a7","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 42 km sabit hızla yola çıkmıştır. 4 saat sonra aynı noktadan aynı yöne, saatte 56 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"12/7 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"B","metin":"3 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"C","metin":"168 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"12 saat","dogru":true,"yanilgi":null},{"harf":"E","metin":"24/7 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"42 × 4 = 168 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"56 − 42 = 14 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"168 / 14 = 12"},{"aciklama":"Yetişme süresi:","ifade":"12 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"d0af1be713fc","sablon":"veri.grafik.daire_aciyla_sayi","govde":"Toplam 200 kişinin katıldığı bir ankette verilen cevapların merkez açıları yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Futbol seçeneğini işaretleyen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"50 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"30 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"216 kişi","dogru":false,"yanilgi":"aciyi_yuzde_sanma"},{"harf":"D","metin":"140 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"60 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Grafikte Futbol diliminin merkez açısını oku:","ifade":"108°"},{"aciklama":"Açıyı orana çevir: dairenin tamamı 360°, dağılımın tamamı 100'dür.","ifade":"108/360 = 0,3"},{"aciklama":"Bulunan oranı toplam kişi sayısıyla çarp:","ifade":"200 × 0,3 = 60"},{"aciklama":"Dereceyi doğrudan sayıya oranlamak iki adımdan birini atlamak olurdu; önce yüzde, sonra sayı.","ifade":null},{"aciklama":"Bu dilimi seçen kişi sayısı:","ifade":"60 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.334,"gorsel":{"tur":"daire","baslik":"Tercihlerin merkez açıları","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"derece","seriler":[{"ad":"Açı","degerler":[108,90,36,126]}]}},{"kimlik":"5fe57fe88a98","sablon":"cebir.esitsizlik.negatif_katsayi","govde":"−6(x + 3) > −23 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"1","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"B","metin":"0","dogru":true,"yanilgi":null},{"harf":"C","metin":"−7","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−1","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"4","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−6x − 18 > −23"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−6x > −5"},{"aciklama":"Her iki tarafı −6 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner: büyüktür işareti küçüktür olur:","ifade":"x < 5/6"},{"aciklama":"Sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"0"},{"aciklama":"En büyük tam sayı:","ifade":"0"}],"