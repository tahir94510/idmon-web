e,"yanilgi":null}],"cozum":[{"aciklama":"Paydaların EKOK'u 40; denklemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(5, 8) = 40"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"8(x + 20) − 5(x − 1) = 240"},{"aciklama":"Benzer terimleri topla:","ifade":"3x + 165 = 240"},{"aciklama":"x'i yalıt:","ifade":"x = 75 / 3 = 25"},{"aciklama":"x değeri:","ifade":"25"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":3.192,"gorsel":null},{"kimlik":"a6b549c3f8ec","sablon":"kume.sayma.en_az_bir_kosullu","govde":"8 kadın ve 3 erkeğin bulunduğu bir ekipten 2 kişilik bir çalışma grubu seçilecektir. Grupta en az bir kadın bulunması koşuluyla, bu seçim kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"80","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"B","metin":"52","dogru":true,"yanilgi":null},{"harf":"C","metin":"104","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"D","metin":"55","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"E","metin":"3","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: önce hiçbir kısıt koymadan say, sonra **istenmeyen** durumları düş. Burada istenmeyen durum, hiç kadın olmaması.","ifade":null},{"aciklama":"Önce koşulsuz seçim sayısı. C(n, r), n kişiden r kişiyi sırasız seçme sayısıdır; burada 11 kişiden 2 kişi:","ifade":"C(11, 2) = (11×10) / (2×1) = 55"},{"aciklama":"Hiç kadın içermeyen seçimler yalnızca erkeklerden kurulur:","ifade":"C(3, 2) = (3×2) / (2×1) = 3"},{"aciklama":"Farkı al:","ifade":"55 − 3 = 52"},{"aciklama":"Farklı seçim sayısı:","ifade":"52"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":["kume.olasilik"],"zorluk":1.902,"gorsel":null},{"kimlik":"42a41f18e7dc","sablon":"oran.ters.kapasite_arac","govde":"Bir depodaki yükün tamamı, her biri 3 ton taşıyan 28 kamyonla bir seferde taşınmaktadır. Aynı yük, her biri 21 ton taşıyan kamyonlarla bir seferde taşınsaydı kaç kamyon gerekirdi?","secenekler":[{"harf":"A","metin":"46 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"B","metin":"4 kamyon","dogru":true,"yanilgi":null},{"harf":"C","metin":"10 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"D","metin":"84 kamyon","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"196 kamyon","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"Taşınan yük değişmiyor; değişen yalnızca onu kaç araca böldüğümüz. Araç sayısı ile kapasite **ters** orantılıdır, yani çarpımları sabittir.","ifade":null},{"aciklama":"Toplam yükü bul:","ifade":"28 × 3 = 84 ton"},{"aciklama":"Yeni kapasiteye böl:","ifade":"84 / 21 = 4"},{"aciklama":"Gereken kamyon sayısı:","ifade":"4 kamyon"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.677,"gorsel":null},{"kimlik":"1fd1e8da0ce1","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin Yaz mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"144 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"210 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"168 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"36 adet","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"120 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"Yaz sütunundaki dört değeri oku:","ifade":"Ankara: 116 · İzmir: 104 · Antalya: 260 · Konya: 96"},{"aciklama":"Dördünü topla:","ifade":"116 + 104 + 260 + 96 = 576"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölünmesidir; burada dört şehir var:","ifade":"576 / 4 = 144"},{"aciklama":"Ortalama satış:","ifade":"144 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yani