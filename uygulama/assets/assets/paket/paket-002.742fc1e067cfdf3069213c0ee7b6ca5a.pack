27,"gorsel":null},{"kimlik":"03c366f6fef6","sablon":"yuzde.artis.indirim","govde":"Fiyatı 2.800 TL olan bir buzdolabı, %70 indirimle satılmaktadır. Buzdolabının indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"840 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.960 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"252 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"4.760 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"2.730 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"2.800 × 70 / 100 = 1.960"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"2.800 − 1.960 = 840"},{"aciklama":"İndirimli fiyat:","ifade":"840 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":null},{"kimlik":"704abb0e0e8e","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 231 cm ve 165 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"33 cm","dogru":true,"yanilgi":null},{"harf":"B","metin":"396 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"C","metin":"1.155 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"D","metin":"12 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"11 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"231 = 33·7   ve   165 = 33·5"},{"aciklama":"Ortak çarpan 33; kalan çarpanlar (7 ve 5) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(231, 165) = 33"},{"aciklama":"En büyük parça