,"dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Yusuf 17k, Fatma 3k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"17k − 3k = 14k = 4.760"},{"aciklama":"Birim payı bul:","ifade":"k = 4.760 / 14 = 340"},{"aciklama":"Yusuf için:","ifade":"17 × 340 = 5.780"},{"aciklama":"Yusuf'un parası:","ifade":"5.780 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.669,"gorsel":null},{"kimlik":"67bb9d391868","sablon":"yuzde.faiz.basit_ay","govde":"39.600 TL tutarındaki bir anapara, yıllık %24 basit faiz oranıyla 9 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"85.536 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"46.728 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"1.056 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"D","metin":"7.128 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"9.504 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"9 ay, yıl cinsinden:","ifade":"9/12"},{"aciklama":"Faiz tutarı:","ifade":"39.600 × 24/100 × 9/12 = 7.128 TL"},{"aciklama":"Elde edilen faiz:","ifade":"7.128 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"79b11bc3f532","sablon":"sayilar.rasyonel.islem_onceligi","govde":"14 + 1/3 × 2/7 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"91/6","dogru":false,"yanilgi":"kesir_carpimda_ters_cevrildi"},{"harf":"B","metin":"296/21","dogru":true,"yanilgi":null},{"harf":"C","metin":"44/3","dogru":false,"yanilgi":"kesir_carpimda_payda_carpilmadi"},{"harf":"D","metin":"86/21","dogru":false,"yanilgi":"islem_onceligi_toplama_once"},{"harf":"E","metin":"292/21","dogru":false,"yanilgi":"isaret_hata