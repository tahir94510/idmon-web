grup_govde":"Bir ikramiye Mustafa, Kaan ve Buse arasında sırasıyla 5, 10 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 4.680 TL'dir."},{"kimlik":"1ec7d0f02bc8","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Zeynep, Mustafa ve Onur arasında sırasıyla 3, 7 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 3.150 TL olduğuna göre, Mustafa'nın payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.050 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"150 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"7.350 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"2.100 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"1.650 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"3 + 7 + 11 = 21"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"3.150 / 21 = 150 TL"},{"aciklama":"Mustafa bu paylardan 7 tane alır:","ifade":"7 × 150 = 1.050 TL"},{"aciklama":"Mustafa'nın payı:","ifade":"1.050 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.719,"gorsel":null},{"kimlik":"fe94ea8dd4ed","sablon":"yuzde.faiz.anapara","govde":"Yıllık %30 basit faiz oranıyla 4 ay vadeye yatırılan bir anapara 720 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"600 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"2.400 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"1.800 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"D","metin":"7.920 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"7.200 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"4 ay için faiz katsayısı:","ifade":"30/100 × 4/12"},{"a