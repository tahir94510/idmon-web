i":null},{"harf":"C","metin":"100 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"49,02 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"E","metin":"200 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/86 + x/114 = x·(200)/(86·114)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·200/(86·114)] = 2·86·114/200 = 98,04 km/sa"},{"aciklama":"Ortalama hız:","ifade":"98,04 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.888,"gorsel":null},{"kimlik":"da5f90ab7a99","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 13 tek doğal sayının toplamı 923'tür.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"85","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"B","metin":"81","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"C","metin":"71","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"77","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"E","metin":"83","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık 13 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"923 / 13 = 71"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 6 adım ileridedir:","ifade":"71 + 2 × 6 = 83"},{"aciklama":"En büyük sayı:","ifade":"83"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"5d466a43ca58","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin Yaz mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"230 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"195 adet","dogru":