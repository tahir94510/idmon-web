lama":"Yol = hız × süre. Birinci bölüm:","ifade":"50 × 2 = 100 km"},{"aciklama":"İkinci bölüm:","ifade":"40 × 1 = 40 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"100 + 40 = 140 km"},{"aciklama":"Toplam yol:","ifade":"140 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":-0.123,"gorsel":null},{"kimlik":"99b470701024","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 8.154 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"906","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"9.060","dogru":true,"yanilgi":null},{"harf":"C","metin":"916","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"D","metin":"90.600","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"8.154","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 8.154"},{"aciklama":"İlk sayı:","ifade":"x = 8.154 / 9 = 906"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 906 = 9.060"},{"aciklama":"Yeni sayı:","ifade":"9.060"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.439,"gorsel":null},{"kimlik":"e9661ca903ce","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Ankara şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2016 yılından 2018 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"60 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"90 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"30 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"D","metin":"210 kişi","dogru":false,"yanilgi":"deg