mutlak_deger_ic_isaret"},{"harf":"D","metin":"109","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−91","dogru":false,"yanilgi":"mutlak_deger_dagitildi"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 10 + 3 = 13 ve x = 10 − 3 = 7"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(10 + 3) × (10 − 3) = 10² − 3² = 91"},{"aciklama":"Köklerin çarpımı:","ifade":"91"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"790cbb3fb6f3","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 16 litre yakıt tüketmektedir.\n\nBu araç Trabzon'a yapılan 2.000 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"3.200 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"125 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"20 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"16 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"320 litre","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"16/100 = x/2.000"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.000 × 16/100 = 320"},{"aciklama":"Tüketilen yakıt:","ifade":"320 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.115,"gorsel":null},{"kimlik":"d8e9f9a42537","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 1.200 TL olan bir sırt çantası %25 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%80","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"%31,25","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%20","dogru":true,"yanilgi":null},{"harf":"E","metin":"%25","dogru":false,"yanilgi":"ardisik_yuzde_toplama"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"1.200 × 125/100 = 1.500 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"1.500 − 1.200 = 300 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"300/1.500 × 100 = 20"},{"aciklama":"Gereken indirim:","ifade":"%20"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.458,"gorsel":null},{"kimlik":"269e4b8672bf","sablon":"cebir.esitsizlik.iki_taraf_bilinmeyen","govde":"8x + 26 > 5x − 9 eşitsizliğini sağlayan en küçük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"6","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−11","dogru":true,"yanilgi":null},{"harf":"C","metin":"−12","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"D","metin":"−2","dogru":false,"yanilgi":"esitsizlikte_sabitler_ayni_tarafta"},{"harf":"E","metin":"−10","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"x'li terimleri bir tarafta, sabitleri öbür tarafta topla:","ifade":"8x − 5x > −9 − 26"},{"aciklama":"Katsayıları sadeleştir:","ifade":"3x > −35"},{"aciklama":"Her iki tarafı 3 ile böl:","ifade":"x > −35/3"},{"aciklama":"Eşitsizliği sağlayan en küçük tam sayı:","ifade":"−11"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.07,"gorsel":null},{"kimlik":"4457186d3419","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört mağazada sattığı Ekmek ve Simit sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört mağazada satılan toplam Ekmek sayısı, toplam Simit sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"210 adet","dogru"