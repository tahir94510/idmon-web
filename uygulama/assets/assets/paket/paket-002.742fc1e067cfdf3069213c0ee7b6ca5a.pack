alse,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"%1.360","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"%212,5","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"%68","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"2.000 − 640 = 1.360 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"1.360 / 2.000 × 100 = %68"},{"aciklama":"Zarar oranı:","ifade":"%68"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.994,"gorsel":null},{"kimlik":"f10d14cdb6ac","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Deniz, Emre, Fatma ve Serkan adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Fatma, Deniz adlı kişinin solunda oturmaktadır.\n• Serkan uçtaki koltuklarda oturmamaktadır.\n• Serkan, Ahmet adlı kişinin hemen solundadır.\n• Deniz, Serkan adlı kişinin hemen solundadır.\n• Deniz ortadaki koltukta oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Deniz, Emre adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Fatma, Emre adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"C","metin":"Ahmet, Emre adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Deniz, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"E","metin":"Fatma, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:",