fade":"2.740 × 125/100 = 3.425 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"3.425 − 2.740 = 685 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"685/3.425 × 100 = 20"},{"aciklama":"Gereken indirim:","ifade":"%20"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.458,"gorsel":null},{"kimlik":"63ddfd7e54f9","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|3x + y − 40| + z = 3\n|4x − 2y − 30| = 2z − 6\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"3","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"−30","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"C","metin":"21","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"D","metin":"18","dogru":true,"yanilgi":null},{"harf":"E","metin":"−10","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 3 − |…| ≤ 3"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 6 ≥ 0 , yani z ≥ 3"},{"aciklama":"İkisi birlikte:","ifade":"z = 3"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"3x + y = 40 , 4x − 2y = 30"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 11 , y = 7"},{"aciklama":"İstenen toplam, x + y:","ifade":"18"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"198483de69ce","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 24 dakikada bir, B hattı 28 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"52 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"4 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"C","metin":"168 dakika","dogru":true,"yanilgi":null},{"harf":"D","metin":"672 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"E","metin":"336 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"24 ve 28 sayılarının EKOK'u:","ifade":"EKOK(24, 28) = 168"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"168 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":3.062,"gorsel":null},{"kimlik":"26c00edef432","sablon":"veri.grafik.sutun_fark","govde":"Bir işletmenin dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Mart ayında satılan Kitap sayısı, aynı ayda satılan Dergi sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"10 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"115 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"185 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"20 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"230 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Önce sorunun istediği ay işaretle: Mart.","ifade":null},{"aciklama":"Kitap sütununu oku:","ifade":"150 adet"},{"aciklama":"Dergi sütununu oku:","ifade":"35 adet"},{"aciklama":"İki değerin farkını al:","ifade":"150 − 35 = 115"},{"aciklama":"Aradaki fark:","ifade":"115 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.658,"gorsel":{"tur":"sutun","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[85,130,150,35]},{"ad":"Dergi","degerler":[180,120,35,80]}]}},{"kimlik":"6622609f5aa5","sablon":"mantik.dizi.carpansal","govde":"15, 49, 151, 457, 1.375, ?\n\nYukarıdaki dizid