:[],"zorluk":1.398,"gorsel":null},{"kimlik":"c4c77a06d01a","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre iki ürünün toplam satışının en yüksek olduğu şube için bu toplam kaç adettir?","secenekler":[{"harf":"A","metin":"295 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"150 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"240 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"590 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"185 adet","dogru":false,"yanilgi":"komsu_kategori_okundu"}],"cozum":[{"aciklama":"Soru tek bir seriyi değil, iki serinin toplamını istiyor; her şube için iki sütunu topla:","ifade":"A şubesi: 275 , B şubesi: 210 , C şubesi: 295 , D şubesi: 180"},{"aciklama":"Toplamların en büyüğü:","ifade":"C şubesi için 295"},{"aciklama":"En yüksek toplam satış:","ifade":"295 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["veri.tablo"],"zorluk":0.873,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[140,145,150,145]},{"ad":"Tablet","degerler":[135,65,145,35]}]}},{"kimlik":"49d4a139c638","sablon":"mantik.dizi.sabit_oran","govde":"8, 32, 128, 512, 2.048, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"8.192","dogru":true,"yanilgi":null},{"harf":"B","metin":"32.768","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"C","metin":"3.584","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"D","metin":"512","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"E","metin":"2.048","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farklar sabit değil; oranlara bak:","ifade":"32÷8=4 , 128÷32=4 , 512÷128=4 , 2.048÷512=4"},{"aciklama":"Oran her adımda aynı, yani her terim bir öncekinin katı:","ifade":"oran = 4"},{"aciklama":"Son terimi bu oranla çarp:","ifade":"2.048 × 4 = 8.192"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"8.192"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"67edf2fca167","sablon":"problem.isci.ek_isci","govde":"14 işçi bir işi 6 günde bitirmektedir. Aynı iş 4 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"18 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"B","metin":"28/3 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"C","metin":"2 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"D","metin":"21 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"7 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"14 × 6 = 84"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"84 / 4 = 21"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"21 − 14 = 7"},{"aciklama":"Gereken ek işçi:","ifade":"7 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.42,"gorsel":null},{"kimlik":"51d2ce2c2c89","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört şubede sattığı Telefon sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre D şubesinde satılan Telefon sayısı, dört şubede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%55","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"%45","dogru":true,"yanilgi":null},{"harf":"D","metin":"%100","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"%1.125","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"750 + 125 + 500 + 1.125 = 2.500"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"1.125 / 2.500 × 100 = %45"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%45"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":{"tur":"sutun","baslik":"Telefon satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[750,125,500,1125]}]}},{"kimlik":"ca40148e5ee0","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 96 cm ve 160 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"256 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"16 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"},{"harf":"C","metin":"8 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"480 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"32 cm","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"96 = 32·3   ve   160 = 32·5"},{"aciklama":"Ortak çarpan 32; kalan çarpanlar (3 ve 5) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(96, 160) = 32"},{"aciklama":"En büyük parça uzunluğu:","ifade":"32 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"9891ae2e9cae","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Yusuf, Merve ve Burak arasında sırasıyla 4, 9 ve 10 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 4.140 TL olduğuna göre, Burak'ın payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"13.800 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"2.340 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"1.800 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.380 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"720 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"4 + 9 + 10 = 23"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"4.140 / 23 = 180 TL"},{"aciklama":"Burak bu paylardan 10 tane alır:","ifade":"10 × 180 = 1.800 TL"},{"aciklama":"Burak'ın payı:","ifade":"1.800 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.612,"gorsel":null},{"kimlik":"8ccc8153ad1b","sablon":"yuzde.faiz.basit_ay","govde":"30.000 TL tutarındaki bir anapara, yıllık %15 basit faiz oranıyla 5 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"31.875 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"1.875 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"4.500 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"D","metin":"900 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"22.500 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"5 ay, yıl cinsinden:","ifade":"5/12"},{"aciklama":"Faiz tutarı:","ifade":"30.000 × 15/100 × 5/12 = 1.875 TL"},{"aciklama":"Elde edilen faiz:","ifade":"1.875 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"3b4d0567acdd","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 10 kız öğrencinin matematik notu ortalaması 40, 40 erkek öğrencinin ortalaması ise 75'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"68","dogru":true,"yanilgi":null},{"harf":"B","metin":"3.400","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"47","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"340","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"57,5","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"10 × 40 + 40 × 75 = 3.400"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"10 + 40 = 50"},{"aciklama":"Sınıf ortalaması:","ifade":"3.400 / 50 = 68"},{"aciklama":"Sınıfın ortalaması:","ifade":"68"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"e76bfe575661","sablon":"mantik.dizi.terim_sirasi","govde":"10, 18, 26, 34, ... biçiminde devam eden dizide 138 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"16","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"17,25","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"17","dogru":true,"yanilgi":null},{"harf":"D","metin":"138","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"18","dogru":false,"yanilgi":"ardisik_terim_sayisi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"18 − 10 = 8"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 10 + (n − 1)·8"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"138 = 10 + (n − 1)·8 → n = 17"},{"aciklama":"Terimin sırası:","ifade":"17"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"39fb2e30c93f","sablon":"problem.isci.kalan_is","govde":"Bir işi Fatma tek başına 40 günde, Serkan tek başına 24 günde bitirmektedir. Fatma işe başlayıp 25 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Serkan tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"9 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"15 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"32 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"64 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"E","metin":"24 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Fatma günde işin 1/40'ını yapıyor; 25 günde:","ifade":"25/40"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 25/40 = 3/8"},{"aciklama":"Serkan işin tamamını 24 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"3/8 × 24 = 9"},{"aciklama":"Kalan iş için gereken süre:","ifade":"9 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":1.24,"gorsel":null},{"kimlik":"be7844d1034c","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|3x + 5| < 60 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"20","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"B","metin":"37","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"42","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"39","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"E","metin":"40","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"|A| < 60 eşitsizliği, A'nın −60 ile 60 arasında olması demektir:","ifade":"−60 < 3x + 5 < 60"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−65/3 < x < 55/3"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"40 tane"},{"aciklama":"Tam sayı adedi:","ifade":"40"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"6670da8619ef","sablon":"veri.ortalama.eksik_terim","govde":"5 öğrencinin sınav notu ortalaması 69. Öğrencilerden 4'ü sırasıyla 96, 76, 39 ve 97 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"77","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"37","dogru":true,"yanilgi":null},{"harf":"C","metin":"308","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"134","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"106","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"69 × 5 = 345"},{"aciklama":"Bilinen notların toplamı:","ifade":"96 + 76 + 39 + 97 = 308"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"345 − 308 = 37"},{"aciklama":"Kalan öğrencinin notu:","ifade":"37"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":null},{"kimlik":"6529ab65eef1","sablon":"oran.temel.oran_ve_fark","govde":"Mustafa'nın parasının Emre'nin parasına oranı 11/9'dur. Aralarındaki fark 480 TL olduğuna göre Mustafa kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"2.160 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"2.640 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"4.800 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"240 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"264 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Mustafa 11k, Emre 9k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"11k − 9k = 2k = 480"},{"aciklama":"Birim payı bul:","ifade":"k = 480 / 2 = 240"},{"aciklama":"Mustafa için:","ifade":"11 × 240 = 2.640"},{"aciklama":"Mustafa'nın parası:","ifade":"2.640 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":2.247,"gorsel":null},{"kimlik":"e18201e6b327","sablon":"yuzde.faiz.getiri_farki","govde":"2.000 TL, yıllık %45 faizle 3 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %18 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","meti