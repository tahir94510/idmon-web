an.paylastirma","veri.tablo"],"zorluk":-0.885,"gorsel":{"tur":"sutun","baslik":"Ekmek satışları (adet)","etiketler":["Merkez","Sahil","Yayla","Vadi"],"birim":"adet","seriler":[{"ad":"Ekmek","degerler":[95,180,160,155]}]}},{"kimlik":"75712acd4d4e","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 4'e bölümünden kalan 2, 10'a bölümünden kalan 8'dir. Bu koşulu sağlayan ve 485'ten büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"486","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"502","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"498","dogru":true,"yanilgi":null},{"harf":"D","metin":"518","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"E","metin":"488","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 2 eksik. Demek ki sayıya 2 eklenirse sayı hem 4 hem 10 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(4, 10) = 20"},{"aciklama":"Sayı 20'nin katından 2 eksiktir. 485'ten büyük ilk böyle sayı:","ifade":"498"},{"aciklama":"Aranan sayı:","ifade":"498"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.178,"gorsel":null},{"kimlik":"53efa693e2aa","sablon":"mantik.dizi.terim_sirasi","govde":"3, 9, 15, 21, ... biçiminde devam eden dizide 111 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"19","dogru":true,"yanilgi":null},{"harf":"B","metin":"20","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"C","metin":"18","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"18,5","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"111","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"9 − 3 = 6"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 3 + (n − 1)·6"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"111 = 3 + (n − 1)·6 → n = 19"},{"aciklama":"Terimin sırası:","ifade":"19"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.862,"gorsel":null},{"kimlik":"b3bd221f5baa","sablon":"problem.sayi.verme_alma","govde":"Mustafa, Fatma'ya kartlarının 20 tanesini verirse ikisinin kart sayıları eşit olmaktadır. Fatma, Mustafa'ya kartlarının 4 tanesini verirse Mustafa'nın kart sayısı Fatma'nınkinin 3 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç kartı vardır?","secenekler":[{"harf":"A","metin":"68","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"84","dogru":false,"yanilgi":"verme_tek_taraf"},{"harf":"C","metin":"48","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"96","dogru":true,"yanilgi":null},{"harf":"E","metin":"56","dogru":false,"yanilgi":"verme_farki_tek_sayildi"}],"cozum":[{"aciklama":"Mustafa 20 tane verince kendisi 20 azalır, Fatma 20 artar: aradaki fark 40 kapanır. Eşitlendiklerine göre baştaki fark 40'tır.","ifade":null},{"aciklama":"Fatma'nın sayısına x dersek Mustafa'nınki x + 40 olur. İkinci koşulda Fatma 4 tane verir, Mustafa 4 tane alır:","ifade":"x + 40 + 4 = 3·(x − 4)"},{"aciklama":"Denklemi çöz:","ifade":"x = 28"},{"aciklama":"Toplam x + (x + 40) olduğuna göre:","ifade":"96"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"b21e54275d09","sablon":"veri.grafik.sutun_fark","govde":"Bir işletmenin dört bölgede sattığı Çay ve Kahve sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Güney bölgesinde satılan Çay sayısı, aynı bölgede satılan Kahve sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"315 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"65 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"110 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"ha