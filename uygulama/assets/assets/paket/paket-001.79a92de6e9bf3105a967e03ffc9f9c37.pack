,{"harf":"C","metin":"ĞPNMFL","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"D","metin":"FOLKDJ","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"E","metin":"GÖMLEK","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Örnekten kaydırma miktarını bul; bütün harflerde aynı çıkmalı:","ifade":"D→F , E→G , F→Ğ , T→Ü , E→G , R→Ş  ⟹ 2 sıra ileri"},{"aciklama":"Şifreyi çözmek, kuralı **ters** yönde uygulamaktır: her harf 2 sıra geri alınır.","ifade":null},{"aciklama":"Harfleri geri al:","ifade":"H→G , R→Ö , O→M , N→L , G→E , M→K"},{"aciklama":"Aranan kelime:","ifade":"GÖMLEK"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":1.218,"gorsel":null},{"kimlik":"9145079296b7","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Eskişehir'e giderken yolun ilk bölümünü saatte 70 km hızla 2 saatte, kalan bölümünü saatte 100 km hızla 4 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"510 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"B","metin":"480 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"C","metin":"540 km","dogru":true,"yanilgi":null},{"harf":"D","metin":"420 km","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"E","metin":"140 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"70 × 2 = 140 km"},{"aciklama":"İkinci bölüm:","ifade":"100 × 4 = 400 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"140 + 400 = 540 km"},{"aciklama":"Toplam yol:","ifade":"540 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"f9c70ce05881","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"653A8 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"},{"harf":"C","metin":"10","dogru":true,"yanilgi":null},{"harf":"D","metin":"4","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"E","metin":"15","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A8 sayısı 4'ün katı olmalı ⟹ 28 ve 88"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"6 + 5 + 3 + A + 8 = 22 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"2 ve 8"},{"aciklama":"Bu rakamları topla:","ifade":"2 + 8 = 10"},{"aciklama":"Rakamların toplamı:","ifade":"10"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"900dfe690ecb","sablon":"veri.grafik.sutun_en_cok_dusen","govde":"Bir işletmenin dört şubede sattığı Telefon sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre **ardışık** iki şube arasındaki en büyük düşüş kaç adettir?","secenekler":[{"harf":"A","metin":"200 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"100 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"25 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"130 adet","dogru":false,"yanilgi":"ardisiklik_sarti_atlandi"},{"harf":"E","metin":"150 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Ardışık dönemlerin farklarını sırayla al:","ifade":"A şubesi→B şubesi: −35 · B şubesi→C şubesi: 100 · C şubesi→D şubesi: −130"},{"aciklama":"Düşüş, farkın **pozitif** olduğu yerdedir; en büyüğü seç:","ifade":"100"},{"aciklama":"En büyük düşüş:","ifade":"100 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.519,"gorsel":{"tur":"sutun","baslik":"Telefon satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[115,150,50,180]}]}},{"kimlik":"34f81d59e90a","sablon":"kume.sayma.iki_gruptan_secim","govde":"9 kadın ve 8 erkekten oluşan bir ekipten, 1 kadın ve 2 erkek içeren bir komite kurulacaktır. Bu komite kaç farklı biçimde kurulabilir?","secenekler":[{"harf":"A","metin":"252","dogru":true,"yanilgi":null},{"harf":"B","metin":"504","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"C","metin":"324","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"D","metin":"680","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"E","metin":"37","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"}],"cozum":[{"aciklama":"Komitede görev ayrımı yok; kimin önce seçildiği sonucu değiştirmez. Böyle sırasız seçimlere kombinasyon denir ve C(n, r) ile yazılır: n kişiden r kişiyi seçme sayısı.","ifade":null},{"aciklama":"Kadınları seç. 9 kişiden 1 kişi:","ifade":"C(9, 1) = (9) / (1) = 9"},{"aciklama":"Erkekleri seç. 8 kişiden 2 kişi:","ifade":"C(8, 2) = (8×7) / (2×1) = 28"},{"aciklama":"İki seçim peş peşe yapıldığı için sayılar çarpılır:","ifade":"9 × 28 = 252"},{"aciklama":"Farklı komite sayısı:","ifade":"252"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":1.218,"gorsel":null},{"kimlik":"22e71b3c8a45","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 8 litre yakıt tüketmektedir.\n\nBu araç Konya'ya yapılan 2.600 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"26 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"325 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"8 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"208 litre","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.080 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"8/100 = x/2.600"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.600 × 8/100 = 208"},{"aciklama":"Tüketilen yakıt:","ifade":"208 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.462,"gorsel":null},{"kimlik":"942b3b2b7073","sablon":"yuzde.artis.indirim","govde":"Fiyatı 2.800 TL olan bir ayakkabı, %80 indirimle satılmaktadır. Ayakkabının indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"560 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"112 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"2.720 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"5.040 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"2.240 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"2.800 × 80 / 100 = 2.240"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"2.800 − 2.240 = 560"},{"aciklama":"İndirimli fiyat:","ifade":"560 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.322,"gorsel":null},{"kimlik":"8c8fe656d5eb","sablon":"veri.grafik.sutun_fark","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre B şubesinde satılan Telefon sayısı, aynı şubede satılan Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"210 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"105 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"55 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"45 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"275 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Önce sorunun istediği şube işaretle: B şubesi.","ifade":null},{"aciklama":"Telefon sütununu oku:","ifade":"190 adet"},{"aciklama":"Tablet sütununu oku:","ifade":"85 adet"},{"aciklama":"İki değerin farkını al:","ifade":"190 − 85 = 105"},{"aciklama":"Aradaki fark:","ifade":"105 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.737,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[145,190,140,125]},{"ad":"Tablet","degerler":[110,85,60,70]}]}},{"kimlik":"8c7af9966844","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 4'e bölümünden kalan 2, 10'a bölümünden kalan 8'dir. Bu koşulu sağlayan ve 205'ten büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"222","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"218","dogru":true,"yanilgi":null},{"harf":"C","metin":"238","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"206","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"E","metin":"208","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 2 eksik. Demek ki sayıya 2 eklenirse sayı hem 4 hem 10 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(4, 10) = 20"},{"aciklama":"Sayı 20'nin katından 2 eksiktir. 205'ten büyük ilk böyle sayı:","ifade":"218"},{"aciklama":"Aranan sayı:","ifade":"218"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.178,"gorsel":null},{"kimlik":"25285082bf08-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Deniz ile Serkan birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"125 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"250 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"100 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"D","metin":"60 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"50 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/150 + 1/100 = 5/300"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"300/5 = 60 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"60 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.875,"gorsel":null,"grup":"25285082bf08","grup_govde":"Bir işi Deniz tek başına 150 günde, Serkan tek başına 100 günde bitirmektedir."},{"kimlik":"25285082bf08-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Deniz işe başlayıp 105 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Serkan tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"100 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"B","metin":"250 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"125 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"70 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"30 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Deniz bir günde işin 1/150'sini yapıyor; 105 gün çalışınca yaptığı iş:","ifade":"105/150"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(150 − 105)/150 = 3/10"},{"aciklama":"Serkan işin tamamını 100 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"3/10 × 100 = 30"},{"aciklama":"Kalan iş için gereken süre:","ifade":"30 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.051,"gorsel":null,"grup":"25285082bf08","grup_govde":"Bir işi Deniz tek başına 150 günde, Serkan tek başına 100 günde bitirmektedir."},{"kimlik":"4fc011f97816","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede DEFTER kelimesi FÇĞSGÖ biçiminde yazılmaktadır. Aynı kurala göre BARDAK kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"ÇYŞCCİ","dogru":true,"yanilgi":null},{"harf":"B","metin":"ZCÖFYM","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"C","metin":"ZYÖCYİ","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"D","metin":"DZTÇÇJ","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"E","metin":"ÇCŞFCM","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"D→F (+2) , E→Ç (−2) , F→Ğ (+2) , T→S (−2) , E→G (+2) , R→Ö (−2)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 2 ileri, çift sıradakiler 2 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı BARDAK kelimesine uygula:","ifade":"B→Ç , A→Y , R→Ş , D→C , A→C , K→İ"},{"aciklama":"Şifrelenmiş kelime:","ifade":"ÇYŞCCİ"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"d1aad5db3f69","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Bursa ile Eskişehir arasındaki yolu giderken 58 km/sa, dönerken 42 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"58 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"50 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"100 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"D","metin":"48,72 km/sa","dogru":true,"yanilgi":null},{"harf":"E","metin":"24,36 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/58 + x/42 = x·(100)/(58·42)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·100/(58·42)] = 2·58·42/100 = 48,72 km/sa"},{"aciklama":"Ortalama hız:","ifade":"48,72 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"2d3ae856b8e4","sablon":"veri.grafik.sutun_ortalama","govde":"Bir işletmenin dört ayda sattığı Kitap sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"50 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"75 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"60 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"D","metin":"100 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"70 adet","dogru":false,"yanilgi":"ortalama_uc_degerlerden"}],"cozum":[{"aciklama":"Dört sütunun değerlerini topla:","ifade":"110 + 30 + 60 + 100 = 300"},{"aciklama":"Ortalama, toplamın sütun sayısına bölümüdür:","ifade":"300 / 4 = 75"},{"aciklama":"Ortalama satış:","ifade":"75 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":{"tur":"sutun","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[110,30,60,100]}]}},{"kimlik":"7438f4ad3411","sablon":"oran.paylastirma.artan_pay","govde":"2.070 TL paranın bir kısmı Kerem'e ve Burak'a 7 : 3 oranında dağıtılmış, Kerem'in payı 1.365 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"330 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"207 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"1.365 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"120 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"4.020 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Kerem'in payından birim payı çöz:","ifade":"7k = 1.365 → k = 195"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(7 + 3) × 195 = 1.950 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"2.070 − 1.950 = 120 TL"},{"aciklama":"Geriye kalan:","ifade":"120 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":3.434,"gorsel":null},{"kimlik":"c814fadd2578","sablon":"yuzde.artis.zam","govde":"Fiyatı 4.800 TL olan bir kulaklık, %4 zamlanmıştır. Zamdan sonra kulaklığın fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"24.000 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"B","metin":"192 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"4.608 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"4.992 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"4.804 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"4.800 × 4/100 = 192 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"4.800 + 192 = 4.992 TL"},{"aciklama":"Zamlı fiyat:","ifade":"4.992 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.813,"gorsel":null},{"kimlik":"a021901fa951","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 6 dakikada bir, B hattı 18 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"24 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"36 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"18 dakika","dogru":true,"yanilgi":null},{"harf":"D","metin":"6 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"108 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"6 ve 18 sayılarının EKOK'u:","ifade":"EKOK(6, 18) = 18"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"18 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.187,"gorsel":null},{"kimlik":"3765bff8f585","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört şubede satılan toplam Telefon sayısı, toplam Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"115 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"B","metin":"5 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"C","metin":"15 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"60 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"135 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Soru tek bir şube değil, dördünün toplamını istiyor. Önce Telefon sütunlarını topla:","ifade":"125 + 175 + 40 + 55 = 395"},{"aciklama":"Sonra Tablet sütunlarını topla:","ifade":"120 + 40 + 140 + 35 = 335"},{"aciklama":"İki toplamın farkını al:","ifade":"395 − 335 = 60"},{"aciklama":"Aradaki fark:","ifade":"60 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.612,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[125,175,40,55]},{"ad":"Tablet","degerler":[120,40,140,35]}]}},{"kimlik":"c299dbde13de","sablon":"cebir.denklem.dagitmali","govde":"2(x + 3) − 5(x − 7) = 53 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"12/7","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"−4","dogru":true,"yanilgi":null},{"harf":"C","metin":"−1","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−40/3","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"−82/3","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Parantezleri dağıt; ikinci parantezin önündeki eksi, içerideki her terimin işaretini çevirir:","ifade":"2x + 6 − 5x + 35 = 53"},{"aciklama":"Benzer terimleri topla:","ifade":"−3x + 41 = 53"},{"aciklama":"Sabit terimi karşıya geçir, yani iki taraftan da 41 çıkar:","ifade":"−3x = 53 − 41 = 12"},{"aciklama":"İki tarafı −3 sayısına böl; x değeri:","ifade":"−4"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"bf5bfacaf4bd","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre iki ürünün toplam satışının en yüksek olduğu ay için bu toplam kaç adettir?","secenekler":[{"harf":"A","metin":"295 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"240 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"590 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"245 adet","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"E","metin":"155 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Soru tek bir seriyi değil, iki serinin toplamını istiyor; her ay için iki sütunu topla:","ifade":"Mayıs: 195 , Haziran: 295 , Temmuz: 245 , Ağustos: 225"},{"aciklama":"Toplamların en büyüğü:","ifade":"Haziran için 295"},{"aciklama":"En yüksek toplam satış:","ifade":"295 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["veri.tablo"],"zorluk":0.873,"gorsel":{"tur":"sutun","baslik":"Bisiklet ve Scooter satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[45,155,155,140]},{"ad":"Scooter","degerler":[150,140,90,85]}]}},{"kimlik":"7f6eb54c6b1c","sablon":"oran.paylastirma.fark","govde":"3.360 TL tutarındaki bir ödül, Merve ile Mustafa arasında 5/9 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.200 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"960 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.680 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"240 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"3.360 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"5 + 9 = 14"},{"aciklama":"Bir parçanın değeri:","ifade":"3.360 / 14 = 240 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(9 − 5) × 240 = 960 TL"},{"aciklama":"Aradaki fark:","ifade":"960 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":1.304,"gorsel":null},{"kimlik":"38cced982973","sablon":"yuzde.faiz.anapara","govde":"Yıllık %24 basit faiz oranıyla 15 ay vadeye yatırılan bir anapara 6.120 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"20.400 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"25.500 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"C","metin":"1.360 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"D","metin":"1.700 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"E","metin":"26.520 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"15 ay için faiz katsayısı:","ifade":"24/100 × 15/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"6.120 / (24 × 15/1200) = 20.400 TL"},{"aciklama":"Anapara:","ifade":"20.400 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.641,"gorsel":null},{"kimlik":"204711211387","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 108 cm ve 180 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"288 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"18 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"},{"harf":"C","metin":"36 cm","dogru":true,"yanilgi":null},{"harf":"D","metin":"540 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"8 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"108 = 36·3   ve   180 = 36·5"},{"aciklama":"Ortak çarpan 36; kalan çarpanlar (3 ve 5) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(108, 180) = 36"},{"aciklama":"En büyük parça uzunluğu:","ifade":"36 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":1.304,"gorsel":null},{"kimlik":"4bcf8cb10660","sablon":"mantik.dizi.artan_fark","govde":"32, 37, 44, 53, 64, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"77","dogru":true,"yanilgi":null},{"harf":"B","metin":"64","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"C","metin":"92","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"75","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"76","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"37−32=5 , 44−37=7 , 53−44=9 , 64−53=11"},{"aciklama":"Farklar sabit değil; her adımda 2 artıyor. Sıradaki fark:","ifade":"11 + 2 = 13"},{"aciklama":"Son terime bu farkı ekle:","ifade":"64 + 13 = 77"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"77"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"74b89570457a","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 45 km sabit hızla yola çıkmıştır. 2 saat sonra aynı noktadan aynı yöne, saatte 63 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"90 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"10/7 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"C","metin":"5 saat","dogru":true,"yanilgi":null},{"harf":"D","metin":"5/3 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"5/6 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"45 × 2 = 90 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"63 − 45 = 18 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"90 / 18 = 5"},{"aciklama":"Yetişme süresi:","ifade":"5 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"c9b170a22da8","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört şubede sattığı Telefon sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre A şubesinde satılan Telefon sayısı, dört şubede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%80","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"%20","dogru":true,"yanilgi":null},{"harf":"C","metin":"%40","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"%100","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"100 + 25 + 250 + 125 = 500"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"100 / 500 × 100 = %20"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%20"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.495,"gorsel":{"tur":"sutun","baslik":"Telefon satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[100,25,250,125]}]}},{"kimlik":"0cd66e8d5354","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 6 kız öğrencinin matematik notu ortalaması 80, 42 erkek öğrencinin ortalaması ise 40'tır. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"60","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"45","dogru":true,"yanilgi":null},{"harf":"C","metin":"75","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"2.160","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"360","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"6 × 80 + 42 × 40 = 2.160"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"6 + 42 = 48"},{"aciklama":"Sınıf ortalaması:","ifade":"2.160 / 48 = 45"},{"aciklama":"Sınıfın ortalaması:","ifade":"45"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"482c3fb5d2c1","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|x − 7| < 19 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"37","dogru":true,"yanilgi":null},{"harf":"B","metin":"19","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"18","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"D","metin":"39","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"23","dogru":false,"yanilgi":"mutlak_deger_dagitildi"}],"cozum":[{"aciklama":"|A| < 19 eşitsizliği, A'nın −19 ile 19 arasında olması demektir:","ifade":"−19 < x − 7 < 19"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−12 < x < 26"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"37 tane"},{"aciklama":"Tam sayı adedi:","ifade":"37"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.32,"gorsel":null},{"kimlik":"12885d54fe91","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Mustafa, Serkan ve Deniz arasında sırasıyla 2, 4 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 4.080 TL olduğuna göre, Serkan'ın payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"960 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.360 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"5.440 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"2.640 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"3.120 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 4 + 11 = 17"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"4.080 / 17 = 240 TL"},{"aciklama":"Serkan bu paylardan 4 tane alır:","ifade":"4 × 240 = 960 TL"},{"aciklama":"Serkan'ın payı:","ifade":"960 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.885,"gorsel":null},{"kimlik":"eb19e9d806f0","sablon":"yuzde.faiz.basit_ay","govde":"22.800 TL tutarındaki bir anapara, yıllık %40 basit faiz oranıyla 2 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.520 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"18.240 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"4.560 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"D","metin":"9.120 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"E","metin":"24.320 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"2 ay, yıl cinsinden:","ifade":"2/12"},{"aciklama":"Faiz tutarı:","ifade":"22.800 × 40/100 × 2/12 = 1.520 TL"},{"aciklama":"Elde edilen faiz:","ifade":"1.520 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"18a8b7a1e2c9","sablon":"cebir.denklem.kesirli","govde":"(x + 3)/2 − (x − 1)/4 = −2 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"−13","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−9","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"−12","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−15","dogru":true,"yanilgi":null},{"harf":"E","metin":"−5","dogru":false,"yanilgi":"taraf_degistirirken_toplama"}],"cozum":[{"aciklama":"Paydaların EKOK'u 4; denklemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(2, 4) = 4"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"2(x + 3) − 1(x − 1) = −8"},{"aciklama":"Benzer terimleri topla:","ifade":"x + 7 = −8"},{"aciklama":"x'i yalıt:","ifade":"x = −15 / 1 = −15"},{"aciklama":"x değeri:","ifade":"−15"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":2.331,"gorsel":null},{"kimlik":"b5d902e7550f","sablon":"veri.ortalama.eksik_terim","govde":"5 öğrencinin sınav notu ortalaması 69. Öğrencilerden 4'ü sırasıyla 48, 96, 89 ve 31 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"112","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"81","dogru":true,"yanilgi":null},{"harf":"C","metin":"66","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"150","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"50","dogru":false,"yanilgi":"toplamda_deger_iki_kez"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"69 × 5 = 345"},{"aciklama":"Bilinen notların toplamı:","ifade":"48 + 96 + 89 + 31 = 264"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"345 − 264 = 81"},{"aciklama":"Kalan öğrencinin notu:","ifade":"81"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":null},{"kimlik":"8c40690320ec","sablon":"mantik.dizi.carpansal","govde":"13, 47, 183, 727, 2.903, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"5.079","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"B","metin":"11.607","dogru":true,"yanilgi":null},{"harf":"C","metin":"46.423","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"11.612","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"2.903","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"}],"cozum":[{"aciklama":"Ardışık terimlerin farkları sabit değil; oran da tam çıkmıyor. Kural iki işlemli olabilir.","ifade":null},{"aciklama":"Her terim bir öncekinin katının sabitle toplamıdır:","ifade":"aₙ₊₁ = 4 · aₙ − 5"},{"aciklama":"Kuralı son terime uygula:","ifade":"4 × 2.903 − 5 = 11.607"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"11.607"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"42c2807e4022","sablon":"problem.isci.birlikte","govde":"Bir işi Serkan tek başına 52 günde, Mehmet tek başına 117 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"84,5 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"52 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"169 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"D","metin":"36 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"65 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/52 + 1/117 = 169/6084"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"6084/169 = 36 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"36 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.358,"gorsel":null},{"kimlik":"e1b48ea1359e","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 10| = 6 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"−64","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"136","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"64","dogru":true,"yanilgi":null},{"harf":"D","metin":"4","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"E","metin":"16","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 10 + 6 = 16 ve x = 10 − 6 = 4"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(10 + 6) × (10 − 6) = 10² − 6² = 64"},{"aciklama":"Köklerin çarpımı:","ifade":"64"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"0bf8c85e2628","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 9 kişinin yaş ortalaması 37. Gruptan bir kişi ayrılınca ortalama 39 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"18","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"312","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"21","dogru":true,"yanilgi":null},{"harf":"D","metin":"645","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"2","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 9 × 37","ifade":"333"},{"aciklama":"Ayrıldıktan sonra grup 8 kişi: 8 × 39","ifade":"312"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"333 − 312 = 21"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"21"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.208,"gorsel":null},{"kimlik":"e13c6e2f7a43","sablon":"oran.temel.oran_ve_fark","govde":"Serkan'ın parasının Deniz'in parasına oranı 13/9'dur. Aralarındaki fark 1.760 TL olduğuna göre Serkan kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"440 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"5.720 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"9.680 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"1.040 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"E","metin":"3.960 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Serkan 13k, Deniz 9k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"13k − 9k = 4k = 1.760"},{"aciklama":"Birim payı bul:","ifade":"k = 1.760 / 4 = 440"},{"aciklama":"Serkan için:","ifade":"13 × 440 = 5.720"},{"aciklama":"Serkan'ın parası:","ifade":"5.720 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.653,"gorsel":null},{"kimlik":"4b1407833b1e","sablon":"yuzde.faiz.getiri_farki","govde":"14.000 TL, yıllık %30 faizle 4 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %15 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"15 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"525 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"700 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.100 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"30 − 15 = 15 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"15/100 × 4/12"},{"aciklama":"Anaparayla çarp:","ifade":"14.000 × 15/100 × 4/12 = 700 TL"},{"aciklama":"Getiri farkı:","ifade":"700 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.107,"gorsel":null},{"kimlik":"5b10c5c67e94","sablon":"kume.sayma.rakamlarla_sayi","govde":"0, 3, 4, 5, 8 ve 9 rakamları kullanılarak, rakamları birbirinden farklı kaç üç basamaklı sayı yazılabilir?","secenekler":[{"harf":"A","metin":"20","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"B","metin":"180","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"C","metin":"100","dogru":true,"yanilgi":null},{"harf":"D","metin":"15","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"E","metin":"120","dogru":false,"yanilgi":"sayma_ozdes_nesne"}],"cozum":[{"aciklama":"Basamaklar soldan sağa doldurulur ve her adımda kullanılan rakam havuzdan çıkar.","ifade":null},{"aciklama":"Bir sayı 0 ile başlayamaz; ilk basamak için 6 rakamdan 0 hariç 5 seçenek vardır.","ifade":null},{"aciklama":"Kalan basamaklar için seçenekler:","ifade":"5 × 5 × 4 = 100"},{"aciklama":"Yazılabilecek sayı adedi:","ifade":"100"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"c148363a0ae4","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 20 kişilik A grubunun puan ortalaması 90, 30 kişilik B grubunun puan ortalaması 60 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"75","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"3.600","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"180","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"72","dogru":true,"yanilgi":null},{"harf":"E","metin":"150","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 20 × 90","ifade":"1.800"},{"aciklama":"B grubu: 30 × 60","ifade":"1.800"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"3.600 / 50 = 72"},{"aciklama":"Ortak ortalama:","ifade":"72"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.592,"gorsel":null},{"kimlik":"9067c5a918c3","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 47| = 22 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"12,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"B","metin":"22","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"−47","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"34,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"47","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değer 22'ye eşitse içerideki ifade 22 ya da −22 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 47 = 22 ⟹ x = 34,5"},{"aciklama":"İkinci durum:","ifade":"2x − 47 = −22 ⟹ x = 12,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"34,5 + 12,5 = 2 × 47 / 2 = 47"},{"aciklama":"Köklerin toplamı:","ifade":"47"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.81,"gorsel":null},{"kimlik":"834b5d4fbf5c","sablon":"mantik.dizi.ikili_orgu","govde":"19, 18, 24, 27, 29, 36, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"24","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"B","metin":"43","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"45","dogru":false,"yanilgi":"dizi_yanlis_altdizi"},{"harf":"D","metin":"39","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"E","metin":"34","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 5 artıyor:","ifade":"19, 24, 29"},{"aciklama":"Çift sıradakiler 9 değişiyor:","ifade":"18, 27, 36"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"29 + 5 = 34"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"34"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"601e3b7278eb","sablon":"problem.isci.ek_isci","govde":"10 işçi bir işi 30 günde bitirmektedir. Aynı iş 12 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"18 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"B","metin":"22 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"C","metin":"25 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"4 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"15 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"10 × 30 = 300"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"300 / 12 = 25"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"25 − 10 = 15"},{"aciklama":"Gereken ek işçi:","ifade":"15 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.592,"gorsel":null},{"kimlik":"f911f4323a3f","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 28 kişilik bir grubun yaş ortalaması 80, ikinci bir grubun yaş ortalaması ise 55'tir. İki grup birleştiğinde yaş ortalaması 69 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"50 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"25 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"42 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"28 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"22 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"28·80 + n·55"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(28·80 + n·55) / (28 + n) = 69"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"28·(80 − 69) = n·(69 − 55)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"22 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.304,"gorsel":null},{"kimlik":"1d48790383e8","sablon":"oran.temel.oran_ve_toplam","govde":"Ali'nin parasının Ece'nin parasına oranı 13/7'dir. İkisinin parası toplam 3.600 TL olduğuna göre Ali kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"7.800 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"B","metin":"2.340 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.800 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"180 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"1.260 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Ali 13k, Ece 7k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"13k + 7k = 20k = 3.600"},{"aciklama":"Birim payı bul:","ifade":"k = 3.600 / 20 = 180"},{"aciklama":"Ali için:","ifade":"13 × 180 = 2.340"},{"aciklama":"Ali'nin parası:","ifade":"2.340 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":1.604,"gorsel":null},{"kimlik":"2ed9d9b782ff","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 2.000 TL olan bir tablet %40 kârla, maliyeti 400 TL olan bir buzdolabı ise %10 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"30 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"800 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"720 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"840 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"760 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"2.000 × 40/100 = 800 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"400 × 10/100 = 40 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"800 − 40 = 760 TL"},{"aciklama":"Net kâr:","ifade":"760 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.545,"gorsel":null},{"kimlik":"0611b880f920","sablon":"veri.ortalama.medyan_tek","govde":"184, 86, 104, 190, 62, 138, 76, 80, 106 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"126","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"62","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"C","metin":"114","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"106","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"104","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"62 < 76 < 80 < 86 < 104 < 106 < 138 < 184 < 190"},{"aciklama":"Terim sayısı 9, yani tek: ortada tek bir terim var.","ifade":"9 → 5. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"104"},{"aciklama":"Ortanca:","ifade":"104"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.267,"gorsel":null},{"kimlik":"2f5ef1abd83c","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(9/14 + 4/7) : 12/13 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"221/168","dogru":true,"yanilgi":null},{"harf":"B","metin":"169/168","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"C","metin":"13/168","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"169/252","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"102/91","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(14, 7) = 14"},{"aciklama":"Her kesri, paydası 14 olacak biçimde genişlet:","ifade":"9/14  (paydası zaten 14)\n4/7 = 8/14  (payı da paydayı da 2 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"9/14 + 8/14 = 17/14"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"17/14 × 13/12"},{"aciklama":"Çarpımı yap:","ifade":"17 × 13 / (14 × 12) = 221/168"},{"aciklama":"İşlemin sonucu:","ifade":"221/168"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.826,"gorsel":null},{"kimlik":"0d0204dbc239","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|4x + y − 15| + z = 3\n|2x − 4y + 24| = 2z − 6\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"9","dogru":true,"yanilgi":null},{"harf":"B","metin":"11","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"C","metin":"3","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−1","dogru":false,"yanilgi":"taraf_degistirirken_toplama"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 3 − |…| ≤ 3"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 6 ≥ 0 , yani z ≥ 3"},{"aciklama":"İkisi birlikte:","ifade":"z = 3"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"4x + y = 15 , 2x − 4y = −24"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 2 , y = 7"},{"aciklama":"İstenen toplam, x + y:","ifade":"9"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"947de883a17b","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 8 kişinin yaş ortalaması 57. Gruba bir kişi daha katılınca ortalama 59'a çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"531","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"75","dogru":true,"yanilgi":null},{"harf":"C","metin":"59","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"16","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"58","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"8 × 57 = 456"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"9 × 59 = 531"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"531 − 456 = 75"},{"aciklama":"Katılan kişinin yaşı:","ifade":"75"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.325,"gorsel":null},{"kimlik":"1d9c5148d78d","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 8 : 4 : 9 oranındadır. İkinci arkadaşın parası 232 TL olduğuna göre birinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"464 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"58 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"8 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"406 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"116 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"8k : 4k : 9k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"4k = 232 → k = 58"},{"aciklama":"Sorulan payı k ile çarp (birinci arkadaş):","ifade":"8 × 58 = 464"},{"aciklama":"Birinci arkadaşın parası:","ifade":"464 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.313,"gorsel":null},{"kimlik":"c7b9e5be812c","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 2.840 TL olan bir klavye 7.100 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"h