":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"9.240 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"C","metin":"420 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"400 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"440 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Mehmet 11k, Merve 10k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"11k + 10k = 21k = 840"},{"aciklama":"Birim payı bul:","ifade":"k = 840 / 21 = 40"},{"aciklama":"Mehmet için:","ifade":"11 × 40 = 440"},{"aciklama":"Mehmet'in parası:","ifade":"440 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.297,"gorsel":null},{"kimlik":"bd7629f359f6","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 400 TL olan bir kol saati %30 kârla, maliyeti 300 TL olan bir bisiklet ise %25 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"195 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"45 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"5 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"120 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"35 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"400 × 30/100 = 120 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"300 × 25/100 = 75 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"120 − 75 = 45 TL"},{"aciklama":"Net kâr:","ifade":"45 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.228,"gorsel":null},{"kimlik":"6d9e63d04a2d","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 22 kişilik bir grubun yaş ortalaması 85, ikinci bir grubun yaş ortalaması ise 55'tir. İki grup birleştiğinde yaş ortalaması 75 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"30 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"22 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"33 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"11 kişi","dogru":true,"yanilgi":null},{"harf":"E","metin":"42 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"22·85 + n·55"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(22·85 + n·55) / (22 + n) = 75"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"22·(85 − 75) = n·(75 − 55)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"11 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.135,"gorsel":null},{"kimlik":"3f8df078ea86","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 37| = 25 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"37","dogru":true,"yanilgi":null},{"harf":"B","metin":"6","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"C","metin":"25","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"−37","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"31","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değer 25'e eşitse içerideki ifade 25 ya da −25 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 37 = 25 ⟹ x = 31"},{"aciklama":"İkinci durum:","ifade":"2x − 37 = −25 ⟹ x = 6"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"31 + 6 = 2 × 37 / 2 = 37"},{"aciklama":"Köklerin toplamı:","ifade":"37"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.604,"gorsel":null},{"kimlik":"9b4b9e6cc9fc","sablon":"veri.ortalama.medyan_tek","govde":"72, 196, 132, 58, 82, 148, 100, 160, 114 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"114","dogru":true,"yanilgi":null},{"harf":"B","metin":"82","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"C","metin":"132","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"118","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"127","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"58 < 72 < 82 < 100 < 114 < 132 < 148 < 160 < 196"},{"aciklama":"Terim sayısı 9, yani tek: ortada tek bir terim var.","ifade":"9 → 5. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"114"},{"aciklama":"Ortanca:","ifade":"114"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.267,"gorsel":null},{"kimlik":"faa25bb724d4","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 7 : 5 : 4 oranındadır. Birinci arkadaşın parası 252 TL olduğuna göre üçüncü arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"192 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"4 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"144 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"36 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"441 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"7k : 5k : 4k"},{"aciklama":"Bilinen paydan k'yı çöz (birinci arkadaş):","ifade":"7k = 252 → k = 36"},{"aciklama":"Sorulan payı k ile çarp (üçüncü arkadaş):","ifade":"4 × 36 = 144"},{"aciklama":"Üçüncü arkadaşın parası:","ifade":"144 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.036,"gorsel":null},{"kimlik":"500aa1362c0e","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 2.000 TL olan bir valiz 2.500 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%25","dogru":true,"yanilgi":null},{"harf":"B","metin":"%500","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%80","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"%125","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"2.500 TL − 2.000 TL = 500 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"500 / 2.000 × 100 = 25"},{"aciklama":"Kâr oranı:","ifade":"%25"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"9b04877b0c47","sablon":"cebir.esitsizlik.iki_taraf_bilinmeyen","govde":"4x − 23 > 8x − 2 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"−5","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"B","metin":"6","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"−7","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"1","dogru":false,"yanilgi":"esitsizlikte_sabitler_ayni_tarafta"},{"harf":"E","metin":"−6","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"x'li terimleri bir tarafta, sabitleri öbür tarafta topla:","ifade":"4x − 8x > −2 + 23"},{"aciklama":"Katsayıları sadeleştir:","ifade":"−4x > 21"},{"aciklama":"Her iki tarafı −4 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner:","ifade":"x < −5,25"},{"aciklama":"Eşitsizliği sağlayan en büyük tam sayı:","ifade":"−6"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.107,"gorsel":null},{"kimlik":"7210824b9079","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(7/9 + 1/12) : 2/3 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"31/54","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"B","metin":"4/7","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"C","metin":"25/24","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"4/3","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"E","metin":"31/24","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(9, 12) = 36"},{"aciklama":"Her kesri, paydası 36 olacak biçimde genişlet:","ifade":"7/9 = 28/36  (payı da paydayı da 4 ile çarptık)\n1/12 = 3/36  (payı da paydayı da 3 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"28/36 + 3/36 = 31/36"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"31/36 × 3/2"},{"aciklama":"Çarpımı yap:","ifade":"31 × 3 / (36 × 2) = 31/24"},{"aciklama":"İşlemin sonucu:","ifade":"31/24"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.398,"gorsel":null},{"kimlik":"5dc6223ca256","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 15 kişinin yaş ortalaması 67. Gruba bir kişi daha katılınca ortalama 71'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"127","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"60","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"69","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"131","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.136","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"15 × 67 = 1.005"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"16 × 71 = 1.136"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"1.136 − 1.005 = 131"},{"aciklama":"Katılan kişinin yaşı:","ifade":"131"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk"