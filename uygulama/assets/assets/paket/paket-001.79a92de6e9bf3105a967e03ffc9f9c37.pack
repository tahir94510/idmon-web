ik_istenen_tum_ters"},{"harf":"D","metin":"19/61","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"E","metin":"55/61","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"}],"cozum":[{"aciklama":"Önce en az bir kulübe üye olanları say; ortak üyeler bir kez düşülür:","ifade":"28 + 27 − 13 = 42"},{"aciklama":"Örnek uzay sınıfın tamamıdır:","ifade":"61 öğrenci"},{"aciklama":"Olasılık, istenen durum sayısının tüm durumlara oranıdır:","ifade":"42/61"},{"aciklama":"İstenen olasılık:","ifade":"42/61"}],"mikrobeceriler":["kume.olasilik","kume.temel"],"yanilgi_alanlari":[],"zorluk":2.585,"gorsel":null},{"kimlik":"7929b3c3a61a","sablon":"sayilar.rasyonel.toplama","govde":"5/7 + 3/11 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"8/7","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"26/7","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"C","metin":"4/9","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"D","metin":"34/77","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"76/77","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(7, 11) = 77"},{"aciklama":"Her kesri, paydası 77 olacak biçimde genişlet:","ifade":"5/7 = 55/77  (payı da paydayı da 11 ile çarptık)\n3/11 = 21/77  (payı da paydayı da 7 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"55/77 + 21/77 = 76/77"},{"aciklama":"İşlemin sonucu:","ifade":"76/77"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.123,"gorsel":null},{"kimlik":"3c2ebfdeedfd","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon'un yıllık toplam satışı, Samsun'un yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"135 adet","dogru":false,"ya