imi"},{"harf":"D","metin":"180","dogru":true,"yanilgi":null},{"harf":"E","metin":"120","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Üzüm: 2,8 − 2,5 = 0,3 TL, Ayva: 4,3 − 4 = 0,3 TL, Erik: 2,9 − 2 = 0,9 TL.","ifade":null},{"aciklama":"Üzüm ile ayvanın kilogram kârı aynı. Hepsi 0,3 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"300 · 0,3 = 90 TL"},{"aciklama":"Fazladan 72 TL yalnızca erik yüzünden: onun her kilogramı 0,6 TL fazla kazandırıyor.","ifade":"erik = 72 ÷ 0,6 = 120 kg"},{"aciklama":"İstenen: 300 − 120 =","ifade":"180"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Üzüm","degerler":[2.5,2.8]},{"ad":"Ayva","degerler":[4.0,4.3]},{"ad":"Erik","degerler":[2.0,2.9]}]}},{"kimlik":"bdcd115f17fc","sablon":"mantik.dizi.artan_fark","govde":"8, 16, 25, 35, 46, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"58","dogru":true,"yanilgi":null},{"harf":"B","metin":"54","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"34","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"46","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"57","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"16−8=8 , 25−16=9 , 35−25=10 , 46−35=11"},{"aciklama":"Farklar sabit değil; her adımda 1 artıyor. Sıradaki fark:","ifade":"11 + 1 = 12"},{"aciklama":"Son terime bu farkı ekle:","ifade":"46 + 12 = 58"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"58"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"cd5287976fce","sablon":"oran.ters.isci_gun","govde":"Bir inşaat işini 8 işçi 21 günde bitirmektedir. Aynı 