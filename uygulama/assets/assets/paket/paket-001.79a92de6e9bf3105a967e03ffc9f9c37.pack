ciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 11) = 143"},{"aciklama":"Her kesri, paydası 143 olacak biçimde genişlet:","ifade":"4/13 = 44/143  (payı da paydayı da 11 ile çarptık)\n1/11 = 13/143  (payı da paydayı da 13 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"44/143 + 13/143 = 57/143"},{"aciklama":"İşlemin sonucu:","ifade":"57/143"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.313,"gorsel":null},{"kimlik":"511e53091fcd","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede BARDAK kelimesi FUÜZEĞ biçiminde yazılmaktadır. Aynı kurala göre GÖMLEK kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"CTIPAÖ","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"B","metin":"KLSIİH","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"C","metin":"JKRHIĞ","dogru":true,"yanilgi":null},{"harf":"D","metin":"JTRPIÖ","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"E","metin":"CKIHAĞ","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"B→F (+5) , A→U (−5) , R→Ü (+5) , D→Z (−5) , A→E (+5) , K→Ğ (−5)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 5 ileri, çift sıradakiler 5 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı GÖMLEK kelimesine uygula:","ifade":"G→J , Ö→K , M→R , L→H , E→I , K→Ğ"},{"aciklama":"Şifrelenmiş kelime:","ifade":"JKRHIĞ"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"c41cce5466e4","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminde Konya'nın yaptığı satışın Trabzon'un yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"0,4","dogru":false,"yanilgi":"v