koltuklarda oturmamaktadır.\n• Elif, Zeynep adlı kişinin hemen solundadır.\n• Mehmet, Yusuf adlı kişinin solunda oturmaktadır.\n• Fatma, Zeynep adlı kişinin solunda oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Yusuf, Zeynep adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Elif, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"C","metin":"Zeynep, Elif adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Fatma, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"E","metin":"Mehmet, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Mehmet − Fatma − Elif − Zeynep − Yusuf"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Mehmet, Fatma adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"269dbc099928","sablon":"problem.karisim.tuz_orani","govde":"90 gram su ile 60 gram tuzdan oluşan bir karışıma 90 gram tuz daha ekleniyor. Yeni karışımın yüzde kaçı tuzdur?","secenekler":[{"harf":"A","metin":"%100","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"B","metin":"%37,5","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"%77,5","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"D","metin":"%62,5","dogru":true,"yanilgi":null},{"harf":"E","metin":"%40","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"ac