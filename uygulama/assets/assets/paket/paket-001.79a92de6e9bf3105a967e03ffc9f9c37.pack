","ifade":"(1.125 − 270) / 45 + 1 = 20"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"20"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":-0.193,"gorsel":null},{"kimlik":"e0b76b5168b4","sablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Bisiklet dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"18 derece","dogru":true,"yanilgi":null},{"harf":"B","metin":"5 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"C","metin":"9 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"342 derece","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"162 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Bisiklet diliminin payı:","ifade":"%5"},{"aciklama":"Merkez açısı:","ifade":"360 × 5 / 100 = 18"},{"aciklama":"Merkez açısı:","ifade":"18 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.134,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Yürüyüş","Bisiklet","Otobüs","Otomobil"],"birim":"%","seriler":[{"ad":"Pay","degerler":[15,5,45,35]}]}},{"kimlik":"8ac436f5bdc4","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 26/x = 33 olduğuna göre x² + 26²/x² kaçtır?","secenekler":[{"harf":"A","metin":"1.037","dogru":true,"yanilgi":null},{"harf":"B","metin":"985","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"1.089","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"1.063","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"E","metin":"1.141","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 26/x)² = x² + 2 · x · 26/x + 26²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 26 kalır:","ifade":"33² = x² + 26²/x² + 52"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 26²/x² = 1.089 − 52 = 1.037"},{"aciklama":"İstenen değer:","ifade":"1.037"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":3.048,"gorsel":null},{"kimlik":"8c240f0c4873","sablon":"oran.dogru.tarif_olcekleme","govde":"7 kişilik bir tarifte 880 gram un kullanılmaktadır. Aynı tarif 35 kişi için hazırlanacağına göre kaç gram un gerekir?","secenekler":[{"harf":"A","metin":"176 gram","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"B","metin":"4.400 gram","dogru":true,"yanilgi":null},{"harf":"C","metin":"908 gram","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"D","metin":"3.520 gram","dogru":false,"yanilgi":"yalniz_eklenen_kisim"},{"harf":"E","metin":"880/7 gram","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Kişi sayısı ile malzeme **doğru orantılıdır**: kişi kaç kat artarsa malzeme de o kat artar.","ifade":null},{"aciklama":"Kaç kat arttığını bul:","ifade":"35 / 7 = 5"},{"aciklama":"Malzemeyi aynı katla çarp:","ifade":"880 × 5 = 4.400"},{"aciklama":"Gereken un:","ifade":"4.400 gram"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.paylastirma","oran.ters"],"zorluk":-0.229,"gorsel":null},{"kimlik":"a6bf66b290f9","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 3.520 TL olan bir valiz %150 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%150","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"B","metin":"%375","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%40","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"%60","dogru":true,"yanilgi":null},{"harf":"E","metin":"%250","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"3