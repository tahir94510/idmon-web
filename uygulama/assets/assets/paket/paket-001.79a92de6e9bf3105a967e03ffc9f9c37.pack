amak"],"yanilgi_alanlari":[],"zorluk":-0.719,"gorsel":null},{"kimlik":"1f1e08607654","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Konya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"40 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"50 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"160 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"D","metin":"10 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"100 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: −50 · 2021→2022: −10 · 2022→2023: 10 · 2023→2024: 10"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2020 → 2021: 160 − 110 = 50 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"50 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":{"tur":"cizgi","baslik":"Konya şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[160,110,100,110,120]}]}},{"kimlik":"e8c9bfd2c7b7","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 44, s(B) = 30 ve s(A ∪ B) = 66'dır. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"22","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"B","metin":"44","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"8","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"D","metin":"36","dogru":true,"yanilgi":null},{"harf":"E","metin":"58","dogru":false,"yanilgi":"kume_yalnizca_biri"}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 44 + 30 − 66 = 8"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"44 − 8 = 36"},{"aciklama":"s(A ∖ B):","ifade":"36"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.366,"gorsel":null},{"kimlik":"6c790d1725e6","sablon":"oran.bilesik.isci_ucret","govde":"6 işçi 3 günde çalışarak toplam 9.000 TL kazanmaktadır. Aynı günlük ücretle çalışan 5 işçi 5 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"7.500 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"B","metin":"500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"15.000 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"6.480 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"E","metin":"12.500 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"9.000 / (6 × 3) = 500 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"5 × 5 = 25"},{"aciklama":"Toplam ücret:","ifade":"25 × 500 = 12.500 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"12.500 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"97e1734fed88","sablon":"yuzde.ardisik.iki_indirim","govde":"4.800 TL olan bir kol saati fiyatına önce %40 indirim, ardından kalan fiyat üzerinden %30 indirim daha yapılmıştır. Son fiyat kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.784 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"2.016 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"8.736 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"2.880 TL","dogru":false,"yanilgi":"ardisik_yuzde_tek_uygulama"},{"harf":"E","metin":"1.440 TL","dogru":false,"y