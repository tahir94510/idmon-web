risimi"},{"harf":"C","metin":"41","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"D","metin":"14","dogru":true,"yanilgi":null},{"harf":"E","metin":"27","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"}],"cozum":[{"aciklama":"12'ye bölünen sayılar 12'nin katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"108 ve 264"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(264 − 108) / 12 + 1 = 14"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"14"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":-0.284,"gorsel":null},{"kimlik":"5807522a7d02","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/1.500.000 olan bir haritada Bursa ile İzmir arasındaki uzaklık 18 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"33 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"B","metin":"18 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"270 km","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.700 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"E","metin":"27 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"18 × 1.500.000 = 27.000.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"27.000.000 / 100.000 = 270 km"},{"aciklama":"Kısayol: ölçek 1/1.500.000 olduğunda haritadaki 1 cm, 15 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"270 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":1.039,"gorsel":null},{"kimlik":"25ce9fee28c8","sablon":"yuzde.artis.degisim_orani","govde":"Bir atölyenin aylık üretimi 1.500 adetten 6.000 adede çıkmıştır. Üretimdeki artış yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%300","dogru":true,"yanilgi":null},{"harf":"B","metin":"%75","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%400","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%4.500","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%25","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Artış miktarı bulunur:","ifade":"6.000 − 1.500 = 4.500 adet"},{"aciklama":"Yüzde artış, artışın **eski** değere oranıdır:","ifade":"4.500 / 1.500 × 100 = %300"},{"aciklama":"Artış oranı:","ifade":"%300"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":3.381,"gorsel":null},{"kimlik":"71e5b8b922bb","sablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Elma dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"18 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"162 derece","dogru":true,"yanilgi":null},{"harf":"C","metin":"198 derece","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"45 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"81 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Elma diliminin payı:","ifade":"%45"},{"aciklama":"Merkez açısı:","ifade":"360 × 45 / 100 = 162"},{"aciklama":"Merkez açısı:","ifade":"162 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.547,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[45,5,15,35]}]}},{"kimlik":"40cd01c00ee5","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"81² − 75² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"−936","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"B","metin":"486","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"36","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"12.186","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"E","metin":"936","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(81 − 75)(81 + 75) = 6 × 156"},{"aciklama":"Çarpımı yap:","ifade":"6 × 156 = 936"},{"aciklama":"İşlemin sonucu:","ifade":"936"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":-0.086,"gorsel":null},{"kimlik":"488227220c56","sablon":"kume.temel.herkes_en_az_bir","govde":"Bir grupta 55 kişi vardır ve herkes bu iki dilden en az birini bilmektedir. İngilizce bilen 51, Almanca bilen 17 kişi olduğuna göre, her iki dili de bilen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"68","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"4","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"C","metin":"13","dogru":true,"yanilgi":null},{"harf":"D","metin":"42","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"E","metin":"38","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Herkes en az birini bildiği için birleşim grubun tamamıdır:","ifade":"s(A ∪ B) = 55"},{"aciklama":"Birleşim formülünü kesişim için çöz:","ifade":"s(A ∩ B) = 51 + 17 − 55 = 13"},{"aciklama":"Her iki dili de bilen kişi sayısı:","ifade":"13"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.346,"gorsel":null},{"kimlik":"83624808c25a","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"458A8 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"B","metin":"10","dogru":true,"yanilgi":null},{"harf":"C","metin":"15","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"E","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A8 sayısı 4'ün katı olmalı ⟹ 28 ve 88"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"4 + 5 + 8 + A + 8 = 25 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"2 ve 8"},{"aciklama":"Bu rakamları topla:","ifade":"2 + 8 = 10"},{"aciklama":"Rakamların toplamı:","ifade":"10"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"603ae99d9084","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 1.300 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Basketbol tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"130 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.170 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"585 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"1.300 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"10 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Basketbol diliminin payı:","ifade":"%10"},{"aciklama":"Kişi sayısı:","ifade":"1.300 × 10 / 100 = 130"},{"aciklama":"Kişi sayısı:","ifade":"130 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.291,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"%","seriler":[{"ad":"Pay","degerler":[40,10,45,5]}]}},{"kimlik":"62c84e21de85","sab