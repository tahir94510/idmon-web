":null},{"harf":"D","metin":"81 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"E","metin":"40,5 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/45 + 1/36 = 81/1620"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"1620/81 = 20 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"20 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":2.585,"gorsel":null},{"kimlik":"f49357ac7574","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 4/15 katı ile 2/21 katı arasındaki fark 12'dir.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"90","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"72","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"C","metin":"70","dogru":true,"yanilgi":null},{"harf":"D","metin":"72/35","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"E","metin":"630/19","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(4/15 − 2/21) · x = 12"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(15, 21) = 105"},{"aciklama":"Her kesri, paydası 105 olacak biçimde genişlet:","ifade":"4/15 = 28/105  (payı da paydayı da 7 ile çarptık)\n2/21 = 10/105  (payı da paydayı da 5 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"28/105 − 10/105 = 18/105"},{"aciklama":"Payı ve paydayı ortak bölenleri 3 ile sadeleştir:","ifade":"18/105 = 6/35"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 12 × 35/6 = 70"},{"aciklama":"Aranan sayı:","ifade":"70"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.366,"gorsel":null},{"kimlik":"fd785a659762","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"240 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"10 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"100 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"80 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"170 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"İzmir: 170 − 70 = 100 · Eskişehir: 105 − 95 = 10 · Samsun: 135 − 85 = 50 · Bursa: 355 − 275 = 80"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"İzmir, 100 adet"},{"aciklama":"En büyük artış:","ifade":"100 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[70,355,170,360]},{"ad":"Eskişehir","degerler":[95,305,105,30]},{"ad":"Samsun","degerler":[85,145,135,330]},{"ad":"Bursa","degerler":[275,85,355,45]}]}},{"kimlik":"86d944579426","sablon":"cebir.denklem.dagitmali","govde":"10(x + 11) − 9(x − 13) = 223 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"−4/19","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"100","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"230","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−4","dogru":true,"yanilgi":null},{"harf":"E","metin":"7","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Parantezleri dağıt; ikinci parantezin önündeki eksi, içerideki her terimin işaretini çevirir:","ifade":"10x + 110 − 9x + 117 = 223"