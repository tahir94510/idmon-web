,"dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"300 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Ocak: 295 · Şubat: 265 · Mart: 205 · Nisan: 135"},{"aciklama":"Dördünü topla:","ifade":"295 + 265 + 205 + 135 = 900"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"900/4 = 225"},{"aciklama":"Dönem ortalaması:","ifade":"225 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.865,"gorsel":{"tur":"cizgi","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[295,265,205,135]}]}},{"kimlik":"646dc38b722c","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 6, onlar basamağındaki rakam 3'tür. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"536","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"653","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"635","dogru":true,"yanilgi":null},{"harf":"D","metin":"65","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"E","metin":"608","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (6 − b) = 99 ⟹ 6 − b = 1 ⟹ b = 5"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 6 + 10 × 3 + 5 = 635"},{"aciklama":"Aranan sayı:","ifade":"635"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"45d09ad7e7d4","sablon":"cebir.denklem.sistem","govde":"x + 6y = 101 ve 7x + 3y = 44 olduğuna göre 2x + 5y kaçtır?","secenekler":[{"harf":"A","metin":"16","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"15","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"−87","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"83","dogru":true,"yanilgi":null},{"harf":"E","metin":"29","dogru":false,"yanilgi":"katsayi_yer_degistirme"}],"cozum":[{"aciklama":"İki denklemi yok etme yöntemiyle çöz:","ifade":"x = −1 , y = 17"},{"aciklama":"Sorulan ifade x ve y'nin kendisi değil, katsayılı birleşimidir:","ifade":"2 × (−1) + 5 × 17"},{"aciklama":"Değeri hesapla:","ifade":"−2 + 85 = 83"},{"aciklama":"İstenen değer:","ifade":"83"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.746,"gorsel":null},{"kimlik":"095005a1b90c","sablon":"veri.grafik.cizgi_yuzde_artis","govde":"Samsun mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2019 yılından 2020 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%25","dogru":true,"yanilgi":null},{"harf":"B","metin":"%50","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"%30","dogru":false,"yanilgi":"artis_miktari_yuzde_sanildi"},{"harf":"D","metin":"%20","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"%125","dogru":false,"yanilgi":"degisim_yerine_deger"}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"150 − 120 = 30"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"30 / 120 × 100 = %25"},{"aciklama":"Yüzde artış:","ifade":"%25"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":{"tur":"cizgi","baslik":"Samsun mağazasının yıllık cirosu (bin TL)","etiketler":["2016","2017","2018","2019","2020"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[60,50,60,120,150]}]}},{"kimlik":"c2001035ee2c","sabl