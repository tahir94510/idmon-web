":"Dergi sütununu oku:","ifade":"55 adet"},{"aciklama":"İki değerin farkını al:","ifade":"65 − 55 = 10"},{"aciklama":"Aradaki fark:","ifade":"10 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.403,"gorsel":{"tur":"sutun","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[190,170,20,65]},{"ad":"Dergi","degerler":[30,165,120,55]}]}},{"kimlik":"3687d23c7833","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 4 litre yakıt tüketmektedir.\n\nBu araç Ankara'ya yapılan 1.800 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"72 litre","dogru":true,"yanilgi":null},{"harf":"B","metin":"450 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"4 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"18 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"720 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"4/100 = x/1.800"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 1.800 × 4/100 = 72"},{"aciklama":"Tüketilen yakıt:","ifade":"72 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.827,"gorsel":null},{"kimlik":"85494c84f450-1","sablon":"veri.blok.cizgi_iki_soru","govde":"2019 yılından 2022 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"320 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"160 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"140 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"80 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"380 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2019 değeri:","ifade":"220 kişi"},{"aciklama":"2022 değeri:","ifade":"380 kişi"},{"aciklama":"Farkı al:","ifade":"380 − 220 = 160"},{"aciklama":"Artış miktarı:","ifade":"160 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.472,"gorsel":{"tur":"cizgi","baslik":"Üye sayısı","etiketler":["2019","2020","2021","2022","2023"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[220,280,360,380,340]}]},"grup":"85494c84f450","grup_govde":"Samsun şubesinin 2019–2023 yılları arasındaki üye sayısı yukarıdaki çizgi grafiğinde verilmiştir."},{"kimlik":"85494c84f450-2","sablon":"veri.blok.cizgi_iki_soru","govde":"Beş yılın üye sayısı ortalaması kaç kişidir?","secenekler":[{"harf":"A","metin":"395 kişi","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"316 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.580 kişi","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"380 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"300 kişi","dogru":false,"yanilgi":"ortalama_uc_degerlerden"}],"cozum":[{"aciklama":"Beş yılın üye sayılarını topla:","ifade":"220 + 280 + 360 + 380 + 340 = 1.580"},{"aciklama":"Ortalama, toplamın yıl sayısına bölümüdür:","ifade":"1.580 / 5 = 316"},{"aciklama":"Yıllık ortalama:","ifade":"316 kişi"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":{"tur":"cizgi","baslik":"Üye sayısı","etiketler":["2019","2020","2021","2022","2023"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[220,280,360,380,340]}]},"grup":"85494c84f450","grup_govde":"Samsun şubesinin 2019–2023 yılları arasındaki üye sayısı yukarıdaki çizgi grafiğinde verilmiştir."},{"kimlik":"3db6537d5109","sablon":"yuzde.artis.indirim","govde":"Fiyatı 2.000 TL olan bir halı, %20 indirimle satılmaktadır. Halının indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.280 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"400 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"1.600 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.400 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"1.980 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"2.000 × 20 / 100 = 400"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"2.000 − 400 = 1.600"},{"aciklama":"İndirimli fiyat:","ifade":"1.600 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.682,"gorsel":null},{"kimlik":"b88f6b4de09d","sablon":"veri.grafik.sutun_ortalama","govde":"Bir işletmenin dört şubede sattığı Telefon sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört şubede satılan Telefon sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"160 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"96 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"C","metin":"120 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"30 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"95 adet","dogru":false,"yanilgi":"ortalama_uc_degerlerden"}],"cozum":[{"aciklama":"Dört sütunun değerlerini topla:","ifade":"30 + 160 + 135 + 155 = 480"},{"aciklama":"Ortalama, toplamın sütun sayısına bölümüdür:","ifade":"480 / 4 = 120"},{"aciklama":"Ortalama satış:","ifade":"120 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.366,"gorsel":{"tur":"sutun","baslik":"Telefon satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[30,160,135,155]}]}},{"kimlik":"ba4542bc1aae","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 42 ve a · b = 366 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"1.764","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"B","metin":"2.496","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"300","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"D","metin":"1.398","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"E","metin":"1.032","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"42² − 2 × 366 = 1.764 − 732 = 1.032"},{"aciklama":"a² + b² değeri:","ifade":"1.032"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.304,"gorsel":null},{"kimlik":"464385278e8d","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 8 dakikada bir, B hattı 24 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"32 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"B","metin":"192 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"C","metin":"24 dakika","dogru":true,"yanilgi":null},{"harf":"D","metin":"48 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"8 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"8 ve 24 sayılarının EKOK'u:","ifade":"EKOK(8, 24) = 24"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"24 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"7f2a0f3d7c9e","sablon":"mantik.ozel_islem.ic_ice","govde":"x ⊕ y = 4x + 5y biçiminde tanımlanan bir işlem için 9 ⊕ (3 ⊕ 5) işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"229","dogru":false,"yanilgi":"ozel_islem_sira"},{"harf":"B","metin":"51","dogru":false,"yanilgi":"ozel_islem_terim_atlandi"},{"harf":"C","metin":"221","dogru":true,"yanilgi":null},{"harf":"D","metin":"193","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"37","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Parantez içi **önce** hesaplanır:","ifade":"3 ⊕ 5 = 4·3 + 5·5 = 37"},{"aciklama":"Bulunan sonucu dıştaki işlemde yerine yaz:","ifade":"9 ⊕ 37 = 4·9 + 5·37 = 221"},{"aciklama":"İç içe işlemin sonucu:","ifade":"221"}],"mikrobeceriler":["mantik.ozel_islem"],"yanilgi_alanlari":["mantik.dizi"],"zorluk":0.862,"gorsel":null},{"kimlik":"924682d75dc1","sablon":"problem.hareket.karsilikli","govde":"Aralarındaki uzaklık 135 km olan Eskişehir ve Trabzon şehirlerinden aynı anda birbirine doğru iki araç hareket ediyor. Araçların hızları sırasıyla 25 km/sa ve 20 km/sa olduğuna göre, araçlar kaç saat sonra karşılaşır?","secenekler":[{"harf":"A","metin":"3 saat","dogru":true,"yanilgi":null},{"harf":"B","metin":"27 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"C","metin":"5,4 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"D","metin":"6 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"6,75 saat","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Zıt yönde hareket eden araçlar için yaklaşma hızı, hızların toplamıdır:","ifade":"25 + 20 = 45 km/sa"},{"aciklama":"Karşılaşma süresi, aradaki uzaklığın yaklaşma hızına bölümüdür:","ifade":"135 / 45 = 3 saat"},{"aciklama":"Karşılaşma süresi:","ifade":"3 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.567,"gorsel":null},{"kimlik":"4b274b9147f8","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki sütun graf