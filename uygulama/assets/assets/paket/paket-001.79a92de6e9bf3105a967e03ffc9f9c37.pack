","metin":"1","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"C","metin":"11/21","dogru":false,"yanilgi":"olasilik_ornek_uzay"},{"harf":"D","metin":"12/49","dogru":true,"yanilgi":null},{"harf":"E","metin":"37/49","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"}],"cozum":[{"aciklama":"Birinci torbadan sarı çekme olasılığı:","ifade":"8/14"},{"aciklama":"İkinci torbadan sarı çekme olasılığı:","ifade":"3/7"},{"aciklama":"Torbalar birbirinden bağımsız olduğu için olasılıklar çarpılır:","ifade":"8/14 × 3/7 = 24/98 = 12/49"},{"aciklama":"İstenen olasılık:","ifade":"12/49"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":["kume.sayma"],"zorluk":1.711,"gorsel":null},{"kimlik":"73099d0b67d3","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 28 kişilik A grubunun puan ortalaması 42, 14 kişilik B grubunun puan ortalaması 78 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"81","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"120","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"2.268","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"54","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 28 × 42","ifade":"1.176"},{"aciklama":"B grubu: 14 × 78","ifade":"1.092"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"2.268 / 42 = 54"},{"aciklama":"Ortak ortalama:","ifade":"54"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.645,"gorsel":null},{"kimlik":"68a06b7b99a8","sablon":"mantik.dizi.toplamsal","govde":"16, 17, 33, 50, 83, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"83","dogru":false,"yanilgi":"dizi