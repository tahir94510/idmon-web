ade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Burak − Ece − Selin − Yusuf − Serkan"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Ece, Burak adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"de846783412d","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 25 kız öğrencinin matematik notu ortalaması 80, 10 erkek öğrencinin ortalaması ise 45'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"62,5","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"55","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"2.450","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"70","dogru":true,"yanilgi":null},{"harf":"E","metin":"98","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"25 × 80 + 10 × 45 = 2.450"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"25 + 10 = 35"},{"aciklama":"Sınıf ortalaması:","ifade":"2.450 / 35 = 70"},{"aciklama":"Sınıfın ortalaması:","ifade":"70"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"6a046c7b8563","sablon":"problem.yas.toplam_iliskisi","govde":"Deniz ile Ece'nin bugünkü yaşları toplamı 62'dir, aralarındaki yaş farkı ise 12'dir.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"25","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"53","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"C","metin":"74","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"D","metin":"45","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"E","metin":"37","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile 