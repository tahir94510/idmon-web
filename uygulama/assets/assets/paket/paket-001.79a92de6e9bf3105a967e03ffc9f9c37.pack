4de","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"40 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"155 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"290 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"20 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"5 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Dergi ilk kez Nisan döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Kitap 135, Dergi 155","ifade":"155 − 135 = 20"},{"aciklama":"Aradaki fark:","ifade":"20 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.079,"gorsel":{"tur":"cizgi","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[225,195,165,135]},{"ad":"Dergi","degerler":[65,95,125,155]}]}},{"kimlik":"70d58263b323","sablon":"oran.bilesik.isci_ucret","govde":"8 işçi 3 günde çalışarak toplam 19.200 TL kazanmaktadır. Aynı günlük ücretle çalışan 4 işçi 8 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"25.600 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"9.600 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"C","metin":"800 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"51.200 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"14.400 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"19.200 / (8 × 3) = 800 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"4 × 8 = 32"},{"aciklama":"Toplam ücret:","ifade":"32 × 800 = 25.600 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"25.600 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"7cfe2e0e5653","sablon":"yuzde.ardisik.iki_indirim","govde":"1.500 TL olan bir güneş gözlüğü fiyatına önce %40 indirim, ardından kalan fiyat üzerinden %10 indirim daha yapılmıştır. Son fiyat kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.310 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"900 TL","dogru":false,"yanilgi":"ardisik_yuzde_tek_uygulama"},{"harf":"C","metin":"690 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"810 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"750 TL","dogru":false,"yanilgi":"ardisik_yuzde_toplama"}],"cozum":[{"aciklama":"İkinci indirim ilk fiyata değil, **kalan fiyata** uygulanır; bu yüzden yüzdeler toplanmaz.","ifade":null},{"aciklama":"İlk indirimden sonra:","ifade":"1.500 TL × 60/100 = 900 TL"},{"aciklama":"İkinci indirimden sonra:","ifade":"900 TL × 90/100 = 810 TL"},{"aciklama":"Son fiyat:","ifade":"810 TL"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":0.201,"gorsel":null},{"kimlik":"0120b7b79dda","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n47, 52, 72, 117, 197, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"322","dogru":true,"yanilgi":null},{"harf":"B","metin":"321","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"C","metin":"222","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"D","metin":"197","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"277","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"5, 20, 45, 80"},{"aciklama":