ılmasıdır:","ifade":"760 − 425 = 335 TL"},{"aciklama":"Geriye kalan:","ifade":"335 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":1.796,"gorsel":null},{"kimlik":"27aab491b992-1","sablon":"veri.blok.tablo_iki_soru","govde":"Konya şubesinin satışı, toplam satışın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%74","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"%21","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"%26","dogru":true,"yanilgi":null},{"harf":"E","metin":"%65","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Konya şubesinin satışını tablodan oku:","ifade":"312 adet"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam satış.","ifade":"1.200 adet"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"312 / 1.200 × 100 = %26"},{"aciklama":"Toplam içindeki pay:","ifade":"%26"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.378,"gorsel":{"tur":"tablo","baslik":"Şubelere göre aylık satış","etiketler":["Eskişehir","Konya","Antalya","İzmir"],"birim":"adet","seriler":[{"ad":"Satış","degerler":[480,312,252,156]}]},"grup":"27aab491b992","grup_govde":"Bir şirketin dört şubesinin bir aylık satış adetleri yukarıdaki tabloda verilmiştir. Şubelerin toplam satışı 1.200 adettir."},{"kimlik":"27aab491b992-2","sablon":"veri.blok.tablo_iki_soru","govde":"Dört şubenin satış ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"480 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"400 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"300 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.200 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"318 adet","dogru":false,"yanilgi":"ortalama_uc_degerlerden"}],"cozum":[{"aciklama":"Dört şubenin satışlarını topla