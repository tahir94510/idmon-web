{"surum":1,"uretim":"2026-10-04","taksonomi_parmak_izi":"c38bfac816a16c83","motor_parmak_izi":"89f6a7c03067ceb5","tohum":20260902,"dilim":1,"madde_sayisi":500,"maddeler":[{"kimlik":"5299c4dec5b9","sablon":"cebir.denklem.sistem","govde":"x + 8y = 110 ve 3x + 2y = 0 olduğuna göre 4x + 7y kaçtır?","secenekler":[{"harf":"A","metin":"−145","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−10","dogru":false,"yanilgi":"katsayi_yer_degistirme"},{"harf":"C","metin":"5","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−25","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"65","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki denklemi yok etme yöntemiyle çöz:","ifade":"x = −10 , y = 15"},{"aciklama":"Sorulan ifade x ve y'nin kendisi değil, katsayılı birleşimidir:","ifade":"4 × (−10) + 7 × 15"},{"aciklama":"Değeri hesapla:","ifade":"−40 + 105 = 65"},{"aciklama":"İstenen değer:","ifade":"65"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.976,"gorsel":null},{"kimlik":"8ae0b82de924","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 18 dakikada bir, B hattı 36 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"72 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"54 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"C","metin":"648 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"D","metin":"18 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"E","metin":"36 dakika","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"18 ve 36 sayılarının EKOK'u:","ifade":"EKOK(18, 36) = 36"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"36 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_a