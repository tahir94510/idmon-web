toplami_yerine_sayi"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A8 sayısı 4'ün katı olmalı ⟹ 28 ve 88"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"5 + 8 + 4 + A + 8 = 25 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"2 ve 8"},{"aciklama":"Bu rakamları topla:","ifade":"2 + 8 = 10"},{"aciklama":"Rakamların toplamı:","ifade":"10"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"9fce92831a3e","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 1.320 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Yürüyüş tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"330 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"3.300 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"25 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"D","metin":"132 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"990 kişi","dogru":false,"yanilgi":"tumleyeni_verme"}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Yürüyüş diliminin payı:","ifade":"%25"},{"aciklama":"Kişi sayısı:","ifade":"1.320 × 25 / 100 = 330"},{"aciklama":"Kişi sayısı:","ifade":"330 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.058,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Yürüyüş","Bisiklet","Otobüs","Otomobil"],"birim":"%","seriler":[{"ad":"Pay","degerler":[25,10,50,15]}]}},{"kimlik":"0501770fed97","sablon":"kume.olasilik.geri_koymadan","govde":"Bir torbada 9 tane siyah, 20 tane mavi top vardır. Torbadan rastgele çekilen bir top geri konulmadan ikinci bir top çekiliyor.