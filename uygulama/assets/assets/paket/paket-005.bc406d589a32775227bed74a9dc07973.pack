 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"1.950 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.925 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Zamlı fiyat, eski fiyatın %150'sidir:","ifade":"eski × 150/100 = 5.850"},{"aciklama":"Eski fiyat, zamlı fiyatın bu orana bölümüdür:","ifade":"5.850 × 100/150 = 3.900 TL"},{"aciklama":"Zamdan önceki fiyat:","ifade":"3.900 TL"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.097,"gorsel":null},{"kimlik":"98b7b57adb83","sablon":"sayilar.mutlak.kokler_toplami","govde":"|3x − 3| = 6 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"−2","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"3","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"D","metin":"2","dogru":true,"yanilgi":null},{"harf":"E","metin":"−1","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değer 6'ya eşitse içerideki ifade 6 ya da −6 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"3x − 3 = 6 ⟹ x = 3"},{"aciklama":"İkinci durum:","ifade":"3x − 3 = −6 ⟹ x = −1"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"3 + (−1) = 2 × 3 / 3 = 2"},{"aciklama":"Köklerin toplamı:","ifade":"2"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":0.975,"gorsel":null},{"kimlik":"d3597465fbd8","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 1.000 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Bisiklet tercih edenler, Otobüs tercih edenlerden kaç kişi fazladır?","secenekler":[{"harf":"A","metin":"1.500 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"15 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"C","metin":"400 kişi","dogru":false,"yanilgi":"grafik_y