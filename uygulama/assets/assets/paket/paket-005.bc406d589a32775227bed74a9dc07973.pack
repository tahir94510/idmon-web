eri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.187,"gorsel":{"tur":"cizgi","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[170,145,120,95]},{"ad":"Dergi","degerler":[40,100,160,220]}]}},{"kimlik":"1b3693516098","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|3x − 7| < 55 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"35","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"B","metin":"18","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"36","dogru":true,"yanilgi":null},{"harf":"D","metin":"31","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"38","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"}],"cozum":[{"aciklama":"|A| < 55 eşitsizliği, A'nın −55 ile 55 arasında olması demektir:","ifade":"−55 < 3x − 7 < 55"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−16 < x < 62/3"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"36 tane"},{"aciklama":"Tam sayı adedi:","ifade":"36"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.31,"gorsel":null},{"kimlik":"d1895d260f6f","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"188² − 173² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"2.820","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"B","metin":"−5.415","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"225","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"65.273","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"E","metin":"5.415","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(188 − 173)(188 + 173) = 15 × 361"},{"aciklama":"Çarpımı yap:","ifade":"15 × 3