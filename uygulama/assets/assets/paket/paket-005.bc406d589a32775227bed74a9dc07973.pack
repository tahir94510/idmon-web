","dogru":true,"yanilgi":null},{"harf":"E","metin":"%3.604","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"5.300 − 1.696 = 3.604 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"3.604 / 5.300 × 100 = %68"},{"aciklama":"Zarar oranı:","ifade":"%68"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.994,"gorsel":null},{"kimlik":"e2c58498baab","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Eskişehir şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"390 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"B","metin":"50 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"160 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"20 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"E","metin":"320 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 160 · 2021→2022: −160 · 2022→2023: −20 · 2023→2024: −30"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2021 → 2022: 390 − 230 = 160 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"160 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.617,"gorsel":{"tur":"cizgi","baslik":"Eskişehir şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[230,390,230,210,180]}]}},{"kimlik":"3334999c0a49","sablon":"cebir.esitsizlik.cift_tarafli","govde":"−52 < 2x + 14 < −31 eşitsizliğini sağlayan x'in en büyük tam sayı değeri kaçtır?","secenekler":[{"harf":"A","metin":"−16","dogru":false,"yanilgi":"esitsizlik_ucu_ayrilmadi"},{"harf":"B","metin":"−33","dogru":false,"yanilgi":"so