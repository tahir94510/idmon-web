orsel":null},{"kimlik":"c41e7c12e600","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 2/x = 6 olduğuna göre x² + 2²/x² kaçtır?","secenekler":[{"harf":"A","metin":"36","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"B","metin":"34","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"C","metin":"32","dogru":true,"yanilgi":null},{"harf":"D","metin":"28","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"E","metin":"40","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 2/x)² = x² + 2 · x · 2/x + 2²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 2 kalır:","ifade":"6² = x² + 2²/x² + 4"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 2²/x² = 36 − 4 = 32"},{"aciklama":"İstenen değer:","ifade":"32"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.247,"gorsel":null},{"kimlik":"44126816f220","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|2x + 5| < 58 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"58","dogru":true,"yanilgi":null},{"harf":"B","metin":"29","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"53","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"57","dogru":false,"yanilgi":"sayimda_bir_eksik"}],"cozum":[{"aciklama":"|A| < 58 eşitsizliği, A'nın −58 ile 58 arasında olması demektir:","ifade":"−58 < 2x + 5 < 58"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−31,5 < x < 26,5"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"58 tane"},{"aciklama":"Tam sayı adedi:","ifade":"58"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.665,"gorsel":null},{"kimlik":"34e710b71e61","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Bisiklet sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Bisiklet sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"140 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"110 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"420 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"105 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"45 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Mayıs: 45 · Haziran: 80 · Temmuz: 120 · Ağustos: 175"},{"aciklama":"Dördünü topla:","ifade":"45 + 80 + 120 + 175 = 420"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"420/4 = 105"},{"aciklama":"Dönem ortalaması:","ifade":"105 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-1.445,"gorsel":{"tur":"cizgi","baslik":"Bisiklet satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[45,80,120,175]}]}},{"kimlik":"9b3d82eef4e7","sablon":"mantik.esleme.yanlis_ifade","govde":"Ali, Ece, Merve, Selin ve Zeynep adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Merve uçtaki koltuklarda oturmamaktadır.\n• Merve ortadaki koltukta oturmamaktadır.\n• Ece, Zeynep adlı kişinin solunda oturmaktadır.\n• Zeynep, Selin adlı kişinin hemen solundadır.\n• Ali, Merve adlı kişinin solunda oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Ali, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"B","metin":"Merve, Ali adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"C","metin":"Ece, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"D","metin":"Zeynep, Ece adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Ece ortadaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ali − Merve − Ece − Zeynep − Selin"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Ali, Merve adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"4a5bd8755fc8","sablon":"problem.sayi.verme_alma","govde":"Kaan, Ahmet'e bilyelerinin 20 tanesini verirse ikisinin bilye sayıları eşit olmaktadır. Ahmet, Kaan'a bilyelerinin 15 tanesini verirse Kaan'ın bilye sayısı Ahmet'inkinin 6 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç bilyesi vardır?","secenekler":[{"harf":"A","metin":"49","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"98","dogru":true,"yanilgi":null},{"harf":"C","metin":"69","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"70","dogru":false,"yanilgi":"verme_farki_tek_sayildi"},{"harf":"E","metin":"62","dogru":false,"yanilgi":"verme_tek_taraf"}],"cozum":[{"aciklama":"Kaan 20 tane verince kendisi 20 azalır, Ahmet 20 artar: aradaki fark 40 kapanır. Eşitlendiklerine göre baştaki fark 40'tır.","ifade":null},{"aciklama":"Ahmet'in sayısına x dersek Kaan'ınki x + 40 olur. İkinci koşulda Ahmet 15 tane verir, Kaan 15 tane alır:","ifade":"x + 40 + 15 = 6·(x − 15)"},{"aciklama":"Denklemi çöz:","ifade":"x = 29"},{"aciklama":"Toplam x + (x + 40) olduğuna göre:","ifade":"98"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"329beda34ba0","sablon":"veri.grafik.cizgi_yuzde_artis","govde":"Samsun mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2021 yılından 2022 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%20","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"%16","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"%25","dogru":true,"yanilgi":null},{"harf":"D","metin":"%40","dogru":false,"yanilgi":"artis_miktari_yuzde_sanildi"},{"harf":"E","metin":"%125","dogru":false,"yanilgi":"degisim_yerine_deger"}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"200 − 160 = 40"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"40 / 160 × 100 = %25"},{"aciklama":"Yüzde artış:","ifade":"%25"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":{"tur":"cizgi","baslik":"Samsun mağazasının yıllık cirosu (bin TL)","etiketler":["2018","2019","2020","2021","2022"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[250,160,150,160,200]}]}},{"kimlik":"5cb784569f0c","sablon":"oran.ters.uc_makine","govde":"Bir iş 10 işçiyle 48 günde, 2 işçiyle 240 günde bitmektedir. Aynı iş 8 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"60 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"7,5 gün","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"C","metin":"38,4 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"D","metin":"144 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"},{"harf":"E","metin":"50 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"Ters orantıda çokluklar birlikte artmaz; **çarpımları** sabit kalır. İki durumdan sabiti çıkar:","ifade":"10 × 48 = 480"},{"aciklama":"İkinci durum da aynı sabiti veriyor, yani kural doğrulanıyor:","ifade":"2 × 240 = 480"},{"aciklama":"Üçüncü durumda gün sayısını sabitten çöz:","ifade":"480/8 = 60"},{"aciklama":"Gereken süre:","ifade":"60 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":["oran.bilesik"],"zorluk":0.862,"gorsel":null},{"kimlik":"1c7858ab8f1e","sablon":"yuzde.temel.orandan_oran","govde":"Bir sayının %40'ı 1.920'dir.\n\nBuna göre aynı sayının %75'i kaçtır?","secenekler":[{"harf":"A","metin":"1.440","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"1.955","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"4.800","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"3.600","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.024","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Sayının %40'ı biliniyorsa sayının kendisi bulunur:","ifade":"1.920 / (40/100) = 4.800"},{"aciklama":"Sayının %75'i:","ifade":"4.800 × 75/100 = 3.600"},{"aciklama":"Aranan değer:","ifade":"3.600"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["oran.temel","yuzde.artis_azalis"],"zorluk":0.11,"gorsel":null},{"kimlik":"44d5b60e8800","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 32| = 20 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"12","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"B","metin":"−624","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"52","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"D","metin":"624","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.424","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 32 + 20 = 52 ve x = 32 − 20 = 12"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(32 + 20) × (32 − 20) = 32² − 20² = 624"},{"aciklama":"Köklerin çarpımı:","ifade":"624"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.976,"gorsel":null},{"kimlik":"bfa95e07a163","sablon":"veri.grafik.daire_aciyla_sayi","govde":"Toplam 900 kişinin katıldığı bir ankette verilen cevapların merkez açıları yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Şiir seçeneğini işaretleyen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"324 kişi","dogru":false,"yanilgi":"aciyi_yuzde_sanma"},{"harf":"B","metin":"225 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"810 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"45 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"90 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Grafikte Şiir diliminin merkez açısını oku:","ifade":"36°"},{"aciklama":"Açıyı orana çevir: dairenin tamamı 360°, dağılımın tamamı 100'dür.","ifade":"36/360 = 0,1"},{"aciklama":"Bulunan oranı toplam kişi sayısıyla çarp:","ifade":"900 × 0,1 = 90"},{"aciklama":"Dereceyi doğrudan sayıya oranlamak iki adımdan birini atlamak olurdu; önce yüzde, sonra sayı.","ifade":null},{"aciklama":"Bu dilimi seçen kişi sayısı:","ifade":"90 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.372,"gorsel":{"tur":"daire","baslik":"Tercihlerin merkez açıları","etiketler":["Roman","Şiir","Deneme","Öykü"],"birim":"derece","seriler":[{"ad":"Açı","degerler":[144,36,108,72]}]}},{"kimlik":"3874b9b3e803","sablon":"mantik.esleme.yerlestirme","govde":"2, 3, 7, 9, 11 ve 12 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ × □ − □ = □ + □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"9","dogru":true,"yanilgi":null},{"harf":"B","metin":"2","dogru":false,"yanilgi":null},{"harf":"C","metin":"7","dogru":false,"yanilgi":null},{"harf":"D","metin":"12","dogru":false,"yanilgi":null},{"harf":"E","metin":"11","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Soldaki çarpımdan bir sayı çıkınca, sağdaki iki sayının toplamı kalmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"2 × 11 − 3 = 7 + 12"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"9"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.405,"gorsel":null,"cevap_uzayi":true},{"kimlik":"2d4841ba9eff","sablon":"problem.yas.kat_iliskisi","govde":"Zeynep'in yaşı bugün Mustafa'nın yaşının 4 katıdır. 32 yıl sonra Zeynep'in yaşı Mustafa'nın yaşının 2 katı olacaktır. Buna göre Zeynep bugün kaç yaşındadır?","secenekler":[{"harf":"A","metin":"64","dogru":true,"yanilgi":null},{"harf":"B","metin":"80","dogru":false,"yanilgi":"yas_toplam_fark_karisimi"},{"harf":"C","metin":"96","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"D","metin":"16","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"48","dogru":false,"yanilgi":"fark_verildi_deger_istendi"}],"cozum":[{"aciklama":"Mustafa'nın bugünkü yaşına x dersek, Zeynep'in yaşı 4x olur.","ifade":null},{"aciklama":"32 yıl sonra ikisi de 32 yaş büyür; fark değişmez:","ifade":"4x + 32 = 2·(x + 32)"},{"aciklama":"Denklemi çöz:","ifade":"4x + 32 = 2x + 64  ⟹  2x = 32  ⟹  x = 16"},{"aciklama":"Zeynep'in bugünkü yaşı bunun 4 katıdır:","ifade":"4 × 16 = 64"},{"aciklama":"Zeynep bugün:","ifade":"64"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.149,"gorsel":null},{"kimlik":"bde079e8553c-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Zeynep ile Emre birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"42 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"126 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"147 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"72 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"294 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/168 + 1/126 = 7/504"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"504/7 = 72 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"72 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.502,"gorsel":null,"grup":"bde079e8553c","grup_govde":"Bir işi Zeynep tek başına 168 günde, Emre tek başına 126 günde bitirmektedir."},{"kimlik":"bde079e8553c-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Zeynep işe başlayıp 64 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Emre tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"48 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"126 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"147 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"D","metin":"78 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"294 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Zeynep bir günde işin 1/168'ini yapıyor; 64 gün çalışınca yaptığı iş:","ifade":"64/168"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(168 − 64)/168 = 13/21"},{"aciklama":"Emre işin tamamını 126 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"13/21 × 126 = 78"},{"aciklama":"Kalan iş için gereken süre:","ifade":"78 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.685,"gorsel":null,"grup":"bde079e8553c","grup_govde":"Bir işi Zeynep tek başına 168 günde, Emre tek başına 126 günde bitirmektedir."},{"kimlik":"b0cc37587860","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 480 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Roman tercih edenler, Öykü tercih edenlerden kaç kişi fazladır?","secenekler":[{"harf":"A","metin":"192 kişi","dogru":false,"ya