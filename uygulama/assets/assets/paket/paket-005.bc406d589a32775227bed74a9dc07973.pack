mi_kosul"},{"harf":"B","metin":"4","dogru":true,"yanilgi":null},{"harf":"C","metin":"10","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"D","metin":"12","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"E","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A4 sayısı 4'ün katı olmalı ⟹ 44"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"1 + 0 + 3 + A + 4 = 8 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"4"},{"aciklama":"Bu rakamları topla:","ifade":"4 = 4"},{"aciklama":"Rakamların toplamı:","ifade":"4"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"81246c7717ba","sablon":"mantik.dizi.carpansal","govde":"12, 35, 104, 311, 932, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"8.384","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"2.795","dogru":true,"yanilgi":null},{"harf":"C","metin":"932","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"2.796","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"1.553","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimlerin farkları sabit değil; oran da tam çıkmıyor. Kural iki işlemli olabilir.","ifade":null},{"aciklama":"Her terim bir öncekinin katının sabitle toplamıdır:","ifade":"aₙ₊₁ = 3 · aₙ − 1"},{"aciklama":"Kuralı son terime uygula:","ifade":"3 × 932 − 1 = 2.795"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"2.795"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"ba8ce9401cb6","sablon":"veri.tablo.satir_toplami","govde":"Bir firmanın dört şehirdeki mağazalarının mev