nra Tablet sütunlarını topla:","ifade":"45 + 40 + 30 + 40 = 155"},{"aciklama":"İki toplamın farkını al:","ifade":"575 − 155 = 420"},{"aciklama":"Aradaki fark:","ifade":"420 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.036,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[190,145,120,120]},{"ad":"Tablet","degerler":[45,40,30,40]}]}},{"kimlik":"2d87211b1994","sablon":"sayilar.uslu.negatif_us","govde":"(5⁻⁵)² · 5⁵ işleminin sonucu, 5 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−5","dogru":true,"yanilgi":null},{"harf":"B","metin":"−50","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"C","metin":"5","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−2","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"E","metin":"15","dogru":false,"yanilgi":"negatif_us_isaret"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(5⁻⁵)² = 5⁻¹⁰"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"5⁻¹⁰ · 5⁵ = 5⁻⁵"},{"aciklama":"Aranan kuvvet:","ifade":"−5"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.902,"gorsel":null},{"kimlik":"e0f2b0dcc515","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört mağazada sattığı Ekmek ve Simit sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre iki ürünün toplam satışının en yüksek olduğu mağaza için bu toplam kaç adettir?","secenekler":[{"harf":"A","metin":"510 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"150 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"195 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"255 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"300 adet","dogru":false,"yanilgi":"komsu_kategori_okundu"}],"cozum":[{"aciklama":"Soru tek bir seriyi değil, iki serinin toplamını istiyor; her mağaza için iki sütunu topla:","ifade":"Merkez: 75 , Sahil: 255 , Yayla: 210 , Vadi: 240"},{"aciklama":"Toplamların en büyüğü:","ifade":"Sahil için 255"},{"aciklama":"En yüksek toplam satış:","ifade":"255 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["veri.tablo"],"zorluk":0.711,"gorsel":{"tur":"sutun","baslik":"Ekmek ve Simit satışları (adet)","etiketler":["Merkez","Sahil","Yayla","Vadi"],"birim":"adet","seriler":[{"ad":"Ekmek","degerler":[55,150,60,140]},{"ad":"Simit","degerler":[20,105,150,100]}]}},{"kimlik":"a622cbd615b2","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 4/x = 25 olduğuna göre x² + 4²/x² kaçtır?","secenekler":[{"harf":"A","metin":"617","dogru":true,"yanilgi":null},{"harf":"B","metin":"633","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"609","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"D","metin":"625","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"621","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 4/x)² = x² + 2 · x · 4/x + 4²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 4 kalır:","ifade":"25² = x² + 4²/x² + 8"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 4²/x² = 625 − 8 = 617"},{"aciklama":"İstenen değer:","ifade":"617"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.888,"gorsel":null},{"kimlik":"3b4fc65d3f14","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Mehmet, Merve, Mustafa ve Serkan adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Mehmet, Merve adlı kişinin solunda oturmaktadır.\n• Mehmet uçtaki koltuklarda oturmamaktadır.\n• Serkan, Mustafa adlı kişinin hemen solundadır.\n• Ahmet, Serkan adlı kişinin hemen solundadır.\n• Serkan ile Mehmet yan yana oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Ahmet, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"B","metin":"Serkan, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Mustafa, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Merve, Mustafa adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"E","metin":"Ahmet, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ahmet − Serkan − Mustafa − Mehmet − Merve"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Serkan, Ahmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"d2b4cee63c19","sablon":"problem.yas.toplam_iliskisi","govde":"Ahmet ile Burak'ın bugünkü yaşları toplamı 78'dir, aralarındaki yaş farkı ise 20'dir.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"57","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"B","metin":"98","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"C","metin":"49","dogru":true,"yanilgi":null},{"harf":"D","metin":"29","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"65","dogru":false,"yanilgi":"yas_farki_degisti"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(78 + 20) / 2 = 49"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"78 − 49 = 29"},{"aciklama":"Büyük olanın yaşı:","ifade":"49"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-0.971,"gorsel":null},{"kimlik":"f6adbac0022f","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 3 litre yakıt tüketmektedir.\n\nBu araç Trabzon'a yapılan 600 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"200 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"6 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"180 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"3 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"18 litre","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"3/100 = x/600"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 600 × 3/100 = 18"},{"aciklama":"Tüketilen yakıt:","ifade":"18 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-1.107,"gorsel":null},{"kimlik":"a6f3134ff960","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 1.540 TL olan bir tablet %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%37,5","dogru":true,"yanilgi":null},{"harf":"C","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"D","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"1.540 × 160/100 = 2.464 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"2.464 − 1.540 = 924 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"924/2.464 × 100 = 37,5"},{"aciklama":"Gereken indirim:","ifade":"%37,5"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.746,"gorsel":null},{"kimlik":"3efaffb5fe10","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört bölgede sattığı Çay sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Batı bölgesinde satılan Çay sayısı, dört bölgede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%100","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"B","metin":"%20","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"%10","dogru":true,"yanilgi":null},{"harf":"E","metin":"%90","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"150 + 500 + 250 + 100 = 1.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"100 / 1.000 × 100 = %10"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%10"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":{"tur":"sutun","baslik":"Çay satışları (adet)","etiketler":["Kuzey","Güney","Doğu","Batı"],"birim":"adet","seriler":[{"ad":"Çay","degerler":[150,500,250,100]}]}},{"kimlik":"95f80500e6f6","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"10 · 2³ · 2² · 7⁰ + 2⁵ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"10.240","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"B","metin":"288","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"32","dogru":false,"yanilgi":"sifir_us"},{"harf":"D","metin":"352","dogru":true,"yanilgi":null},{"harf":"E","metin":"672","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"7⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2³ · 2² = 2⁵ = 32"},{"aciklama":"Katsayıyla çarp:","ifade":"10 × 32 = 320"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"320 + 32 = 352"},{"aciklama":"İşlemin sonucu:","ifade":"352"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.013,"gorsel":null},{"kimlik":"c42745f7235c","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 9 kız öğrencinin matematik notu ortalaması 95, 36 erkek öğrencinin ortalaması ise 85'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"87","dogru":true,"yanilgi":null},{"harf":"B","metin":"435","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"93","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"3.915","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"90","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"9 × 95 + 36 × 85 = 3.915"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"9 + 36 = 45"},{"aciklama":"Sınıf ortalaması:","ifade":"3.915 / 45 = 87"},{"aciklama":"Sınıfın ortalaması:","ifade":"87"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"c0f46726a22c","sablon":"kume.olasilik.en_az_bir","govde":"Bir torbada 12 tane beyaz, 5 tane mavi top vardır. Torbadan rastgele bir top çekilip rengine bakıldıktan sonra geri konuluyor. Bu işlem 2 kez tekrarlandığına göre, çekilen toplardan en az birinin beyaz olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"264/289","dogru":true,"yanilgi":null},{"harf":"B","metin":"25/289","dogru":false,"yanilgi":"olasilik_istenen_tum_ters"},{"harf":"C","metin":"24/17","dogru":false,"yanilgi":"olasilik_toplam_bir_asildi"},{"harf":"D","metin":"120/289","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"E","metin":"63/68","dogru":false,"yanilgi":"olasilik_bagimsiz_sanildi"}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: istenenin **tam tersini** hesapla, yani hiçbirinin istenen renkte olmama olasılığını. Bu ikisi birlikte 1 eder.","ifade":null},{"aciklama":"Top geri konulduğu için her çekiliş bağımsızdır ve mavi gelme olasılığı hep aynıdır:","ifade":"(5/17)² = 25/289"},{"aciklama":"İstenen olasılık, bunun 1'den farkıdır:","ifade":"1 − 25/289 = 264/289"},{"aciklama":"İstenen olasılık:","ifade":"264/289"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":[],"zorluk":2.81,"gorsel":null},{"kimlik":"763f8963854c","sablon":"oran.paylastirma.artan_pay","govde":"810 TL paranın bir kısmı Kerem'e ve Ece'ye 3 : 2 oranında dağıtılmış, Kerem'in payı 315 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"162 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"1.335 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"90 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"315 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"285 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kerem'in payından birim payı çöz:","ifade":"3k = 315 → k = 105"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(3 + 2) × 105 = 525 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"810 − 525 = 285 TL"},{"aciklama":"Geriye kalan:","ifade":"285 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":1.961,"gorsel":null},{"kimlik":"70a8ac3b5dab","sablon":"yuzde.artis.indirim","govde":"Fiyatı 4.200 TL olan bir masa lambası, %70 indirimle satılmaktadır. Masa lambasının indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.940 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"7.140 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"1.260 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"378 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"4.130 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"4.200 × 70 / 100 = 2.940"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"4.200 − 2.940 = 1.260"},{"aciklama":"İndirimli fiyat:","ifade":"1.260 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.519,"gorsel":null},{"kimlik":"ac7b3e8cb6fe","sablon":"veri.ortalama.eksik_terim","govde":"6 öğrencinin sınav notu ortalaması 80. Öğrencilerden 5'i sırasıyla 82, 74, 99, 41 ve 84 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"184","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"380","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"180","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"76","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"100","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"80 × 6 = 480"},{"aciklama":"Bilinen notların toplamı:","ifade":"82 + 74 + 99 + 41 + 84 = 380"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"480 − 380 = 100"},{"aciklama":"Kalan öğrencinin notu:","ifade":"100"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.495,"gorsel":null},{"kimlik":"613f4eb3d1a3-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Merve ile Buse birlikte çalışırsa aynı iş kaç saatte biter?","secenekler":[{"harf":"A","metin":"24 saat","dogru":true,"yanilgi":null},{"harf":"B","metin":"50 saat","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"40 saat","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"D","metin":"20 saat","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"E","metin":"100 saat","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/60 + 1/40 = 5/120"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"120/5 = 24 saat"},{"aciklama":"Birlikte çalışma süresi:","ifade":"24 saat"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":2.888,"gorsel":null,"grup":"613f4eb3d1a3","grup_govde":"Bir işi Merve tek başına 60 saatte, Buse tek başına 40 saatte bitirmektedir."},{"kimlik":"613f4eb3d1a3-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Merve işe başlayıp 51 saat çalıştıktan sonra işi bırakmıştır. Kalan işi Buse tek başına kaç saatte bitirir?","secenekler":[{"harf":"A","metin":"40 saat","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"B","metin":"50 saat","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"6 saat","dogru":true,"yanilgi":null},{"harf":"D","metin":"34 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"100 saat","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Merve bir saatte işin 1/60'ını yapıyor; 51 saat çalışınca yaptığı iş:","ifade":"51/60"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(60 − 51)/60 = 3/20"},{"aciklama":"Buse işin tamamını 40 saatte bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"3/20 × 40 = 6"},{"aciklama":"Kalan iş için gereken süre:","ifade":"6 saat"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":2.997,"gorsel":null,"grup":