|x − 31| = 4 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"−945","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"977","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"35","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"D","metin":"945","dogru":true,"yanilgi":null},{"harf":"E","metin":"27","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 31 + 4 = 35 ve x = 31 − 4 = 27"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(31 + 4) × (31 − 4) = 31² − 4² = 945"},{"aciklama":"Köklerin çarpımı:","ifade":"945"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.961,"gorsel":null},{"kimlik":"acd8d6804a7a","sablon":"oran.ters.uc_makine","govde":"Bir iş 2 işçiyle 180 günde, 5 işçiyle 72 günde bitmektedir. Aynı iş 12 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"1.080 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"126 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"},{"harf":"C","metin":"30 gün","dogru":true,"yanilgi":null},{"harf":"D","metin":"2,5 gün","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"E","metin":"170 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"Ters orantıda çokluklar birlikte artmaz; **çarpımları** sabit kalır. İki durumdan sabiti çıkar:","ifade":"2 × 180 = 360"},{"aciklama":"İkinci durum da aynı sabiti veriyor, yani kural doğrulanıyor:","ifade":"5 × 72 = 360"},{"aciklama":"Üçüncü durumda gün sayısını sabitten çöz:","ifade":"360/12 = 30"},{"aciklama":"Gereken süre:","ifade":"30 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":["oran.bilesik"],"zorluk":0.957,"gorsel":null},{"kimlik":"e52008f6e8a8","sablon":"yuzde.temel.orandan_oran","govde":"Bir sayının %8'i 80'dir.\n\nBuna göre aynı sayının %20'si kaçtır?","secenekler":[{"harf":"A","metin":"32","dogru":false,"yanilg