orsel":null},{"kimlik":"80944377a1ad","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Bursa şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2022 yılından 2024 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"390 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"B","metin":"120 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"50 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"40 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"60 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2022 değeri:","ifade":"330 kişi"},{"aciklama":"2024 değeri:","ifade":"390 kişi"},{"aciklama":"Farkı al:","ifade":"390 − 330 = 60"},{"aciklama":"Artış miktarı:","ifade":"60 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.719,"gorsel":{"tur":"cizgi","baslik":"Bursa şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[230,280,330,370,390]}]}},{"kimlik":"d76c5f53abef-1","sablon":"kume.blok.iki_kurs_uc_soru","govde":"Yalnızca resim kursuna giden kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"19","dogru":true,"yanilgi":null},{"harf":"B","metin":"26","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"C","metin":"25","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"6","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"E","metin":"7","dogru":false,"yanilgi":"kume_tumleyen_karisimi"}],"cozum":[{"aciklama":"Bir kursa giden öğrenci sayısı, iki kursa da gidenleri de içerir.","ifade":"resim kursuna giden: 25"},{"aciklama":"Yalnızca resim kursuna gidenleri bulmak için iki kursa da gidenleri çıkar:","ifade":"25 − 6 = 19"},{"aciklama":"Yalnızca o kursa gidenler:","ifade":"19"}],"mikrobeceri