gru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"312 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"4.212 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"35.100 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"E","metin":"3.588 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"3.900 × 8/100 = 312 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"3.900 + 312 = 4.212 TL"},{"aciklama":"Zamlı fiyat:","ifade":"4.212 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.54,"gorsel":null},{"kimlik":"2664ced3f0c9","sablon":"sayilar.basamak.deger_toplami","govde":"316 sayısında onlar basamağındaki rakamın basamak değeri ile yüzler basamağındaki rakamın sayı değerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"103","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"B","metin":"40","dogru":false,"yanilgi":"rakam_sayi_karisimi"},{"harf":"C","metin":"31","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"D","metin":"4","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"E","metin":"13","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basamak değeri, rakamın kendisi değil; rakam ile basamağın ağırlığının çarpımıdır.","ifade":null},{"aciklama":"Onlar basamağındaki 1 rakamının basamak değeri:","ifade":"1 × 10 = 10"},{"aciklama":"Yüzler basamağındaki rakamın sayı değeri rakamın kendisidir:","ifade":"3"},{"aciklama":"İkisini topla:","ifade":"10 + 3 = 13"},{"aciklama":"Aranan toplam:","ifade":"13"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-3.115,"gorsel":null},{"kimlik":"97fabd55fe99","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 6 kişilik bir grubun yaş ortalaması 80, ikinci bir grubun yaş ortalaması ise 75'tir. İki grup birleştiğinde yaş ortalaması 76 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"24 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"7 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"30 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"5 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"6 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"6·80 + n·75"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(6·80 + n·75) / (6 + n) = 76"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"6·(80 − 76) = n·(76 − 75)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"24 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.325,"gorsel":null},{"kimlik":"f4a0f6f95a23","sablon":"mantik.dizi.toplamsal","govde":"14, 17, 31, 48, 79, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"110","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"B","metin":"79","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"C","metin":"127","dogru":true,"yanilgi":null},{"harf":"D","metin":"158","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"206","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"14 + 17 = 31"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"17 + 31 = 48"},{"aciklama":"Son iki terimi topla:","ifade":"48 + 79 = 127"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"127"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"6b8061dd83fb","sablon":"problem.yas.toplam_iliskisi","govde":"Serkan ile Deniz'in bugünkü yaşları toplamı 42'dir, aralarındaki yaş farkı ise 18'dir.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"30","dogru":true,"yanilgi":null},{"harf":"B","metin":"12","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"54","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"E","metin":"42","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(42 + 18) / 2 = 30"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"42 − 30 = 12"},{"aciklama":"Büyük olanın yaşı:","ifade":"30"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.023,"gorsel":null},{"kimlik":"00a2b1c3bda7","sablon":"veri.ortalama.medyan_tek","govde":"46, 90, 56, 176, 172 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"111","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"172","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"90","dogru":true,"yanilgi":null},{"harf":"D","metin":"56","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"E","metin":"108","dogru":false,"yanilgi":"toplam_yerine_ortalama"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"46 < 56 < 90 < 172 < 176"},{"aciklama":"Terim sayısı 5, yani tek: ortada tek bir terim var.","ifade":"5 → 3. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"90"},{"aciklama":"Ortanca:","ifade":"90"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.643,"gorsel":null},{"kimlik":"a7c2c4438dbd","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Kaan, Elif ve Ece arasında sırasıyla 2, 12 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 3.240 TL olduğuna göre, Kaan'ın payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.160 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"1.080 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"240 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.560 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"120 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 12 + 13 = 27"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"3.240 / 27 = 120 TL"},{"aciklama":"Kaan bu paylardan 2 tane alır:","ifade":"2 × 120 = 240 TL"},{"aciklama":"Kaan'ın payı:","ifade":"240 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.448,"gorsel":null},{"kimlik":"cf1dc252cf7b","sablon":"yuzde.faiz.anapara","govde":"Yıllık %24 basit faiz oranıyla 8 ay vadeye yatırılan bir anapara 7.680 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"4.000 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"48.000 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"32.000 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"D","metin":"55.680 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"6.000 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"8 ay için faiz katsayısı:","ifade":"24/100 × 8/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"7.680 / (24 × 8/1200) = 48.000 TL"},{"aciklama":"Anapara:","ifade":"48.000 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.641,"gorsel":null},{"kimlik":"2bfa33ba4351","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 2.052 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"22.800","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"2.280","dogru":true,"yanilgi":null},{"harf":"C","metin":"2.052","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"D","metin":"238","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"E","metin":"228","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 2.052"},{"aciklama":"İlk sayı:","ifade":"x = 2.052 / 9 = 228"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 228 = 2.280"},{"aciklama":"Yeni sayı:","ifade":"2.280"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-1.395,"gorsel":null},{"kimlik":"f6a1db885ad7","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 11 kişinin yaş ortalaması 47. Gruba bir kişi daha katılınca ortalama 51'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"51","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"44","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"91","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"95","dogru":true,"yanilgi":null},{"harf":"E","metin":"49","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"11 × 47 = 517"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"12 × 51 = 612"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"612 − 517 = 95"},{"aciklama":"Katılan kişinin yaşı:","ifade":"95"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.532,"gorsel":null},{"kimlik":"61d6a02bb56b","sablon":"cebir.ozdeslik.katsayi","govde":"(12x + 11) · (2x + 3) çarpımı düzenlendiğinde x'li terimin katsayısı kaç olur?","secenekler":[{"harf":"A","metin":"14","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"58","dogru":true,"yanilgi":null},{"harf":"C","metin":"115","dogru":false,"yanilgi":"terimleri_toplayip_carpma"},{"harf":"D","metin":"36","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"57","dogru":false,"yanilgi":"carpraz_terim_eslesmesi"}],"cozum":[{"aciklama":"Parantezleri dağıt; her terim öbürünün her terimiyle çarpılır:","ifade":"12x · 2x + 12x · 3 + 11 · 2x + 11 · 3"},{"aciklama":"x'li terimler ortadaki iki çarpımdan gelir:","ifade":"12 · 3 · x + 11 · 2 · x"},{"aciklama":"Katsayıları topla:","ifade":"36 + 22 = 58"},{"aciklama":"x'li terimin katsayısı:","ifade":"58"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.398,"gorsel":null},{"kimlik":"bd07925afde8","sablon":"kume.sayma.iki_gruptan_secim","govde":"8 kadın ve 8 erkekten oluşan bir ekipten, 2 kadın ve 2 erkek içeren bir komite kurulacaktır. Bu komite kaç farklı biçimde kurulabilir?","secenekler":[{"harf":"A","metin":"56","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"B","metin":"3.136","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"C","metin":"1.296","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"D","metin":"1.820","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"E","metin":"784","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Komitede görev ayrımı yok; kimin önce seçildiği sonucu değiştirmez. Böyle sırasız seçimlere kombinasyon denir ve C(n, r) ile yazılır: n kişiden r kişiyi seçme sayısı.","ifade":null},{"aciklama":"Kadınları seç. 8 kişiden 2 kişi:","ifade":"C(8, 2) = (8×7) / (2×1) = 28"},{"aciklama":"Erkekleri seç. 8 kişiden 2 kişi:","ifade":"C(8, 2) = (8×7) / (2×1) = 28"},{"aciklama":"İki seçim peş peşe yapıldığı için sayılar çarpılır:","ifade":"28 × 28 = 784"},{"aciklama":"Farklı komite sayısı:","ifade":"784"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":1.24,"gorsel":null},{"kimlik":"aabd8be0c2b4","sablon":"oran.temel.oran_ve_fark","govde":"Merve'nin parasının Kaan'ın parasına oranı 15/11'dir. Aralarındaki fark 1.040 TL olduğuna göre Merve kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"6.760 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"3.900 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"260 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"2.860 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"600 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Merve 15k, Kaan 11k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"15k − 11k = 4k = 1.040"},{"aciklama":"Birim payı bul:","ifade":"k = 1.040 / 4 = 260"},{"aciklama":"Merve için:","ifade":"15 × 260 = 3.900"},{"aciklama":"Merve'nin parası:","ifade":"3.900 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.114,"gorsel":null},{"kimlik":"22f2e08ce377","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Bursa'nın Sonbahar satışı silinmiş, yerine 0 yazılmıştır. Bursa satırının gerçek yıllık toplamı 1.100 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"1.100 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"90 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"320 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"275 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"705 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"Bursa satırında görünen üç değeri topla:","ifade":"305 + 90 + 385 = 780"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"1.100 − 780 = 320"},{"aciklama":"Silinen değer:","ifade":"320 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.171,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Samsun","degerler":[380,255,90,185]},{"ad":"Konya","degerler":[375,300,265,165]},{"ad":"İzmir","degerler":[155,80,60,50]},{"ad":"Bursa","degerler":[305,90,0,385]}]}},{"kimlik":"ed24e26a7d8c","sablon":"yuzde.faiz.basit_ay","govde":"32.400 TL tutarındaki bir anapara, yıllık %18 basit faiz oranıyla 4 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"5.832 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"34.344 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"1.944 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.458 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"23.328 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"4 ay, yıl cinsinden:","ifade":"4/12"},{"aciklama":"Faiz tutarı:","ifade":"32.400 × 18/100 × 4/12 = 1.944 TL"},{"aciklama":"Elde edilen faiz:","ifade":"1.944 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.048,"gorsel":null},{"kimlik":"7fc8dd87ac35","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 2, onlar basamağındaki rakam 5'tir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"152","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"215","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"251","dogru":true,"yanilgi":null},{"harf":"D","metin":"206","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"E","metin":"21","dogru":false,"yanilgi":"sifir_basamak_atlandi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (2 − b) = 99 ⟹ 2 − b = 1 ⟹ b = 1"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 2 + 10 × 5 + 1 = 251"},{"aciklama":"Aranan sayı:","ifade":"251"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"34f03bfe7491","sablon":"mantik.esleme.kesin_dogru","govde":"Ayşe, Burak, Kerem, Selin ve Zeynep adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Burak ortadaki koltukta oturmamaktadır.\n• Kerem, Zeynep adlı kişinin solunda oturmaktadır.\n• Zeynep, Burak adlı kişinin hemen solundadır.\n• Zeynep, Ayşe adlı kişinin solunda oturmaktadır.\n• Kerem, Selin adlı kişinin solunda oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Selin, Burak adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Burak, Ayşe adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"C","metin":"Kerem, Burak adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"D","metin":"Zeynep, Kerem adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"E","metin":"Selin, Kerem adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Kerem − Selin − Zeynep − Burak − Ayşe"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Selin, Kerem adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"dca9224194a1","sablon":"problem.hareket.karsilikli","govde":"Aralarındaki uzaklık 480 km olan İzmir ve Ankara şehirlerinden aynı anda birbirine doğru iki araç hareket ediyor. Araçların hızları sırasıyla 25 km/sa ve 15 km/sa olduğuna göre, araçlar kaç saat sonra karşılaşır?","secenekler":[{"harf":"A","metin":"19,2 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"12 saat","dogru":true,"yanilgi":null},{"harf":"C","metin":"24 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"48 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"32 saat","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Zıt yönde hareket eden araçlar için yaklaşma hızı, hızların toplamıdır:","ifade":"25 + 15 = 40 km/sa"},{"aciklama":"Karşılaşma süresi, aradaki uzaklığın yaklaşma hızına bölümüdür:","ifade":"480 / 40 = 12 saat"},{"aciklama":"Karşılaşma süresi:","ifade":"12 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":3.095,"gorsel":null},{"kimlik":"0b0819c1050d","sablon":"veri.tablo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"195 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"245 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"105 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"220 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"180 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"İzmir: 225 − 65 = 160 · Bursa: 220 − 25 = 195 · Trabzon: 280 − 100 = 180 · Konya: 355 − 250 = 105"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Bursa, 195 adet"},{"aciklama":"En büyük artış:","ifade":"195 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":-0.038,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[65,35,225,160]},{"ad":"Bursa","degerler":[25,300,220,155]},{"ad":"Trabzon","degerler":[100,285,280,280]},{"ad":"Konya","degerler":[250,70,355,265]}]}},{"kimlik":"1e7e08ab6411","sablon":"oran.temel.oran_ve_toplam","govde":"Deniz'in parasının Onur'un parasına oranı 10/9'dur. İkisinin parası toplam 4.180 TL olduğuna göre Deniz kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"2.090 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"1.980 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"2.200 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"41.800 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"E","metin":"220 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Deniz 10k, Onur 9k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"10k + 9k = 19k = 4.180"},{"aciklama":"Birim payı bul:","ifade":"k = 4.180 / 19 = 220"},{"aciklama":"Deniz için:","ifade":"10 × 220 = 2.200"},{"aciklama":"Deniz'in parası:","ifade":"2.200 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":1.458,"gorsel":null},{"kimlik":"9da6372d3580","sablon":"yuzde.faiz.getiri_farki","govde":"17.000 TL, yıllık %30 faizle 3 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %18 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"2.040 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"510 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"12 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"1.275 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"680 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"30 − 18 = 12 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"12/100 × 3/12"},{"aciklama":"Anaparayla çarp:","ifade":"17.000 × 12/100 × 3/12 = 510 TL"},{"aciklama":"Getiri farkı:","ifade":"510 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.272,"gorsel":null},{"kimlik":"52cb7cb7ffee","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"240 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"330 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"180 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"4 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"340 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"İzmir: 340/58 · Bursa: 330/22 · Antalya: 240/4 · Eskişehir: 180/50"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Antalya satırında:","ifade":"240/4"},{"aciklama":"O satırın satış sayısı:","ifade":"240 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.356,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[340,58]},{"ad":"Bursa","degerler":[330,22]},{"ad":"Antalya","degerler":[240,4]},{"ad":"Eskişehir","degerler":[180,50]}]}},{"kimlik":"101a6336e04a","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 18 ile bölümünden elde edilen bölüm 15, kalan ise 7'dir. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"263","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"B","metin":"277","dogru":true,"yanilgi":null},{"harf":"C","metin":"270","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"D","metin":"141","dogru":false,"yanilgi":"kalan_bolen_karisimi"},{"harf":"E","metin":"396","dogru":false,"yanilgi":"kalan_bolume_eklendi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"18 × 15 + 7 = 270 + 7 = 277"},{"aciklama":"Kalan (7) bölenden (18) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"277"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.596,"gorsel":null},{"kimlik":"c94f6736029a","sablon":"mantik.esleme.yanlis_ifade","govde":"Ayşe, Buse, Deniz, Fatma ve Merve adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Fatma, Merve adlı kişinin hemen solundadır.\n• Merve ile Ayşe yan yana oturmamaktadır.\n• Buse, Deniz adlı kişinin solunda oturmaktadır.\n• Buse ile Deniz yan yana oturmamaktadır.\n• Fatma en baştaki ya da en sondaki koltukta oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Deniz, Ayşe adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"B","metin":"Fatma, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Merve, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"D","metin":"Deniz en sağdaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"E","metin":"Ayşe, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Fatma − Merve − Buse − Ayşe − Deniz"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Fatma, Merve adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"cce4647f1bae","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Samsun'a giderken yolun ilk bölümünü saatte 50 km hızla 2 saatte, kalan bölümünü saatte 110 km hızla 4 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"420 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"B","metin":"540 km","dogru":true,"yanilgi":null},{"harf":"C","metin":"100 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"480 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"300 km","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"50 × 2 = 100 km"},{"aciklama":"İkinci bölüm:","ifade":"110 × 4 = 440 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"100 + 440 = 540 km"},{"aciklama":"Toplam yol:","ifade":"540 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"37dc8cf5b4e5","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminde Eskişehir'in yaptığı satışın İzmir'in yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"3","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"60","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"0,25","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"2","dogru":true,"yanilgi":null},{"harf":"E","metin":"0,5","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"İlkbahar sütunundan iki değeri oku:","ifade":"Eskişehir: 120 · İzmir: 60"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"120 / 60 = 2"},{"aciklama":"Aranan oran:","ifade":"2"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[120,180,180,360]},{"ad":"İzmir","degerler":[60,60,90,270]},{"ad":"Bursa","degerler":[60,360,330,360]},{"ad":"Antalya","degerler":[330,270,330,330]}]}},{"kimlik":"0b716a2ee1cb","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"205 ile 1.404 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 45'e tam bölünür?","secenekler":[{"harf":"A","metin":"240","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"B","metin":"27","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.244/45","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"80","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"E","metin":"134","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"}],"cozum":[{"aciklama":"45'e bölünen sayılar 45'in katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"225 ve 1.395"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(1.395 − 225) / 45 + 1 = 27"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"27"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":-0.072,"gorsel":null},{"kimlik":"3c3f11cf6017","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 21/x = 12 olduğuna göre x² + 21²/x² kaçtır?","secenekler":[{"harf":"A","metin":"60","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"186","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"102","dogru":true,"yanilgi":null},{"harf":"D","metin":"144","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"123","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 21/x)² = x² + 2 · x · 21/x + 21²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 21 kalır:","ifade":"12² = x² + 21²/x² + 42"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 21²/x² = 144 − 42 = 102"},{"aciklama":"İstenen değer:","ifade":"102"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.422,"gorsel":null},{"kimlik":"f52483d85f3a","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 10 : 7 : 8 oranındadır. Birinci arkadaşın parası 300 TL olduğuna göre üçüncü arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"375 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"250 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"8 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"30 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"240 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"10k : 7k : 8k"},{"aciklama":"Bilinen paydan k'yı çöz (birinci arkadaş):","ifade":"10k = 300 → k = 30"},{"aciklama":"Sorulan payı k ile çarp (üçüncü arkadaş):","ifade":"8 × 30 = 240"},{"aciklama":"Üçüncü arkadaşın parası:","ifade":"240 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.495,"gorsel":null},{"kimlik":"bd46dd654c37","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Konya'nın yıllık toplam satışı, İzmir'in yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"25 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"B","metin":"280 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"1.060 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"100 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"260 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Konya satırını topla:","ifade":"275 + 335 + 270 + 180 = 1.060"},{"aciklama":"İzmir satırını topla:","ifade":"295 + 375 + 50 + 240 = 960"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"1.060 − 960 = 100"},{"aciklama":"Aradaki fark:","ifade":"100 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.971,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[295,375,50,240]},{"ad":"Trabzon","degerler":[325,240,380,75]},{"ad":"Konya","degerler":[275,335,270,180]},{"ad":"Antalya","degerler":[370,50,305,225]}]}},{"kimlik":"0918e19d85b5","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 1.800 TL olan bir kol saati %40 kârla, maliyeti 2.100 TL olan bir gömlek ise %25 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.245 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"720 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"585 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"15 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"195 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"1.800 × 40/100 = 720 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"2.100 × 25/100 = 525 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"720 − 525 = 195 TL"},{"aciklama":"Net kâr:","ifade":"195 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.843,"gorsel":null},{"kimlik":"75de8e48f276","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan mandalina, ayva ve elmanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 150 kilogram satılmış ve toplam 165 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram mandalina ve ayva satılmıştır?","secenekler":[{"harf":"A","metin":"120","dogru":true,"yanilgi":null},{"harf":"B","metin":"30","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"100","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"144","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"140","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Mandalina: 3 − 2 = 1 TL, Ayva: 6 − 5 = 1 TL, Elma: 4 − 2,5 = 1,5 TL.","ifade":null},{"aciklama":"Mandalina ile ayvanın kilogram kârı aynı. Hepsi 1 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"150 · 1 = 150 TL"},{"aciklama":"Fazladan 15 TL yalnızca elma yüzünden: onun her kilogramı 0,5 TL fazla kazandırıyor.","ifade":"elma = 15 ÷ 0,5 = 30 kg"},{"aciklama":"İstenen: 150 − 30 =","ifade":"120"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Mandalina","degerler":[2.0,3.0]},{"ad":"Ayva","degerler":[5.0,6.0]},{"ad":"Elma","degerler":[2.5,4.0]}]}},{"kimlik":"7959f63560a5","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"820A2 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"18","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"B","metin":"25","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"C","metin":"12","dogru":true,"yanilgi":null},{"harf":"D","metin":"8","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"E","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A2 sayısı 4'ün katı olmalı ⟹ 32 ve 92"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"8 + 2 + 0 + A + 2 = 12 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"3 ve 9"},{"aciklama":"Bu rakamları topla:","ifade":"3 + 9 = 12"},{"aciklama":"Rakamların toplamı:","ifade":"12"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.957,"gorsel":null},{"kimlik":"7393144acc83","sablon":"mantik.esleme.yerlestirme","govde":"2, 4, 9, 10, 12 ve 13 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ × □ − □ = □ + □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"13","dogru":false,"yanilgi":null},{"harf":"B","metin":"10","dogru":false,"yanilgi":null},{"harf":"C","metin":"4","dogru":false,"yanilgi":null},{"harf":"D","metin":"9","dogru":true,"yanilgi":null},{"harf":"E","metin":"2","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Soldaki çarpımdan bir sayı çıkınca, sağdaki iki sayının toplamı kalmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"2 × 13 − 4 = 10 + 12"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"9"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.464,"gorsel":null,"cevap_uzayi":true},{"kimlik":"08b3acfbc1e8","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Samsun ile Trabzon arasındaki yolu giderken 110 km/sa, dönerken 15 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"62,5 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"B","metin":"125 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"C","metin":"13,2 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"D","metin":"110 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"E","metin":"26,4 km/sa","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/110 + x/15 = x·(125)/(110·15)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·125/(110·15)] = 2·110·15/125 = 26,4 km/sa"},{"aciklama":"Ortalama hız:","ifade":"26,4 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.46,"gorsel":null},{"kimlik":"913a07ab90ab","sablon":"oran.temel.zincir","govde":"Selin'in parasının Elif'in parasına oranı 13/12, Elif'in parasının Kerem'in parasına oranı 9/7 olarak veriliyor. Buna göre Selin'in parasının Kerem'in parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"28/39","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"B","metin":"39/28","dogru":true,"yanilgi":null},{"harf":"C","metin":"13/12","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"91/108","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"199/84","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Ortadaki terim ortak olduğu için oranlar zincirlenir:","ifade":"(13/12) × (9/7)"},{"aciklama":"Çarpım sadeleştirilir:","ifade":"117/84 = 39/28"},{"aciklama":"Aranan oran:","ifade":"39/28"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.dogru"],"zorluk":2.291,"gorsel":null},{"kimlik":"62dddc2de320","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 5.660 TL olan bir güneş gözlüğü 7.075 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%1.415","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%125","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"C","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%80","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"%25","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"7.075 TL − 5.660 TL = 1.415 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"1.415 / 5.660 × 100 = 25"},{"aciklama":"Kâr oranı:","ifade":"%25"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null}]}