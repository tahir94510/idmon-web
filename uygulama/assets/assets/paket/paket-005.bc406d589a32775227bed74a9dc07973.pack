ittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"78 − 65 = 13 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"65 / 13 = 5"},{"aciklama":"Yetişme süresi:","ifade":"5 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"7f8142d50613-1","sablon":"veri.blok.cizgi_iki_soru","govde":"2016 yılından 2019 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"280 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"60 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"C","metin":"80 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"180 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"E","metin":"140 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2016 değeri:","ifade":"40 kişi"},{"aciklama":"2019 değeri:","ifade":"180 kişi"},{"aciklama":"Farkı al:","ifade":"180 − 40 = 140"},{"aciklama":"Artış miktarı:","ifade":"140 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.575,"gorsel":{"tur":"cizgi","baslik":"Üye sayısı","etiketler":["2016","2017","2018","2019","2020"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[40,60,120,180,120]}]},"grup":"7f8142d50613","grup_govde":"Eskişehir şubesinin 2016–2020 yılları arasındaki üye sayısı yukarıdaki çizgi grafiğinde verilmiştir."},{"kimlik":"7f8142d50613-2","sablon":"veri.blok.cizgi_iki_soru","govde":"Beş yılın üye sayısı ortalaması kaç kişidir?","secenekler":[{"harf":"A","metin":"104 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"110 kişi","dogru":false,"yanilgi":"ortalama_uc_degerlerden"},{"harf":"C","metin":"180 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"520 kişi","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"130 kişi","dogru":false,"yanilgi":