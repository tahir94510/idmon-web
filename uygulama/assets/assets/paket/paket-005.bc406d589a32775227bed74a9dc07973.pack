.","ifade":null},{"aciklama":"2019 değeri:","ifade":"210 kişi"},{"aciklama":"2023 değeri:","ifade":"320 kişi"},{"aciklama":"Farkı al:","ifade":"320 − 210 = 110"},{"aciklama":"Artış miktarı:","ifade":"110 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.472,"gorsel":{"tur":"cizgi","baslik":"Bursa şubesinin yıllık üye sayısı","etiketler":["2019","2020","2021","2022","2023"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[210,220,250,310,320]}]}},{"kimlik":"0225a4215eb6","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 72 cm ve 324 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"648 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"B","metin":"11 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"396 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"D","metin":"18 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"},{"harf":"E","metin":"36 cm","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"72 = 36·2   ve   324 = 36·9"},{"aciklama":"Ortak çarpan 36; kalan çarpanlar (2 ve 9) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(72, 324) = 36"},{"aciklama":"En büyük parça uzunluğu:","ifade":"36 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":1.304,"gorsel":null},{"kimlik":"fc6c7276d211","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Konya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"240 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"20 kişi","dogru":false,"yanilgi":"gr