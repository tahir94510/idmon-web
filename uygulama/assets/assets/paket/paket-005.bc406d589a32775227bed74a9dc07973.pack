aret_hatasi"},{"harf":"D","metin":"162","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"E","metin":"297","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 3 eksik. Demek ki sayıya 3 eklenirse sayı hem 10 hem 15 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(10, 15) = 30"},{"aciklama":"Sayı 30'un katından 3 eksiktir. 151'den büyük ilk böyle sayı:","ifade":"177"},{"aciklama":"Aranan sayı:","ifade":"177"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.218,"gorsel":null},{"kimlik":"c9c40cd0391e","sablon":"problem.isci.ek_isci","govde":"18 işçi bir işi 38 günde bitirmektedir. Aynı iş 36 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"324/19 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"2 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"C","metin":"1 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"54 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"E","metin":"19 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"18 × 38 = 684"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"684 / 36 = 19"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"19 − 18 = 1"},{"aciklama":"Gereken ek işçi:","ifade":"1 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.296,"gorsel":null},{"kimlik":"60de90e5abfc","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin Sonbahar mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"960 ad