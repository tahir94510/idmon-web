egerler":[395,205,40,170]},{"ad":"Eskişehir","degerler":[95,55,340,230]}]}},{"kimlik":"bdfc1e161a2a","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 9 ile bölümünden elde edilen bölüm 35, kalan ise 6'dır. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"89","dogru":false,"yanilgi":"kalan_bolen_karisimi"},{"harf":"B","metin":"369","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"C","metin":"309","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"D","metin":"315","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"E","metin":"321","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"9 × 35 + 6 = 315 + 6 = 321"},{"aciklama":"Kalan (6) bölenden (9) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"321"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-2.209,"gorsel":null},{"kimlik":"2450d7be9ac9","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 1.400 TL olan bir kulaklık %30 kârla, maliyeti 2.100 TL olan bir çanta ise %15 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"735 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"525 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"15 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"420 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"105 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"1.400 × 30/100 = 420 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"2.100 × 15/100 = 315 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"420 − 315 = 105 TL"},{"aciklama":"Net kâr:","ifade":"105 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.775,"gorsel":null},{"kimlik":"b6c158627d7c","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan erik, üzüm ve soğanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 300 kilogram satılmış ve toplam 66 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram erik ve üzüm satılmıştır?","secenekler":[{"harf":"A","metin":"285","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},{"harf":"B","metin":"30","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"200","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"290","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"270","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Erik: 2,2 − 2 = 0,2 TL, Üzüm: 3,7 − 3,5 = 0,2 TL, Soğan: 4,9 − 4,5 = 0,4 TL.","ifade":null},{"aciklama":"Erik ile üzümün kilogram kârı aynı. Hepsi 0,2 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"300 · 0,2 = 60 TL"},{"aciklama":"Fazladan 6 TL yalnızca soğan yüzünden: onun her kilogramı 0,2 TL fazla kazandırıyor.","ifade":"soğan = 6 ÷ 0,2 = 30 kg"},{"aciklama":"İstenen: 300 − 30 =","ifade":"270"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Erik","degerler":[2.0,2.2]},{"ad":"Üzüm","degerler":[3.5,3.7]},{"ad":"Soğan","degerler":[4.5,4.9]}]}},{"kimlik":"7861d0f29d30-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Ayşe'nin payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"600 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"33.600 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"4.200 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"5.400 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"4.800 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"4 + 8 + 9 = 21"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"12.600 / 21 = 600 TL"},{"aciklama":"Ayşe bu paylardan 8 tane alır:","ifade":"8 × 600 = 4.800 TL"},{"aciklama":"Ayşe'nin payı:","ifade":"4.800 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.719,"gorsel":null,"grup":"7861d0f29d30","grup_govde":"Bir ikramiye Deniz, Ayşe ve Mustafa arasında sırasıyla 4, 8 ve 9 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 12.600 TL'dir."},{"kimlik":"7861d0f29d30-2","sablon":"oran.blok.paylastirma_uc_soru","govde":"Mustafa'nın payı, Deniz'in payından kaç TL fazladır?","secenekler":[{"harf":"A","metin":"5.400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"600 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"7.800 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"4.200 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"3.000 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"4 + 8 + 9 = 21"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"12.600 / 21 = 600 TL"},{"aciklama":"İki pay arasındaki fark, katsayı farkı kadar paydır:","ifade":"(9 − 4) × 600 = 3.000 TL"},{"aciklama":"Aradaki fark:","ifade":"3.000 TL"}],"mikrobeceriler":["oran.paylastirma"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.297,"gorsel":null,"grup":"7861d0f29d30","grup_govde":"Bir ikramiye Deniz, Ayşe ve Mustafa arasında sırasıyla 4, 8 ve 9 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 12.600 TL'dir."},{"kimlik":"7861d0f29d30-3","sablon":"oran.blok.paylastirma_uc_soru","govde":"Deniz, kendi payının %40'ını bağışlamıştır. Buna göre Deniz'in elinde kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"7.560 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"1.440 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"3.240 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"3.360 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"960 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"4 + 8 + 9 = 21"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"12.600 / 21 = 600 TL"},{"aciklama":"Deniz'in payı:","ifade":"4 × 600 = 2.400 TL"},{"aciklama":"Bağıştan sonra kalan, payın %60'ıdır:","ifade":"2.400 × 60/100 = 1.440 TL"},{"aciklama":"Elinde kalan:","ifade":"1.440 TL"}],"mikrobeceriler":["oran.paylastirma","yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.036,"gorsel":null,"grup":"7861d0f29d30","grup_govde":"Bir ikramiye Deniz, Ayşe ve Mustafa arasında sırasıyla 4, 8 ve 9 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 12.600 TL'dir."},{"kimlik":"e2bed63b643e","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 56 ve a · b = 614 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"680","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"1.908","dogru":true,"yanilgi":null},{"harf":"C","metin":"3.136","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"2.522","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"E","metin":"4.364","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"56² − 2 × 614 = 3.136 − 1.228 = 1.908"},{"aciklama":"a² + b² değeri:","ifade":"1.908"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.589,"gorsel":null},{"kimlik":"b8aad304d679","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"285 ile 669 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 24'e tam bölünür?","secenekler":[{"harf":"A","metin":"48","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"17","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"C","metin":"32","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"16","dogru":true,"yanilgi":null},{"harf":"E","metin":"129","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"}],"cozum":[{"aciklama":"24'e bölünen sayılar 24'ün katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"288 ve 648"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(648 − 288) / 24 + 1 = 16"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"16"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":-0.25,"gorsel":null},{"kimlik":"609a66627d75","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 12 : 4 : 9 oranındadır. Birinci arkadaşın parası 432 TL olduğuna göre üçüncü arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"36 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"576 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"300 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"9 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"324 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"12k : 4k : 9k"},{"aciklama":"Bilinen paydan k'yı çöz (birinci arkadaş):","ifade":"12k = 432 → k = 36"},{"aciklama":"Sorulan payı k ile çarp (üçüncü arkadaş):","ifade":"9 × 36 = 324"},{"aciklama":"Üçüncü arkadaşın parası:","ifade":"324 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.495,"gorsel":null},{"kimlik":"dc1ce9cde638","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 4.980 TL olan bir yazıcı 12.450 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%150","dogru":true,"yanilgi":null},{"harf":"B","metin":"%60","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%7.470","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%250","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"%40","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"12.450 TL − 4.980 TL = 7.470 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"7.470 / 4.980 × 100 = 150"},{"aciklama":"Kâr oranı:","ifade":"%150"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"9a71a69100f1","sablon":"veri.tablo.satir_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Bursa'nın dört mevsimdeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"120 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"150 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"480 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"145 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"E","metin":"160 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Bursa satırındaki dört değeri topla:","ifade":"80 + 24 + 276 + 100 = 480"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür; burada dört mevsim var:","ifade":"480 / 4 = 120"},{"aciklama":"Satır ortalaması:","ifade":"120 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari