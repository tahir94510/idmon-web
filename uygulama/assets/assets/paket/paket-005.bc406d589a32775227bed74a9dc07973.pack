":"1.080","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"D","metin":"360","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"E","metin":"300","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basamaklar soldan sağa doldurulur ve her adımda kullanılan rakam havuzdan çıkar.","ifade":null},{"aciklama":"Bir sayı 0 ile başlayamaz; ilk basamak için 6 rakamdan 0 hariç 5 seçenek vardır.","ifade":null},{"aciklama":"Kalan basamaklar için seçenekler:","ifade":"5 × 5 × 4 × 3 = 300"},{"aciklama":"Yazılabilecek sayı adedi:","ifade":"300"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"899d0d3ef92f","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Eskişehir şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2018 yılından 2021 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"220 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"320 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"C","metin":"110 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"130 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"E","metin":"80 kişi","dogru":false,"yanilgi":"grafik_artis_egim"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2018 değeri:","ifade":"210 kişi"},{"aciklama":"2021 değeri:","ifade":"320 kişi"},{"aciklama":"Farkı al:","ifade":"320 − 210 = 110"},{"aciklama":"Artış miktarı:","ifade":"110 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.472,"gorsel":{"tur":"cizgi","baslik":"Eskişehir şubesinin yıllık üye sayısı","etiketler":["2017","2018","2019","2020","2021"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[230,210,190,240,320]}]}},{"kimlik":"a8d4f86a7b02","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Buse, Emre, Mustafa ve Zeynep adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ahmet en baştaki ya da en sondaki koltukta oturmaktadır.\n• Zeynep, Mustafa adlı kişinin solunda oturmaktadır.\n• Emre ile Zeynep yan yana oturmamaktadır.\n• Emre uçtaki koltuklarda oturmamaktadır.\n• Ahmet, Emre adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Buse, Mustafa adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"B","metin":"Buse, Zeynep adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"C","metin":"Emre, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"D","metin":"Zeynep, Emre adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Zeynep, Mustafa adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ahmet − Emre − Buse − Zeynep − Mustafa"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Emre, Ahmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"d73df67afc2d","sablon":"oran.ters.kapasite_arac","govde":"Bir depodaki yükün tamamı, her biri 10 ton taşıyan 24 kamyonla bir seferde taşınmaktadır. Aynı yük, her biri 20 ton taşıyan kamyonlarla bir seferde taşınsaydı kaç kamyon gerekirdi?","secenekler":[{"harf":"A","metin":"240 kamyon","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"14 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"48 kamyon","