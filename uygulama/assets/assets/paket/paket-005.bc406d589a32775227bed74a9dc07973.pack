harf":"E","metin":"65","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"12 × 35 + 24 × 95 = 2.700"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"12 + 24 = 36"},{"aciklama":"Sınıf ortalaması:","ifade":"2.700 / 36 = 75"},{"aciklama":"Sınıfın ortalaması:","ifade":"75"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"c3fbb48e24de","sablon":"cebir.esitsizlik.iki_taraf_bilinmeyen","govde":"3x − 3 > 5x + 6 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"−5","dogru":true,"yanilgi":null},{"harf":"B","metin":"1","dogru":false,"yanilgi":"esitsizlikte_sabitler_ayni_tarafta"},{"harf":"C","metin":"−6","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"−4","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"E","metin":"−2","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"x'li terimleri bir tarafta, sabitleri öbür tarafta topla:","ifade":"3x − 5x > 6 + 3"},{"aciklama":"Katsayıları sadeleştir:","ifade":"−2x > 9"},{"aciklama":"Her iki tarafı −2 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner:","ifade":"x < −4,5"},{"aciklama":"Eşitsizliği sağlayan en büyük tam sayı:","ifade":"−5"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.007,"gorsel":null},{"kimlik":"293d0cc0eb74","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"5 · 2² · 2⁴ · 8⁰ + 2⁵ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"288","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"32","dogru":false,"yanilgi":"sifir_us"},{"harf":"C","metin":"1.312","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"10.240","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"E","metin":"352","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"8⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2² · 2⁴ = 2⁶ = 64"},{"aciklama":"Katsayıyla çarp:","ifade":"5 × 64 = 320"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"320 + 32 = 352"},{"aciklama":"İşlemin sonucu:","ifade":"352"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.036,"gorsel":null},{"kimlik":"bdee89b6dd61","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 67. Öğrencilerden 3'ü sırasıyla 81, 66 ve 42 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"63","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"189","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"79","dogru":true,"yanilgi":null},{"harf":"D","metin":"146","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"121","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"67 × 4 = 268"},{"aciklama":"Bilinen notların toplamı:","ifade":"81 + 66 + 42 = 189"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"268 − 189 = 79"},{"aciklama":"Kalan öğrencinin notu:","ifade":"79"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"540c73c4ce93","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 15 litre yakıt tüketmektedir.\n\nBu araç Antalya'ya yapılan 2.100 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"3.150 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"140 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"315 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"21 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"15 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"15/100 = x/2.100"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 2.100 × 15/100 = 315"},{"aciklama":"Tüketilen yakıt:","ifade":"315 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.164,"gorsel":null},{"kimlik":"47fa30a015b2","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 1.460 TL olan bir termos %150 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%60","dogru":true,"yanilgi":null},{"harf":"B","metin":"%40","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"C","metin":"%250","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%375","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%150","dogru":false,"yanilgi":"ardisik_yuzde_toplama"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"1.460 × 250/100 = 3.650 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"3.650 − 1.460 = 2.190 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"2.190/3.650 × 100 = 60"},{"aciklama":"Gereken indirim:","ifade":"%60"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.526,"gorsel":null},{"kimlik":"aa64338f7723","sablon":"kume.sayma.en_az_bir_kosullu","govde":"8 kadın ve 7 erkeğin bulunduğu bir ekipten 3 kişilik bir çalışma grubu seçilecektir. Grupta en az bir kadın bulunması koşuluyla, bu seçim kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"420","dogru":true,"yanilgi":null},{"harf":"B","metin":"2.520","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"C","metin":"35","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"D","metin":"728","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"E","metin":"455","dogru":false,"yanilgi":"sayma_ozdes_nesne"}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: önce hiçbir kısıt koymadan say, sonra **istenmeyen** durumları düş. Burada istenmeyen durum, hiç kadın olmaması.","ifade":null},{"aciklama":"Önce koşulsuz seçim sayısı. C(n, r), n kişiden r kişiyi sırasız seçme sayısıdır; burada 15 kişiden 3 kişi:","ifade":"C(15, 3) = (15×14×13) / (3×2×1) = 455"},{"aciklama":"Hiç kadın içermeyen seçimler yalnızca erkeklerden kurulur:","ifade":"C(7, 3) = (7×6×5) / (3×2×1) = 35"},{"aciklama":"Farkı al:","ifade":"455 − 35 = 420"},{"aciklama":"Farklı seçim sayısı:","ifade":"420"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":["kume.olasilik"],"zorluk":2.034,"gorsel":null},{"kimlik":"df0df93963da","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 9 kişinin yaş ortalaması 42. Gruptan bir kişi ayrılınca ortalama 45 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"738","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"360","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"27","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"D","metin":"3","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"18","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 9 × 42","ifade":"378"},{"aciklama":"Ayrıldıktan sonra grup 8 kişi: 8 × 45","ifade":"360"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"378 − 360 = 18"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"18"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.208,"gorsel":null},{"kimlik":"bfe13c29284f","sablon":"mantik.dizi.ikili_orgu","govde":"19, 23, 30, 29, 41, 35, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"63","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"29","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"52","dogru":true,"yanilgi":null},{"harf":"D","metin":"30","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"E","metin":"41","dogru":false,"yanilgi":"dizi_yanlis_altdizi"}],"cozum":[{"aciklama":"Ardışık farklar düzensiz; dizi tek bir kuralla yürümüyor. Terimleri birer atlayarak iki gruba ayır.","ifade":null},{"aciklama":"Baştan tek sıradakiler 11 artıyor:","ifade":"19, 30, 41"},{"aciklama":"Çift sıradakiler 6 değişiyor:","ifade":"23, 29, 35"},{"aciklama":"Soru işareti tek sıralı grubun sıradaki terimidir:","ifade":"41 + 11 = 52"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"52"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.402,"gorsel":null},{"kimlik":"258ab455dc70","sablon":"sayilar.uslu.us_kurallari","govde":"(2⁵)³ · (2⁴)³ : 2⁵ işleminin sonucu, 2 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"32","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"10","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"C","metin":"175","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"−27","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"E","metin":"22","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(2⁵)³ = 2¹⁵ , (2⁴)³ = 2¹²"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2¹⁵ · 2¹² = 2²⁷"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"2²⁷ : 2⁵ = 2²²"},{"aciklama":"Aranan kuvvet:","ifade":"22"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.37,"gorsel":null},{"kimlik":"2bb2b7a89c26","sablon":"problem.isci.ek_isci","govde":"12 işçi bir işi 6 günde bitirmektedir. Aynı iş 4 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"6 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"2 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"C","metin":"18 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"16 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"E","metin":"8 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"12 × 6 = 72"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"72 / 4 = 18"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"18 − 12 = 6"},{"aciklama":"Gereken ek işçi:","ifade":"6 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.405,"gorsel":null},{"kimlik":"91cf58b0e544","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 12 kişilik A grubunun puan ortalaması 40, 28 kişilik B grubunun puan ortalaması 90 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"65","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"75","dogru":true,"yanilgi":null},{"harf":"C","metin":"3.000","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"130","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"250","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 12 × 40","ifade":"480"},{"aciklama":"B grubu: 28 × 90","ifade":"2.520"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"3.000 / 40 = 75"},{"aciklama":"Ortak ortalama:","ifade":"75"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.799,"gorsel":null},{"kimlik":"81d544edc714","sablon":"oran.paylastirma.artan_pay","govde":"1.690 TL paranın bir kısmı Mehmet'e ve Ece'ye 4 : 9 oranında dağıtılmış, Mehmet'in payı 460 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"385 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"130 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"3.185 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"1.035 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"195 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mehmet'in payından birim payı çöz:","ifade":"4k = 460 → k = 115"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(4 + 9) × 115 = 1.495 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"1.690 − 1.495 = 195 TL"},{"aciklama":"Geriye kalan:","ifade":"195 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":3.18,"gorsel":null},{"kimlik":"edb381cd225e","sablon":"yuzde.artis.indirim","govde":"Fiyatı 2.700 TL olan bir güneş gözlüğü, %20 indirimle satılmaktadır. Güneş gözlüğünün indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"540 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"2.680 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"1.728 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"2.160 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"3.240 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"2.700 × 20 / 100 = 540"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"2.700 − 540 = 2.160"},{"aciklama":"İndirimli fiyat:","ifade":"2.160 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.682,"gorsel":null},{"kimlik":"5910591581c6","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 22 kişilik bir grubun yaş ortalaması 30, ikinci bir grubun yaş ortalaması ise 55'tir. İki grup birleştiğinde yaş ortalaması 45 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"22 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"32 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"C","metin":"33 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"55 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"25 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"22·30 + n·55"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(22·30 + n·55) / (22 + n) = 45"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"22·(30 − 45) = n·(45 − 55)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"33 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.532,"gorsel":null},{"kimlik":"78ebd5e18bfc","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 7 tek doğal sayının toplamı 959'dur.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"137","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"131","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"},{"harf":"C","metin":"141","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"D","metin":"143","dogru":true,"yanilgi":null},{"harf":"E","metin":"140","dogru":false,"yanilgi":"ardisik_adim_hatasi"}],"cozum":[{"aciklama":"Ardışık 7 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"959 / 7 = 137"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 3 adım ileridedir:","ifade":"137 + 2 × 3 = 143"},{"aciklama":"En büyük sayı:","ifade":"143"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"e0d5364b42d5","sablon":"cebir.esitsizlik.negatif_katsayi","govde":"−6(x − 20) > 31 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"14","dogru":true,"yanilgi":null},{"harf":"B","metin":"15","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"C","metin":"13","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"−9","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"25","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−6x + 120 > 31"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−6x > −89"},{"aciklama":"Her iki tarafı −6 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner: büyüktür işareti küçüktür olur:","ifade":"x < 89/6"},{"aciklama":"Sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"14"},{"aciklama":"En büyük tam sayı:","ifade":"14"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":["cebir.ozdeslik"],"zorluk":1.976,"gorsel":null},{"kimlik":"67f86f03cbd6","sablon":"oran.paylastirma.fark","govde":"6.600 TL tutarındaki bir ödül, Ali ile Deniz arasında 5/6 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"6.600 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"3.600 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"3.000 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"3.300 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"600 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"5 + 6 = 11"},{"aciklama":"Bir parçanın değeri:","ifade":"6.600 / 11 = 600 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(6 − 5) × 600 = 600 TL"},{"aciklama":"Aradaki fark:","ifade":"600 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":0.862,"gorsel":null},{"kimlik":"b52c01e03bc5","sablon":"veri.ortalama.medyan_tek","govde":"56, 164, 130, 184, 152, 198, 82 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"127","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"164","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"138","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"152","dogru":true,"yanilgi":null},{"harf":"E","metin":"184","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"56 < 82 < 130 < 152 < 164 < 184 < 198"},{"aciklama":"Terim sayısı 7, yani tek: ortada tek bir terim var.","ifade":"7 → 4. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"152"},{"aciklama":"Ortanca:","ifade":"152"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.413,"gorsel":null},{"kimlik":"96b46c30c568","sablon":"yuzde.artis.zam","govde":"Fiyatı 3.500 TL olan bir halı, %8 zamlanmıştır. Zamdan sonra halının fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"31.500 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"B","metin":"3.780 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"280 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"3.508 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"3.220 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"3.500 × 8/100 = 280 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"3.500 + 280 = 3.780 TL"},{"aciklama":"Zamlı fiyat:","ifade":"3.780 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.54,"gorsel":null},{"kimlik":"e587e80a1ad2","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n11, 15, 31, 67, 131, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"131","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"195","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"151","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"D","metin":"231","dogru":true,"yanilgi":null},{"harf":"E","metin":"230","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"4, 16, 36, 64"},{"aciklama":"Farklar ardışık sayıların karelerinin **4 katı**: 4·1², 4·2², 4·3², 4·4². Sıradaki fark 4·5²:","ifade":"100"},{"aciklama":"Son terime bu farkı ekle:","ifade":"131 + 100 = 231"},{"aciklama":"Sıradaki terim:","ifade":"231"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"d888e156bc63","sablon":"problem.isci.kalan_is","govde":"Bir işi Burak tek başına 80 günde, Kerem tek başına 20 günde bitirmektedir. Burak işe başlayıp 64 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Kerem tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"4 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"100 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"20 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"D","metin":"16 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"50 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"}],"cozum":[{"aciklama":"Burak günde işin 1/80'ini yapıyor; 64 günde:","ifade":"64/80"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 64/80 = 0,2"},{"aciklama":"Kerem işin tamamını 20 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"0,2 × 20 = 4"},{"aciklama":"Kalan iş için gereken süre:","ifade":"4 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":1.048,"gorsel":null},{"kimlik":"01f3ae378e43","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 6 kişinin yaş ortalaması 85. Gruba bir kişi daha katılınca ortalama 89'a çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"113","dogru":true,"yanilgi":null},{"harf":"B","metin":"89","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"24","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"87","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"109","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"6 × 85 = 510"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"7 × 89 = 623"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"623 − 510 = 113"},{"aciklama":"Katılan kişinin yaşı:","ifade":"113"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.24,"gorsel":null},{"kimlik":"c5ecf3b22d3a","sablon":"sayilar.basamak.deger_toplami","govde":"362 sayısında onlar basamağındaki rakamın basamak değeri ile birler basamağındaki rakamın sayı değerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"80","dogru":false,"yanilgi":"rakam_sayi_karisimi"},{"harf":"B","metin":"26","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"C","metin":"602","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"D","metin":"8","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"E","metin":"62","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basamak değeri, rakamın kendisi değil; rakam ile basamağın ağırlığının çarpımıdır.","ifade":null},{"aciklama":"Onlar basamağındaki 6 rakamının basamak değeri:","ifade":"6 × 10 = 60"},{"aciklama":"Birler basamağındaki rakamın sayı değeri rakamın kendisidir:","ifade":"2"},{"aciklama":"İkisini topla:","ifade":"60 + 2 = 62"},{"aciklama":"Aranan toplam:","ifade":"62"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.448,"gorsel":null},{"kimlik":"79b4a331d772","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Serkan, Kerem ve Onur arasında sırasıyla 7, 9 ve 10 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 4.680 TL olduğuna göre, Onur'un payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.560 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"1.800 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"180 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"D","metin":"1.260 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"2.880 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"7 + 9 + 10 = 26"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"4.680 / 26 = 180 TL"},{"aciklama":"Onur bu paylardan 10 tane alır:","ifade":"10 × 180 = 1.800 TL"},{"aciklama":"Onur'un payı:","ifade":"1.800 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.472,"gorsel":null},{"kimlik":"8b44f8cdf7dc","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda İzmir'in Sonbahar satışı silinmiş, yerine 0 yazılmıştır. İzmir satırının gerçek yıllık toplamı 780 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"780 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"305 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"195 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"215 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"E","metin":"395 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"İzmir satırında görünen üç değeri topla:","ifade":"325 + 60 + 90 = 475"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"780 − 475 = 305"},{"aciklama":"Silinen değer:","ifade":"305 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.197,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Trabzon","degerler":[235,115,260,280]},{"ad":"Bursa","degerler":[80,105,270,205]},{"ad":"İzmir","degerler":[325,60,0,90]},{"ad":"Samsun","degerler":[360,290,20,265]}]}},{"kimlik":"7833ee50c9a7","sablon":"yuzde.faiz.anapara","govde":"Yıllık %10 basit faiz oranıyla 3 ay vadeye yatırılan bir anapara 330 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.300 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"1.100 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"13.530 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"4.400 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"E","metin":"13.200 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"3 ay için faiz katsayısı:","ifade":"10/100 × 3/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"330 / (10 × 3/1200) = 13.200 TL"},{"aciklama":"Anapara:","ifade":"13.200 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.398,"gorsel":null},{"kimlik":"db0f6384b0ff","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 6.048 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"6.720","dogru":true,"yanilgi":null},{"harf":"B","metin":"682","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"6.048","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"D","metin":"67.200","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"672","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 6.048"},{"aciklama":"İlk sayı:","ifade":"x = 6.048 / 9 = 672"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 672 = 6.720"},{"aciklama":"Yeni sayı:","ifade":"6.720"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.749,"gorsel":null},{"kimlik":"bc2d0c2df9da","sablon":"mantik.dizi.sabit_fark","govde":"12, 21, 30, 39, 48, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"66","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"57","dogru":true,"yanilgi":null},{"harf":"C","metin":"39","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"48","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"56","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"21−12=9 , 30−21=9 , 39−30=9 , 48−39=9"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerliyor:","ifade":"fark = 9"},{"aciklama":"Son terime bu farkı ekle:","ifade":"48 + 9 = 57"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"57"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.663,"gorsel":null},{"kimlik":"ee0dfed402f0","sablon":"problem.karisim.birlestirme","govde":"Tuz oranı %10 olan 35 litre çözelti ile tuz oranı %16 olan 70 litre çözelti karıştırılıyor. Elde edilen karışımın tuz oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%14","dogru":true,"yanilgi":null},{"harf":"B","metin":"%12","dogru":false,"yanilgi":"karisim_agirlik_capraz"},{"harf":"C","metin":"%13","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"%42","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"E","metin":"%26","dogru":false,"yanilgi":"karisim_derisim_toplama"}],"cozum":[{"aciklama":"Önce her çözeltideki saf