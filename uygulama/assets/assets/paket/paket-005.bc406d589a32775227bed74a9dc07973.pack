iklama":"Merkez açısı:","ifade":"360 × 35 / 100 = 126"},{"aciklama":"Merkez açısı:","ifade":"126 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.39,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Yürüyüş","Bisiklet","Otobüs","Otomobil"],"birim":"%","seriler":[{"ad":"Pay","degerler":[25,10,30,35]}]}},{"kimlik":"4df482739701","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Eskişehir'e giderken yolun ilk bölümünü saatte 50 km hızla 2 saatte, kalan bölümünü saatte 70 km hızla 3 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"290 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"B","metin":"250 km","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"C","metin":"100 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"300 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"310 km","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"50 × 2 = 100 km"},{"aciklama":"İkinci bölüm:","ifade":"70 × 3 = 210 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"100 + 210 = 310 km"},{"aciklama":"Toplam yol:","ifade":"310 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.296,"gorsel":null},{"kimlik":"45dc2d51ea35","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(1/6 + 1/12) : 7/13 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"13/28","dogru":true,"yanilgi":null},{"harf":"B","metin":"13/63","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"C","metin":"13/84","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"7/52","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"E","metin":"13/21","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(6, 12) = 12"},{"aciklama":"Her kesri, paydası 12 olacak biçimde genişlet:","ifade":"1/6 = 2/12  (payı da paydayı da 2 ile çarptık)\n1/12  (paydası zaten 12)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"2/12 + 1/12 = 3/12"},{"aciklama":"Payı ve paydayı ortak bölenleri 3 ile sadeleştir:","ifade":"3/12 = 1/4"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"1/4 × 13/7"},{"aciklama":"Çarpımı yap:","ifade":"1 × 13 / (4 × 7) = 13/28"},{"aciklama":"İşlemin sonucu:","ifade":"13/28"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.711,"gorsel":null},{"kimlik":"e6a5e1e05385","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 2.000 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Üzüm tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"1.700 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"3.000 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"300 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.100 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"15 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Üzüm diliminin payı:","ifade":"%15"},{"aciklama":"Kişi sayısı:","ifade":"2.000 × 15 / 100 = 300"},{"aciklama":"Kişi sayısı:","ifade":"300 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[55,20,10,15]}]}},{"kimlik":"64536bd7bad9","sablon":"kume.olasilik.kume_uzerinden","govde":"Bir sınıftaki 46 öğrenciden 30 tanesi foto