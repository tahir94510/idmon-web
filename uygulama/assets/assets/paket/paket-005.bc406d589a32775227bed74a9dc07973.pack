null},{"harf":"C","metin":"169/45","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"D","metin":"585/37","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"104/3","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(5/9 − 4/15) · x = 13"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(9, 15) = 45"},{"aciklama":"Her kesri, paydası 45 olacak biçimde genişlet:","ifade":"5/9 = 25/45  (payı da paydayı da 5 ile çarptık)\n4/15 = 12/45  (payı da paydayı da 3 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"25/45 − 12/45 = 13/45"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 13 × 45/13 = 45"},{"aciklama":"Aranan sayı:","ifade":"45"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"77bc8713b71c","sablon":"mantik.ozel_islem.ic_ice","govde":"x ⊕ y = 3x + 4y biçiminde tanımlanan bir işlem için 6 ⊕ (5 ⊕ 6) işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"174","dogru":true,"yanilgi":null},{"harf":"B","metin":"38","dogru":false,"yanilgi":"ozel_islem_terim_atlandi"},{"harf":"C","metin":"141","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"D","metin":"39","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"138","dogru":false,"yanilgi":"ozel_islem_sira"}],"cozum":[{"aciklama":"Parantez içi **önce** hesaplanır:","ifade":"5 ⊕ 6 = 3·5 + 4·6 = 39"},{"aciklama":"Bulunan sonucu dıştaki işlemde yerine yaz:","ifade":"6 ⊕ 39 = 3·6 + 4·39 = 174"},{"aciklama":"İç içe işlemin sonucu:","ifade":"174"}],"mikrobeceriler":["mantik.ozel_islem"],"yanilgi_alanlari":["mantik.dizi"],"zorluk":0.758,"gorsel":null},{"kimlik":"d42402e1388f","sablon":"problem.hareket.karsilikli","govde":"Aralarındaki uzaklık 600 km