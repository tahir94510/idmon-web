"harf":"A","metin":"250 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"1.500 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"C","metin":"9.000 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"6.750 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"E","metin":"3.000 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"4.500 / (6 × 3) = 250 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"2 × 6 = 12"},{"aciklama":"Toplam ücret:","ifade":"12 × 250 = 3.000 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"3.000 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"21cc1680a784","sablon":"yuzde.temel.ters_yuzde","govde":"Bir masa lambası fiyatına %60 zam yapıldıktan sonra fiyatı 8.320 TL olmuştur. Masa lambasının zamdan önceki fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"8.260 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"20.800 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"3.328 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"3.120 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"5.200 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Zamlı fiyat, eski fiyatın %160'ıdır:","ifade":"eski × 160/100 = 8.320"},{"aciklama":"Eski fiyat, zamlı fiyatın bu orana bölümüdür:","ifade":"8.320 × 100/160 = 5.200 TL"},{"aciklama":"Zamdan önceki fiyat:","ifade":"5.200 TL"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.274,"gorsel":null},{"kimlik":"58c88ba9b297","sablon":"veri.grafik.daire_iki_dilim","govde":"200 kişiyle yapılan bir ankette tercihler yukarıdaki daire grafiğindeki gibi dağılmıştır. Buna göre Kiraz ve Elma seçeneklerini işaretleye