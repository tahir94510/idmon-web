:null},{"kimlik":"f3a1f6435017","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört şubede satılan toplam Telefon sayısı, toplam Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"5 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"100 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"25 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"60 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"360 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Soru tek bir şube değil, dördünün toplamını istiyor. Önce Telefon sütunlarını topla:","ifade":"65 + 110 + 90 + 95 = 360"},{"aciklama":"Sonra Tablet sütunlarını topla:","ifade":"50 + 110 + 30 + 70 = 260"},{"aciklama":"İki toplamın farkını al:","ifade":"360 − 260 = 100"},{"aciklama":"Aradaki fark:","ifade":"100 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.519,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[65,110,90,95]},{"ad":"Tablet","degerler":[50,110,30,70]}]}},{"kimlik":"5c08a55118d6","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 11| = 6 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"157","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"C","metin":"85","dogru":true,"yanilgi":null},{"harf":"D","metin":"−85","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"17","dogru":false,"yanilgi":"mutlak_deger_tek_kok"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 11 + 6 = 17 ve x = 11 − 6 = 5"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(11 + 6) × (11 − 6) = 11² − 6² = 85"},{"aciklama":"Köklerin çarpımı:","ifade":"85"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.503,"gorsel":null},{"kimlik":"7d3e2c70439e","sablon":"oran.bilesik.makine_uretim","govde":"9 makine 6 günde 4.050 parça üretmektedir. Aynı hızla çalışan 14 makine 3 günde kaç parça üretir?","secenekler":[{"harf":"A","metin":"75 parça","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"18.225/14 parça","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"C","metin":"3.150 parça","dogru":true,"yanilgi":null},{"harf":"D","metin":"6.075/7 parça","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"6.300 parça","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"}],"cozum":[{"aciklama":"Bir makinenin bir günlük üretimi bulunur:","ifade":"4.050 / (9 × 6) = 75 parça"},{"aciklama":"Üretim hem makine sayısıyla hem gün sayısıyla doğru orantılıdır:","ifade":"75 × 14 × 3 = 3.150 parça"},{"aciklama":"Üretilen parça:","ifade":"3.150 parça"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":2.233,"gorsel":null},{"kimlik":"cb7442917131","sablon":"yuzde.ardisik.zam_indirim","govde":"Bir mağazada 5.200 TL olan kol saatinin fiyatına önce %75 zam yapılmış, ardından yeni fiyat üzerinden %20 indirim uygulanmıştır. Son fiyat kaç TL'dir?","secenekler":[{"harf":"A","metin":"4.160 TL","dogru":false,"yanilgi":"ardisik_yuzde_tek_uygulama"},{"harf":"B","metin":"8.060 TL","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"C","metin":"9.100 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.560 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"7.280 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce %75 zam uygulanır:","ifade":"5.200 × 175/100 = 9.100 TL"},{"aciklama":"İndirim, zamlı fiyat üzerinden alınır (%20 inince %80 kalır):","ifade":"9.100 × 80/100 = 7.280 TL"},{"aciklama":"Ardışık yüzdeler toplanmaz, çarpılarak birleşir:","ifade":"175/100 × 80/100 = 1,4"},{"aciklama":"Son fiyat:","ifade":"7.280 TL"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":2.932,"gorsel":null},{"kimlik":"eddfa6d894c1","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre iki ürünün toplam satışının en yüksek olduğu ay için bu toplam kaç adettir?","secenekler":[{"harf":"A","metin":"230 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"200 adet","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"C","metin":"85 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"190 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"140 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Soru tek bir seriyi değil, iki serinin toplamını istiyor; her ay için iki sütunu topla:","ifade":"Mayıs: 230 , Haziran: 185 , Temmuz: 205 , Ağustos: 140"},{"aciklama":"Toplamların en büyüğü:","ifade":"Mayıs için 230"},{"aciklama":"En yüksek toplam satış:","ifade":"230 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["veri.tablo"],"zorluk":0.617,"gorsel":{"tur":"sutun","baslik":"Bisiklet ve Scooter satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[85,70,90,105]},{"ad":"Scooter","degerler":[145,115,115,35]}]}},{"kimlik":"6efee3f16909","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 58| = 13 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"22,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"B","metin":"35,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"13","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"58","dogru":true,"yanilgi":null},{"harf":"E","metin":"−58","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değer 13'e eşitse içerideki ifade 13 ya da −13 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 58 = 13 ⟹ x = 35,5"},{"aciklama":"İkinci durum:","ifade":"2x − 58 = −13 ⟹ x = 22,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"35,5 + 22,5 = 2 × 58 / 2 = 58"},{"aciklama":"Köklerin toplamı:","ifade":"58"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":2.107,"gorsel":null},{"kimlik":"5234f9241be9","sablon":"mantik.esleme.yerlestirme","govde":"4, 5, 6, 11, 13 ve 15 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ × □ − □ = □ + □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"11","dogru":false,"yanilgi":null},{"harf":"B","metin":"4","dogru":false,"yanilgi":null},{"harf":"C","metin":"13","dogru":true,"yanilgi":null},{"harf":"D","metin":"15","dogru":false,"yanilgi":null},{"harf":"E","metin":"5","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Soldaki çarpımdan bir sayı çıkınca, sağdaki iki sayının toplamı kalmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"5 × 6 − 4 = 11 + 15"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"13"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null,"cevap_uzayi":true},{"kimlik":"48d07798121b","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört bölgede sattığı Çay sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Doğu bölgesinde satılan Çay sayısı, dört bölgede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%45","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"%100","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%550","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"D","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"%55","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"250 + 150 + 550 + 50 = 1.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"550 / 1.000 × 100 = %55"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%55"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":{"tur":"sutun","baslik":"Çay satışları (adet)","etiketler":["Kuzey","Güney","Doğu","Batı"],"birim":"adet","seriler":[{"ad":"Çay","degerler":[250,150,550,50]}]}},{"kimlik":"645f77cfba32","sablon":"problem.yas.toplam_iliskisi","govde":"Burak ile Kerem'in bugünkü yaşları toplamı 40'tır, aralarındaki yaş farkı ise 10'dur.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"32","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"B","metin":"15","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"25","dogru":true,"yanilgi":null},{"harf":"D","metin":"39","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"E","metin":"50","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(40 + 10) / 2 = 25"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"40 − 25 = 15"},{"aciklama":"Büyük olanın yaşı:","ifade":"25"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.228,"gorsel":null},{"kimlik":"545307792b15","sablon":"oran.dogru.birim_fiyat","govde":"Bir ürünün 8 kilogram için 288 TL ödenmektedir. Aynı üründen 18 kilogram alan biri kaç TL öder?","secenekler":[{"harf":"A","metin":"360 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"648 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"936 TL","dogru":false,"yanilgi":"ikinci_alim_ek_sanildi"},{"harf":"D","metin":"298 TL","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"E","metin":"128 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"}],"cozum":[{"aciklama":"Miktar ile tutar doğru orantılıdır; önce birim fiyat bulunur:","ifade":"288 / 8 = 36 TL"},{"aciklama":"18 kilogram için tutar, birim fiyatın 18 katıdır:","ifade":"18 × 36 = 648 TL"},{"aciklama":"Ödenecek tutar:","ifade":"648 TL"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.sayi"],"zorluk":-2.058,"gorsel":null},{"kimlik":"22c2036961a1","sablon":"yuzde.artis.azalma_orani","govde":"Bir atölyenin aylık üretimi 1.480 adetten 296 adede düşmüştür. Üretimdeki azalma yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%1.184","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"%80","dogru":true,"yanilgi":null},{"harf":"C","metin":"%296","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%400","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%20","dogru":false,"yanilgi":"tumleyeni_verme"}],"cozum":[{"aciklama":"Azalma yüzdesi, azalma miktarının **eski** değere oranıdır.","ifade":null},{"aciklama":"Azalma miktarı:","ifade":"1.480 − 296 = 1.184"},{"aciklama":"Bunu eski değere oranla ve 100 ile çarp:","ifade":"1.184 / 1.480 × 100 = 80"},{"aciklama":"Azalma oranı:","ifade":"%80"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":-0.086,"gorsel":null},{"kimlik":"fd447a39a961","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 12 kız öğrencinin matematik notu ortalaması 95, 8 erkek öğrencinin ortalaması ise 75'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"87","dogru":true,"yanilgi":null},{"harf":"B","metin":"83","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"145","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"1.740","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"85","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"12 × 95 + 8 × 75 = 1.740"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"12 + 8 = 20"},{"aciklama":"Sınıf ortalaması:","ifade":"1.740 / 20 = 87"},{"aciklama":"Sınıfın ortalaması:","ifade":"87"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"4197188b6132","sablon":"cebir.denklem.sistem","govde":"3x + y = −13 ve 7x + 4y = −32 olduğuna göre 4x + 7y kaçtır?","secenekler":[{"harf":"A","metin":"−23","dogru":true,"yanilgi":null},{"harf":"B","metin":"−32","dogru":false,"yanilgi":"katsayi_yer_degistirme"},{"harf":"C","metin":"−9","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−5","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"−17","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"İki denklemi yok etme yöntemiyle çöz:","ifade":"x = −4 , y = −1"},{"aciklama":"Sorulan ifade x ve y'nin kendisi değil, katsayılı birleşimidir:","ifade":"4 × (−4) + 7 × (−1)"},{"aciklama":"Değeri hesapla:","ifade":"−16 − 7 = −23"},{"aciklama":"İstenen değer:","ifade":"−23"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.976,"gorsel":null},{"kimlik":"06669d206c71","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(2/3 + 3/13) : 6/7 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"119/234","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"245/234","dogru":true,"yanilgi":null},{"harf":"C","metin":"35/96","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"D","metin":"35/18","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"E","metin":"10/13","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(3, 13) = 39"},{"aciklama":"Her kesri, paydası 39 olacak biçimde genişlet:","ifade":"2/3 = 26/39  (payı da paydayı da 13 ile çarptık)\n3/13 = 9/39  (payı da paydayı da 3 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"26/39 + 9/39 = 35/39"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"35/39 × 7/6"},{"aciklama":"Çarpımı yap:","ifade":"35 × 7 / (39 × 6) = 245/234"},{"aciklama":"İşlemin sonucu:","ifade":"245/234"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.366,"gorsel":null},{"kimlik":"d8198fa641b4","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 60. Öğrencilerden 3'ü sırasıyla 83, 71 ve 32 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"114","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"186","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"86","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"54","dogru":true,"yanilgi":null},{"harf":"E","metin":"62","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"60 × 4 = 240"},{"aciklama":"Bilinen notların toplamı:","ifade":"83 + 71 + 32 = 186"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"240 − 186 = 54"},{"aciklama":"Kalan öğrencinin notu:","ifade":"54"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"7502fcb9156d","sablon":"kume.temel.hicbiri","govde":"Bir okulda 55 öğrenci vardır. Bu öğrencilerin 18 tanesi atletizm, 20 tanesi basketbol kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 5'tir. Buna göre bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"50","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"B","metin":"17","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"C","metin":"33","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"D","metin":"22","dogru":true,"yanilgi":null},{"harf":"E","metin":"27","dogru":false,"yanilgi":"kume_yalnizca_biri"}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"18 + 20 − 5 = 33"},{"aciklama":"Evrensel küme, hiçbir kursa gitmeyenleri de içerir:","ifade":"55 − 33 = 22"},{"aciklama":"Hiçbir kursa gitmeyen öğrenci sayısı:","ifade":"22"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"3445a356d9c7","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/600.000 olan bir haritada Eskişehir ile Konya arasındaki uzaklık 18 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"10,8 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"1.080 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"24 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"D","metin":"18 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"108 km","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"18 × 600.000 = 10.800.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"10.800.000 / 100.000 = 108 km"},{"aciklama":"Kısayol: ölçek 1/600.000 olduğunda haritadaki 1 cm, 6 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"108 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":0.163,"gorsel":null},{"kimlik":"00b42c469d10","sablon":"yuzde.artis.degisim_orani","govde":"Bir at