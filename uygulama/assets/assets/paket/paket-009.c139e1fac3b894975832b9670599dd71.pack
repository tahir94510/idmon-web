0 TL'dir."},{"kimlik":"6a54e02c02dd","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|5x + y − 3| + z = 5\n|5x − 5y + 15| = 2z − 10\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"1","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"6","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"},{"harf":"C","metin":"3","dogru":true,"yanilgi":null},{"harf":"D","metin":"5","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"−3","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 5 − |…| ≤ 5"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 10 ≥ 0 , yani z ≥ 5"},{"aciklama":"İkisi birlikte:","ifade":"z = 5"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"5x + y = 3 , 5x − 5y = −15"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 0 , y = 3"},{"aciklama":"İstenen toplam, x + y:","ifade":"3"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"dade5dc61fb8","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|x − 24| < 36 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"23","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"35","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"C","metin":"36","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"D","metin":"70","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"E","metin":"71","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"|A| < 36 eşitsizliği, A'nın −36 ile 36 arasında olması demektir:","ifade":"−36 < x − 24 < 36"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−12 < x < 60"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"71 tane"},{"aciklama":"Tam sayı adedi:","ifade":"71"}],"mikrobecerile