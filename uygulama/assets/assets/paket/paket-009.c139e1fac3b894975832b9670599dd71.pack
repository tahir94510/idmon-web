+ b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"59² − 2 × 49 = 3.481 − 98 = 3.383"},{"aciklama":"a² + b² değeri:","ifade":"3.383"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.635,"gorsel":null},{"kimlik":"fa12fc094cec","sablon":"mantik.dizi.artan_fark","govde":"18, 21, 29, 42, 60, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"60","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"82","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"C","metin":"63","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"D","metin":"83","dogru":true,"yanilgi":null},{"harf":"E","metin":"78","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"21−18=3 , 29−21=8 , 42−29=13 , 60−42=18"},{"aciklama":"Farklar sabit değil; her adımda 5 artıyor. Sıradaki fark:","ifade":"18 + 5 = 23"},{"aciklama":"Son terime bu farkı ekle:","ifade":"60 + 23 = 83"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"83"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.37,"gorsel":null},{"kimlik":"7058f97b0e5e","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"445A4 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"},{"harf":"C","metin":"12","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"4","dogru":true,"yanilgi":null},{"harf":"E","metin":"10","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A4 sayısı 4'ün katı olmalı ⟹ 44"},