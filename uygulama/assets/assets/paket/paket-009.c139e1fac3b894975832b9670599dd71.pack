8","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"E","metin":"−2","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 8 − |…| ≤ 8"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"4z − 32 ≥ 0 , yani z ≥ 8"},{"aciklama":"İkisi birlikte:","ifade":"z = 8"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"3x + y = 18 , 4x − 4y = −8"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 4 , y = 6"},{"aciklama":"İstenen toplam, x + y:","ifade":"10"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"b952a825f21e","sablon":"mantik.esleme.kesin_dogru","govde":"Ali, Ece, Kerem, Merve ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Kerem, Ali adlı kişinin solunda oturmaktadır.\n• Yusuf uçtaki koltuklarda oturmamaktadır.\n• Ali ile Merve yan yana oturmamaktadır.\n• Merve, Ece adlı kişinin hemen solundadır.\n• Ali, Yusuf adlı kişinin solunda oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Yusuf, Ece adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Merve, Ece adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"C","metin":"Ali, Kerem adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"D","metin":"Kerem, Ali adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"E","metin":"Merve, Ali adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Kerem − Ali − Yusuf − Merve − Ece"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Ali, Kerem adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"db09e6d3f3e2","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Antalya'ya giderken yolun ilk bölümünü saatte 110 km hızla 3 saatte, kalan bölümünü saatte 100 km hızla 2 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"520 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"B","metin":"530 km","dogru":true,"yanilgi":null},{"harf":"C","metin":"525 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"330 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"500 km","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"110 × 3 = 330 km"},{"aciklama":"İkinci bölüm:","ifade":"100 × 2 = 200 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"330 + 200 = 530 km"},{"aciklama":"Toplam yol:","ifade":"530 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.738,"gorsel":null},{"kimlik":"20db94d957b9","sablon":"oran.paylastirma.fark","govde":"5.850 TL tutarındaki bir ödül, Zeynep ile Ece arasında 2/11 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"4.050 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"900 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"4.950 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"2.925 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"450 TL","dogru":false,"yanilgi":"payla