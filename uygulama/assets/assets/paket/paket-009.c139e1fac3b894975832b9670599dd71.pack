× 2 = 1.280"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"1.280"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"0fd5843fe303","sablon":"sayilar.rasyonel.islem_onceligi","govde":"4 + 6/13 × 1/12 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"58/13","dogru":false,"yanilgi":"kesir_carpimda_payda_carpilmadi"},{"harf":"B","metin":"105/26","dogru":true,"yanilgi":null},{"harf":"C","metin":"124/13","dogru":false,"yanilgi":"kesir_carpimda_ters_cevrildi"},{"harf":"D","metin":"29/78","dogru":false,"yanilgi":"islem_onceligi_toplama_once"},{"harf":"E","metin":"103/26","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"İşlem önceliği: çarpma toplamadan önce yapılır.","ifade":null},{"aciklama":"Kesirlerin çarpımında paylar payla, paydalar paydayla çarpılır:","ifade":"6/13 × 1/12 = 6/156 = 1/26"},{"aciklama":"Tam sayıyı ekle:","ifade":"4 + 1/26 = 105/26"},{"aciklama":"İşlemin sonucu:","ifade":"105/26"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.687,"gorsel":null},{"kimlik":"effcf9d7796a","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 11 kız öğrencinin matematik notu ortalaması 80, 22 erkek öğrencinin ortalaması ise 95'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"85","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"90","dogru":true,"yanilgi":null},{"harf":"C","metin":"270","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"87,5","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"2.970","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"11 × 80 + 22 × 95 = 2.970"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"11 + 22 = 33"},{"aciklama":"Sınıf ortalaması:","ifade":"2.970 / 33 = 90"},{"aciklama":"Sınıfın ortalaması:","ifade":"90"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"1aa6c9cd1ec1","sablon":"problem.yas.kat_iliskisi","govde":"Emre'nin yaşı bugün Ece'nin yaşının 5 katıdır. 6 yıl önce Emre'nin yaşı Ece'nin yaşının 11 katı idi. Buna göre Emre bugün kaç yaşındadır?","secenekler":[{"harf":"A","metin":"40","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"44","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"C","metin":"50","dogru":true,"yanilgi":null},{"harf":"D","metin":"60","dogru":false,"yanilgi":"yas_toplam_fark_karisimi"},{"harf":"E","metin":"55","dogru":false,"yanilgi":"yas_farki_degisti"}],"cozum":[{"aciklama":"Ece'nin bugünkü yaşına x dersek, Emre'nin yaşı 5x olur.","ifade":null},{"aciklama":"6 yıl önce ikisi de 6 yaş küçüktü; fark değişmez:","ifade":"5x − 6 = 11·(x − 6)"},{"aciklama":"Denklemi çöz:","ifade":"5x − 6 = 11x − 66  ⟹  6x = 60  ⟹  x = 10"},{"aciklama":"Emre'nin bugünkü yaşı bunun 5 katıdır:","ifade":"5 × 10 = 50"},{"aciklama":"Emre bugün:","ifade":"50"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"5e0508dba8c2","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/500.000 olan bir haritada Trabzon ile Eskişehir arasındaki uzaklık 12 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"6 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"600 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"17 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"D","metin":"12 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"60 km","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"12 × 500.000 = 6.000.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"6.000.000 / 100.000 = 60 km"},{"aciklama":"Kısayol: ölçek 1/500.000 olduğunda haritadaki 1 cm, 5 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"60 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":0.051,"gorsel":null},{"kimlik":"9803365fbd4a","sablon":"yuzde.artis.azalma_orani","govde":"Bir atölyenin aylık üretimi 4.900 adetten 1.960 adede düşmüştür. Üretimdeki azalma yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%60","dogru":true,"yanilgi":null},{"harf":"B","metin":"%1.960","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%150","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%40","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"%2.940","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Azalma yüzdesi, azalma miktarının **eski** değere oranıdır.","ifade":null},{"aciklama":"Azalma miktarı:","ifade":"4.900 − 1.960 = 2.940"},{"aciklama":"Bunu eski değere oranla ve 100 ile çarp:","ifade":"2.940 / 4.900 × 100 = 60"},{"aciklama":"Azalma oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":-0.154,"gorsel":null},{"kimlik":"a019569b5606","sablon":"veri.ortalama.eksik_terim","govde":"5 öğrencinin sınav notu ortalaması 74. Öğrencilerden 4'ü sırasıyla 98, 43, 84 ve 91 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"79","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"54","dogru":true,"yanilgi":null},{"harf":"C","metin":"370","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"145","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"128","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"74 × 5 = 370"},{"aciklama":"Bilinen notların toplamı:","ifade":"98 + 43 + 84 + 91 = 316"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"370 − 316 = 54"},{"aciklama":"Kalan öğrencinin notu:","ifade":"54"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":null},{"kimlik":"62d951a860c9","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 3/8 katı ile 1/6 katı arasındaki fark 130'dur.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"624","dogru":true,"yanilgi":null},{"harf":"B","metin":"520","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"C","metin":"240","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"325/12","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"E","metin":"455","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(3/8 − 1/6) · x = 130"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(8, 6) = 24"},{"aciklama":"Her kesri, paydası 24 olacak biçimde genişlet:","ifade":"3/8 = 9/24  (payı da paydayı da 3 ile çarptık)\n1/6 = 4/24  (payı da paydayı da 4 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"9/24 − 4/24 = 5/24"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 130 × 24/5 = 624"},{"aciklama":"Aranan sayı:","ifade":"624"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":0.985,"gorsel":null},{"kimlik":"85a0b47e0cfc","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 10 kişinin yaş ortalaması 34. Gruptan bir kişi ayrılınca ortalama 36 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"664","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"16","dogru":true,"yanilgi":null},{"harf":"C","metin":"324","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"20","dogru":false,"yanilgi":"ortalama_eksik_terim"}