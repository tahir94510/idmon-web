metin":"280","dogru":false,"yanilgi":"sayma_tekrarli_secim"},{"harf":"E","metin":"27","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"}],"cozum":[{"aciklama":"Komitede görev ayrımı yok; kimin önce seçildiği sonucu değiştirmez. Böyle sırasız seçimlere kombinasyon denir ve C(n, r) ile yazılır: n kişiden r kişiyi seçme sayısı.","ifade":null},{"aciklama":"Kadınları seç. 4 kişiden 2 kişi:","ifade":"C(4, 2) = (4×3) / (2×1) = 6"},{"aciklama":"Erkekleri seç. 7 kişiden 2 kişi:","ifade":"C(7, 2) = (7×6) / (2×1) = 21"},{"aciklama":"İki seçim peş peşe yapıldığı için sayılar çarpılır:","ifade":"6 × 21 = 126"},{"aciklama":"Farklı komite sayısı:","ifade":"126"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":1.24,"gorsel":null},{"kimlik":"a86b1898f7ce","sablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Otobüs dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"36 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"72 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"144 derece","dogru":true,"yanilgi":null},{"harf":"D","metin":"40 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"216 derece","dogru":false,"yanilgi":"tumleyeni_verme"}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Otobüs diliminin payı:","ifade":"%40"},{"aciklama":"Merkez açısı:","ifade":"360 × 40 / 100 = 144"},{"aciklama":"Merkez açısı:","ifade":"144 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.455,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Yürüyüş","Bisiklet","Otobüs","Otomobil"],"birim":"%","seriler":[{"ad":"Pay","degerler":[15,35,40,10]}]}},{"kimlik":"5b4c57bf1074","sablon":"mantik.sifreleme.artan_kaydirma","gov