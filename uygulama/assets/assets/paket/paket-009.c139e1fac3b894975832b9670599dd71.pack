lo.en_cok_artan","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminden Sonbahar mevsimine satışı en çok artan şehirde bu artış kaç adettir?","secenekler":[{"harf":"A","metin":"40 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"460 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"335 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"5 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"210 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Her şehir için artışı ayrı ayrı hesapla (Sonbahar − İlkbahar):","ifade":"İzmir: 295 − 225 = 70 · Antalya: 335 − 125 = 210 · Trabzon: 50 − 45 = 5 · Konya: 345 − 305 = 40"},{"aciklama":"Sorulan, en büyük satış değil **en büyük artış**:","ifade":"Antalya, 210 adet"},{"aciklama":"En büyük artış:","ifade":"210 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.grafik","oran.paylastirma"],"zorluk":0.019,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[225,225,295,75]},{"ad":"Antalya","degerler":[125,345,335,190]},{"ad":"Trabzon","degerler":[45,280,50,385]},{"ad":"Konya","degerler":[305,40,345,85]}]}},{"kimlik":"7b298ab21636","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 30 ve a · b = 4 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"900","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"B","metin":"892","dogru":true,"yanilgi":null},{"harf":"C","metin":"896","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"D","metin":"908","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"E","metin":"884","dogru":false,"yanilgi":"iki_kare_farki_toplam"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"30² − 2 × 4 = 900 − 8 = 892"},{"aciklama":"a² + b² değeri:","ifade":"892"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"ac76c74af976","sablon":"oran.paylastirma.artan_pay","govde":"1.170 TL paranın bir kısmı Fatma'ya ve Elif'e 7 : 3 oranında dağıtılmış, Fatma'nın payı 700 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"115 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"117 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"700 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"170 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.170 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Fatma'nın payından birim payı çöz:","ifade":"7k = 700 → k = 100"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(7 + 3) × 100 = 1.000 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"1.170 − 1.000 = 170 TL"},{"aciklama":"Geriye kalan:","ifade":"170 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.66,"gorsel":null},{"kimlik":"a030f9b45d94","sablon":"yuzde.faiz.anapara","govde":"Yıllık %30 basit faiz oranıyla 9 ay vadeye yatırılan bir anapara 4.050 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"13.500 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"18.000 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.500 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"D","metin":"22.050 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.000 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"9 ay için faiz katsayısı:","ifade":"30/100 × 9/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"4.050 / (30 × 9/1200) = 18.000 TL"},{"aciklama":"Anapara:","ifade":"18.000 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.746,"gorsel":null},{"kimlik":"b2047da1a5a1","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"380 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"275 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"160 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"365 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"6 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Samsun: 380/40 · Bursa: 160/56 · Konya: 365/14 · Trabzon: 275/6"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Trabzon satırında:","ifade":"275/6"},{"aciklama":"O satırın satış sayısı:","ifade":"275 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.427,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Samsun","degerler":[380,40]},{"ad":"Bursa","degerler":[160,56]},{"ad":"Konya","degerler":[365,14]},{"ad":"Trabzon","degerler":[275,6]}]}},{"kimlik":"8b687d5131c5","sablon":"mantik.dizi.artan_fark","govde":"22, 25, 33, 46, 64, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"67","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"B","metin":"87","dogru":true,"yanilgi":null},{"harf":"C","metin":"64","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"86","dogru":false,"yanil