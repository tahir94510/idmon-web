,{"harf":"E","metin":"195 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"65 × 3 = 195 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"104 − 65 = 39 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"195 / 39 = 5"},{"aciklama":"Yetişme süresi:","ifade":"5 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"4576dae6d343","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 5/12 katı ile 2/9 katı arasındaki fark 14'tür.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"504/23","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"72","dogru":true,"yanilgi":null},{"harf":"C","metin":"56","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"D","metin":"42","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"49/18","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(5/12 − 2/9) · x = 14"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(12, 9) = 36"},{"aciklama":"Her kesri, paydası 36 olacak biçimde genişlet:","ifade":"5/12 = 15/36  (payı da paydayı da 3 ile çarptık)\n2/9 = 8/36  (payı da paydayı da 4 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"15/36 − 8/36 = 7/36"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 14 × 36/7 = 72"},{"aciklama":"Aranan sayı:","ifade":"72"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.135,"gorsel":null},{"kimlik":"23954618a809","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"134² − 119² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"32.117","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"2.010","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"−3.795","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"D","metin":"3.795","dogru":true,"yanilgi":null},{"harf":"E","metin":"225","dogru":false,"yanilgi":"tam_kare_orta_terim"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(134 − 119)(134 + 119) = 15 × 253"},{"aciklama":"Çarpımı yap:","ifade":"15 × 253 = 3.795"},{"aciklama":"İşlemin sonucu:","ifade":"3.795"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.11,"gorsel":null},{"kimlik":"3eda09c2fcb2","sablon":"oran.dogru.tarif_olcekleme","govde":"2 kişilik bir tarifte 860 gram un kullanılmaktadır. Aynı tarif 4 kişi için hazırlanacağına göre kaç gram un gerekir?","secenekler":[{"harf":"A","metin":"430 gram","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"B","metin":"862 gram","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"C","metin":"860 gram","dogru":false,"yanilgi":"yalniz_eklenen_kisim"},{"harf":"D","metin":"1.720 gram","dogru":true,"yanilgi":null},{"harf":"E","metin":"3.440 gram","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Kişi sayısı ile malzeme **doğru orantılıdır**: kişi kaç kat artarsa malzeme de o kat artar.","ifade":null},{"aciklama":"Kaç kat arttığını bul:","ifade":"4 / 2 = 2"},{"aciklama":"Malzemeyi aynı katla çarp:","ifade":"860 × 2 = 1.720"},{"aciklama":"Gereken un:","ifade":"1.720 gram"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.paylastirma","oran.ters"],"zorluk":-1.363,"gorsel":null},{"kimlik":"aade7457bbaf","sablon":"veri.ortalama.medyan_tek","govde":"30, 48, 24, 178, 80 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"80","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"101","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"48","dogru":true,"yanilgi":null},{"harf":"D","metin":"72","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"24","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"24 < 30 < 48 < 80 < 178"},{"aciklama":"Terim sayısı 5, yani tek: ortada tek bir terim var.","ifade":"5 → 3. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"48"},{"aciklama":"Ortanca:","ifade":"48"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.643,"gorsel":null},{"kimlik":"9d985c376763","sablon":"yuzde.artis.indirim","govde":"Fiyatı 3.600 TL olan bir masa lambası, %40 indirimle satılmaktadır. Masa lambasının indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.440 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"3.560 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"2.160 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"5.040 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"1.296 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"3.600 × 40 / 100 = 1.440"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"3.600 − 1.440 = 2.160"},{"aciklama":"İndirimli fiyat:","ifade":"2.160 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.228,"gorsel":null},{"kimlik":"1102a3d53ec6","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 10 kişinin yaş ortalaması 77. Gruba bir kişi daha katılınca ortalama 81'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"891","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"121","dogr