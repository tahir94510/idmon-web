sonra güneş gözlüğünün fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"2.730 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"630 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"65.100 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"1.470 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"2.130 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"2.100 × 30/100 = 630 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"2.100 + 630 = 2.730 TL"},{"aciklama":"Zamlı fiyat:","ifade":"2.730 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.92,"gorsel":null},{"kimlik":"5f91753a38af","sablon":"sayilar.uslu.us_kurallari","govde":"(7⁴)² · (7²)⁴ : 7¹⁰ işleminin sonucu, 7 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"54","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"B","metin":"−16","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"C","metin":"6","dogru":true,"yanilgi":null},{"harf":"D","metin":"2","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"E","metin":"26","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(7⁴)² = 7⁸ , (7²)⁴ = 7⁸"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"7⁸ · 7⁸ = 7¹⁶"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"7¹⁶ : 7¹⁰ = 7⁶"},{"aciklama":"Aranan kuvvet:","ifade":"6"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.687,"gorsel":null},{"kimlik":"07fb1f4016d2","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"290 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","meti