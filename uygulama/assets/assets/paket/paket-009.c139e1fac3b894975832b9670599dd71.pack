lgi":"basamak_farki_yanlis_bolen"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 7.893"},{"aciklama":"İlk sayı:","ifade":"x = 7.893 / 9 = 877"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 877 = 8.770"},{"aciklama":"Yeni sayı:","ifade":"8.770"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.462,"gorsel":null},{"kimlik":"4196b9999055","sablon":"oran.temel.oran_ve_toplam","govde":"Kerem'in parasının Ayşe'nin parasına oranı 7/6'dır. İkisinin parası toplam 2.080 TL olduğuna göre Kerem kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"1.120 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"14.560 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"C","metin":"960 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"160 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"1.040 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Kerem 7k, Ayşe 6k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"7k + 6k = 13k = 2.080"},{"aciklama":"Birim payı bul:","ifade":"k = 2.080 / 13 = 160"},{"aciklama":"Kerem için:","ifade":"7 × 160 = 1.120"},{"aciklama":"Kerem'in parası:","ifade":"1.120 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.405,"gorsel":null},{"kimlik":"bb061d23889b","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 3.860 TL olan bir koltuk 6.176 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%62,5","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"%37,5","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%2.316","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%160","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"%60","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"6.176 TL − 3.860 TL = 2.316 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"2.316 / 3.860 × 100 = 60"},{"aciklama":"Kâr oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"713eec323bd7","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 15/x = 21 olduğuna göre x² + 15²/x² kaçtır?","secenekler":[{"harf":"A","metin":"381","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"411","dogru":true,"yanilgi":null},{"harf":"C","metin":"426","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"D","metin":"441","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"471","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 15/x)² = x² + 2 · x · 15/x + 15²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 15 kalır:","ifade":"21² = x² + 15²/x² + 30"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 15²/x² = 441 − 30 = 411"},{"aciklama":"İstenen değer:","ifade":"411"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.793,"gorsel":null},{"kimlik":"e28c12017e44","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Ankara şubesindeki personel sayısı, toplam 1.900 personelin yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"%70","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%65","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%10","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"%35","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ankara şubesinin personel sayısı:","ifade":"665"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam personel.","ifade":"1.900"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"665 / 1.900 × 100 = %35"},{"aciklama":"Toplam içindeki pay:","ifade":"%35"}],"mikrobeceriler":["veri.yuzde_pay","veri.tablo","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.105,"gorsel":{"tur":"tablo","baslik":"Şubelere göre personel sayısı","etiketler":["Eskişehir","Ankara","Samsun","Antalya"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[950,665,190,95]}]}},{"kimlik":"01f7b9a1c4db","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n45, 46, 50, 59, 75, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"80","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"B","metin":"99","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"C","metin":"75","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"100","dogru":true,"yanilgi":null},{"harf":"E","metin":"111","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"1, 4, 9, 16"},{"aciklama":"Farklar ardışık sayıların **kareleri**: 1², 2², 3², 4². Sıradaki fark 5²:","ifade":"25"},{"aciklama":"Son terime bu farkı ekle:","ifade":"75 + 25 = 100"},{"aciklama":"Sıradaki terim:","ifade":"100"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.346,"gorsel":null},{"kimlik":"1949afd61611","sablon":"problem.karisim.su_ekleme","govde":"1.000 gram %12 tuzlu su çözeltisine 250 gram saf su eklenmiştir. Yeni çözeltinin tuz oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%12","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"B","metin":"%20","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%48","dogru":false,"yanilgi":"karisim_agirlik_capraz"},{"harf":"D","metin":"%9,6","dogru":true,"yanilgi":null},{"harf":"E","metin":"%6","dogru":false,"yanilgi":"karisim_derisim_toplama"}],"cozum":[{"aciklama":"Su eklemek tuz miktarını değiştirmez; önce tuzu bul:","ifade":"1.000 × 12/100 = 120 gram"},{"aciklama":"Yeni toplam miktar:","ifade":"1.000 + 250 = 1.250 gram"},{"aciklama":"Yeni oran, tuzun yeni toplama oranıdır:","ifade":"120 / 1.250 × 100 = %9,6"},{"aciklama":"Yeni tuz oranı:","ifade":"%9,6"}],"mikrobeceriler":["problem.karisim"],"yanilgi_alanlari":[],"zorluk":3.035,"gorsel":null},{"kimlik":"61494a0e2bea","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 4, onlar basamağındaki rakam 8'dir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"384","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"43","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"C","metin":"483","dogru":true,"yanilgi":null},{"harf":"D","metin":"411","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"E","metin":"438","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (4 − b) = 99 ⟹ 4 − b = 1 ⟹ b = 3"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 4 + 10 × 8 + 3 = 483"},{"aciklama":"Aranan sayı:","ifade":"483"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"727e1f7f4131","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Samsun şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2020 yılından 2022 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"80 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"120 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"C","metin":"20 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"160 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"60 kişi","dogru":false,"yanilgi":"grafik_artis_egim"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2020 değeri:","ifade":"40 kişi"},{"aciklama":"2022 değeri:","ifade":"120 kişi"},{"aciklama":"Farkı al:","ifade":"120 − 40 = 80"},{"aciklama":"Artış miktarı:","ifade":"80 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.612,"gorsel":{"tur":"cizgi","baslik":"Samsun şubesinin yıllık üye sayısı","etiketler":["2018","2019","2020","2021","2022"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[60,50,40,60,120]}]}},{"kimlik":"b176988a4cf2","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 9 : 3 : 12 oranındadır. Üçüncü arkadaşın parası 600 TL olduğuna göre ikinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"3 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"50 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"400 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"150 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.400 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"9k : 3k : 12k"},{"aciklama":"Bilinen paydan k'yı çöz (üçüncü arkadaş):","ifade":"12k = 600 → k = 50"},{"aciklama":"Sorulan payı k ile çarp (ikinci arkadaş):","ifade":"3 × 50 = 150"},{"aciklama":"İkinci arkadaşın parası:","ifade":"150 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.44,"gorsel":null},{"kimlik":"3994d14f4926","sablon":"yuzde.kar_zarar.maliyet_bulma","govde":"Bir ürün %60 kârla 2.400 TL fiyatına satılmıştır. Ürünün maliyeti kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.340 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"960 TL","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"C","metin":"1.500 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"900 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"6.000 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Kâr her zaman maliyet üzerinden hesaplanır; satış fiyatı maliyetin %160'ıdır:","ifade":"maliyet × 160/100 = 2.400"},{"aciklama":"Maliyet, satış fiyatının bu orana bölümüdür:","ifade":"2.400 × 100/160 = 1.500 TL"},{"aciklama":"Maliyet:","ifade":"1.500 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.398,"gorsel":null},{"kimlik":"398778807163","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 40, s(B) = 30 ve s(A ∪ B) = 46'dır. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"22","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"B","metin":"24","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"C","metin":"6","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"D","metin":"40","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"E","metin":"16","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 40 + 30 − 46 = 24"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"40 − 24 = 16"},{"aciklama":"s(A ∖ B):","ifade":"16"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"679b8a4c2deb","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Antalya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"430 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"B","metin":"100 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"C","metin":"240 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"50 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"E","metin":"170 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 100 · 2021→2022: −120 · 2022→2023: −50 · 2023→2024: −170"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2023 → 2024: 430 − 260 = 170 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"170 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.626,"gorsel":{"tur":"cizgi","baslik":"Antalya şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[500,600,480,430,260]}]}},{"kimlik":"ebcc08a1b788","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 18 ile bölümünden elde edilen bölüm 33, kalan ise 6'dır. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"702","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"B","metin":"600","dogru":true,"yanilgi":null},{"harf":"C","metin":"588","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"D","metin":"594","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"E","metin":"141","dogru":false,"yanilgi":"kalan_bolen_karisimi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"18 × 33 + 6 = 594 + 6 = 600"},{"aciklama":"Kalan (6) bölenden (18) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"600"}]