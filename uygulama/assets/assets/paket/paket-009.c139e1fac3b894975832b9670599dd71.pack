6"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"36"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":2.331,"gorsel":null},{"kimlik":"bbb9d6538465","sablon":"problem.yas.kat_iliskisi","govde":"Mehmet'in yaşı bugün Serkan'ın yaşının 6 katıdır. 4 yıl önce Mehmet'in yaşı Serkan'ın yaşının 10 katı idi. Buna göre Mehmet bugün kaç yaşındadır?","secenekler":[{"harf":"A","metin":"45","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"63","dogru":false,"yanilgi":"yas_toplam_fark_karisimi"},{"harf":"C","metin":"60","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"D","metin":"54","dogru":true,"yanilgi":null},{"harf":"E","metin":"50","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"Serkan'ın bugünkü yaşına x dersek, Mehmet'in yaşı 6x olur.","ifade":null},{"aciklama":"4 yıl önce ikisi de 4 yaş küçüktü; fark değişmez:","ifade":"6x − 4 = 10·(x − 4)"},{"aciklama":"Denklemi çöz:","ifade":"6x − 4 = 10x − 40  ⟹  4x = 36  ⟹  x = 9"},{"aciklama":"Mehmet'in bugünkü yaşı bunun 6 katıdır:","ifade":"6 × 9 = 54"},{"aciklama":"Mehmet bugün:","ifade":"54"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.826,"gorsel":null},{"kimlik":"98794a278907","sablon":"sayilar.uslu.us_kurallari","govde":"(2⁵)⁵ · (2⁴)² : 2³ işleminin sonucu, 2 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−33","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"B","metin":"13","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"C","metin":"30","dogru":true,"yanilgi":null},{"harf":"D","metin":"36","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"197","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(2⁵)⁵ = 2²⁵ , (2⁴)² = 2⁸"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2²⁵ · 2⁸ = 2³³"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"2³³ : 2³ = 2³⁰"},{"aciklama":"Aranan kuvvet:","ifade":"30"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.997,"gorsel":null},{"kimlik":"09e134f09e0b","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 14 kişinin yaş ortalaması 73. Gruba bir kişi daha katılınca ortalama 75'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"74","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"103","dogru":true,"yanilgi":null},{"harf":"C","metin":"28","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"101","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"75","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"14 × 73 = 1.022"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"15 × 75 = 1.125"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"1.125 − 1.022 = 103"},{"aciklama":"Katılan kişinin yaşı:","ifade":"103"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.711,"gorsel":null},{"kimlik":"eab1b9efd778","sablon":"oran.paylastirma.artan_pay","govde":"840 TL paranın bir kısmı Buse'ye ve Ahmet'e 3 : 2 oranında dağıtılmış, Buse'nin payı 345 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"75 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"265 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"345 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"168 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"1.415 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Buse'nin payından birim payı çöz:","ifade":"3k = 345 → k = 115"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(3 + 2) × 115 = 575 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"840 − 575 = 265 TL"},{"aciklama":"Geriye kalan:","ifade":"265 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.007,"gorsel":null},{"kimlik":"5bf0e9da1c0f","sablon":"yuzde.artis.zam","govde":"Fiyatı 1.000 TL olan bir halı, %30 zamlanmıştır. Zamdan sonra halının fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"31.000 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"B","metin":"1.030 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"1.300 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"300 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"700 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"1.000 × 30/100 = 300 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"1.000 + 300 = 1.300 TL"},{"aciklama":"Zamlı fiyat:","ifade":"1.300 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.92,"gorsel":null},{"kimlik":"c160c1bdf7b5","sablon":"veri.tablo.eksik_hucre","govde":"Yukarıdaki tabloda Trabzon'un Yaz satışı silinmiş, yerine 0 yazılmıştır. Trabzon satırının gerçek yıllık toplamı 620 adet olduğuna göre silinen değer kaçtır?","secenekler":[{"harf":"A","metin":"395 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"155 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"1.115 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"220 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"125 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Trabzon satırında görünen üç değeri topla:","ifade":"355 + 95 + 45 = 495"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"620 − 495 = 125"},{"aciklama":"Silinen değer:","ifade":"125 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.613,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[305,395,110,25]},{"ad":"Bursa","degerler":[155,335,285,100]},{"ad":"Ankara","degerler":[385,310,270,140]},{"ad":"Trabzon","degerler":[355,0,95,45]}]}},{"kimlik":"9e5d633bf180","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 20/x = 38 olduğuna göre x² + 20²/x² kaçtır?","secenekler":[{"harf":"A","metin":"1.484","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"B","metin":"1.444","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"C","metin":"1.424","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"D","metin":"1.364","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"E","metin":"1.404","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 20/x)² = x² + 2 · x · 20/x + 20²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 20 kalır:","ifade":"38² = x² + 20²/x² + 40"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 20²/x² = 1.444 − 40 = 1.404"},{"aciklama":"İstenen değer:","ifade":"1.404"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":3.125,"gorsel":null},{"kimlik":"c565a969a635","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 5 tek doğal sayının toplamı 245'tir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"51","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"B","metin":"45","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"},{"harf":"C","metin":"55","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"D","metin":"53","dogru":true,"yanilgi":null},{"harf":"E","metin":"49","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ardışık 5 sayıda ortadaki terim, toplamın terim sayısına bölümüne eşittir:","ifade":"245 / 5 = 49"},{"aciklama":"Ardışık tek sayılar 2'şer artar; en büyük terim ortadan 2 adım ileridedir:","ifade":"49 + 2 × 2 = 53"},{"aciklama":"En büyük sayı:","ifade":"53"}],"mikrobeceriler":["sayilar.ardisik"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null}]}