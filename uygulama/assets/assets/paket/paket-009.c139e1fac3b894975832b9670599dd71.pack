ır:","ifade":"1/150 + 1/100 = 5/300"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"300/5 = 60 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"60 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.875,"gorsel":null,"grup":"1f182b5fff7a","grup_govde":"Bir işi Fatma tek başına 150 günde, Merve tek başına 100 günde bitirmektedir."},{"kimlik":"1f182b5fff7a-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Fatma işe başlayıp 54 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Merve tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"64 gün","dogru":true,"yanilgi":null},{"harf":"B","metin":"100 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"36 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"125 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"E","metin":"250 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Fatma bir günde işin 1/150'sini yapıyor; 54 gün çalışınca yaptığı iş:","ifade":"54/150"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(150 − 54)/150 = 16/25"},{"aciklama":"Merve işin tamamını 100 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"16/25 × 100 = 64"},{"aciklama":"Kalan iş için gereken süre:","ifade":"64 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":4.051,"gorsel":null,"grup":"1f182b5fff7a","grup_govde":"Bir işi Fatma tek başına 150 günde, Merve tek başına 100 günde bitirmektedir."},{"kimlik":"5c018a806f3d","sablon":"oran.dogru.birim_fiyat","govde":"Bir ürünün 7 metre için 252 TL ödenmektedir. Aynı üründen 21 metre alan biri kaç TL öder?","secenekler":[{"harf":"A","metin":"84 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"B","metin":"756 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"504 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.008 TL","dogru":false,"yanilgi":"ikinci_alim_ek_sanildi"},{"harf":"E","metin":"266 TL","dogru":false,"yanilgi":"oran_yerine_sabit_fark"}],"cozum":[{"aciklama":"Miktar ile tutar doğru orantılıdır; önce birim fiyat bulunur:","ifade":"252 / 7 = 36 TL"},{"aciklama":"21 metre için tutar, birim fiyatın 21 katıdır:","ifade":"21 × 36 = 756 TL"},{"aciklama":"Ödenecek tutar:","ifade":"756 TL"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.sayi"],"zorluk":-1.845,"gorsel":null},{"kimlik":"5b67ede4b194","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 60. Öğrencilerden 3'ü sırasıyla 78, 56 ve 79 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"71","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"213","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"27","dogru":true,"yanilgi":null},{"harf":"D","metin":"106","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"87","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"60 × 4 = 240"},{"aciklama":"Bilinen notların toplamı:","ifade":"78 + 56 + 79 = 213"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"240 − 213 = 27"},{"aciklama":"Kalan öğrencinin notu:","ifade":"27"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"15b1e14719dc","sablon":"yuzde.artis.degisim_orani","govde":"Bir atölyenin aylık üretimi 1.500 adetten 4.800 adede çıkmıştır. Üretimdeki artış yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%68,75","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%31,25","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"%320","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%3.300","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%220","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Artış miktarı bulunur:","ifade":"4.800 − 1.500 = 3.300 adet"},{"aciklama":"Yüzde artış, artışın **eski** değere oranıdır:","ifade":"3.300 / 1.500 × 100 = %220"},{"aciklama":"Artış oranı:","ifade":"%220"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":2.948,"gorsel":null},{"kimlik":"11b9f7e1b3ec","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(11/14 + 2/7) : 3/11 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"143/42","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"55/14","dogru":true,"yanilgi":null},{"harf":"C","metin":"11/6","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"143/63","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"45/154","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(14, 7) = 14"},{"aciklama":"Her kesri, paydası 14 olacak biçimde genişlet:","ifade":"11/14  (paydası zaten 14)\n2/7 = 4/14  (payı da paydayı da 2 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"11/14 + 4/14 = 15/14"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"15/14 × 11/3"},{"aciklama":"Çarpımı yap:","ifade":"15 × 11 / (14 × 3) = 55/14"},{"aciklama":"İşlemin sonucu:","ifade":"55/14"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.746,"gorsel":null},{"kimlik":"b68ab74e5190","sablon":"mantik.sifreleme.artan_kaydirma","govde":"Bir şifrelemede KAPI kelimesi RĞZR biçiminde yazılmaktadır. Aynı kurala göre ÜZÜM kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"ÇGEÜ","dogru":true,"yanilgi":null},{"harf":"B","metin":"ÖRNE","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"C","metin":"DĞFV","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"D","metin":"ÇFÇŞ","dogru":false,"yanilgi":"sifreleme_sabit_kaydirma"},{"harf":"E","metin":"FĞDŞ","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"}],"cozum":[{"aciklama":"Örnekteki harfleri tek tek karşılaştır ve her harfin alfabede kaç sıra ilerlediğini yaz:","ifade":"K→R (7) , A→Ğ (8) , P→Z (9) , I→R (10)"},{"aciklama":"Kaydırma sabit değil; her harfte bir artıyor:","ifade":"7, 8, 9, 10"},{"aciklama":"Aynı kaydırmaları ÜZÜM kelimesine uygula:","ifade":"Ü→Ç , Z→G , Ü→E , M→Ü"},{"aciklama":"Şifrelenmiş kelime:","ifade":"ÇGEÜ"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":null},{"kimlik":"7d9e34a36ba1","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Trabzon ile Bursa arasındaki yolu giderken 91 km/sa, dönerken 78 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"91 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"42 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"C","metin":"84 km/sa","dogru":true,"yanilgi":null},{"harf":"D","metin":"84,5 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"169 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/91 + x/78 = x·(169)/(91·78)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·169/(91·78)] = 2·91·78/169 = 84 km/sa"},{"aciklama":"Ortalama hız:","ifade":"84 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.786,"gorsel":null},{"kimlik":"dd2a020b8d22","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 5 kişinin yaş ortalaması 38. Gruptan bir kişi ayrılınca ortalama 42 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"22","dogru":true,"yanilgi":null},{"harf":"B","metin":"168","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"4","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"20","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"358","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 5 × 38","ifade":"190"},{"aciklama":"Ayrıldıktan sonra grup 4 kişi: 4 × 42","ifade":"168"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"190 − 168 = 22"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"22"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.11,"gorsel":null},{"kimlik":"4cad688f8617","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/200.000 olan bir haritada Eskişehir ile Trabzon arasındaki uzaklık 7 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"140 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"9 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"C","metin":"7 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1,4 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"14 km","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"7 × 200.000 = 1.400.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"1.400.000 / 100.000 = 14 km"},{"aciklama":"Kısayol: ölçek 1/200.000 olduğunda haritadaki 1 cm, 2 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"14 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":-0.219,"gorsel":null},{"kimlik":"8b4f9eba7e92","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 1.880 TL olan bir sırt çantası %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde ka