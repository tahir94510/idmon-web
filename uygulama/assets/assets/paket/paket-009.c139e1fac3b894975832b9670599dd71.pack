500","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"%20","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Artış miktarı bulunur:","ifade":"12.500 − 2.500 = 10.000 adet"},{"aciklama":"Yüzde artış, artışın **eski** değere oranıdır:","ifade":"10.000 / 2.500 × 100 = %400"},{"aciklama":"Artış oranı:","ifade":"%400"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":3.875,"gorsel":null},{"kimlik":"7e11533c7d13","sablon":"mantik.dizi.terim_sirasi","govde":"15, 19, 23, 27, ... biçiminde devam eden dizide 67 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"14","dogru":true,"yanilgi":null},{"harf":"B","metin":"15","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"C","metin":"13","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"67","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"16,75","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"19 − 15 = 4"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 15 + (n − 1)·4"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"67 = 15 + (n − 1)·4 → n = 14"},{"aciklama":"Terimin sırası:","ifade":"14"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.645,"gorsel":null},{"kimlik":"1ba4879ed524","sablon":"problem.yas.toplam_iliskisi","govde":"Burak ile Emre'nin bugünkü yaşları toplamı 74'tür, aralarındaki yaş farkı ise 8'dir.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"41","dogru":true,"yanilgi":null},{"harf":"B","metin":"47","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"C","metin":"33","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"82","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"E","metin":"44","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(74 + 8) / 2 = 41"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"74 − 41 = 33"},{"aciklama":"Büyük olanın yaşı:","ifade":"41"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.282,"gorsel":null},{"kimlik":"a8194dbe102a","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 10 kişilik A grubunun puan ortalaması 76, 30 kişilik B grubunun puan ortalaması 68 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"72","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"144","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"70","dogru":true,"yanilgi":null},{"harf":"D","metin":"280","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"2.800","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 10 × 76","ifade":"760"},{"aciklama":"B grubu: 30 × 68","ifade":"2.040"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"2.800 / 40 = 70"},{"aciklama":"Ortak ortalama:","ifade":"70"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.356,"gorsel":null},{"kimlik":"c83187f309ac","sablon":"sayilar.rasyonel.toplama","govde":"5/7 + 5/12 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"25/84","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"40/7","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"C","metin":"10/7","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"D","metin":"95/84","dogru":true,"yanilgi":null},{"harf":"E","metin":"10/19","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(7, 12) = 84"},{"aciklama":"Her kesri, paydası 84 olacak biçimde genişlet:","ifade":"5/7 = 60/84  (payı da paydayı da 12 ile çarptık)\n5/12 = 35/84  (payı da paydayı da 7 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"60/84 + 35/84 = 95/84"},{"aciklama":"İşlemin sonucu:","ifade":"95/84"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.072,"gorsel":null},{"kimlik":"e9386a47475c","sablon":"cebir.denklem.kesirli","govde":"(x + 15)/8 − (x − 23)/6 = 5 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"17","dogru":true,"yanilgi":null},{"harf":"B","metin":"−167","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"32","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−17/7","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"E","metin":"132","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"Paydaların EKOK'u 24; denklemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(8, 6) = 24"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"3(x + 15) − 4(x − 23) = 120"},{"aciklama":"Benzer terimleri topla:","ifade":"−x + 137 = 120"},{"aciklama":"x'i yalıt:","ifade":"x = −17 / −1 = 17"},{"aciklama":"x değeri:","ifade":"17"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":2.973,"gorsel":null},{"kimlik":"715527c1a530","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 38 kişilik bir grubun yaş ortalaması 55, ikinci bir grubun yaş ortalaması ise 40'tır. İki grup birleştiğinde yaş ortalaması 50 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"57 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"19 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"15 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"48 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"38 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"38·55 + n·40"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(38·55 + n·40) / (38 + n) = 50"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"38·(55 − 50) = n·(50 − 40)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"19 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.253,"gorsel":null},{"kimlik":"34fd5ab2f020","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 36 litre yakıt tüketmektedir.\n\nBu araç Samsun'a yapılan 900 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"36 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"3.240 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"9 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"324 litre","dogru":true,"yanilgi":null},{"harf":"E","metin":"25 litre","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"36/100 = x/900"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 900 × 36/100 = 324"},{"aciklama":"Tüketilen yakıt:","ifade":"324 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":1.037,"gorsel":null},{"kimlik":"a39198fa5836","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 2.420 TL olan bir yazıcı %25 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%31,25","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"C","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%80","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"%20","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"2.420 × 125/100 = 3.025 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"3.025 − 2.420 = 605 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"605/3.025 × 100 = 20"},{"aciklama":"Gereken indirim:","ifade":"%20"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.458,"gorsel":null},{"kimlik":"c997f57df513","sablon":"sayilar.uslu.negatif_us","govde":"(2⁻³)² · 2³ işleminin sonucu, 2 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"9","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"B","metin":"−18","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"C","metin":"−2","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"D","metin":"3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−3","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(2⁻³)² = 2⁻⁶"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2⁻⁶ · 2³ = 2⁻³"},{"aciklama":"Aranan kuvvet:","ifade":"−3"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.619,"gorsel":null},{"kimlik":"fc32ed3e39e2","sablon":"veri.ortalama.medyan_tek","govde":"114, 98, 22, 62, 30, 116, 132 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"114","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"62","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"C","metin":"77","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"82","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"98","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"22 < 30 < 62 < 98 < 114 < 116 < 132"},{"aciklama":"Terim sayısı 7, yani tek: ortada tek bir terim var.","ifade":"7 → 4. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"98"},{"aciklama":"Ortanca:","ifade":"98"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.413,"gorsel":null},{"kimlik":"a380f73f47d7","sablon":"mantik.dizi.toplamsal","govde":"19, 36, 55, 91, 146, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"201","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"B","metin":"237","dogru":true,"yanilgi":null},{"harf":"C","metin":"383","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"D","metin":"146","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"292","dogru":false,"yanilgi":"dizi_kurali_eksik"}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"19 + 36 = 55"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"36 + 55 = 91"},{"aciklama":"Son iki terimi topla:","ifade":"91 + 146 = 237"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"237"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"b6f2516cd2f9-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Ayşe'nin payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"51.150 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"450 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"4.650 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"4.950 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"5.850 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"7 + 11 + 13 = 31"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"13.950 / 31 = 450 TL"},{"aciklama":"Ayşe bu paylardan 11 tane alır:","ifade":"11 × 450 = 4.950 TL"},{"aciklama":"Ayşe'nin payı:","ifade":"4.950 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.297,"gorsel":null,"grup":"b6f2516cd2f9","grup_govde":"Bir ikramiye Buse, Ayşe ve Yusuf arasında sırasıyla 7, 11 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 13.950 TL'dir."},{"kimlik":"b6f2516cd2f9-2","sablon":"oran.blok.paylastirma_uc_soru","govde":"Yusuf'un payı, Buse'nin payından kaç TL fazladır?","secenekler":[{"harf":"A","metin":"2.700 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"450 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"5.850 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"4.650 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"9.000 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"7 + 11 + 13 = 31"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"13.950 / 31 = 450 TL"},{"aciklama":"İki pay arasındaki fark, katsayı farkı kadar paydır:","ifade":"(13 − 7) × 450 = 2.700 TL"},{"aciklama":"Aradaki fark:","ifade":"2.700 TL"}],"mikrobeceriler":["oran.paylastirma"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.036,"gorsel":null,"grup":"b6f2516cd2f9","grup_govde":"Bir ikramiye Buse, Ayşe ve Yusuf arasında sırasıyla 7, 11 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 13.950 TL'dir."},{"kimlik":"b6f2516cd2f9-3","sablon":"oran.blok.paylastirma_uc_soru","govde":"Buse, kendi payının %10'unu bağışlamıştır. Buna göre Buse'nin elinde kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"5.265 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"3.465 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"2.835 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"12.555 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"315 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"7 + 11 + 13 = 31"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"13.950 / 31 = 450 TL"},{"aciklama":"Buse'nin payı:","ifade":"7 × 450 = 3.150 TL"},{"aciklama":"Bağıştan sonra kalan, payın %90'ıdır:","ifade":"3.150 × 90/100 = 2.835 TL"},{"aciklama":"Elinde kalan:","ifade":"2.835 TL"}],"mikrobeceriler":["oran.paylastirma","yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.537,"gorsel":null,"grup":"b6f2516cd2f9","grup_govde":"Bir ikramiye Buse, Ayşe ve Yusuf arasında sırasıyla 7, 11 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 13.950 TL'dir."},{"kimlik":"8dd29fc10486","sablon":"problem.hareket.karsilikli","govde":"Aralarındaki uzaklık 180 km olan Konya ve Bursa şehirlerinden aynı anda birbirine doğru iki araç hareket ediyor. Araçların hızları sırasıyla 40 km/sa ve 50 km/sa olduğuna göre, araçlar kaç saat sonra karşılaşır?","secenekler":[{"harf":"A","metin":"3,6 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"4 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"18 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"D","metin":"4,5 saat","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"E","metin":"2 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Zıt yönde hareket eden araçlar için yaklaşma hızı, hızların toplamıdır:","ifade":"40 + 50 = 90 km/sa"},{"aciklama":"Karşılaşma süresi, aradaki uzaklığın yaklaşma hızına bölümüdür:","ifade":"180 / 90 = 2 saat"},{"aciklama":"Karşılaşma süresi:","ifade":"2 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.957,"gorsel":null},{"kimlik":"ce66595ca700","sablon":"oran.paylastirma.artan_pay","govde":"2.610 TL paranın bir kısmı Mehmet'e ve Selin'e 8 : 7 oranında dağıtılmış, Mehmet'in payı 1.200 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"1.200 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"105 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"360 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"174 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"4.860 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Mehmet'in payından birim payı çöz:","ifade":"8k = 1.200 → k = 150"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(8 + 7) × 150 = 2.250 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"2.610 − 2.250 = 360 TL"},{"aciklama":"Geriye kalan:","ifade":"360 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":3.718,"gorsel":null},{"kimlik":"c6c554498ee9","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 14 kişinin yaş ortalaması 60. Gruba bir kişi daha katılınca ortalama 64'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"56","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"B","metin":"120","dogru":true,"yanilgi":null},{"harf":"C","metin":"960","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"116","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"62","dogru":false,"yanilgi":"ortalama_agirliksiz"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"14 × 60 = 