uzde.ardisik.iki_indirim","govde":"2.000 TL olan bir şemsiye fiyatına önce %25 indirim, ardından kalan fiyat üzerinden %30 indirim daha yapılmıştır. Son fiyat kaç TL'dir?","secenekler":[{"harf":"A","metin":"950 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"900 TL","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"C","metin":"3.250 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"1.500 TL","dogru":false,"yanilgi":"ardisik_yuzde_tek_uygulama"},{"harf":"E","metin":"1.050 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İkinci indirim ilk fiyata değil, **kalan fiyata** uygulanır; bu yüzden yüzdeler toplanmaz.","ifade":null},{"aciklama":"İlk indirimden sonra:","ifade":"2.000 TL × 75/100 = 1.500 TL"},{"aciklama":"İkinci indirimden sonra:","ifade":"1.500 TL × 70/100 = 1.050 TL"},{"aciklama":"Son fiyat:","ifade":"1.050 TL"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":0.294,"gorsel":null},{"kimlik":"7243c860a739","sablon":"sayilar.mutlak.kokler_toplami","govde":"|x − 55| = 4 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"110","dogru":true,"yanilgi":null},{"harf":"B","metin":"59","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"51","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"8","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"E","metin":"−110","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Mutlak değer 4'e eşitse içerideki ifade 4 ya da −4 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"x − 55 = 4 ⟹ x = 59"},{"aciklama":"İkinci durum:","ifade":"x − 55 = −4 ⟹ x = 51"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"59 + 51 = 2 × 55 = 110"},{"aciklama":"Köklerin toplamı:","ifade":"110"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":2.034,"gorsel":null},{"kimlik":"25d5f6196e24",