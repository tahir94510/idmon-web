{"surum":1,"uretim":"2026-10-04","taksonomi_parmak_izi":"c38bfac816a16c83","motor_parmak_izi":"89f6a7c03067ceb5","tohum":20260902,"dilim":9,"madde_sayisi":500,"maddeler":[{"kimlik":"6c3b8f255c3b","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Konya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2016 yılından 2018 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"270 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"B","metin":"90 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"20 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"70 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"180 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2016 değeri:","ifade":"180 kişi"},{"aciklama":"2018 değeri:","ifade":"270 kişi"},{"aciklama":"Farkı al:","ifade":"270 − 180 = 90"},{"aciklama":"Artış miktarı:","ifade":"90 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.575,"gorsel":{"tur":"cizgi","baslik":"Konya şubesinin yıllık üye sayısı","etiketler":["2016","2017","2018","2019","2020"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[180,200,270,290,210]}]}},{"kimlik":"3ae57338ec71","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 5.562 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"5.562","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"B","metin":"6.180","dogru":true,"yanilgi":null},{"harf":"C","metin":"618","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"628","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"E","metin":"61.800","dogru":false,"yanilgi":"basamak_yer_degistirme"}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 5.562"},{"aciklama":"İlk sayı:","ifade":"x = 5.562 / 9 = 618"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 618 = 6.180"},{"aciklama":"Yeni sayı:","ifade":"6.180"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.828,"gorsel":null},{"kimlik":"671bc8da1c43","sablon":"kume.sayma.en_az_bir_kosullu","govde":"12 kadın ve 9 erkeğin bulunduğu bir ekipten 2 kişilik bir çalışma grubu seçilecektir. Grupta en az bir kadın bulunması koşuluyla, bu seçim kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"210","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"B","metin":"36","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"C","metin":"240","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"D","metin":"174","dogru":true,"yanilgi":null},{"harf":"E","metin":"348","dogru":false,"yanilgi":"sayma_sira_onemli_mi"}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: önce hiçbir kısıt koymadan say, sonra **istenmeyen** durumları düş. Burada istenmeyen durum, hiç kadın olmaması.","ifade":null},{"aciklama":"Önce koşulsuz seçim sayısı. C(n, r), n kişiden r kişiyi sırasız seçme sayısıdır; burada 21 kişiden 2 kişi:","ifade":"C(21, 2) = (21×20) / (2×1) = 210"},{"aciklama":"Hiç kadın içermeyen seçimler yalnızca erkeklerden kurulur:","ifade":"C(9, 2) = (9×8) / (2×1) = 36"},{"aciklama":"Farkı al:","ifade":"210 − 36 = 174"},{"aciklama":"Farklı seçim sayısı:","ifade":"174"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":["kume.olasilik"],"zorluk":1.902,"gorsel":null},{"kimlik":"192de7d26a97","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Eskişehir şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"100 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"30 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"C","metin":"50 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"190 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"E","metin":"10 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: −50 · 2021→2022: −30 · 2022→2023: −10 · 2023→2024: 100"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2020 → 2021: 190 − 140 = 50 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"50 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":{"tur":"cizgi","baslik":"Eskişehir şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[190,140,110,100,200]}]}},{"kimlik":"f2ee64eda633","sablon":"mantik.esleme.yanlis_ifade","govde":"Ali, Ayşe, Buse, Elif ve Zeynep adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Buse ortadaki koltukta oturmamaktadır.\n• Ayşe, Zeynep adlı kişinin hemen solundadır.\n• Zeynep, Ali adlı kişinin solunda oturmaktadır.\n• Ayşe ile Elif yan yana oturmamaktadır.\n• Buse, Elif adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Ayşe, Zeynep adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"B","metin":"Ali ortadaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"C","metin":"Zeynep, Ayşe adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"D","metin":"Buse, Ali adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Ali, Zeynep adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ayşe − Zeynep − Ali − Buse − Elif"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Ayşe, Zeynep adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"e219a7521a1c","sablon":"problem.sayi.kesir_kalan","govde":"Burak, parasının 1/4'ünü kiraya, kalan parasının 1/3'ünü faturalara harcadığında geriye 100 TL kalmaktadır.\n\nBuna göre Burak'ın başlangıçtaki parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"100","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"1.200","dogru":false,"yanilgi":"harcanan_kesir_kalan_sanildi"},{"harf":"C","metin":"200","dogru":true,"yanilgi":null},{"harf":"D","metin":"240","dogru":false,"yanilgi":"kalanin_kesri_butunden"},{"harf":"E","metin":"150","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce paranın 1/4'ü harcanınca 3/4'ü kalır.","ifade":null},{"aciklama":"Sonra **kalanın** 1/3'ü harcanınca kalanın 2/3'ü kalır. İki kalan kesri çarpılır:","ifade":"3/4 · 2/3 = 1/2"},{"aciklama":"Paranın 1/2'si 100 TL ediyor:","ifade":"X · 1/2 = 100"},{"aciklama":"Baştaki para:","ifade":"200"}],"mikrobeceriler":["problem.sayi","sayilar.rasyonel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"4d97ef486888","sablon":"oran.temel.zincir","govde":"Elif'in parasının Yusuf'un parasına oranı 7/11, Yusuf'un parasının Buse'nin parasına oranı 11/6 olarak veriliyor. Buna göre Elif'in parasının Buse'nin parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"42/121","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"7/6","dogru":true,"yanilgi":null},{"harf":"C","metin":"7/11","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"163/66","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"6/7","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"}],"cozum":[{"aciklama":"Ortadaki terim ortak olduğu için oranlar zincirlenir:","ifade":"(7/11) × (11/6)"},{"aciklama":"Çarpım sadeleştirilir:","ifade":"77/66 = 7/6"},{"aciklama":"Aranan oran:","ifade":"7/6"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.dogru"],"zorluk":2.034,"gorsel":null},{"kimlik":"2a96376823c4","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, tanesini 2.800 TL maliyetle aldığı bir şemsiye çeşidini %20 kârla satmaktadır. Buna göre şemsiyenin satış fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.360 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"560 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"2.240 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"58.800 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"E","metin":"2.820 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Kâr yüzdesi her zaman maliyet üzerinden hesaplanır:","ifade":"2.800 × 20/100 = 560 TL"},{"aciklama":"Satış fiyatı maliyet ile kârın toplamıdır:","ifade":"2.800 + 560 = 3.360 TL"},{"aciklama":"Satış fiyatı:","ifade":"3.360 TL"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-1.38,"gorsel":null},{"kimlik":"c2552c673952","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"210 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"5 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"10 adet","dogru":false,"ya