ılımı","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"%","seriler":[{"ad":"Pay","degerler":[5,30,40,25]}]}},{"kimlik":"a86d1f745062","sablon":"yuzde.temel.orandan_oran","govde":"Bir sayının %40'ı 1.800'dür.\n\nBuna göre aynı sayının %45'i kaçtır?","secenekler":[{"harf":"A","metin":"1.600","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"1.805","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"4.500","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"810","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"2.025","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayının %40'ı biliniyorsa sayının kendisi bulunur:","ifade":"1.800 / (40/100) = 4.500"},{"aciklama":"Sayının %45'i:","ifade":"4.500 × 45/100 = 2.025"},{"aciklama":"Aranan değer:","ifade":"2.025"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["oran.temel","yuzde.artis_azalis"],"zorluk":-0.413,"gorsel":null},{"kimlik":"ef4dee7bec4c","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 39 dakikada bir, B hattı 6 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"3 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"B","metin":"156 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"234 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"D","metin":"78 dakika","dogru":true,"yanilgi":null},{"harf":"E","metin":"45 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"39 ve 6 sayılarının EKOK'u:","ifade":"EKOK(39, 6) = 78"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"78 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":1.398,"gorsel":null},{"kimlik":"ec7c8538856e","sablon":"kume.temel.herkes_en_az_bir","govde":"Bir grupta 33 kişi vardır ve herkes bu iki dilden en az birini bilmektedir. İngilizce bilen 24, Almanca bilen 25 kişi olduğuna göre, her iki dili de bilen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"17","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"C","metin":"49","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"9","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"E","metin":"16","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Herkes en az birini bildiği için birleşim grubun tamamıdır:","ifade":"s(A ∪ B) = 33"},{"aciklama":"Birleşim formülünü kesişim için çöz:","ifade":"s(A ∩ B) = 24 + 25 − 33 = 16"},{"aciklama":"Her iki dili de bilen kişi sayısı:","ifade":"16"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.975,"gorsel":null},{"kimlik":"7613e82796b9","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 1.420 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Öykü tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"15 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"B","metin":"142 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"1.207 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"2.130 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"213 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Öykü diliminin payı:","ifade":"%15"},{"aciklama":"Kişi sayısı:","ifade":"1.420 × 15 / 100 = 213"},{"aciklama":"Kişi sayısı:","ifade":"213 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.164,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Roman","Şiir","Deneme","Öykü"],"birim":"%","seriler":[{"ad":"Pay","degerler":[10,25,50,15]}]}},{"kimlik":"7ed8d939d697","sablon":"mantik.esleme.kesin_dogru","govde":"Ali, Buse, Deniz, Mehmet ve Merve adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Merve, Mehmet adlı kişinin solunda oturmaktadır.\n• Merve ile Mehmet yan yana oturmamaktadır.\n• Buse ile Deniz yan yana oturmamaktadır.\n• Buse, Merve adlı kişinin hemen solundadır.\n• Deniz ile Mehmet yan yana oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Mehmet, Deniz adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"B","metin":"Merve, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Deniz, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"D","metin":"Ali, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"E","metin":"Buse, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Buse − Merve − Deniz − Ali − Mehmet"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Merve, Buse adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"9fa717d59b11","sablon":"oran.ters.musluk_havuz","govde":"Özdeş 6 musluk bir havuzu 24 saatte doldurmaktadır. Aynı havuz özdeş 4 muslukla kaç saatte dolar?","secenekler":[{"harf":"A","metin":"16 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"22 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"8/3 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"D","metin":"26 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"E","metin":"36 saat","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Musluk sayısı ile süre ters orantılıdır; çarpımları sabittir:","ifade":"6 × 24 = 144"},{"aciklama":"4 muslukta süre, bu sabitin musluk sayısına bölümüdür:","ifade":"144 / 4 = 36 saat"},{"aciklama":"Dolma süresi:","ifade":"36 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.25,"gorsel":null},{"kimlik":"e7995c67defe","sablon":"yuzde.temel.ters_yuzde","govde":"Bir ayakkabı fiyatına %20 zam yapıldıktan sonra fiyatı 4.560 TL olmuştur. Ayakkabının zamdan önceki fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.648 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"760 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"3.800 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"4.540 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"5.700 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zamlı fiyat, eski fiyatın %120'sidir:","ifade":"eski × 120/100 = 4.560"},{"aciklama":"Eski fiyat, zamlı fiyatın bu orana bölümüdür:","ifade":"4.560 × 100/120 = 3.800 TL"},{"aciklama":"Zamdan önceki fiyat:","ifade":"3.800 TL"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.495,"gorsel":null},{"kimlik":"4b276feee9e6","sablon":"veri.grafik.sutun_en_cok_dusen","govde":"Bir işletmenin dört ayda sattığı Kitap sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre **ardışık** iki ay arasındaki en büyük düşüş kaç adettir?","secenekler":[{"harf":"A","metin":"5 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"B","metin":"20 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"280 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"150 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"120 adet","dogru":false,"yanilgi":"ardisiklik_sarti_atlandi"}],"cozum":[{"aciklama":"Ardışık dönemlerin farklarını sırayla al:","ifade":"Ocak→Şubat: −40 · Şubat→Mart: 20 · Mart→Nisan: −100"},{"aciklama":"Düşüş, farkın **pozitif** olduğu yerdedir; en büyüğü seç:","ifade":"20"},{"aciklama":"En büyük düşüş:","ifade":"20 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.885,"gorsel":{"tur":"sutun","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[110,150,130,230]}]}},{"kimlik":"6f973d745863","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 108 cm ve 297 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"27 cm","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.188 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"C","metin":"15 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"405 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"E","metin":"9 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"108 = 27·4   ve   297 = 27·11"},{"aciklama":"Ortak çarpan 27; kalan çarpanlar (4 ve 11) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(108, 297) = 27"},{"aciklama":"En büyük parça uzunluğu:","ifade":"27 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.985,"gorsel":null},{"kimlik":"ecbd94f075d3","sablon":"problem.sayi.verme_alma","govde":"Selin, Buse'ye bilyelerinin 15 tanesini verirse ikisinin bilye sayıları eşit olmaktadır. Buse, Selin'e bilyelerinin 13 tanesini verirse Selin'in bilye sayısı Buse'ninkinin 2 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç bilyesi vardır?","secenekler":[{"harf":"A","metin":"123","dogru":false,"yanilgi":"verme_farki_tek_sayildi"},{"harf":"B","metin":"168","dogru":true,"yanilgi":null},{"harf":"C","metin":"84","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"99","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"116","dogru":false,"yanilgi":"verme_tek_taraf"}],"cozum":[{"aciklama":"Selin 15 tane verince kendisi 15 azalır, Buse 15 artar: aradaki fark 30 kapanır. Eşitlendiklerine göre baştaki fark 30'dur.","ifade":null},{"aciklama":"Buse'nin sayısına x dersek Selin'inki x + 30 olur. İkinci koşulda Buse 13 tane verir, Selin 13 tane alır:","ifade":"x + 30 + 13 = 2·(x − 13)"},{"aciklama":"Denklemi çöz:","ifade":"x = 69"},{"aciklama":"Toplam x + (x + 30) olduğuna göre:","ifade":"168"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"f76448261728","sablon":"veri.grafik.sutun_fark","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre D şubesinde satılan Telefon sayısı, aynı şubede satılan Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"15 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"110 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"85 adet","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"D","metin":"95 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"160 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Önce sorunun istediği şube işaretle: D şubesi.","ifade":null},{"aciklama":"Telefon sütununu oku:","ifade":"135 adet"},{"aciklama":"Tablet sütununu oku:","ifade":"25 adet"},{"aciklama":"İki değerin farkını al:","ifade":"135 − 25 = 110"},{"aciklama":"Aradaki fark:","ifade":"110 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.7,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[135,85,120,135]},{"ad":"Tablet","degerler":[40,75,35,25]}]}},{"kimlik":"491a243dc94e-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Elif'in payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"43.200 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"5.200 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"400 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"D","metin":"3.600 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"4.800 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 12 + 13 = 27"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"10.800 / 27 = 400 TL"},{"aciklama":"Elif bu paylardan 12 tane alır:","ifade":"12 × 400 = 4.800 TL"},{"aciklama":"Elif'in payı:","ifade":"4.800 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.448,"gorsel":null,"grup":"491a243dc94e","grup_govde":"Bir ikramiye Selin, Elif ve Ali arasında sırasıyla 2, 12 ve 13 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 10.800 TL'dir."},{"kimlik":"491a243dc94e-2","sablon":"oran.blok.paylastirma_uc_soru","govde":"Ali'nin payı, Selin'in payından kaç TL fazladır?","secenekler":[{"harf":"A","metin":"4.400 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"5.200 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"6.000 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"3.600 TL","dogru":false,"yanilgi":"paylastirmada