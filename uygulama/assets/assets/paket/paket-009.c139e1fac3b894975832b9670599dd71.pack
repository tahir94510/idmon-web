r işletmenin dört bölgede sattığı Çay sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre **ardışık** iki bölge arasındaki en büyük düşüş kaç adettir?","secenekler":[{"harf":"A","metin":"100 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"25 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"160 adet","dogru":false,"yanilgi":"ardisiklik_sarti_atlandi"},{"harf":"D","metin":"195 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"290 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Ardışık dönemlerin farklarını sırayla al:","ifade":"Kuzey→Güney: −135 · Güney→Doğu: 100 · Doğu→Batı: −125"},{"aciklama":"Düşüş, farkın **pozitif** olduğu yerdedir; en büyüğü seç:","ifade":"100"},{"aciklama":"En büyük düşüş:","ifade":"100 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.519,"gorsel":{"tur":"sutun","baslik":"Çay satışları (adet)","etiketler":["Kuzey","Güney","Doğu","Batı"],"birim":"adet","seriler":[{"ad":"Çay","degerler":[60,195,95,220]}]}},{"kimlik":"c9f6f9c24a4c","sablon":"sayilar.mutlak.kokler_toplami","govde":"|6x − 36| = 6 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"−12","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"2","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"12","dogru":true,"yanilgi":null},{"harf":"D","metin":"7","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değer 6'ya eşitse içerideki ifade 6 ya da −6 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"6x − 36 = 6 ⟹ x = 7"},{"aciklama":"İkinci durum:","ifade":"6x − 36 = −6 ⟹ x = 5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"7 + 5 = 2 × 36 / 6 = 12"},{"aciklama":"Köklerin toplamı:","ifade":"12"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.589,"gorsel":null},{"kimlik":"6583885dc5e6","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"60² − 44² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"5.536","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"1.664","dogru":true,"yanilgi":null},{"harf":"C","metin":"−1.664","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"D","metin":"256","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"960","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(60 − 44)(60 + 44) = 16 × 104"},{"aciklama":"Çarpımı yap:","ifade":"16 × 104 = 1.664"},{"aciklama":"İşlemin sonucu:","ifade":"1.664"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.14,"gorsel":null},{"kimlik":"a9e0df705889","sablon":"oran.bilesik.isci_ucret","govde":"8 işçi 3 günde çalışarak toplam 12.000 TL kazanmaktadır. Aynı günlük ücretle çalışan 3 işçi 12 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"18.000 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"48.000 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"8.000 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"D","metin":"4.500 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"E","metin":"500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"12.000 / (8 × 3) = 500 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"3 × 12 = 36"},{"aciklama":"Toplam ücret:","ifade":"36 × 500 = 18.000 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"18.000 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":1.201,"gorse