yi_dogru_kurma"},{"harf":"C","metin":"308 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"14 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"17 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"İşçi sayısı ile süre ters orantılıdır; çarpımları toplam iş yükünü verir:","ifade":"11 × 28 = 308 işçi-gün"},{"aciklama":"Aynı iş yükü 22 işçiye bölündüğünde süre:","ifade":"308 / 22 = 14 gün"},{"aciklama":"İşin biteceği süre:","ifade":"14 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.567,"gorsel":null},{"kimlik":"7b164c570aff","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 1.800 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Armut tercih edenler, Elma tercih edenlerden kaç kişi fazladır?","secenekler":[{"harf":"A","metin":"30 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"B","metin":"720 kişi","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"5.400 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"270 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"540 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Dilimler yüzdedir; önce ikisinin yüzde farkını al:","ifade":"%35 − %5 = %30"},{"aciklama":"Yüzde farkını kişi sayısına çevir:","ifade":"1.800 × 30 / 100 = 540"},{"aciklama":"Aradaki fark:","ifade":"540 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":1.325,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[5,35,50,10]}]}},{"kimlik":"9522949560fc","sablon":"yuzde.temel.iki_yuzde_farki","govde":"1.150 sayısının %24'ü ile %20'si arasındaki fark kaçtır?","secenekler":[{"harf":"A","metin":"276","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"4","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"