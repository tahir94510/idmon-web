abit_fark"},{"harf":"B","metin":"2.160 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"18 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"216 km","dogru":true,"yanilgi":null},{"harf":"E","metin":"21,6 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"18 × 1.200.000 = 21.600.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"21.600.000 / 100.000 = 216 km"},{"aciklama":"Kısayol: ölçek 1/1.200.000 olduğunda haritadaki 1 cm, 12 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"216 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":0.758,"gorsel":null},{"kimlik":"6f499f1fb924","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 60. Öğrencilerden 3'ü sırasıyla 58, 54 ve 74 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"114","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"62","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"240","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"128","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"54","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"60 × 4 = 240"},{"aciklama":"Bilinen notların toplamı:","ifade":"58 + 54 + 74 = 186"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"240 − 186 = 54"},{"aciklama":"Kalan öğrencinin notu:","ifade":"54"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"0db4fecf7b4e","sablon":"sayilar.rasyonel.toplama","govde":"5/6 + 5/13 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"35/78","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"95/