sablon":"cebir.esitsizlik.cift_tarafli","govde":"15 < 3x − 13 < 66 eşitsizliğini sağlayan x'in en büyük tam sayı değeri kaçtır?","secenekler":[{"harf":"A","metin":"26","dogru":true,"yanilgi":null},{"harf":"B","metin":"22","dogru":false,"yanilgi":"esitsizlik_ucu_ayrilmadi"},{"harf":"C","metin":"17","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"27","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"10","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Çift taraflı eşitsizlikte yapılan işlem her üç bölüme birden uygulanır. Önce sabit terimi at:","ifade":"28 < 3x < 79"},{"aciklama":"Her bölümü 3 ile böl:","ifade":"28/3 < x < 79/3"},{"aciklama":"Üst sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"26"},{"aciklama":"En büyük tam sayı değer:","ifade":"26"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":1.366,"gorsel":null},{"kimlik":"f4681915ab42","sablon":"kume.sayma.iki_gruptan_secim","govde":"8 kadın ve 5 erkekten oluşan bir ekipten, 2 kadın ve 2 erkek içeren bir komite kurulacaktır. Bu komite kaç farklı biçimde kurulabilir?","secenekler":[{"harf":"A","metin":"1.120","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"B","metin":"280","dogru":true,"yanilgi":null},{"harf":"C","metin":"38","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"D","metin":"715","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"E","metin":"540","dogru":false,"yanilgi":"sayma_tekrarli_secim"}],"cozum":[{"aciklama":"Komitede görev ayrımı yok; kimin önce seçildiği sonucu değiştirmez. Böyle sırasız seçimlere kombinasyon denir ve C(n, r) ile yazılır: n kişiden r kişiyi seçme sayısı.","ifade":null},{"aciklama":"Kadınları seç. 8 kişiden 2 kişi:","ifade":"C(8, 2) = (8×7) / (2×1) = 28"},{"aciklama":"Erkekleri seç. 5 kişiden 2 kişi:","ifade":"C(5, 2) = (5×4) / (2×1) = 10"},{"aciklama":"İki seçim peş peşe yapıldığı için sayılar çarpılır:","ifade":"28 × 10 = 280"},{"aci