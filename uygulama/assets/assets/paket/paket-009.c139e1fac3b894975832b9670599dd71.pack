üzde kaçtır?","secenekler":[{"harf":"A","metin":"%72","dogru":false,"yanilgi":"karisim_agirlik_capraz"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%24","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"D","metin":"%12","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"E","metin":"%18","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Su eklemek tuz miktarını değiştirmez; önce tuzu bul:","ifade":"1.950 × 24/100 = 468 gram"},{"aciklama":"Yeni toplam miktar:","ifade":"1.950 + 650 = 2.600 gram"},{"aciklama":"Yeni oran, tuzun yeni toplama oranıdır:","ifade":"468 / 2.600 × 100 = %18"},{"aciklama":"Yeni tuz oranı:","ifade":"%18"}],"mikrobeceriler":["problem.karisim"],"yanilgi_alanlari":[],"zorluk":4.685,"gorsel":null},{"kimlik":"f9c3e2a228e6","sablon":"veri.grafik.daire_sayi","govde":"Yukarıdaki daire grafiği 1.100 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Basketbol tercih eden kaç kişi vardır?","secenekler":[{"harf":"A","metin":"3.850 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"35 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"C","metin":"715 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"D","metin":"275 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"385 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Daire grafiğindeki dilim bir **yüzde**dir; kişi sayısı değildir. Sayıya çevirmek için toplamla çarpılıp 100'e bölünür.","ifade":null},{"aciklama":"Basketbol diliminin payı:","ifade":"%35"},{"aciklama":"Kişi sayısı:","ifade":"1.100 × 35 / 100 = 385"},{"aciklama":"Kişi sayısı:","ifade":"385 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.203,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"%","seriler":[{"ad":"Pay","degerler":[30,35,25,10]}]}},{"kimlik":"87afef5c4528","sablon":"