,"ifade":"4x − 48 = −26 ⟹ x = 5,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"18,5 + 5,5 = 2 × 48 / 4 = 24"},{"aciklama":"Köklerin toplamı:","ifade":"24"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.826,"gorsel":null},{"kimlik":"17d1733c4b51","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 12 kız öğrencinin matematik notu ortalaması 35, 20 erkek öğrencinin ortalaması ise 75'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"60","dogru":true,"yanilgi":null},{"harf":"B","metin":"50","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"1.920","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"55","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"160","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"12 × 35 + 20 × 75 = 1.920"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"12 + 20 = 32"},{"aciklama":"Sınıf ortalaması:","ifade":"1.920 / 32 = 60"},{"aciklama":"Sınıfın ortalaması:","ifade":"60"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"9e96785fe464","sablon":"cebir.esitsizlik.negatif_katsayi","govde":"−5(x + 10) > −34 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"−17","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−3","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"C","metin":"−5","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"8","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"E","metin":"−4","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−5x − 50 > −34"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−5x > 16"},{"aciklama":"He