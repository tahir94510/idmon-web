,175]}]}},{"kimlik":"2cb7dcd5add5","sablon":"problem.isci.kalan_is","govde":"Bir işi Ayşe tek başına 204 günde, Mehmet tek başına 102 günde bitirmektedir. Ayşe işe başlayıp 24 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Mehmet tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"12 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"153 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"90 gün","dogru":true,"yanilgi":null},{"harf":"D","metin":"102 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"E","metin":"306 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Ayşe günde işin 1/204'ünü yapıyor; 24 günde:","ifade":"24/204"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 24/204 = 15/17"},{"aciklama":"Mehmet işin tamamını 102 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"15/17 × 102 = 90"},{"aciklama":"Kalan iş için gereken süre:","ifade":"90 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.443,"gorsel":null},{"kimlik":"34983e40630d","sablon":"oran.ters.isci_gun","govde":"Bir inşaat işini 14 işçi 20 günde bitirmektedir. Aynı işi, aynı hızda çalışan 7 işçi kaç günde bitirir?","secenekler":[{"harf":"A","metin":"13 gün","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"B","metin":"27 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"C","metin":"40 gün","dogru":true,"yanilgi":null},{"harf":"D","metin":"280 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"10 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"İşçi sayısı ile süre ters orantılıdır; çarpımları toplam iş yükünü verir:","ifade":"14 × 20 = 280 işçi-gün"},{"aciklama":"Aynı iş yükü 7 işçiye bölündüğünde süre:","ifade":"280 / 7 = 40 gün"},{"aciklama":"İşin biteceği süre:","ifade":"40 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.123,"gorsel":null}