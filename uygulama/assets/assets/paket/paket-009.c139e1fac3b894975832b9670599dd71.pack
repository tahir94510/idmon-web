d":"İzmir","degerler":[350,135,220,320]}]}},{"kimlik":"55ac5845c4de","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 396 azalmaktadır. Bu sayının yüzler basamağındaki rakam 7, onlar basamağındaki rakam 6'dır. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"709","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"B","metin":"736","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"763","dogru":true,"yanilgi":null},{"harf":"D","metin":"367","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"73","dogru":false,"yanilgi":"sifir_basamak_atlandi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (7 − b) = 396 ⟹ 7 − b = 4 ⟹ b = 3"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 7 + 10 × 6 + 3 = 763"},{"aciklama":"Aranan sayı:","ifade":"763"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"5ee6322cd376","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin Yaz mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"295 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"194 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"180 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"240 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"720 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Yaz sütunundaki dört değeri oku:","ifade":"Eskişehir: 228 · Antalya: 308 · Bursa: 128 · Konya: 56"},{