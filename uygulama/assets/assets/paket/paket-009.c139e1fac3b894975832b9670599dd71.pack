i.grafik.cizgi_yuzde_artis","govde":"Samsun mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2021 yılından 2024 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%300","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"%100","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"C","metin":"%250","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"D","metin":"%150","dogru":true,"yanilgi":null},{"harf":"E","metin":"%180","dogru":false,"yanilgi":"artis_miktari_yuzde_sanildi"}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"300 − 120 = 180"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"180 / 120 × 100 = %150"},{"aciklama":"Yüzde artış:","ifade":"%150"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"cizgi","baslik":"Samsun mağazasının yıllık cirosu (bin TL)","etiketler":["2020","2021","2022","2023","2024"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[60,120,150,200,300]}]}},{"kimlik":"7511938297c7","sablon":"veri.grafik.daire_aciyla_sayi","govde":"Toplam 700 kişinin katıldığı bir ankette verilen cevapların merkez açıları yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Üzüm seçeneğini işaretleyen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"175 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"35 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"252 kişi","dogru":false,"yanilgi":"aciyi_yuzde_sanma"},{"harf":"D","metin":"630 kişi","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"70 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Grafikte Üzüm diliminin merkez açısını oku:","ifade":"36°"},{"aciklama":"Açıyı orana çevir: dairenin tamamı 360°, dağılımın tamamı 100'dür.","ifade":"36/360 = 0,1"},{"aciklama":"Bul