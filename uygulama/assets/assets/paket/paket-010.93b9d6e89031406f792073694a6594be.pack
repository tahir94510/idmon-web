azanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"6 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"120 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"250 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"110 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"275 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Ankara: 110/6 · Antalya: 275/46 · İzmir: 120/58 · Trabzon: 250/18"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Ankara satırında:","ifade":"110/6"},{"aciklama":"O satırın satış sayısı:","ifade":"110 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.019,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Ankara","degerler":[110,6]},{"ad":"Antalya","degerler":[275,46]},{"ad":"İzmir","degerler":[120,58]},{"ad":"Trabzon","degerler":[250,18]}]}},{"kimlik":"f2f90a69c7c6","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|4x + y − 42| + z = 8\n|4x − 2y − 12| = 4z − 32\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"18","dogru":true,"yanilgi":null},{"harf":"B","metin":"8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"−12","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−24","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"E","metin":"30","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 8 − |…| ≤ 8"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"4z − 32 ≥ 0 , yani z ≥ 8"},{"aciklama":"İkisi birlikte:","ifade":"z = 8"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"4x + y = 42 , 4x − 2y = 12"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 8 , y = 10"},{"aciklama":"İstenen toplam, x + y:","ifade":"18"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"02e92ff6b07c","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İlkbahar mevsiminde Eskişehir'in yaptığı satışın Ankara'nın yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"225","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"0,25","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"4","dogru":true,"yanilgi":null},{"harf":"D","metin":"5","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"0,6","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"İlkbahar sütunundan iki değeri oku:","ifade":"Eskişehir: 300 · Ankara: 75"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"300 / 75 = 4"},{"aciklama":"Aranan oran:","ifade":"4"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.013,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[300,250,275,225]},{"ad":"Ankara","degerler":[75,50,175,200]},{"ad":"Samsun","degerler":[250,50,275,75]},{"ad":"Antalya","degerler":[75,175,100,275]}]}},{"kimlik":"e461a1187a25","sablon":"oran.temel.oran_ve_toplam","govde":"Emre'nin parasının Selin'in parasına oranı 13/12'dir. İkisinin parası toplam 2.000 TL olduğuna göre Emre kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"1.040 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"960 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"80 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"26.000 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"E","metin":"1.000 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Emre 13k, Selin 12k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"13k + 12k = 25k = 2.000"},{"aciklama":"Birim payı bul:","ifade":"k = 2.000 / 25 = 80"},{"aciklama":"Emre için:","ifade":"13 × 80 = 1.040"},{"aciklama":"Emre'nin parası:","ifade":"1.040 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.313,"gorsel":null},{"kimlik":"023f2fd291d7","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 3.300 TL olan bir bisiklet %20 kârla, maliyeti 3.800 TL olan bir çanta ise %10 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"280 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"660 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"1.040 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"10 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"710 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"3.300 × 20/100 = 660 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"3.800 × 10/100 = 380 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"660 − 380 = 280 TL"},{"aciklama":"Net kâr:","ifade":"280 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.585,"gorsel":null},{"kimlik":"4c38f357d48d","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 13 ile bölümünden elde edilen bölüm 29, kalan ise 12'dir. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"185","dogru":false,"yanilgi":"kalan_bolen_karisimi"},{"harf":"B","metin":"389","dogru":true,"yanilgi":null},{"harf":"C","metin":"365","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"D","metin":"533","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"E","metin":"377","dogru":false,"yanilgi":"kalan_sifir_sayildi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"13 × 29 + 12 = 377 + 12 = 389"},{"aciklama":"Kalan (12) bölenden (13) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"389"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.972,"gorsel":null},{"kimlik":"0bdd74ac38ba","sablon":"mantik.esleme.kesin_dogru","govde":"Deniz, Ece, Emre, Selin ve Serkan adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Deniz, Selin adlı kişinin hemen solundadır.\n• Serkan uçtaki koltuklarda oturmamaktadır.\n• Emre ile Serkan yan yana oturmamaktadır.\n• Ece, Serkan adlı kişinin solunda oturmaktadır.\n• Emre, Deniz adlı kişinin solunda oturmaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Deniz, Selin adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"B","metin":"Ece, Emre adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Ece, Serkan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Serkan, Selin adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"E","metin":"Ece, Selin adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Emre − Ece − Serkan − Deniz − Selin"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Ece, Emre adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"59a287053e64","sablon":"problem.karisim.tuz_orani","govde":"45 gram su ile 135 gram tuzdan oluşan bir karışıma 45 gram tuz daha ekleniyor. Yeni karışımın yüzde kaçı tuzdur?","secenekler":[{"harf":"A","metin":"%95","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"B","metin":"%75","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%100","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"D","metin":"%20","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"%80","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Tuz eklendiğinde hem tuz miktarı hem toplam miktar büyür; ikisini de ayrı ayrı yaz.","ifade":null},{"aciklama":"Karışımın eski toplamı (su + tuz):","ifade":"45 + 135 = 180 gram"},{"aciklama":"Yeni tuz miktarı (eski tuz + eklenen):","ifade":"135 + 45 = 180 gram"},{"aciklama":"Yeni toplam (eski toplam + eklenen):","ifade":"180 + 45 = 225 gram"},{"aciklama":"Oran, yeni tuzun yeni toplama bölümüdür:","ifade":"180/225 × 100 = 80"},{"aciklama":"Yeni karışımdaki tuz oranı:","ifade":"%80"}],"mikrobeceriler":["problem.karisim"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":1.412,"gorsel":null},{"kimlik":"463d2d5f898b","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Eskişehir'in yıllık toplam satışı, Bursa'nın yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"1.065 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"1.950 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"425 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"180 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"300 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"}],"cozum":[{"aciklama":"Eskişehir satırını topla:","ifade":"350 + 235 + 360 + 120 = 1.065"},{"aciklama":"Bursa satırını topla:","ifade":"120 + 120 + 290 + 355 = 885"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"1.065 − 885 = 180"},{"aciklama":"Aradaki fark:","ifade":"180 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.807,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[365,35,255,215]},{"ad":"Bursa","degerler":[120,120,290,355]},{"ad":"Eskişehir","degerler":[350,235,360,120]},{"ad":"Konya","degerler":[370,275,185,115]}]}},{"kimlik":"1ecc16b4803f","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan armut, soğan ve muzun kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 300 kilogram satılmış ve toplam 324 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram soğan ve muz satılmıştır?","secenekler":[{"harf":"A","metin":"200","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"240","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"220","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"60","dogru":true,"yanilgi":null},{"harf":"E","metin":"180","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Armut: 4,7 − 3,5 = 1,2 TL, Soğan: 2,1 − 1,5 = 0,6 TL, Muz: 5,1 − 4,5 = 0,6 TL.","ifade":null},{"aciklama":"Soğan ile muzun kilogram kârı aynı. Hepsi 0,6 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"300 · 0,6 = 180 TL"},{"aciklama":"Fazladan 144 TL yalnızca armut yüzünden: onun her kilogramı 0,6 TL fazla kazandırıyor.","ifade":"armut = 144 ÷ 0,6 = 240 kg"},{"aciklama":"İstenen: 300 − 240 =","ifade":"60"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Armut","degerler":[3.5,4.7]},{"ad":"Soğan","degerler":[1.5,2.1]},{"ad":"Muz","degerler":[4.5,5.1]}]}},{"kimlik":"0f97ab5e6a56","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"167 ile 1.070 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 63'e tam bölünür?","secenekler":[{"harf":"A","metin":"14","dogru":true,"yanilgi":null},{"harf":"B","metin":"100","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"C","metin":"46/3","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"129","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"E","metin":"43","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"}],"cozum":[{"aciklama":"63'e bölünen sayılar 63'ün katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"189 ve 1.008"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(1.008 − 189) / 63 + 1 = 14"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"14"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":-0.284,"gorsel":null},{"kimlik":"a8812d0793a3","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 6 : 5 : 10 oranındadır. İkinci arkadaşın parası 240 TL olduğuna göre üçüncü arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"336 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"10 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"480 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"48 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"120 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"6k : 5k : 10k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"5k = 240 → k = 48"},{"aciklama":"Sorulan payı k ile çarp (üçüncü arkadaş):","ifade":"10 × 48 = 480"},{"aciklama":"Üçüncü arkadaşın parası:","ifade":"480 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.313,"gorsel":null},{"kimlik":"0e5d25107338","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 3.340 TL olan bir klavye 5.344 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%60","dogru":true,"yanilgi":null},{"harf":"B","metin":"%37,5","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%2.004","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%160","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"%62,5","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"5.344 TL − 3.340 TL = 2.004 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"2.004 / 3.340 × 100 = 60"},{"aciklama":"Kâr oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"1f7ec9c54137","sablon":"cebir.denklem.sistem","govde":"4x + 4y = −40 ve 3x + 5y = −52 olduğuna göre 7x + 2y kaçtır?","secenekler":[{"harf":"A","metin":"−75","dogru":false,"yanilgi":"katsayi_yer_degistirme"},{"harf":"B","metin":"−10","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"−4","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"D","metin":"29","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−15","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki denklemi yok etme yöntemiyle çöz:","ifade":"x = 1 , y = −11"},{"aciklama":"Sorulan ifade x ve y'nin kendisi değil, katsayılı birleşimidir:","ifade":"7 × 1 + 2 × (−11)"