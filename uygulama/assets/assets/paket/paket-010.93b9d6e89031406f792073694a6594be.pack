","metin":"%2.472","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%37,5","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%62,5","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"%160","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"%60","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"6.592 TL − 4.120 TL = 2.472 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"2.472 / 4.120 × 100 = 60"},{"aciklama":"Kâr oranı:","ifade":"%60"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"fd888f03373d","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"317 ile 1.418 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 28'e tam bölünür?","secenekler":[{"harf":"A","metin":"275","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"79","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"C","metin":"157","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"D","metin":"1.129/28","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"39","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"28'e bölünen sayılar 28'in katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"336 ve 1.400"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(1.400 − 336) / 28 + 1 = 39"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"39"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":0.208,"gorsel":null},{"kimlik":"46345bf3545f","sablon":"veri.tablo.sutun_yuzde_degisim","govde":"Bir kulübün dört şehirdeki şubelerinin 2024 ve 2025 yıllarındaki üye sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Eskişehir'de üye sayısı 2024'ten 2025'e yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%85","dogru":