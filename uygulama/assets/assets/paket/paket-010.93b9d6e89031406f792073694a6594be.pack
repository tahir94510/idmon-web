di"},{"harf":"D","metin":"1.120 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.012 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"1.000 × 12/100 = 120 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"1.000 + 120 = 1.120 TL"},{"aciklama":"Zamlı fiyat:","ifade":"1.120 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.385,"gorsel":null},{"kimlik":"8240d56285ee","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 13 kişinin yaş ortalaması 54. Gruba bir kişi daha katılınca ortalama 58'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"812","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"106","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"58","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"110","dogru":true,"yanilgi":null},{"harf":"E","metin":"52","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"13 × 54 = 702"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"14 × 58 = 812"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"812 − 702 = 110"},{"aciklama":"Katılan kişinin yaşı:","ifade":"110"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.635,"gorsel":null},{"kimlik":"9ae9fe7fd842","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 3 tek doğal sayının toplamı 69'dur.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"25","dogru":true,"yanilgi":null},{"harf":"B","metin":"27","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"C","metin":"23","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"24","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"E","metin":"21","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"}],"cozum":[{"aciklama":"Ard