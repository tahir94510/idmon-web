ade":"11 ⊕ 12 = 6·11 + 4·12 = 114"},{"aciklama":"Bulunan sonucu dıştaki işlemde yerine yaz:","ifade":"9 ⊕ 114 = 6·9 + 4·114 = 510"},{"aciklama":"İç içe işlemin sonucu:","ifade":"510"}],"mikrobeceriler":["mantik.ozel_islem"],"yanilgi_alanlari":["mantik.dizi"],"zorluk":0.906,"gorsel":null},{"kimlik":"9e92c54f64e7","sablon":"problem.sayi.ardisik_tek_cift","govde":"Ardışık 5 tek sayının toplamı 525'tir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"210","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"101","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"109","dogru":true,"yanilgi":null},{"harf":"D","metin":"105","dogru":false,"yanilgi":"ardisik_ortalama_terim_sayisi"},{"harf":"E","metin":"107","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"5 ardışık tek sayı, ortadaki etrafında simetriktir; toplam, terim sayısı çarpı ortadaki sayıdır.","ifade":null},{"aciklama":"Sayıları yaz:","ifade":"101 + 103 + 105 + 107 + 109 = 525"},{"aciklama":"En büyüğü seç:","ifade":"109"},{"aciklama":"En büyük sayı:","ifade":"109"}],"mikrobeceriler":["problem.sayi"],"yanilgi_alanlari":["sayilar.ardisik","veri.ortalama"],"zorluk":0.687,"gorsel":null},{"kimlik":"66d0083c5d50","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Antalya'nın yıllık toplam satışı, Ankara'nın yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"1.075 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"520 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"140 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"35 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"240 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Antalya satırını topla:","ifade":"255 + 45 + 395 + 380 = 1.075"},{"aciklama":"Ankara satırını topla:","ifade":"175 + 265 + 165 + 330 = 935"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"1.075 − 935 = 140"},{"aciklama":"Aradaki fark:","ifade":"140 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.885,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[255,45,395,380]},{"ad":"Konya","degerler":[70,95,395,110]},{"ad":"Eskişehir","degerler":[270,245,305,190]},{"ad":"Ankara","degerler":[175,265,165,330]}]}},{"kimlik":"4b9e2980340d","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 396 azalmaktadır. Bu sayının yüzler basamağındaki rakam 8, onlar basamağındaki rakam 6'dır. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"864","dogru":true,"yanilgi":null},{"harf":"B","metin":"468","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"C","metin":"810","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"D","metin":"846","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"E","metin":"84","dogru":false,"yanilgi":"sifir_basamak_atlandi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (8 − b) = 396 ⟹ 8 − b = 4 ⟹ b = 4"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 8 + 10 × 6 + 4 = 864"},{"aciklama":"Aranan sayı:","ifade":"864"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"da1a29625180","sablon":"oran.temel.oran_ve_toplam","govde":"Ali'nin parasının Merve'nin parasına oranı 5/4'tür. İkisinin parası toplam 4.320 TL olduğuna göre Ali kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"2.400 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.920 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"2.160 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"480 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"21.600 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Ali 5k, Merve 4k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"5k + 4k = 9k = 4.320"},{"aciklama":"Birim payı bul:","ifade":"k = 4.320 / 9 = 480"},{"aciklama":"Ali için:","ifade":"5 × 480 = 2.400"},{"aciklama":"Ali'nin parası:","ifade":"2.400 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":1.672,"gorsel":null},{"kimlik":"5ecd39c5eb81","sablon":"yuzde.faiz.getiri_farki","govde":"14.000 TL, yıllık %36 faizle 4 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %15 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"21 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"980 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"1.680 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"2.940 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"E","metin":"735 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"36 − 15 = 21 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"21/100 × 4/12"},{"aciklama":"Anaparayla çarp:","ifade":"14.000 × 21/100 × 4/12 = 980 TL"},{"aciklama":"Getiri farkı:","ifade":"980 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.107,"gorsel":null},{"kimlik":"9cd31587a8b6","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan patates, üzüm ve elmanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 270 kilogram satılmış ve toplam 194 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram patates ve üzüm satılmıştır?","secenekler":[{"harf":"A","metin":"80","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"250","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"238","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},{"harf":"D","metin":"180","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"190","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Patates: 2,6 − 2 = 0,6 TL, Üzüm: 4,6 − 4 = 0,6 TL, Elma: 6 − 5 = 1 TL.","ifade":null},{"aciklama":"Patates ile üzümün kilogram kârı aynı. Hepsi 0,6 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"270 · 0,6 = 162 TL"},{"aciklama":"Fazladan 32 TL yalnızca elma yüzünden: onun her kilogramı 0,4 TL fazla kazandırıyor.","ifade":"elma = 32 ÷ 0,4 = 80 kg"},{"aciklama":"İstenen: 270 − 80 =","ifade":"190"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Patates","degerler":[2.0,2.6]},{"ad":"Üzüm","degerler":[4.0,4.6]},{"ad":"Elma","degerler":[5.0,6.0]}]}},{"kimlik":"31ce7a0868ff","sablon":"mantik.ozel_islem.iki_terimli","govde":"Her x ve y gerçek sayısı için x ⊕ y = 6x − 7y + x·y biçiminde tanımlanıyor. Buna göre 6 ⊕ 10 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"−4","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"B","metin":"−34","dogru":false,"yanilgi":"ozel_islem_terim_atlandi"},{"harf":"C","metin":"26","dogru":true,"yanilgi":null},{"harf":"D","metin":"78","dogru":false,"yanilgi":"ozel_islem_sira"},{"harf":"E","metin":"166","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Tanımda x yerine soldaki, y yerine sağdaki sayıyı yaz. Sıra önemli: yer değiştirirsen sonuç değişebilir.","ifade":null},{"aciklama":"6 ⊕ 10 =","ifade":"6·6 − 7·10 + 6·10"},{"aciklama":"İşlemleri sırayla yap:","ifade":"36 − 70 + 60 = 26"},{"aciklama":"İşlemin sonucu:","ifade":"26"}],"mikrobeceriler":["mantik.ozel_islem"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.201,"gorsel":null},{"kimlik":"b13c473daf53","sablon":"problem.sayi.kesir_kalan","govde":"Selin, parasının 1/5'ini kiraya, kalan parasının 3/5'ini faturalara harcadığında geriye 48 TL kalmaktadır.\n\nBuna göre Selin'in başlangıçtaki parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"120","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"102","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"400","dogru":false,"yanilgi":"harcanan_kesir_kalan_sanildi"},{"harf":"D","metin":"240","dogru":false,"yanilgi":"kalanin_kesri_butunden"},{"harf":"E","metin":"150","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce paranın 1/5'i harcanınca 4/5'i kalır.","ifade":null},{"aciklama":"Sonra **kalanın** 3/5'i harcanınca kalanın 2/5'i kalır. İki kalan kesri çarpılır:","ifade":"4/5 · 2/5 = 8/25"},{"aciklama":"Paranın 8/25'i 48 TL ediyor:","ifade":"X · 8/25 = 48"},{"aciklama":"Baştaki para:","ifade":"150"}],"mikrobeceriler":["problem.sayi","sayilar.rasyonel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"3a58cb9d12b8","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 19 ile bölümünden elde edilen bölüm 10, kalan ise 2'dir. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"48","dogru":false,"yanilgi":"kalan_bolen_karisimi"},{"harf":"B","metin":"188","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"C","metin":"192","dogru":true,"yanilgi":null},{"harf":"D","metin":"190","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"E","metin":"228","dogru":false,"yanilgi":"kalan_bolume_eklendi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"19 × 10 + 2 = 190 + 2 = 192"},{"aciklama":"Kalan (2) bölenden (19) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"192"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.536,"gorsel":null},{"kimlik":"73e25444f281","sablon":"veri.tablo.satir_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon'un dört mevsimdeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"167 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"996 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"301 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"249 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"332 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Trabzon satırındaki dört değeri topla:","ifade":"360 + 356 + 72 + 208 = 996"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür; burada dört mevsim var:","ifade":"996 / 4 = 249"},{"aciklama":"Satır ortalaması:","ifade":"249 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-1.103,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Ankara","degerler":[270,65,150,135]},{"ad":"İzmir","degerler":[345,95,240,230]},{"ad":"Antalya","degerler":[140,65,345,95]},{"ad":"Trabzon","degerler":[360,356,72,208]}]}},{"kimlik":"b22f0d216a05","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 5 : 10 : 12 oranındadır. Birinci arkadaşın parası 80 TL olduğuna göre ikinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"160 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"144 TL","dogru":fals