izi_kurali_eksik"},{"harf":"D","metin":"300","dogru":true,"yanilgi":null},{"harf":"E","metin":"56","dogru":false,"yanilgi":"ozel_islem_terim_atlandi"}],"cozum":[{"aciklama":"Parantez içi **önce** hesaplanır:","ifade":"5 ⊕ 9 = 6·5 + 4·9 = 66"},{"aciklama":"Bulunan sonucu dıştaki işlemde yerine yaz:","ifade":"6 ⊕ 66 = 6·6 + 4·66 = 300"},{"aciklama":"İç içe işlemin sonucu:","ifade":"300"}],"mikrobeceriler":["mantik.ozel_islem"],"yanilgi_alanlari":["mantik.dizi"],"zorluk":0.906,"gorsel":null},{"kimlik":"0c3783c3b7e3","sablon":"problem.yas.kat_iliskisi","govde":"Yusuf'un yaşı bugün Buse'nin yaşının 3 katıdır. 21 yıl önce Yusuf'un yaşı Buse'nin yaşının 10 katı idi. Buna göre Yusuf bugün kaç yaşındadır?","secenekler":[{"harf":"A","metin":"54","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"90","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"C","metin":"60","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"D","metin":"27","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"81","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Buse'nin bugünkü yaşına x dersek, Yusuf'un yaşı 3x olur.","ifade":null},{"aciklama":"21 yıl önce ikisi de 21 yaş küçüktü; fark değişmez:","ifade":"3x − 21 = 10·(x − 21)"},{"aciklama":"Denklemi çöz:","ifade":"3x − 21 = 10x − 210  ⟹  7x = 189  ⟹  x = 27"},{"aciklama":"Yusuf'un bugünkü yaşı bunun 3 katıdır:","ifade":"3 × 27 = 81"},{"aciklama":"Yusuf bugün:","ifade":"81"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.325,"gorsel":null},{"kimlik":"e3ca5cb75d0c","sablon":"oran.ters.uc_makine","govde":"Bir iş 4 işçiyle 180 günde, 2 işçiyle 360 günde bitmektedir. Aynı iş 5 işçiyle kaç günde biter?","secenekler":[{"harf":"A","metin":"225 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"144 gün","dogru":true,"yanilgi":null},{"harf":"C","metin":"270 gün","dogru":false,"yanilgi":"bilesik_oranti_gun_ortalamasi"},{"harf":"D",