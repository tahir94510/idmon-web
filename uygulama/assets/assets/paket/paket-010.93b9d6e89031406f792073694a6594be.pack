lse,"yanilgi":null},{"harf":"C","metin":"8","dogru":false,"yanilgi":null},{"harf":"D","metin":"4","dogru":true,"yanilgi":null},{"harf":"E","metin":"13","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Soldaki çarpımdan bir sayı çıkınca, sağdaki iki sayının toplamı kalmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"2 × 13 − 7 = 8 + 11"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"4"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.464,"gorsel":null,"cevap_uzayi":true},{"kimlik":"276cab219a6e","sablon":"sayilar.uslu.us_kurallari","govde":"(5⁴)³ · (5⁵)⁵ : 5⁴ işleminin sonucu, 5 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"33","dogru":true,"yanilgi":null},{"harf":"B","metin":"−37","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"C","metin":"296","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"41","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"13","dogru":false,"yanilgi":"us_us_toplandi"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(5⁴)³ = 5¹² , (5⁵)⁵ = 5²⁵"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"5¹² · 5²⁵ = 5³⁷"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"5³⁷ : 5⁴ = 5³³"},{"aciklama":"Aranan kuvvet:","ifade":"33"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":3.114,"gorsel":null},{"kimlik":"68712d7931a0","sablon":"problem.karisim.su_ekleme","govde":"2.000 gram %8 tuzlu su çözeltisine 500 gram saf su eklenmiştir. Yeni çözeltinin tuz oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%32","dogru":false,"yanilgi":"karisim_agirlik_capraz"},{"harf":"B","metin":"%4","dogru":false,"yanilgi":"karisim_derisim_