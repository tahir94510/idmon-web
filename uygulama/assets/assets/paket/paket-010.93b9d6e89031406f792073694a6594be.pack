,"etiketler":["2018","2019","2020","2021","2022"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[240,200,240,300,500]}]}},{"kimlik":"98c7d251851c","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 47 ve a · b = 68 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"2.141","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"B","metin":"2.345","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"C","metin":"2.073","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.209","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"1.937","dogru":false,"yanilgi":"iki_kare_farki_toplam"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"47² − 2 × 68 = 2.209 − 136 = 2.073"},{"aciklama":"a² + b² değeri:","ifade":"2.073"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.383,"gorsel":null},{"kimlik":"1d80def65cd8","sablon":"kume.sayma.iki_gruptan_secim","govde":"5 kadın ve 6 erkekten oluşan bir ekipten, 1 kadın ve 2 erkek içeren bir komite kurulacaktır. Bu komite kaç farklı biçimde kurulabilir?","secenekler":[{"harf":"A","metin":"150","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"B","metin":"75","dogru":true,"yanilgi":null},{"harf":"C","metin":"165","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"D","metin":"20","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"E","metin":"105","dogru":false,"yanilgi":"sayma_tekrarli_secim"}],"cozum":[{"aciklama":"Komitede görev ayrımı yok; kimin önce seçildiği sonucu değiştirmez. Böyle sırasız seçimlere kombinasyon denir ve C(n, r) ile yazılır: n kişiden r kişiyi seçme sayısı.","ifade":null},{"aciklama":"Kadınları seç. 5 kişiden 1 kişi:","ifade":"C(5, 1) = (5) / (1) = 5"},{"aciklama":"Erkekleri seç. 6 kişiden 2 kişi:","ifade":"C(6, 2) = (6×5) / (2×1) = 15"},{"aciklama":