de":null},{"aciklama":"Yanlış olan ifade:","ifade":"Burak, Mehmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"ee6c21f61f06","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 9 kişinin yaş ortalaması 43. Gruptan bir kişi ayrılınca ortalama 45 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"18","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"747","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"27","dogru":true,"yanilgi":null},{"harf":"D","metin":"2","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"360","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 9 × 43","ifade":"387"},{"aciklama":"Ayrıldıktan sonra grup 8 kişi: 8 × 45","ifade":"360"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"387 − 360 = 27"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"27"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.208,"gorsel":null},{"kimlik":"c2fc04f907b5","sablon":"problem.karisim.birlestirme","govde":"Tuz oranı %4 olan 25 litre çözelti ile tuz oranı %40 olan 75 litre çözelti karıştırılıyor. Elde edilen karışımın tuz oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%22","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"%13","dogru":false,"yanilgi":"karisim_agirlik_capraz"},{"harf":"C","metin":"%31","dogru":true,"yanilgi":null},{"harf":"D","metin":"%44","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"E","metin":"%124","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"}],"cozum":[{"aciklama":"Önce her çözeltideki saf tuz miktarını bul:","ifade":"25·4/100 + 75·40/100 = 31 litre"},{"aciklama":"Karışımın toplam miktarı:","ifade":"25 + 75 = 100 litre"},{"aciklama":"Yeni oran, saf tuzun yeni toplam miktara bölümüdür:","ifade":"31 / 100 = %31"},{"aciklama":"Karışımın tuz oranı:","ifade":"%31"}],"mikrobeceriler":["problem.karisim","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":2.31,"gorsel":null},{"kimlik":"14147eb8f9ca","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 24 litre yakıt tüketmektedir.\n\nBu araç Trabzon'a yapılan 600 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"6 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"1.440 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"144 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"24 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"25 litre","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"24/100 = x/600"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 600 × 24/100 = 144"},{"aciklama":"Tüketilen yakıt:","ifade":"144 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":0.172,"gorsel":null},{"kimlik":"0df949306875","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 240 TL olan bir tablet %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%37,5","dogru":true,"yanilgi":null},{"harf":"D","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifa