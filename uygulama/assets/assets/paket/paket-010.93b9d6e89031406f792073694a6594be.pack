gi":"yuzde_yon_ters"},{"harf":"E","metin":"800 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr her zaman maliyet üzerinden hesaplanır; satış fiyatı maliyetin %175'idir:","ifade":"maliyet × 175/100 = 1.400"},{"aciklama":"Maliyet, satış fiyatının bu orana bölümüdür:","ifade":"1.400 × 100/175 = 800 TL"},{"aciklama":"Maliyet:","ifade":"800 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.672,"gorsel":null},{"kimlik":"7d8ccb488b75","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 18, s(B) = 20 ve s(A ∪ B) = 32'dir. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"18","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"B","metin":"14","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"C","metin":"12","dogru":true,"yanilgi":null},{"harf":"D","metin":"26","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"6","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 18 + 20 − 32 = 6"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"18 − 6 = 12"},{"aciklama":"s(A ∖ B):","ifade":"12"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":0.724,"gorsel":null},{"kimlik":"55cd9bdf381c","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin Kış mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"132 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"205 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"141 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"123 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"176 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Kış sütunundaki dört değeri oku:","ifade":"Konya: 136 · Bursa: 336 · İzmir: 20 · Samsun: 36"},{"aciklama":"Dördünü topla:","ifade":"136 + 336 + 20 + 36 = 528"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölünmesidir; burada dört şehir var:","ifade":"528 / 4 = 132"},{"aciklama":"Ortalama satış:","ifade":"132 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-1.142,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[220,360,320,136]},{"ad":"Bursa","degerler":[235,230,360,336]},{"ad":"İzmir","degerler":[45,300,175,20]},{"ad":"Samsun","degerler":[320,210,280,36]}]}},{"kimlik":"5cebd622e1f4","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 10'a bölümünden kalan 9, 15'e bölümünden kalan 14'tür. Bu koşulu sağlayan ve 461'den büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"599","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"B","metin":"469","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"C","metin":"464","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"D","metin":"479","dogru":true,"yanilgi":null},{"harf":"E","metin":"481","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 1 eksik. Demek ki sayıya 1 eklenirse sayı hem 10 hem 15 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(10, 15) = 30"},{"aciklama":"Sayı 30'un katından 1 eksiktir. 461'den büyük ilk böyle sayı:","ifade":"479"},{"aciklama":"Aranan sayı:","ifade":"479"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.149,"gorsel":null},{"kimlik":"bcbe344dedd2","sablon":"mantik.esleme.yerlestirme","govde":"2, 3, 5, 8, 13 ve 15 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ + □ + □ = □ × □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"8","dogru":false,"yanilgi":null},{"harf":"B","metin":"3","dogru":false,"yanilgi":null},{"harf":"C","metin":"5","dogru":true,"yanilgi":null},{"harf":"D","metin":"15","dogru":false,"yanilgi":null},{"harf":"E","metin":"13","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Sağdaki iki sayının çarpımı, soldaki üç sayının toplamına eşit olmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"3 + 8 + 15 = 2 × 13"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"5"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null,"cevap_uzayi":true},{"kimlik":"bc619ef887c2","sablon":"veri.tablo.sutun_yuzde_degisim","govde":"Bir kulübün dört şehirdeki şubelerinin 2024 ve 2025 yıllarındaki üye sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon'da üye sayısı 2024'ten 2025'e yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%40","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"%10","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"%25","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Trabzon satırındaki iki değeri oku:","ifade":"2024: 160 · 2025: 200"},{"aciklama":"Artış miktarını bul:","ifade":"200 − 160 = 40"},{"aciklama":"Artış oranı **eski** değere bölünür, yeniye değil:","ifade":"40/160 × 100"},{"aciklama":"Artış oranı:","ifade":"%25"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.254,"gorsel":{"tur":"tablo","baslik":"Yıllara göre üye sayısı (kişi)","etiketler":["2024","2025"],"birim":"kişi","seriler":[{"ad":"Trabzon","degerler":[160,200]},{"ad":"İzmir","degerler":[100,110]},{"ad":"Ankara","degerler":[100,150]},{"ad":"Samsun","degerler":[60,220]}]}},{"kimlik":"9a3d8f147fa8","sablon":"problem.sayi.kesir_kalan","govde":"Yusuf, parasının 1/3'ünü ayakkabıya, kalan parasının 3/5'ini çantaya harcadığında geriye 128 TL kalmaktadır.\n\nBuna göre Yusuf'un başlangıçtaki parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"352","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"320","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"640","dogru":false,"yanilgi":"harcanan_kesir_kalan_sanildi"},{"harf":"D","metin":"480","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.920","dogru":false,"yanilgi":"kalanin_kesri_butunden"}],"cozum":[{"aciklama":"Önce paranın 1/3'ü harcanınca 2/3'ü kalır.","ifade":null},{"aciklama":"Sonra **kalanın** 3/5'i harcanınca kalanın 2/5'i kalır. İki kalan kesri çarpılır:","ifade":"2/3 · 2/5 = 4/15"},{"aciklama":"Paranın 4/15'i 128 TL ediyor:","ifade":"X · 4/15 = 128"},{"aciklama":"Baştaki para:","ifade":"480"}],"mikrobeceriler":["problem.sayi","sayilar.rasyonel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"892de6586c82","sablon":"oran.ters.hiz_sure","govde":"Bir araç Antalya ile Bursa arasını saatte 60 km hızla 13 saatte almaktadır. Aynı yolu saatte 30 km hızla giden bir araç kaç saatte alır?","secenekler":[{"harf":"A","metin":"10 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"B","metin":"13 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"C","metin":"26 saat","dogru":true,"yanilgi":null},{"harf":"D","metin":"6,5 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"16 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"Sabit yolda hız ile süre ters orantılıdır; yol çarpımlarıdır:","ifade":"60 × 13 = 780 km"},{"aciklama":"Yeni süre, aynı yolun yeni hıza bölümüdür:","ifade":"780 / 30 = 26 saat"},{"aciklama":"Geçen süre:","ifade":"26 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.036,"gorsel":null},{"kimlik":"307a936af885","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, tanesini 1.400 TL maliyetle aldığı bir buzdolabı çeşidini %40 kârla satmaktadır. Buna göre buzdolabının satış fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"57.400 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"B","metin":"560 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"840 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"1.440 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"1.960 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr yüzdesi her zaman maliyet üzerinden hesaplanır:","ifade":"1.400 × 40/100 = 560 TL"},{"aciklama":"Satış fiyatı maliyet ile kârın toplamıdır:","ifade":"1.400 + 560 = 1.960 TL"},{"aciklama":"Satış fiyatı:","ifade":"1.960 TL"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-0.807,"gorsel":null},{"kimlik":"0f3930f8f871","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Bursa şubesindeki personel sayısı, toplam 1.500 personelin yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%90","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"%20","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"%10","dogru":true,"yanilgi":null},{"harf":"E","metin":"%50","dogru":false,"y