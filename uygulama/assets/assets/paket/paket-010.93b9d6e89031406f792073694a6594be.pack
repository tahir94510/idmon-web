,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"180 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"155 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"230 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"160 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Soru tek bir seriyi değil, iki serinin toplamını istiyor; her ay için iki sütunu topla:","ifade":"Ocak: 180 , Şubat: 230 , Mart: 110 , Nisan: 120"},{"aciklama":"Toplamların en büyüğü:","ifade":"Şubat için 230"},{"aciklama":"En yüksek toplam satış:","ifade":"230 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["veri.tablo"],"zorluk":0.617,"gorsel":{"tur":"sutun","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[155,155,35,100]},{"ad":"Dergi","degerler":[25,75,75,20]}]}},{"kimlik":"33826a221a15","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/2.500.000 olan bir haritada Ankara ile Konya arasındaki uzaklık 7 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"1.750 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"B","metin":"175 km","dogru":true,"yanilgi":null},{"harf":"C","metin":"32 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"D","metin":"17,5 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"7 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"7 × 2.500.000 = 17.500.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"17.500.000 / 100.000 = 175 km"},{"aciklama":"Kısayol: ölçek 1/2.500.000 olduğunda haritadaki 1 cm, 25 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"175 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":1.991,"gorsel":null},{"kimlik":"b843959d2c0d","sablon":"yuzde.artis.azalma_orani","govde":"Bir atölyenin aylık üretimi 300 adetten 60 adede düşmüştür. Üretimdeki azalma yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%80","dogru":true,"yanilgi":null},{"harf":"B","metin":"%60","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%400","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%240","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%20","dogru":false,"yanilgi":"tumleyeni_verme"}],"cozum":[{"aciklama":"Azalma yüzdesi, azalma miktarının **eski** değere oranıdır.","ifade":null},{"aciklama":"Azalma miktarı:","ifade":"300 − 60 = 240"},{"aciklama":"Bunu eski değere oranla ve 100 ile çarp:","ifade":"240 / 300 × 100 = 80"},{"aciklama":"Azalma oranı:","ifade":"%80"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":-0.086,"gorsel":null},{"kimlik":"a27d26938e0f","sablon":"kume.olasilik.iki_torba","govde":"Birinci torbada 4 sarı, 3 siyah top; ikinci torbada 2 sarı, 5 siyah top vardır. Her torbadan rastgele birer top çekildiğine göre, çekilen iki topun da sarı olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"3/7","dogru":false,"yanilgi":"olasilik_ornek_uzay"},{"harf":"B","metin":"6/7","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"C","metin":"49/8","dogru":false,"yanilgi":"olasilik_istenen_tum_ters"},{"harf":"D","metin":"34/49","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"E","metin":"8/49","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Birinci torbadan sarı çekme olasılığı:","ifade":"4/7"},{"aciklama":"İkinci torbadan sarı çekme olasılığı:","ifade":"2/7"},{"aciklama":"Torbalar birbirinden bağımsız olduğu için olasılıklar çarpılır:","ifade":"4/7 × 2/7 = 8/49"},{"aciklama":"İstenen olasılık:","ifade":"8/49"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":["kume.sayma"],"zorluk":1.398,"gorsel":null},{"kimlik":"854e9a3e0703","sablon":"veri.grafik.sutun_yuzde_pay","govde":"Bir işletmenin dört bölgede sattığı Çay sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Kuzey bölgesinde satılan Çay sayısı, dört bölgede satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%400","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"%80","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"%20","dogru":true,"yanilgi":null},{"harf":"E","metin":"%40","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"400 + 1.000 + 500 + 100 = 2.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"400 / 2.000 × 100 = %20"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%20"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":{"tur":"sutun","baslik":"Çay satışları (adet)","etiketler":["Kuzey","Güney","Doğu","Batı"],"birim":"adet","seriler":[{"ad":"Çay","degerler":[400,1000,500,100]}]}},{"kimlik":"da266213554e","sablon":"mantik.esleme.kesin_dogru","govde":"Ali, Ayşe, Emre, Merve ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ayşe, Merve adlı kişinin solunda oturmaktadır.\n• Ayşe ile Merve yan yana oturmamaktadır.\n• Emre uçtaki koltuklarda oturmamaktadır.\n• Yusuf, Ayşe adlı kişinin hemen solundadır.\n• Ali, Yusuf adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Yusuf, Ayşe adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"B","metin":"Merve, Ayşe adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"C","metin":"Yusuf, Ali adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"D","metin":"Emre, Merve adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"E","metin":"Ali, Emre adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ali − Yusuf − Ayşe − Emre − Merve"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Yusuf, Ali adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"b33be364d50f","sablon":"problem.isci.kalan_is","govde":"Bir işi Ahmet tek başına 204 günde, Kaan tek başına 68 günde bitirmektedir. Ahmet işe başlayıp 174 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Kaan tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"136 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"68 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"58 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"10 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"272 gün","dogru":false,"yanilgi":"isci_sure_toplama"}],"cozum":[{"aciklama":"Ahmet günde işin 1/204'ünü yapıyor; 174 günde:","ifade":"174/204"},{"aciklama":"Geriye kalan iş:","ifade":"1 − 174/204 = 5/34"},{"aciklama":"Kaan işin tamamını 68 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"5/34 × 68 = 10"},{"aciklama":"Kalan iş için gereken süre:","ifade":"10 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"a6a5277e07b2","sablon":"sayilar.rasyonel.toplama","govde":"9/11 + 1/3 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"20/11","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"B","metin":"5/7","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"C","metin":"10/11","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"D","metin":"16/33","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"38/33","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(11, 3) = 33"},{"aciklama":"Her kesri, paydası 33 olacak biçimde genişlet:","ifade":"9/11 = 27/33  (payı da paydayı da 3 ile çarptık)\n1/3 = 11/33  (payı da paydayı da 11 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"27/33 + 11/33 = 38/33"},{"aciklama":"İşlemin sonucu:","ifade":"38/33"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.297,"gorsel":null},{"kimlik":"d6e2ccbd8dcf","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 11 kız öğrencinin matematik notu ortalaması 95, 44 erkek öğrencinin ortalaması ise 35'tir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"235","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"65","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"47","dogru":true,"yanilgi":null},{"harf":"D","metin":"83","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"2.585","dogru":false,"yanilgi":"ortalama_yerine_toplam"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"11 × 95 + 44 × 35 = 2.585"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"11 + 44 = 55"},{"aciklama":"Sınıf ortalaması:","ifade":"2.585 / 55 = 47"},{"aciklama":"Sınıfın ortalaması:","ifade":"47"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"d54103ff7370","sablon":"oran.dogru.tarif_olcekleme","govde":"5 kişilik bir tarifte 440 gram un kullanılmaktadır. Aynı tarif 30 kişi için hazırlanacağına göre kaç gram un gerekir?","secenekler":[{"harf":"A","metin":"465 gram","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"B","metin":"2.640 gram","dogru":true,"yanilgi":null},{"harf":"C","metin":"2.200 gram","dogru":false,"yanilgi":"yalniz_eklenen_kisim"},{"harf":"D","metin":"88 gram","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"13.200 gram","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Kişi sayısı ile malzeme **doğru orantılıdır**: kişi kaç kat artarsa malzeme de o kat artar.","ifade":null},{"aciklama":"Kaç kat arttığını bul:","ifade":"30 / 5 = 6"},{"aciklama":"Malzemeyi aynı katla çarp:","ifade":"440 × 6 = 2.640"},{"aciklama":"Gereken un:","ifade":"2.640 gram"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.paylastirma","oran.ters"],"zorluk":-0.903,"gorsel":null},{"kimlik":"c26a139fb18b","sablon":"yuzde.artis.degisim_orani","govde":"Bir atölyenin aylık üretimi 3.900 adetten 19.500 adede çıkmıştır. Üretimdeki artış yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%20","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"%80","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%400","dogru":true,"yanilgi":null},{"harf":"D","metin":"%500","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"%15.600","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Artış miktarı bulunur:","ifade":"19.500 − 3.900 = 15.600 adet"},{"aciklama":"Yüzde artış, artışın **eski** değere oranıdır:","ifade":"15.600 / 3.900 × 100 = %400"},{"aciklama":"Artış oranı:","ifade":"%400"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":3.875,"gorsel":null},{"kimlik":"5fba3405aad5","sablon":"veri.ortalama.eksik_terim","govde":"6 öğrencinin sınav notu ortalaması 54. Öğrencilerden 5'i sırasıyla 42, 85, 93, 47 ve 33 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"57","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"24","dogru":true,"yanilgi":null},{"harf":"C","metin":"324","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"60","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"78","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"54 × 6 = 324"},{"aciklama":"Bilinen notların toplamı:","ifade":"42 + 85 + 93 + 47 + 33 = 300"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"324 − 300 = 24"},{"aciklama":"Kalan öğrencinin notu:","ifade":"24"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.495,"gorsel":null},{"kimlik":"e51541195e78","sablon":"sayilar.uslu.negatif_us","govde":"(6⁻⁴)³ · 6⁴ işleminin sonucu, 6 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−8","dogru":true,"yanilgi":null},{"harf":"B","metin":"16","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"C","metin":"−48","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"8","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−3","dogru":false,"yanilgi":"us_us_toplandi"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(6⁻⁴)³ = 6⁻¹²"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"6⁻¹² · 6⁴ = 6⁻⁸"},{"aciklama":"Aranan kuvvet:","ifade":"−8"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.07,"gorsel":null},{"kimlik":"4c76f37644f5","sablon":"cebir.denklem.sistem","govde":"5x + 4y = 16 ve 3x + 3y = 21 olduğuna göre 5x + 6y kaçtır?","secenekler":[{"harf":"A","metin":"54","dogru":true,"yanilgi":null},{"harf":"B","metin":"−41","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"−174","dogru":false,"yanilg