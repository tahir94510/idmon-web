":"175 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"}],"cozum":[{"aciklama":"Bursa satırında görünen üç değeri topla:","ifade":"190 + 215 + 160 = 565"},{"aciklama":"Silinen değer, gerçek toplamdan görünenlerin toplamının **çıkarılmasıyla** bulunur:","ifade":"900 − 565 = 335"},{"aciklama":"Silinen değer:","ifade":"335 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-1.136,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[220,275,25,380]},{"ad":"Bursa","degerler":[190,215,0,160]},{"ad":"Konya","degerler":[40,135,100,395]},{"ad":"Eskişehir","degerler":[330,180,25,60]}]}},{"kimlik":"eacb58491e7f","sablon":"problem.karisim.tuz_orani","govde":"490 gram su ile 70 gram tuzdan oluşan bir karışıma 140 gram tuz daha ekleniyor. Yeni karışımın yüzde kaçı tuzdur?","secenekler":[{"harf":"A","metin":"%30","dogru":true,"yanilgi":null},{"harf":"B","metin":"%20","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"C","metin":"%37,5","dogru":false,"yanilgi":"karisim_eski_miktara_bolme"},{"harf":"D","metin":"%32,5","dogru":false,"yanilgi":"karisim_derisim_toplama"},{"harf":"E","metin":"%12,5","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Tuz eklendiğinde hem tuz miktarı hem toplam miktar büyür; ikisini de ayrı ayrı yaz.","ifade":null},{"aciklama":"Karışımın eski toplamı (su + tuz):","ifade":"490 + 70 = 560 gram"},{"aciklama":"Yeni tuz miktarı (eski tuz + eklenen):","ifade":"70 + 140 = 210 gram"},{"aciklama":"Yeni toplam (eski toplam + eklenen):","ifade":"560 + 140 = 700 gram"},{"aciklama":"Oran, yeni tuzun yeni toplama bölümüdür:","ifade":"210/700 × 100 = 30"},{"aciklama":"Yeni karışımdaki tuz oranı:","ifade":"%30"}],"mikrobeceriler":["problem.karisim"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":1.826,"gorsel":null},{"kimlik":"c604129ae3d8-1","sablon":"veri.blok.cizgi_iki_soru","govde":"2