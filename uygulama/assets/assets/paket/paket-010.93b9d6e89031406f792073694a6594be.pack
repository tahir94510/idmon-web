praz_hata"},{"harf":"B","metin":"3.600 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"C","metin":"300 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"3.000 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"27.000 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"9.000 / (5 × 6) = 300 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"2 × 5 = 10"},{"aciklama":"Toplam ücret:","ifade":"10 × 300 = 3.000 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"3.000 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":0.711,"gorsel":null},{"kimlik":"f721d77eed20","sablon":"yuzde.ardisik.iki_indirim","govde":"4.700 TL olan bir klavye fiyatına önce %30 indirim, ardından kalan fiyat üzerinden %40 indirim daha yapılmıştır. Son fiyat kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.726 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"1.410 TL","dogru":false,"yanilgi":"ardisik_yuzde_toplama"},{"harf":"C","metin":"8.554 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"3.290 TL","dogru":false,"yanilgi":"ardisik_yuzde_tek_uygulama"},{"harf":"E","metin":"1.974 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İkinci indirim ilk fiyata değil, **kalan fiyata** uygulanır; bu yüzden yüzdeler toplanmaz.","ifade":null},{"aciklama":"İlk indirimden sonra:","ifade":"4.700 TL × 70/100 = 3.290 TL"},{"aciklama":"İkinci indirimden sonra:","ifade":"3.290 TL × 60/100 = 1.974 TL"},{"aciklama":"Son fiyat:","ifade":"1.974 TL"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":0.472,"gorsel":null},{"kimlik":"7db5d5ae4f99","sablon":"mantik.dizi.artan_fark","govde":"20, 30, 44, 62, 84, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler"