":"%3.885","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Azalma yüzdesi, azalma miktarının **eski** değere oranıdır.","ifade":null},{"aciklama":"Azalma miktarı:","ifade":"5.180 − 1.295 = 3.885"},{"aciklama":"Bunu eski değere oranla ve 100 ile çarp:","ifade":"3.885 / 5.180 × 100 = 75"},{"aciklama":"Azalma oranı:","ifade":"%75"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":-0.105,"gorsel":null},{"kimlik":"cb145cac6345","sablon":"veri.grafik.sutun_ortalama","govde":"Bir işletmenin dört ayda sattığı Kitap sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"190 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"120 adet","dogru":false,"yanilgi":"ortalama_uc_degerlerden"},{"harf":"C","metin":"105 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"420 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"140 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Dört sütunun değerlerini topla:","ifade":"190 + 65 + 115 + 50 = 420"},{"aciklama":"Ortalama, toplamın sütun sayısına bölümüdür:","ifade":"420 / 4 = 105"},{"aciklama":"Ortalama satış:","ifade":"105 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":{"tur":"sutun","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[190,65,115,50]}]}},{"kimlik":"bf483027d54d","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"181² − 167² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"196","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"B","metin":"60.650","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"−4.872","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"D","metin":"4.872","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.534","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(181 − 167)(181 + 167) = 14 × 348"},{"aciklama":"Çarpımı yap:","ifade":"14 × 348 = 4.872"},{"aciklama":"İşlemin sonucu:","ifade":"4.872"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.079,"gorsel":null},{"kimlik":"e85ba80cc554","sablon":"sayilar.uslu.negatif_us","govde":"(4⁻³)⁴ · 4⁵ işleminin sonucu, 4 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−7","dogru":true,"yanilgi":null},{"harf":"B","metin":"7","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"−60","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"17","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"E","metin":"−2","dogru":false,"yanilgi":"us_us_toplandi"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(4⁻³)⁴ = 4⁻¹²"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"4⁻¹² · 4⁵ = 4⁻⁷"},{"aciklama":"Aranan kuvvet:","ifade":"−7"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.07,"gorsel":null},{"kimlik":"41125283dce7","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört şubede satılan toplam Telefon sayısı, toplam Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"680 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"370 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"460 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"240 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"60 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"}],"cozum":[{"aciklama":"Soru tek bir şube değil, dördünün toplamını istiyor. Önce Telefon sütunlarını topla:","ifade":"140 + 135 + 55 + 130 = 460"},{"aciklama":"Sonra Tablet sütunlarını topla:","ifade":"35 + 65 + 100 + 20 = 220"},{"aciklama":"İki toplamın farkını al:","ifade":"460 − 220 = 240"},{"aciklama":"Aradaki fark:","ifade":"240 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.284,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[140,135,55,130]},{"ad":"Tablet","degerler":[35,65,100,20]}]}},{"kimlik":"5bd50cdcdadc","sablon":"kume.temel.hicbiri","govde":"Bir okulda 66 öğrenci vardır. Bu öğrencilerin 24 tanesi futbol, 26 tanesi voleybol kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 2'dir. Buna göre bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"20","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"B","metin":"48","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"C","metin":"16","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"64","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"E","metin":"18","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"24 + 26 − 2 = 48"},{"aciklama":"Evrensel küme, hiçbir kursa gitmeyenleri de içerir:","ifade":"66 − 48 = 18"},{"aciklama":"Hiçbir kursa gitmeyen öğrenci sayısı:","ifade":"18"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"05eb69f38dde","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 25 litre yakıt tüketmektedir.\n\nBu araç İzmir'e yapılan 1.500 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"3.750 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"375 litre","dogru":true,"yanilgi":null},{"harf":"C","metin":"60 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"15 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"25 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"25/100 = x/1.500"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 1.500 × 25/100 = 375"},{"aciklama":"Tüketilen yakıt:","ifade":"375 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":0.451,"gorsel":null}]}