:[{"harf":"A","metin":"16","dogru":true,"yanilgi":null},{"harf":"B","metin":"32","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"C","metin":"14","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"21","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"E","metin":"26","dogru":false,"yanilgi":"yas_farki_degisti"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(30 + 2) / 2 = 16"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"30 − 16 = 14"},{"aciklama":"Büyük olanın yaşı:","ifade":"16"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.417,"gorsel":null},{"kimlik":"68504159ecfc","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"16 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"380 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"205 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"390 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"370 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Ankara: 370/16 · Antalya: 390/44 · Samsun: 205/40 · Trabzon: 380/20"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Ankara satırında:","ifade":"370/16"},{"aciklama":"O satırın satış sayısı:","ifade":"370 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.626,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Ankara","degerle