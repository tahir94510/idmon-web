/84 = 83/84"},{"aciklama":"İşlemin sonucu:","ifade":"83/84"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.072,"gorsel":null},{"kimlik":"351d05882080","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n54, 57, 69, 96, 144, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"252","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"159","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"C","metin":"218","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"D","metin":"144","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"219","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"3, 12, 27, 48"},{"aciklama":"Farklar ardışık sayıların karelerinin **3 katı**: 3·1², 3·2², 3·3², 3·4². Sıradaki fark 3·5²:","ifade":"75"},{"aciklama":"Son terime bu farkı ekle:","ifade":"144 + 75 = 219"},{"aciklama":"Sıradaki terim:","ifade":"219"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.566,"gorsel":null},{"kimlik":"1c9c93e01a4b","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 22 kız öğrencinin matematik notu ortalaması 55, 33 erkek öğrencinin ortalaması ise 40'tır. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"49","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"47,5","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"46","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.530","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"115","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"22 × 55 + 33 × 40 = 2.530"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"22 + 33 = 55"},{"aciklama":"Sınıf ortalaması:","ifade":"2.530 / 55 = 46"},{"aciklama":"Sınıfın ortalaması:","ifade":"46"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"a7353faf0a92","sablon":"problem.isci.birlikte","govde":"Bir işi Ece tek başına 28 günde, Onur tek başına 70 günde bitirmektedir. İkisi birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"49 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"98 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"20 gün","dogru":true,"yanilgi":null},{"harf":"D","metin":"42 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"E","metin":"28 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/28 + 1/70 = 98/1960"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"1960/98 = 20 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"20 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":2.858,"gorsel":null},{"kimlik":"31a205f6d942","sablon":"sayilar.uslu.negatif_us","govde":"(2⁻⁵)² · 2² işleminin sonucu, 2 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−5","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"B","metin":"−20","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"C","metin":"12","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"D","metin":"8","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−8","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(2⁻⁵)² = 2⁻¹⁰"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2⁻¹⁰ · 2² = 2⁻⁸"},{"aciklama":"Aranan kuvvet:","ifade":"−8"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.902,"gorsel":null},{"kimlik":"d6c17da669e8","sablon":"cebir.denklem.dagitmali","govde":"10(x + 7) − 7(x − 8) = 99 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"85/3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−9","dogru":true,"yanilgi":null},{"harf":"C","metin":"−27/17","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"D","metin":"−2","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"7","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"Parantezleri dağıt; ikinci parantezin önündeki eksi, içerideki her terimin işaretini çevirir:","ifade":"10x + 70 − 7x + 56 = 99"},{"aciklama":"Benzer terimleri topla:","ifade":"3x + 126 = 99"},{"aciklama":"Sabit terimi karşıya geçir, yani iki taraftan da 126 çıkar:","ifade":"3x = 99 − 126 = −27"},{"aciklama":"İki tarafı 3 sayısına böl; x değeri:","ifade":"−9"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.025,"gorsel":null},{"kimlik":"e7e52292c422","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 38 litre yakıt tüketmektedir.\n\nBu araç Trabzon'a yapılan 1.900 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"38 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"19 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"722 litre","dogru":true,"yanilgi":null},{"harf":"D","metin":"50 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"7.220 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"38/100 = x/1.900"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 1.900 × 38/100 = 722"},{"aciklama":"Tüketilen yakıt:","ifade":"722 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":1.255,"gorsel":null},{"kimlik":"fbf61f5f5bb8","sablon":"veri.ortalama.eksik_terim","govde":"7 öğrencinin sınav notu ortalaması 79. Öğrencilerden 6'yı sırasıyla 54, 58, 98, 90, 76 ve 86 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"553","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"462","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"91","dogru":true,"yanilgi":null},{"harf":"D","metin":"170","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"177","dogru":false,"yanilgi":"toplamda_deger_atlandi"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"79 × 7 = 553"},{"aciklama":"Bilinen notların toplamı:","ifade":"54 + 58 + 98 + 90 + 76 + 86 = 462"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"553 − 462 = 91"},{"aciklama":"Kalan öğrencinin notu:","ifade":"91"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null},{"kimlik":"b7794ea28dcf","sablon":"yuzde.artis.indirim","govde":"Fiyatı 3.600 TL olan bir şemsiye, %20 indirimle satılmaktadır. Şemsiyenin indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.304 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"720 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"3.580 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"4.320 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"2.880 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"3.600 × 20 / 100 = 720"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"3.600 − 720 = 2.880"},{"aciklama":"İndirimli fiyat:","ifade":"2.880 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_