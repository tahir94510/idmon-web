hareket"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"2a33ace001d0","sablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Armut dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"342 derece","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"72 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"18 derece","dogru":true,"yanilgi":null},{"harf":"D","metin":"5 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"9 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Armut diliminin payı:","ifade":"%5"},{"aciklama":"Merkez açısı:","ifade":"360 × 5 / 100 = 18"},{"aciklama":"Merkez açısı:","ifade":"18 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.134,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Elma","Armut","Kiraz","Üzüm"],"birim":"%","seriler":[{"ad":"Pay","degerler":[50,5,20,25]}]}},{"kimlik":"3cea145935ff","sablon":"oran.bilesik.isci_ucret","govde":"9 işçi 4 günde çalışarak toplam 18.000 TL kazanmaktadır. Aynı günlük ücretle çalışan 5 işçi 9 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"40.500 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"14.400 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"C","metin":"500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"22.500 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"10.000 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"18.000 / (9 × 4) = 500 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"5 × 9 = 45"},{"aciklama":"Toplam ücret:","ifade":"45 × 500 = 22.500 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"22.500 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":1.149,"gorsel":null},{"kimlik":"11e2b5e2a959","sablon":"yuzde.temel.ters_yuzde","govde":"Bir mont fiyatına %10 zam yapıldıktan sonra fiyatı 4.950 TL olmuştur. Montun zamdan önceki fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"450 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"4.500 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"5.500 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"4.455 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"4.940 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zamlı fiyat, eski fiyatın %110'udur:","ifade":"eski × 110/100 = 4.950"},{"aciklama":"Eski fiyat, zamlı fiyatın bu orana bölümüdür:","ifade":"4.950 × 100/110 = 4.500 TL"},{"aciklama":"Zamdan önceki fiyat:","ifade":"4.500 TL"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.254,"gorsel":null},{"kimlik":"91fafb1019c1","sablon":"sayilar.mutlak.kokler_toplami","govde":"|4x − 8| = 12 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"4","dogru":true,"yanilgi":null},{"harf":"B","metin":"5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"6","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"−4","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−1","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değer 12'ye eşitse içerideki ifade 12 ya da −12 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"4x − 8 = 12 ⟹ x = 5"},{"aciklama":"İkinci durum:","ifade":"4x − 8 = −12 ⟹ x = −1"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini