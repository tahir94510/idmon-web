:null},{"kimlik":"1abcf882d675","sablon":"veri.grafik.daire_iki_dilim","govde":"2.300 kişiyle yapılan bir ankette tercihler yukarıdaki daire grafiğindeki gibi dağılmıştır. Buna göre Deneme ve Öykü seçeneklerini işaretleyen toplam kaç kişi vardır?","secenekler":[{"harf":"A","metin":"1.150 kişi","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"B","metin":"805 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"35 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"D","metin":"1.495 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"345 kişi","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"İki dilimin yüzdelerini topla:","ifade":"%15 + %20 = %35"},{"aciklama":"Bu yüzdeyi toplam kişi sayısıyla çarp:","ifade":"2.300 × 35/100 = 805 kişi"},{"aciklama":"Toplam kişi:","ifade":"805 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.17,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Roman","Şiir","Deneme","Öykü"],"birim":"%","seriler":[{"ad":"Pay","degerler":[35,30,15,20]}]}},{"kimlik":"636998595cbb","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 28| = 18 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"460","dogru":true,"yanilgi":null},{"harf":"B","metin":"46","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"C","metin":"1.108","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"10","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"E","metin":"−460","dogru":false,"yanilgi":"mutlak_deger_dagitildi"}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 28 + 18 = 46 ve x = 28 − 18 = 10"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(28 + 18) × (28 − 18) = 28² − 18² = 460"},{"aciklama":"Köklerin çarpımı:","ifade":"460"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.826,"gorsel":null},{"kimlik":"e0e253e3669c","sablon":"m