,"yanilgi":"hiz_toplama_yonu"},{"harf":"D","metin":"21 saat","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"E","metin":"18 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"}],"cozum":[{"aciklama":"Zıt yönde hareket eden araçlar için yaklaşma hızı, hızların toplamıdır:","ifade":"40 + 30 = 70 km/sa"},{"aciklama":"Karşılaşma süresi, aradaki uzaklığın yaklaşma hızına bölümüdür:","ifade":"630 / 70 = 9 saat"},{"aciklama":"Karşılaşma süresi:","ifade":"9 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":3.453,"gorsel":null},{"kimlik":"9c8922dac860","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Konya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2020 yılından 2023 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"240 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"110 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"C","metin":"120 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"390 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"E","metin":"80 kişi","dogru":false,"yanilgi":"grafik_artis_egim"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2020 değeri:","ifade":"270 kişi"},{"aciklama":"2023 değeri:","ifade":"390 kişi"},{"aciklama":"Farkı al:","ifade":"390 − 270 = 120"},{"aciklama":"Artış miktarı:","ifade":"120 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.448,"gorsel":{"tur":"cizgi","baslik":"Konya şubesinin yıllık üye sayısı","etiketler":["2019","2020","2021","2022","2023"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[240,270,280,310,390]}]}},{"kimlik":"22defd829dbd","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 10/x = 30 olduğuna göre x² + 10²/x² kaçtır?","secenekler":[{"harf":"A","metin":"920","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"B","metin":"900","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"C","metin":"860","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"D","metin":"880","dogru":true,"yanilgi":null},{"harf":"E","metin":"890","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 10/x)² = x² + 2 · x · 10/x + 10²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 10 kalır:","ifade":"30² = x² + 10²/x² + 20"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 10²/x² = 900 − 20 = 880"},{"aciklama":"İstenen değer:","ifade":"880"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.997,"gorsel":null},{"kimlik":"515239c9a51f","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 6'ya bölümünden kalan 4, 15'e bölümünden kalan 13'tür. Bu koşulu sağlayan ve 361'den büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"364","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"448","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"C","metin":"388","dogru":true,"yanilgi":null},{"harf":"D","metin":"373","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"E","metin":"362","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 2 eksik. Demek ki sayıya 2 eklenirse sayı hem 6 hem 15 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(6, 15) = 30"},{"aciklama":"Sayı 30'un katından 2 eksiktir. 361'den büyük ilk böyle sayı:","ifade":"388"},{"aciklama":"Aranan sayı:","ifade":"388"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.178,"gorsel":null},{"kimlik":"ff92483c1da6","sablon":"oran.ters.isci_gun","govde":"Bir inşaat işini 5 işçi 12 günde bitirmektedir. Aynı işi, aynı hızda çalışan 15 işçi kaç günde bitirir?","secenekler":[{"harf":"A","metin":"36 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"22 gün","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"60 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"2 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"E","metin":"4 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İşçi sayısı ile süre ters orantılıdır; çarpımları toplam iş yükünü verir:","ifade":"5 × 12 = 60 işçi-gün"},{"aciklama":"Aynı iş yükü 15 işçiye bölündüğünde süre:","ifade":"60 / 15 = 4 gün"},{"aciklama":"İşin biteceği süre:","ifade":"4 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"a8a0860ff9dc","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Eskişehir şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"160 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"B","metin":"10 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"C","metin":"50 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"60 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"100 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 60 · 2021→2022: −50 · 2022→2023: −10 · 2023→2024: 60"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2021 → 2022: 160 − 110 = 50 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"50 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":{"tur":"cizgi","baslik":"Eskişehir şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[100,160,110,100,160]}]}},{"kimlik":"1c3ea6114e98","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, tanesini 2.700 TL maliyetle aldığı bir mont çeşidini %24 kârla satmaktadır. Buna göre montun satış fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"648 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"67.500 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"2.052 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"2.724 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"3.348 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr yüzdesi her zaman maliyet üzerinden hesaplanır:","ifade":"2.700 × 24/100 = 648 TL"},{"aciklama":"Satış fiyatı maliyet ile kârın toplamıdır:","ifade":"2.700 + 648 = 3.348 TL"},{"aciklama":"Satış fiyatı:","ifade":"3.348 TL"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-1.271,"gorsel":null},{"kimlik":"7a117153ca21","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n3, 6, 18, 45, 93, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"201","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"167","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"C","metin":"168","dogru":true,"yanilgi":null},{"harf":"D","metin":"108","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"141","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"3, 12, 27, 48"},{"aciklama":"Farklar ardışık sayıların karelerinin **3 katı**: 3·1², 3·2², 3·3², 3·4². Sıradaki fark 3·5²:","ifade":"75"},{"aciklama":"Son terime bu farkı ekle:","ifade":"93 + 75 = 168"},{"aciklama":"Sıradaki terim:","ifade":"168"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.566,"gorsel":null},{"kimlik":"6eafca50ef77","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"310 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"10 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"40 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"175 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"45 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Dergi ilk kez Mart döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Kitap 135, Dergi 175","ifade":"175 − 135 = 40"},{"aciklama":"Aradaki fark:","ifade":"40 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.187,"gorsel":{"tur":"cizgi","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[175,155,135,115]},{"ad":"Dergi","degerler":[45,110,175,240]}]}},{"kimlik":"bec12189d220","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Antalya'ya giderken yolun ilk bölümünü saatte 70 km hızla 1 saatte, kalan bölümünü saatte 120 km hızla 3 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"430 km","dogru":true,"yanilgi":null},{"harf":"B","metin":"380 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"70 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"330 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"E","metin":"280 km","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"70 × 1 = 70 km"},{"aciklama":"İkinci bölüm:","ifade":"120 × 3 = 360 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"70 + 360 = 430 km"},{"aciklama":"Toplam yol:","ifade":"430 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.555,"gorsel":null},{"kimlik":"9816dfc9fe05","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 36 dakikada bir, B hattı 20 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"180 dakika","dogru":true,"yanilgi":null},{"harf":"B","metin":"360 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"4 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"D","metin":"56 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"E","metin":"720 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"36 ve 20 sayılarının EKOK'u:","ifade":"EKOK(36, 20) = 180"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"180 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":3.153,"gorsel":null},{"kimlik":"31dfd717cc22","sablon":"oran.ters.kapasite_arac","govde":"Bir depodaki yükün tamamı, her biri 18 ton taşıyan 30 kamyonla bir seferde taşınmaktadır. Aynı yük, her biri 12 ton taşıyan kamyonlarla bir seferde taşınsaydı kaç kamyon gerekirdi?","secenekler":[{"harf":"A","metin":"20 kamyon","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"36 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"24 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"D","metin":"45 kamyon","dogru":true,"yanilgi":null},{"harf":"E","metin":"540 kamyon","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Taşınan yük değişmiyor; değişen yalnızca onu kaç araca böldüğümüz. Araç sayısı ile kapasite **ters** orantılıdır, yani çarpımları sabittir.","ifade":null},{"aciklama":"Toplam yükü bul:","ifade":"30 × 18 = 540 ton"},{"aciklama":"Yeni kapasiteye böl:","ifade":"540 / 12 = 45"},{"aciklama":"Gereken kamyon sayısı:","ifade":"45 kamyon"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.11,"gorsel":null},{"kimlik":"f67ef4e4bd75","sablon":"yuzde.kar_zarar.zarar_orani","govde":"Maliyeti 1.500 TL olan bir ürün 480 TL fiyatına satılmıştır. Bu satışta zarar yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%68","dogru":true,"yanilgi":null},{"harf":"B","metin":"%32","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"%312,5","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%1.020","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%212,5","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"}],"cozum":[{"aciklama":"Zarar tutarı bulunur:","ifade":"1.500 − 480 = 1.020 TL"},{"aciklama":"Zarar yüzdesi, zararın **maliyete** oranıdır:","ifade":"1.020 / 1.500 × 100 = %68"},{"aciklama":"Zarar oranı:","ifade":"%68"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.994,"gorsel":null},{"kimlik":"be6206210717","sablon":"veri.grafik.cizgi_ortalama","govde":"Bir mağazanın dört ayda sattığı Kitap sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan Kitap sayısının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"165 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"230 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"192 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"D","metin":"240 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"320 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Grafikteki dört değeri sırayla oku:","ifade":"Ocak: 165 · Şubat: 230 · Mart: 295 · Nisan: 270"},{"aciklama":"Dördünü topla:","ifade":"165 + 230 + 295 + 270 = 960"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür (4 dönem):","ifade":"960/4 = 240"},{"aciklama":"Dönem ortalaması:","ifade":"240 adet"}],"mikrobeceriler":["veri.grafik","veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.807,"gorsel":{"tur":"cizgi","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[165,230,295,270]}]}},{"kimlik":"f552d24662d7","sablon":"sayilar.ebob_ekok.parcalama","govde":"Uzunlukları 32 cm ve 24 cm olan iki tel, artan olmayacak biçimde eşit uzunlukta parçalara ayrılacaktır. Bir parçanın uzunluğu en fazla kaç santimetre olabilir?","secenekler":[{"harf":"A","metin":"7 cm","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"96 cm","dogru":false,"yanilgi":"ebob_ekok_karisimi"},{"harf":"C","metin":"8 cm","dogru":true,"yanilgi":null},{"harf":"D","metin":"56 cm","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"E","metin":"4 cm","dogru":false,"yanilgi":"ebob_ortak_bolende_durma"}],"cozum":[{"aciklama":"Artan olmaması, parça uzunluğunun **iki sayıyı da** tam bölmesi demektir; en büyüğü aranıyorsa bu EBOB'dur.","ifade":null},{"aciklama":"İki sayıyı çarpanlarına ayır:","ifade":"32 = 8·4   ve   24 = 8·3"},{"aciklama":"Ortak çarpan 8; kalan çarpanlar (4 ve 3) aralarında asal, yani daha büyük bir ortak bölen yok.","ifade":"EBOB(32, 24) = 8"},{"aciklama":"En büyük parça uzunluğu:","ifade":"8 cm"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":0.14,"gorsel":null},{"kimlik":"39f67a2b291a","sablon":"veri.grafik.cizgi_yuzde_artis","govde":"Bursa mağazasının yıllık cirosu bin TL cinsinden yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2019 yılından 2021 yılına ciro yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%150","dogru":true,"yanilgi":null},{"harf":"B","metin":"%48","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"%60","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"%100","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"E","metin":"%250","dogru":false,"yanilgi":"degisim_yerine_deger"}],"cozum":[{"aciklama":"Yüzde artışta bütün, **başlangıç** değeridir; artış ona oranlanır.","ifade":null},{"aciklama":"Artış miktarı:","ifade":"100 − 40 = 60"},{"aciklama":"Artışı başlangıç değerine böl ve 100 ile çarp:","ifade":"60 / 40 × 100 = %150"},{"aciklama":"Yüzde artış:","ifade":"%150"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"cizgi","baslik":"Bursa mağazasının yıllık cirosu (bin TL)","etiketler":["2017","2018","2019","2020","2021"],"birim":"bin TL","seriler":[{"ad":"Ciro","degerler":[125,80,40,50,100]}]}},{"kimlik":"24fc69668595","sablon":"cebir.denklem.dagitmali","govde":"5(x + 18) − 7(x − 15) = 159 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"−3","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"−27","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"18","dogru":true,"yanilgi":null},{"harf":"D","metin":"36","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"−87","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Parantezleri dağıt; ikinci parantezin önündeki eksi, içerideki her terimin işaretini çevirir:","ifade":"5x + 90 − 7x + 105 = 159"},{"aciklama":"Benzer terimleri topla:","ifade":"−2x + 195 = 159"},{"aciklama":"Sabit terimi karşıya geçir, yani iki taraftan da 195 çıkar:","ifade":"−2x = 159 − 195 = −36"},{"aciklama":"İki tarafı −2 sayısına böl; x değeri:","ifade":"18"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":0.985,"gorsel":null},{"kimlik":"7e9c3d604d6f","sablon":"mantik.dizi.sabit_fark","govde":"28, 43, 58, 73, 88, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"103","dogru":true,"yanilgi":null},{"harf":"B","metin":"88","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"C","metin":"102","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"D","metin":"73","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"E","metin":"118","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"43−28=15 , 58−43=15 , 73−58=15 , 88−73=15"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerliyor:","ifade":"fark = 15"},{"aciklama":"Son terime bu farkı ekle:","ifade":"88 + 15 = 103"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"103"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"fd9270161d8f","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Bursa ile Ankara arasındaki yolu giderken 88 km/sa, dönerken 22 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"88 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"55 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"35,2 km/sa","dogru":true,"yanilgi":null},{"harf":"D","metin":"110 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"17,6 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/88 + x/22 = x·(110)/(88·22)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·110/(88·22)] = 2·88·22/110 = 35,2 km/sa"},{"aciklama":"Ortalama hız:","ifade":"35,2 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.412,"gorsel":null},{"kimlik":"f6354f903bae","sablon":"oran.ters.musluk_havuz","govde":"Özdeş 2 musluk bir havuzu 38 saatte doldurmaktadır. Aynı havuz özdeş 4 muslukla kaç saatte dolar?","secenekler":[{"harf":"A","metin":"19 saat","dogru":true,"yanilgi":null},{"harf":"B","metin":"40 saat","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"76 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"D","metin":"38 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"},{"harf":"E","metin":"36 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"Musluk sayısı ile süre ters orantılıdır; çarpımları sabittir:","ifade":"2 × 38 = 76"},{"aciklama":"4 muslukta süre, bu sabitin musluk sayısına bölümüdür:","ifade":"76 / 4 = 19 saat"},{"aciklama":"Dolma süresi:","ifade":"19 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.25,"gorsel":null},{"kimlik":"57f406f712ca","sablon":"yuzde.temel.iki_yuzde_farki","govde":"2.650 sayısının %60'ı ile %24'ü arasındaki fark kaçtır?","secenekler":[{"harf":"A","metin":"36","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"9.540","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"954","dogru":true,"yanilgi":null},{"harf":"D","metin":"1.590","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.226","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Sayının %60'ını al:","ifade":"2.650 × 60/100 = 1.590"},{"aciklama":"Sayının %24'ünü al:","ifade":"2.650 × 24/100 = 636"},{"aciklama":"İki sonucun farkını al (yüzdelerin farkı doğrudan cevap değil, o farkın sayıdaki karşılığı sorulmuş):","ifade":"1.590 − 636 = 954"},{"aciklama":"Aradaki fark:","ifade":"954"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.378,"gorsel":null},{"kimlik":"c7341b16bd5e","sablon":"veri.grafik.daire_aciyla_sayi","govde":"Toplam 1.400 kişinin katıldığı bir ankette verilen cevapların merkez açıları yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Kiraz seçeneğini işaretleyen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"350 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"980 kişi","dogru":false,"yanilgi":"tumleyeni_