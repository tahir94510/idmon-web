gru":true,"yanilgi":null},{"harf":"D","metin":"30","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"180","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Muz: 4,2 − 3 = 1,2 TL, Soğan: 2,8 − 2 = 0,8 TL, Mandalina: 4,8 − 4 = 0,8 TL.","ifade":null},{"aciklama":"Soğan ile mandalinanın kilogram kârı aynı. Hepsi 0,8 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"270 · 0,8 = 216 TL"},{"aciklama":"Fazladan 12 TL yalnızca muz yüzünden: onun her kilogramı 0,4 TL fazla kazandırıyor.","ifade":"muz = 12 ÷ 0,4 = 30 kg"},{"aciklama":"İstenen: 270 − 30 =","ifade":"240"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Muz","degerler":[3.0,4.2]},{"ad":"Soğan","degerler":[2.0,2.8]},{"ad":"Mandalina","degerler":[4.0,4.8]}]}},{"kimlik":"8d1ef45837e8","sablon":"oran.temel.oran_ve_fark","govde":"Fatma'nın parasının Zeynep'in parasına oranı 13/3'tür. Aralarındaki fark 4.800 TL olduğuna göre Fatma kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"7.680 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"6.240 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"480 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"D","metin":"1.440 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"3.900 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Fatma 13k, Zeynep 3k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"13k − 3k = 10k = 4.800"},{"aciklama":"Birim payı bul:","ifade":"k = 4.800 / 10 = 480"},{"aciklama":"Fatma için:","ifade":"13 × 480 = 6.240"},{"aciklama":"Fatma'nın parası:","ifade":"6.240 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.785,"gorsel":null},{"kimlik":"b1d79843f743","sablon":"yuzde.faiz.getiri_farki","govde":"14.000 TL, yıllık %30 faizle 3 ay vadeli bir hesaba yatırılıyor.\n\nBuna göre bu hesabın getirisi, aynı paranın yıllık %12 faizle aynı süreye yatırılmasıyla elde edilecek getiriden kaç TL fazladır?","secenekler":[{"harf":"A","metin":"18 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"630 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"2.520 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"D","metin":"1.050 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"840 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"İki hesabın farkı, oran farkının aynı anapara ve aynı süreyle işlemesidir:","ifade":"30 − 12 = 18 puan"},{"aciklama":"Yıllık faiz oranı aya çevrilir (yıl 12 ay):","ifade":"18/100 × 3/12"},{"aciklama":"Anaparayla çarp:","ifade":"14.000 × 18/100 × 3/12 = 630 TL"},{"aciklama":"Getiri farkı:","ifade":"630 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.107,"gorsel":null},{"kimlik":"65fe92c0b7dc","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 396 azalmaktadır. Bu sayının yüzler basamağındaki rakam 6, onlar basamağındaki rakam 6'dır. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"62","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"B","metin":"266","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"C","metin":"608","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"D","metin":"626","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"E","metin":"662","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (6 − b) = 396 ⟹ 6 − b = 4 ⟹ b = 2"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 6 + 10 × 6 + 2 = 662"},{"aciklama":"Aranan sayı:","ifade":"662"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"cfc68abd2536","sablon":"veri.tablo.satir_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Antalya'nın dört mevsimdeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"92 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"101 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"108 adet","dogru":false,"yanilgi":"ortalama_fazla_terim"},{"harf":"D","metin":"135 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"145 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Antalya satırındaki dört değeri topla:","ifade":"24 + 312 + 32 + 172 = 540"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür; burada dört mevsim var:","ifade":"540 / 4 = 135"},{"aciklama":"Satır ortalaması:","ifade":"135 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-1.398,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[24,312,32,172]},{"ad":"Eskişehir","degerler":[70,250,105,155]},{"ad":"Bursa","degerler":[165,270,385,370]},{"ad":"Trabzon","degerler":[145,70,340,155]}]}},{"kimlik":"c0dd78eeb7f4-1","sablon":"problem.blok.ortak_is_iki_soru","govde":"Deniz ile Emre birlikte çalışırsa aynı iş kaç günde biter?","secenekler":[{"harf":"A","metin":"100 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"200 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"C","metin":"80 gün","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"D","metin":"42 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"60 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/140 + 1/60 = 10/420"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"420/10 = 42 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"42 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.559,"gorsel":null,"grup":"c0dd78eeb7f4","grup_govde":"Bir işi Deniz tek başına 140 günde, Emre tek başına 60 günde bitirmektedir."},{"kimlik":"c0dd78eeb7f4-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Deniz işe başlayıp 91 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Emre tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"100 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"B","metin":"60 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"C","metin":"39 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"200 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"E","metin":"21 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Deniz bir günde işin 1/140'ını yapıyor; 91 gün çalışınca yaptığı iş:","ifade":"91/140"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(140 − 91)/140 = 7/20"},{"aciklama":"Emre işin tamamını 60 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"7/20 × 60 = 21"},{"aciklama":"Kalan iş için gereken süre:","ifade":"21 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.625,"gorsel":null,"grup":"c0dd78eeb7f4","grup_govde":"Bir işi Deniz tek başına 140 günde, Emre tek başına 60 günde bitirmektedir."},{"kimlik":"b3cb72680035","sablon":"mantik.dizi.sabit_oran","govde":"19, 76, 304, 1.216, 4.864, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"77.824","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"8.512","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"4.864","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"19.456","dogru":true,"yanilgi":null},{"harf":"E","metin":"1.216","dogru":false,"yanilgi":"dizi_yon_ters"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farklar sabit değil; oranlara bak:","ifade":"76÷19=4 , 304÷76=4 , 1.216÷304=4 , 4.864÷1.216=4"},{"aciklama":"Oran her adımda aynı, yani her terim bir öncekinin katı:","ifade":"oran = 4"},{"aciklama":"Son terimi bu oranla çarp:","ifade":"4.864 × 4 = 19.456"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"19.456"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"0c63d2c91993","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Ankara'ya giderken yolun ilk bölümünü saatte 100 km hızla 3 saatte, kalan bölümünü saatte 80 km hızla 1 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"320 km","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"B","metin":"300 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"360 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"380 km","dogru":true,"yanilgi":null},{"harf":"E","metin":"340 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"100 × 3 = 300 km"},{"aciklama":"İkinci bölüm:","ifade":"80 × 1 = 80 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"300 + 80 = 380 km"},{"aciklama":"Toplam yol:","ifade":"380 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.44,"gorsel":null},{"kimlik":"1866763c4ad6","sablon":"veri.tablo.satir_toplami","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Eskişehir'in yıl boyunca yaptığı toplam satış kaç adettir?","secenekler":[{"harf":"A","metin":"3.420 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"780 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"1.380 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"725 adet","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"1.060 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Tabloda sorulan satırı bul: Eskişehir satırı.","ifade":null},{"aciklama":"O satırdaki dört mevsim değerini sırayla oku:","ifade":"İlkbahar: 320 · Yaz: 70 · Sonbahar: 350 · Kış: 320"},{"aciklama":"Dördünü topla:","ifade":"320 + 70 + 350 + 320 = 1.060"},{"aciklama":"Yıl boyunca yapılan toplam satış:","ifade":"1.060 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":[],"zorluk":-0.378,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Antalya","degerler":[205,240,65,345]},{"ad":"Eskişehir","degerler":[320,70,350,320]},{"ad":"Ankara","degerler":[270,240,215,55]},{"ad":"Samsun","degerler":[180,175,145,225]}]}},{"kimlik":"fc7a0cbfd3cf","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 14 ile bölümünden elde edilen bölüm 11, kalan ise 5'tir. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"154","dogru":false,"yanilgi":"kalan_sifir_sayildi"},{"harf":"B","metin":"159","dogru":true,"yanilgi":null},{"harf":"C","metin":"149","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"D","metin":"224","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"E","metin":"81","dogru":false,"yanilgi":"kalan_bolen_karisimi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"14 × 11 + 5 = 154 + 5 = 159"},{"aciklama":"Kalan (5) bölenden (14) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"159"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.865,"gorsel":null},{"kimlik":"8eac66f95a8e","sablon":"oran.temel.oran_ve_toplam","govde":"Zeynep'in parasının Burak'ın parasına oranı 11/6'dır. İkisinin parası toplam 8.160 TL olduğuna göre Zeynep kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"4.080 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"480 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"17.952 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"D","metin":"5.280 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.880 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Zeynep 11k, Burak 6k.","ifade":null},{"aciklama":"Verilen **toplam**dır, fark değil:","ifade":"11k + 6k = 17k = 8.160"},{"aciklama":"Birim payı bul:","ifade":"k = 8.160 / 17 = 480"},{"aciklama":"Zeynep için:","ifade":"11 × 480 = 5.280"},{"aciklama":"Zeynep'in parası:","ifade":"5.280 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":3.457,"gorsel":null},{"kimlik":"25e023771434","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 1.100 TL olan bir mont %30 kârla, maliyeti 2.600 TL olan bir buzdolabı ise %10 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"330 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"70 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"590 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"740 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"20 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"1.100 × 30/100 = 330 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"2.600 × 10/100 = 260 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"330 − 260 = 70 TL"},{"aciklama":"Net kâr:","ifade":"70 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.81,"gorsel":null},{"kimlik":"9860a25c71e2","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin Kış mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"252 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.008 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"335 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"169 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"E","metin":"336 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Kış sütunundaki dört değeri oku:","ifade":"Ankara: 356 · Antalya: 92 · Eskişehir: 228 · Samsun: 332"},{"aciklama":"Dördünü topla:","ifade":"356 + 92 + 228 + 332 = 1.008"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölünmesidir; burada dört şehir var:","ifade":"1.008 / 4 = 252"},{"aciklama":"Ortalama satış:","ifade":"252 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-0.859,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Ankara","degerler":[60,100,355,356]},{"ad":"Antalya","degerler":[265,175,60,92]},{"ad":"Eskişehir","degerler":[240,40,105,228]},{"ad":"Samsun","degerler":[275,395,80,332]}]}},{"kimlik":"fc91661e291f","sablon":"cebir.denklem.kesirli","govde":"(x + 2)/8 − (x − 5)/5 = −1 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"−90/13","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"B","metin":"10/3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"32","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"30","dogru":true,"yanilgi":null},{"harf":"E","metin":"17","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"Paydaların EKOK'u 40; denklemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(8, 5) = 40"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"5(x + 2) − 8(x − 5) = −40"},{"aciklama":"Benzer terimleri topla:","ifade":"−3x + 50 = −40"},{"aciklama":"x'i yalıt:","ifade":"x = −90 / −3 = 30"},{"aciklama":"x değeri:","ifade":"30"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":3.192,"gorsel":null},{"kimlik":"a24041531f73","sablon":"kume.temel.fark_kumesi","govde":"A ve B kümeleri için s(A) = 25, s(B) = 37 ve s(A ∪ B) = 55'tir. Buna göre s(A ∖ B) kaçtır?","secenekler":[{"harf":"A","metin":"30","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"B","metin":"48","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"C","metin":"25","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"7","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"E","metin":"18","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Burada s(...) \"eleman sayısı\" demek. İki kümenin birleşimi sayılırken ortak elemanlar iki kez sayılır, o yüzden bir kez geri çıkarılır:","ifade":"s(A ∪ B) = s(A) + s(B) − s(A ∩ B)"},{"aciklama":"Bu eşitlikten kesişimi yalnız bırak:","ifade":"s(A ∩ B) = 25 + 37 − 55 = 7"},{"aciklama":"A ∖ B, A'da olup B'de olmayanlar; yani A'nın kesişim dışında kalan kısmı:","ifade":"25 − 7 = 18"},{"aciklama":"s(A ∖ B):","ifade":"18"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"149159c35898","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"172 ile 2.483 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 63'e tam bölünür?","secenekler":[{"harf":"A","metin":"330","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"B","metin":"256","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"C","metin":"37","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.374/63","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"110","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"}],"cozum":[{"aciklama":"63'e bölünen sayılar 63'ün katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"189 ve 2.457"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(2.457 − 189) / 63 + 1 = 37"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"37"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":0.163,"gorsel":null},{"kimlik":"2f967c4ff725","sablon":"veri.tablo.sutun_yuzde_degisim","govde":"Bir kulübün dört şehirdeki şubelerinin 2024 ve 2025 yıllarındaki üye sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Bursa'da üye sayısı 2024'ten 2025'e yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"%250","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%25","dogru":true,"yanilgi":null},{"harf":"E","metin":"%35","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Bursa satırındaki iki değeri oku:","ifade":"2024: 140 · 2025: 175"},{"aciklama":"Artış miktarını bul:","ifade":"175 − 140 = 35"},{"aciklama":"Artış oranı **eski** değere bölünür, yeniye değil:","ifade":"35/140 × 100"},{"aciklama":"Artış oranı:","ifade":"%25"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.254,"gorsel":{"tur":"tablo","baslik":"Yıllara göre üye sayısı (kişi)","etiketler":["2024","2025"],"birim":"kişi","seriler":[{"ad":"İzmir","degerler":[280,460]},{"ad":"Ankara","degerler":[260,300]},{"ad":"Bursa","degerler":[140,175]},{"ad":"Samsun","degerler":[40,140]}]}},{"kimlik":"2dbb3743f2a8","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 3 : 2 : 6 oranındadır. İkinci arkadaşın parası 72 TL olduğuna göre birinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"132 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"48 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"108 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"3 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"36 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"3k : 2k : 6k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"2k = 72 → k = 36"},{"aciklama":"Sorulan payı k ile çarp (birinci arkadaş):","ifade":"3 × 36 = 108"},{"aciklama":"Birinci arkadaşın parası:","ifade":"108 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.154,"gorsel":null},{"kimlik":"2f3b4c698532","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 2.300 TL olan bir yazıcı 5.750 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%150","dogru":true,"yanilgi":null},{"harf":"B","metin":"%60","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%250","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"D","metin":"%3.450","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"%40","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"5.750 TL − 2.300 TL = 3.450 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"3.450 / 2.300 × 100 = 150"},{"aciklama":"Kâr oranı:","ifade":"%150"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"1e1c86143671","sablon":"mantik.dizi.terim_sirasi","govde":"24, 28, 32, 36, ... biçiminde devam eden dizide 156 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"33","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"34","dogru":true,"yanilgi":null},{"harf":"C","metin":"156","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"39","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"35","dogru":false,"yanilgi":"ardisik_terim_sayisi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"28 − 24 = 4"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 24 + (n − 1)·4"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"156 = 24 + (n − 1)·4 → n = 34"},{"aciklama":"Terimin sırası:","ifade":"34"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.398,"gorsel":null},{"kimlik":"7673b9573554","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç Ankara ile İzmir arasındaki yolu giderken 13 km/sa, dönerken 12 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"12,48 km/sa","dogru":true,"yanilgi":null},{"harf":"B","metin":"6,24 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"C","metin":"12,5 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"25 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"E","metin":"13 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/13 + x/12 = x·(25)/(13·12)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·25/(13·12)] = 2·13·12/25 = 12,48 km/sa"},{"aciklama":"Ortalama hız:","ifade":"12,48 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.814,"gorsel":null},{"kimlik":"0415acc74476","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Bursa şubesindeki personel sayısı, toplam 1.900 personelin yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"%30","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%85","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"%5","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"%15","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bursa şubesinin personel sayısı:","ifade":"285"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam personel.","ifade":"1.900"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"285 / 1.900 × 100 = %15"},{"aciklama":"Toplam içindeki pay:","ifade":"%15"}],"mikrobeceriler":["veri.yuzde_pay","veri.tablo","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.413,"gorsel":{"tur":"tablo","baslik":"Şubelere göre personel sayısı","etiketler":["Konya","Trabzon","Bursa","Ankara"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[950,570,285,95]}]}},{"kimlik":"2dfd4bc13588","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"730A4 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"10","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"B","metin":"4","dogru":true,"yanilgi":null},{"harf":"C","metin":"12","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"},{"harf":"E","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A4 sayısı 4'ün katı olmalı ⟹ 44"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"7 + 3 + 0 + A + 4 = 14 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"4"},{"aciklama":"Bu rakamları topla:","ifade":"4 = 4"},{"aciklama":"Rakamların toplamı:","ifade":"4"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"8d69d9e6f518","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Antalya şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2020 yılından 2023 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"70 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"60 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"140 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"D","metin":"30 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"E","metin":"40 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2020 değeri:","ifade":"280 kişi"},{"aciklama":"2023 değeri:","ifade":"350 kişi"},{"aciklama":"Farkı al:","ifade":"350 − 280 = 70"},{"aciklama":"Artış miktarı:","ifade":"70 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.677,"gorsel":{"tur":"cizgi","baslik":"Antalya şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[280,310,340,350,380]}]}},{"kimlik":"5ec1d76df6ff","sablon":"oran.temel.zincir","govde":"Zeynep'in parasının Ahmet'in parasına oranı 11/8, Ahmet'in parasının Burak'ın parasına oranı 7/11 olarak veriliyor. Buna göre Zeynep'in parasının Burak'ın parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"121/56","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"177/88","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"11/8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"8/7","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"E","metin":"7/8","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortadaki terim ortak olduğu için oranlar zincirlenir:","ifade":"(11/8) × (7/11)"},{"aciklama":"Çarpım sadeleştirilir:","ifade":"77/88 = 7/8"},{"aciklama":"Aranan oran:","ifade":"7/8"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.dogru"],"zorluk":2.291,"gorsel":null},{"kimlik":"04b68c027db0","sablon":"yuzde.kar_zarar.maliyet_bulma","govde":"Bir ürün %75 kârla 9.800 TL fiyatına satılmıştır. Ürünün maliyeti kaç TL'dir?","secenekler":[{"harf":"A","metin":"5.600 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"4.200 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"2.450 TL","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"D","metin":"9.725 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"39.200 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Kâr her zaman maliyet üzerinden hesaplanır; satış fiyatı maliyetin %175'idir:","ifade":"maliyet × 175/100 = 9.800"},{"aciklama":"Maliyet, satış fiyatının bu orana bölümüdür:","ifade":"9.800 × 100/175 = 5.600 TL"},{"aciklama":"Maliyet:","ifade":"5.600 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.672,"gorsel":null},{"kimlik":"ab920a0b3142","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|4x + y − 55| + z = 6\n|4x − 2y − 22| = 2z − 12\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"22","dogru":true,"yanilgi":null},{"harf":"B","metin":"−11","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"−33","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"D","metin":"6","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"28","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 6 − |…| ≤ 6"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 12 ≥ 0 , yani z ≥ 6"},{"aciklama":"İkisi birlikte:","ifade":"z = 6"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"4x + y = 55 , 4x − 2y = 22"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 11 , y = 11"},{"aciklama":"İstenen toplam, x + y:","ifade":"22"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"aeca7be278d5","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Eskişehir şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"30 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"140 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"110 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"60 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"E","metin":"70 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: −70 · 2021→2022: −60 · 2022→2023: 30 · 2023→2024: −10"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2020 → 2021: 230 − 160 = 70 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"70 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.42,"gorsel":{"tur":"cizgi","baslik":"Eskişehir şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[230,160,100,130,120]}]}},{"kimlik":"3ee94e079863","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 6'ya bölümünden kalan 5, 15'e bölümünden kalan 14'tür. Bu koşulu sağlayan ve 661'den büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"674","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"B","metin":"719","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"C","metin":"665","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"D","metin":"691","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"689","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 1 eksik. Demek ki sayıya 1 eklenirse sayı hem 6 hem 15 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(6, 15) = 30"},{"aciklama":"Sayı 30'un katından 1 eksiktir. 661'den büyük ilk böyle sayı:","ifade":"689"},{"aciklama":"Aranan sayı:","ifade":"689"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.149,"gorsel":null},{"kimlik":"e577136238fc","sablon":"mantik.dizi.toplamsal","govde":"28, 37, 65, 102, 167, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"232","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"B","metin":"436","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"C","metin":"269","dogru":true,"yanilgi":null},{"harf":"D","metin":"167","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"334","dogru":false,"yanilgi":"dizi_kurali_eksik"}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"28 + 37 = 65"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"37 + 65 = 102"},{"aciklama":"Son iki terimi topla:","ifade":"102 + 167 = 269"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"269"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"29694dcd256c","sablon":"problem.hareket.yetisme","govde":"Bir araç saatte 88 km sabit hızla yola çıkmıştır. 3 saat sonra aynı noktadan aynı yöne, saatte 121 km sabit hızla ikinci bir araç hareket etmiştir. İkinci araç birinciye kaç saatte yetişir?","secenekler":[{"harf":"A","metin":"8 saat","dogru":true,"yanilgi":null},{"harf":"B","metin":"24/19 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"C","metin":"48/19 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"D","metin":"24/11 saat","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"E","metin":"264 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İkinci araç yola çıktığında aradaki mesafeyi bul:","ifade":"88 × 3 = 264 km"},{"aciklama":"Aynı yöne gittikleri için aradaki mesafe, hızların **farkı** kadar kapanır:","ifade":"121 − 88 = 33 km/sa"},{"aciklama":"Süre, mesafenin yaklaşma hızına bölünmesidir:","ifade":"264 / 33 = 8"},{"aciklama":"Yetişme süresi:","ifade":"8 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"99afcc7e9e53","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"20 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"5 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"C","metin":"200 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"50 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"110 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Dergi ilk kez Şubat döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Kitap 90, Dergi 110","ifade":"110 − 90 = 20"},{"aciklama":"Aradaki fark:","ifade":"20 adet"}],"mikr