me"},{"harf":"D","metin":"21.060 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"E","metin":"1.170 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"18 ay, yıl cinsinden:","ifade":"18/12"},{"aciklama":"Faiz tutarı:","ifade":"46.800 × 45/100 × 18/12 = 31.590 TL"},{"aciklama":"Elde edilen faiz:","ifade":"31.590 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.566,"gorsel":null},{"kimlik":"05744c26926b-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Mehmet'in payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"13.000 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"1.650 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"1.500 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"150 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"E","metin":"1.300 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"5 + 10 + 11 = 26"},{"aciklama":"Bir payın değeri, tutarın pay sayısına bölümüdür:","ifade":"3.900 / 26 = 150 TL"},{"aciklama":"Mehmet bu paylardan 10 tane alır:","ifade":"10 × 150 = 1.500 TL"},{"aciklama":"Mehmet'in payı:","ifade":"1.500 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.472,"gorsel":null,"grup":"05744c26926b","grup_govde":"Bir ikramiye Mustafa, Mehmet ve Buse arasında sırasıyla 5, 10 ve 11 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 3.900 TL'dir."},{"kimlik":"05744c26926b-2","sablon":"oran.blok.paylastirma_uc_soru","govde":"Buse'nin payı, Mustafa'nın payından kaç TL fazladır?","secenekler":[{"harf":"A","metin":"150 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"2.400 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf"