ma_eksik"},{"harf":"B","metin":"18","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"C","metin":"16","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"17","dogru":true,"yanilgi":null},{"harf":"E","metin":"24","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−8x + 168 > 25"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−8x > −143"},{"aciklama":"Her iki tarafı −8 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner: büyüktür işareti küçüktür olur:","ifade":"x < 143/8"},{"aciklama":"Sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"17"},{"aciklama":"En büyük tam sayı:","ifade":"17"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":["cebir.ozdeslik"],"zorluk":2.07,"gorsel":null},{"kimlik":"8233d1d4bf99","sablon":"veri.tablo.satir_toplami","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Ankara'nın yıl boyunca yaptığı toplam satış kaç adettir?","secenekler":[{"harf":"A","metin":"1.185 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"515 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"490 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"4.165 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"830 adet","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Tabloda sorulan satırı bul: Ankara satırı.","ifade":null},{"aciklama":"O satırdaki dört mevsim değerini sırayla oku:","ifade":"İlkbahar: 365 · Yaz: 20 · Sonbahar: 80 · Kış: 25"},{"aciklama":"Dördünü topla:","ifade":"365 + 20 + 80 + 25 = 490"},{"aciklama":"Yıl boyunca yapılan toplam satış:","ifade":"490 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":[],"zorluk":-1.726,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[395,330,325,135]},{"ad":"Samsun","degerler":[375,170,375,285]},{"ad":"İzmir","degerler":[310,215,375,385]},{"ad":"Ankara","degerler":[365,20,80,25]}]}},{"kimlik":"08c2f84ffb82","sablon":"sayilar.bolunebilme.aralikta_sayma","govde":"371 ile 1.258 sayıları arasındaki (ikisi de dâhil) tam sayılardan kaç tanesi 45'e tam bölünür?","secenekler":[{"harf":"A","metin":"177","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"B","metin":"932/45","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"C","metin":"98","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"D","metin":"59","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"E","metin":"19","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"45'e bölünen sayılar 45'in katlarıdır. Aralıktaki ilk ve son katı bul:","ifade":"405 ve 1.215"},{"aciklama":"İki kat arasındaki adım sayısı, katların sayısından bir eksiktir; bu yüzden sona 1 eklenir:","ifade":"(1.215 − 405) / 45 + 1 = 19"},{"aciklama":"Aralıktaki sayı adedi:","ifade":"19"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.esitsizlik"],"zorluk":-0.219,"gorsel":null},{"kimlik":"afd82cb6a5d6","sablon":"kume.sayma.en_az_bir_kosullu","govde":"9 kadın ve 9 erkeğin bulunduğu bir ekipten 4 kişilik bir çalışma grubu seçilecektir. Grupta en az bir kadın bulunması koşuluyla, bu seçim kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"2.934","dogru":true,"yanilgi":null},{"harf":"B","metin":"6.120","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"C","metin":"3.060","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"D","metin":"70.416","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"E","metin":"126","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: önce hiçbir kısıt koymadan say, sonra **istenmeyen** durumları düş. Burada istenmeyen durum, hiç kadın olmaması.","ifade":null},{"aciklama":"Önce koşulsuz seçim sayısı. C(n, r), n kişiden r kişiyi sırasız seçme sayısıdır; burada 18 kişiden 4 kişi:","ifade":"C(18, 4) = (18×17×16×15) / (4×3×2×1) = 3.060"},{"aciklama":"Hiç kadın içermeyen seçimler yalnızca erkeklerden kurulur:","ifade":"C(9, 4) = (9×8×7×6) / (4×3×2×1) = 126"},{"aciklama":"Farkı al:","ifade":"3.060 − 126 = 2.934"},{"aciklama":"Farklı seçim sayısı:","ifade":"2.934"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":["kume.olasilik"],"zorluk":2.176,"gorsel":null},{"kimlik":"8b713ad8ada8","sablon":"veri.tablo.sutun_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre dört şehrin Kış mevsimindeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"432 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"144 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"118 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"195 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"108 adet","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kış sütunundaki dört değeri oku:","ifade":"Eskişehir: 180 · Trabzon: 152 · Konya: 60 · Antalya: 40"},{"aciklama":"Dördünü topla:","ifade":"180 + 152 + 60 + 40 = 432"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölünmesidir; burada dört şehir var:","ifade":"432 / 4 = 108"},{"aciklama":"Ortalama satış:","ifade":"108 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-1.195,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[150,20,115,180]},{"ad":"Trabzon","degerler":[105,185,170,152]},{"ad":"Konya","degerler":[175,325,25,60]},{"ad":"Antalya","degerler":[350,25,180,40]}]}},{"kimlik":"9fd9dbfd8cc4","sablon":"mantik.ozel_islem.ters_cozum","govde":"x ⊕ y = 5x + 4y biçiminde tanımlanan bir işlem için a ⊕ 2 = 53 olduğuna göre a kaçtır?","secenekler":[{"harf":"A","metin":"9","dogru":true,"yanilgi":null},{"harf":"B","metin":"10,75","dogru":false,"yanilgi":"ozel_islem_sira"},{"harf":"C","metin":"8","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"10,6","dogru":false,"yanilgi":"ozel_islem_terim_atlandi"},{"harf":"E","metin":"12,2","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Tanımı olduğu gibi yaz; **sıra önemli**, ilk terim x'in yerinde:","ifade":"a ⊕ 2 = 5a + 4·2"},{"aciklama":"Sonuca eşitle:","ifade":"5a + 8 = 53"},{"aciklama":"a'yı yalnız bırak:","ifade":"5a = 45 → a = 9"},{"aciklama":"Aranan a değeri:","ifade":"9"}],"mikrobeceriler":["mantik.ozel_islem"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.048,"gorsel":null},{"kimlik":"53f3f5b55bae","sablon":"problem.sayi.verme_alma","govde":"Selin, Onur'a fidanlarının 12 tanesini verirse ikisinin fidan sayıları eşit olmaktadır. Onur, Selin'e fidanlarının 12 tanesini verirse Selin'in fidan sayısı Onur'unkinin 2 katı olmaktadır.\n\nBuna göre ikisinin toplam kaç fidanı vardır?","secenekler":[{"harf":"A","metin":"96","dogru":false,"yanilgi":"verme_tek_taraf"},{"harf":"B","metin":"144","dogru":true,"yanilgi":null},{"harf":"C","metin":"84","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"72","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"108","dogru":false,"yanilgi":"verme_farki_tek_sayildi"}],"cozum":[{"aciklama":"Selin 12 tane verince kendisi 12 azalır, Onur 12 artar: aradaki fark 24 kapanır. Eşitlendiklerine göre baştaki fark 24'tür.","ifade":null},{"aciklama":"Onur'un sayısına x dersek Selin'inki x + 24 olur. İkinci koşulda Onur 12 tane verir, Selin 12 tane alır:","ifade":"x + 24 + 12 = 2·(x − 12)"},{"aciklama":"Denklemi çöz:","ifade":"x = 60"},{"aciklama":"Toplam x + (x + 24) olduğuna göre:","ifade":"144"}],"mikrobeceriler":["problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"7c1df6a63e29","sablon":"oran.temel.zincir","govde":"Burak'ın parasının Yusuf'un parasına oranı 9/7, Yusuf'un parasının Ali'nin parasına oranı 3/4 olarak veriliyor. Buna göre Burak'ın parasının Ali'nin parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"27/28","dogru":true,"yanilgi":null},{"harf":"B","metin":"28/27","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"C","metin":"12/7","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"9/7","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"57/28","dogru":false,"yanilgi":"oran_carpim_capraz_hata"}],"cozum":[{"aciklama":"Ortadaki terim ortak olduğu için oranlar zincirlenir:","ifade":"(9/7) × (3/4)"},{"aciklama":"Çarpım sadeleştirilir:","ifade":"27/28 = 27/28"},{"aciklama":"Aranan oran:","ifade":"27/28"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.dogru"],"zorluk":1.346,"gorsel":null},{"kimlik":"e68778cd3824","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 580 TL olan bir sırt çantası 1.450 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%40","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"B","metin":"%60","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%150","dogru":true,"yanilgi":null},{"harf":"D","metin":"%250","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"E","metin":"%870","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"1.450 TL − 580 TL = 870 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"870 / 580 × 100 = 150"},{"aciklama":"Kâr oranı:","ifade":"%150"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"78ba150b9bf1","sablon":"veri.tablo.sutun_yuzde_degisim","govde":"Bir kulübün dört şehirdeki şubelerinin 2024 ve 2025 yıllarındaki üye sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Samsun'da üye sayısı 2024'ten 2025'e yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%60","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"%50","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"%25","dogru":true,"yanilgi":null},{"harf":"E","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Samsun satırındaki iki değeri oku:","ifade":"2024: 240 · 2025: 300"},{"aciklama":"Artış miktarını bul:","ifade":"300 − 240 = 60"},{"aciklama":"Artış oranı **eski** değere bölünür, yeniye değil:","ifade":"60/240 × 100"},{"aciklama":"Artış oranı:","ifade":"%25"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.254,"gorsel":{"tur":"tablo","baslik":"Yıllara göre üye sayısı (kişi)","etiketler":["2024","2025"],"birim":"kişi","seriler":[{"ad":"Samsun","degerler":[240,300]},{"ad":"Trabzon","degerler":[80,120]},{"ad":"Antalya","degerler":[300,420]},{"ad":"Bursa","degerler":[340,460]}]}},{"kimlik":"8b9d085a558d","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"326A8 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"10","dogru":true,"yanilgi":null},{"harf":"B","metin":"15","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"C","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"D","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"},{"harf":"E","metin":"4","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A8 sayısı 4'ün katı olmalı ⟹ 28 ve 88"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"3 + 2 + 6 + A + 8 = 19 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"2 ve 8"},{"aciklama":"Bu rakamları topla:","ifade":"2 + 8 = 10"},{"aciklama":"Rakamların toplamı:","ifade":"10"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"f80a045c69d9","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon şubesindeki personel sayısı, toplam 300 personelin yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%85","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%30","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%10","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"%15","dogru":true,"yanilgi":null},{"harf":"E","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Trabzon şubesinin personel sayısı:","ifade":"45"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam personel.","ifade":"300"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"45 / 300 × 100 = %15"},{"aciklama":"Toplam içindeki pay:","ifade":"%15"}],"mikrobeceriler":["veri.yuzde_pay","veri.tablo","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.413,"gorsel":{"tur":"tablo","baslik":"Şubelere göre personel sayısı","etiketler":["Samsun","Antalya","Trabzon","İzmir"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[150,75,45,30]}]}},{"kimlik":"429f7fb46f95","sablon":"oran.ters.hiz_sure","govde":"Bir araç Eskişehir ile Konya arasını saatte 150 km hızla 14 saatte almaktadır. Aynı yolu saatte 60 km hızla giden bir araç kaç saatte alır?","secenekler":[{"harf":"A","metin":"35 saat","dogru":true,"yanilgi":null},{"harf":"B","metin":"21 saat","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"23 saat","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"D","metin":"5,6 saat","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"E","metin":"14 saat","dogru":false,"yanilgi":"ters_orantida_carpan_bolen"}],"cozum":[{"aciklama":"Sabit yolda hız ile süre ters orantılıdır; yol çarpımlarıdır:","ifade":"150 × 14 = 2.100 km"},{"aciklama":"Yeni süre, aynı yolun yeni hıza bölümüdür:","ifade":"2.100 / 60 = 35 saat"},{"aciklama":"Geçen süre:","ifade":"35 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":null},{"kimlik":"12ee76e8f7e3","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, tanesini 1.800 TL maliyetle aldığı bir buzdolabı çeşidini %30 kârla satmaktadır. Buna göre buzdolabının satış fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.830 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"55.800 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"1.260 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"540 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.340 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr yüzdesi her zaman maliyet üzerinden hesaplanır:","ifade":"1.800 × 30/100 = 540 TL"},{"aciklama":"Satış fiyatı maliyet ile kârın toplamıdır:","ifade":"1.800 + 540 = 2.340 TL"},{"aciklama":"Satış fiyatı:","ifade":"2.340 TL"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.artis_azalis"],"yanilgi_alanlari":[],"zorluk":-1.069,"gorsel":null},{"kimlik":"dfbf88c79b13","sablon":"cebir.ozdeslik.iki_kare_farki","govde":"141² − 130² işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"1.551","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"B","metin":"36.781","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"2.981","dogru":true,"yanilgi":null},{"harf":"D","metin":"121","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"−2.981","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(141 − 130)(141 + 130) = 11 × 271"},{"aciklama":"Çarpımı yap:","ifade":"11 × 271 = 2.981"},{"aciklama":"İşlemin sonucu:","ifade":"2.981"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.019,"gorsel":null},{"kimlik":"9486a6bcb301","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 6'ya bölümünden kalan 2, 9'a bölümünden kalan 5'tir. Bu koşulu sağlayan ve 158'den büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"167","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"B","metin":"212","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"C","metin":"164","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"D","metin":"166","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"176","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 4 eksik. Demek ki sayıya 4 eklenirse sayı hem 6 hem 9 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(6, 9) = 18"},{"aciklama":"Sayı 18'in katından 4 eksiktir. 158'den büyük ilk böyle sayı:","ifade":"176"},{"aciklama":"Aranan sayı:","ifade":"176"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.24,"gorsel":null},{"kimlik":"f3bcda92ad14","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün İzmir şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2016 yılından 2018 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"30 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"100 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"310 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"},{"harf":"D","metin":"50 kişi","dogru":true,"yanilgi":null},{"harf":"E","metin":"40 kişi","dogru":false,"yanilgi":"grafik_artis_egim"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2016 değeri:","ifade":"260 kişi"},{"aciklama":"2018 değeri:","ifade":"310 kişi"},{"aciklama":"Farkı al:","ifade":"310 − 260 = 50"},{"aciklama":"Artış miktarı:","ifade":"50 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":-0.765,"gorsel":{"tur":"cizgi","baslik":"İzmir şubesinin yıllık üye sayısı","etiketler":["2016","2017","2018","2019","2020"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[260,290,310,290,330]}]}},{"kimlik":"50cb0bb8ce27","sablon":"mantik.sifreleme.artan_kaydirma","govde":"Bir şifrelemede ŞAPKA kelimesi YFVSH biçiminde yazılmaktadır. Aynı kurala göre ÇORAP kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"ĞTYĞZ","dogru":true,"yanilgi":null},{"harf":"B","metin":"YİKSI","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"C","metin":"JÜYFU","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"D","metin":"HUZHA","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"E","metin":"ĞŞÜEU","dogru":false,"yanilgi":"sifreleme_sabit_kaydirma"}],"cozum":[{"aciklama":"Örnekteki harfleri tek tek karşılaştır ve her harfin alfabede kaç sıra ilerlediğini yaz:","ifade":"Ş→Y (5) , A→F (6) , P→V (7) , K→S (8) , A→H (9)"},{"aciklama":"Kaydırma sabit değil; her harfte bir artıyor:","ifade":"5, 6, 7, 8, 9"},{"aciklama":"Aynı kaydırmaları ÇORAP kelimesine uygula:","ifade":"Ç→Ğ , O→T , R→Y , A→Ğ , P→Z"},{"aciklama":"Şifrelenmiş kelime:","ifade":"ĞTYĞZ"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.034,"gorsel":null},{"kimlik":"291801ac569e","sablon":"problem.yas.kat_iliskisi","govde":"Buse'nin yaşı bugün Ahmet'in yaşının 4 katıdır. 34 yıl sonra Buse'nin yaşı Ahmet'in yaşının 2 katı olacaktır. Buna göre Buse bugün kaç yaşındadır?","secenekler":[{"harf":"A","metin":"51","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"136","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"C","metin":"85","dogru":false,"yanilgi":"yas_toplam_fark_karisimi"},{"harf":"D","metin":"102","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"E","metin":"68","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ahmet'in bugünkü yaşına x dersek, Buse'nin yaşı 4x olur.","ifade":null},{"aciklama":"34 yıl sonra ikisi de 34 yaş büyür; fark değişmez:","ifade":"4x + 34 = 2·(x + 34)"},{"aciklama":"Denklemi çöz:","ifade":"4x + 34 = 2x + 68  ⟹  2x = 34  ⟹  x = 17"},{"aciklama":"Buse'nin bugünkü yaşı bunun 4 katıdır:","ifade":"4 × 17 = 68"},{"aciklama":"Buse bugün:","ifade":"68"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.149,"gorsel":null},{"kimlik":"3eabdd022540","sablon":"veri.grafik.cizgi_en_buyuk_dusus","govde":"Bir spor kulübünün Ankara şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre ardışık iki yıl arasında üye sayısındaki en büyük düşüş kaç kişidir?","secenekler":[{"harf":"A","metin":"80 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"40 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"150 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"D","metin":"210 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"720 kişi","dogru":false,"yanilgi":"degisim_yerine_deger"}],"cozum":[{"aciklama":"Ardışık yıllar arasındaki değişimi yaz (yeni − eski); eksi işareti düşüş demek:","ifade":"2020→2021: 150 · 2021→2022: 40 · 2022→2023: 60 · 2023→2024: −40"},{"aciklama":"En büyük düşüş, en çok eksiye giden değişimdir:","ifade":"2023 → 2024: 720 − 680 = 40 kişi düşüş"},{"aciklama":"En büyük düşüş:","ifade":"40 kişi"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":[],"zorluk":0.356,"gorsel":{"tur":"cizgi","baslik":"Ankara şubesinin yıllık üye sayısı","etiketler":["2020","2021","2022","2023","2024"],"birim":"kişi","seriler":[{"ad":"Üye","degerler":[470,620,660,720,680]}]}},{"kimlik":"cd757b2e043f","sablon":"oran.ters.kapasite_arac","govde":"Bir depodaki yükün tamamı, her biri 7 ton taşıyan 36 kamyonla bir seferde taşınmaktadır. Aynı yük, her biri 21 ton taşıyan kamyonlarla bir seferde taşınsaydı kaç kamyon gerekirdi?","secenekler":[{"harf":"A","metin":"12 kamyon","dogru":true,"yanilgi":null},{"harf":"B","metin":"22 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"},{"harf":"C","metin":"108 kamyon","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"D","metin":"252 kamyon","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"50 kamyon","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"}],"cozum":[{"aciklama":"Taşınan yük değişmiyor; değişen yalnızca onu kaç araca böldüğümüz. Araç sayısı ile kapasite **ters** orantılıdır, yani çarpımları sabittir.","ifade":null},{"aciklama":"Toplam yükü bul:","ifade":"36 × 7 = 252 ton"},{"aciklama":"Yeni kapasiteye böl:","ifade":"252 / 21 = 12"},{"aciklama":"Gereken kamyon sayısı:","ifade":"12 kamyon"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":-0.472,"gorsel":null},{"kimlik":"dc5f66c0ce91","sablon":"yuzde.temel.iki_yuzde_farki","govde":"900 sayısının %60'ı ile %36'sı arasındaki fark kaçtır?","secenekler":[{"harf":"A","metin":"540","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"864","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"2.160","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"24","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"216","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayının %60'ını al:","ifade":"900 × 60/100 = 540"},{"aciklama":"Sayının %36'sını al:","ifade":"900 × 36/100 = 324"},{"aciklama":"İki sonucun farkını al (yüzdelerin farkı doğrudan cevap değil, o farkın sayıdaki karşılığı sorulmuş):","ifade":"540 − 324 = 216"},{"aciklama":"Aradaki fark:","ifade":"216"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":-0.677,"gorsel":null},{"kimlik":"09adfa8836ea","sablon":"sayilar.ebob_ekok.bulusma","govde":"Bir duraktan A hattı 45 dakikada bir, B hattı 10 dakikada bir kalkmaktadır. İki hat sabah aynı anda kalktığına göre, en az kaç dakika sonra tekrar aynı anda kalkarlar?","secenekler":[{"harf":"A","metin":"180 dakika","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"55 dakika","dogru":false,"yanilgi":"ebob_ekok_toplama"},{"harf":"C","metin":"450 dakika","dogru":false,"yanilgi":"ebob_ekok_carpim"},{"harf":"D","metin":"90 dakika","dogru":true,"yanilgi":null},{"harf":"E","metin":"5 dakika","dogru":false,"yanilgi":"ebob_ekok_karisimi"}],"cozum":[{"aciklama":"İki hattın aynı anda kalkması, kalkış aralıklarının ortak katıdır. 'En az' istendiği için EKOK alınır.","ifade":null},{"aciklama":"45 ve 10 sayılarının EKOK'u:","ifade":"EKOK(45, 10) = 90"},{"aciklama":"Tekrar birlikte kalkış süresi:","ifade":"90 dakika"}],"mikrobeceriler":["sayilar.ebob_ekok"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":null},{"kimlik":"d9481dda5edf","sablon":"veri.grafik.cizgi_iki_seri_kesisim","govde":"Bir mağazanın dört ayda sattığı Kitap ve Dergi sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre Dergi satışının Kitap satışını ilk kez geçtiği ayda iki ürün arasındaki fark kaç adettir?","secenekler":[{"harf":"A","metin":"155 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"250 adet","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"15 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"D","metin":"60 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"5 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Her ay için iki seriyi karşılaştır; Dergi ilk kez Mart döneminde öne geçiyor.","ifade":null},{"aciklama":"O dönemdeki değerler: Kitap 95, Dergi 155","ifade":"155 − 95 = 60"},{"aciklama":"Aradaki fark:","ifade":"60 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":0.313,"gorsel":{"tur":"cizgi","baslik":"Kitap ve Dergi satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[135,115,95,75]},{"ad":"Dergi","degerler":[65,110,155,200]}]}},{"kimlik":"21a09ca589dc","sablon":"mantik.sifreleme.cozme","govde":"Bir şifrelemede ELMA kelimesi LTUH biçiminde yazılmaktadır. Aynı kurala göre ÖHTP biçiminde yazılan kelime aşağıdakilerden hangisidir?","secenekler":[{"harf":"A","metin":"HZJG","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"B","metin":"YÖÇZ","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"C","metin":"ĞZKH","dogru":false,"yanilgi":"harf_sira_kaydi"},{"harf":"D","metin":"IBMİ","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"E","metin":"HALI","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Örnekten kaydırma miktarını bul; bütün harflerde aynı çıkmalı:","ifade":"E→L , L→T , M→U , A→H  ⟹ 9 sıra ileri"},{"aciklama":"Şifreyi çözmek, kuralı **ters** yönde uygulamaktır: her harf 9 sıra geri alınır.","ifade":null},{"aciklama":"Harfleri geri al:","ifade":"Ö→H , H→A , T→L , P→I"},{"aciklama":"Aranan kelime:","ifade":"HALI"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":1.604,"gorsel":null},{"kimlik":"5eb746e161f2","sablon":"problem.yas.toplam_iliskisi","govde":"Kerem ile Ayşe'nin bugünkü yaşları toplamı 82'dir, aralarındaki yaş farkı ise 8'dir.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"90","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"B","metin":"45","dogru":true,"yanilgi":null},{"harf":"C","metin":"61","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"D","metin":"53","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"E","metin":"37","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda b