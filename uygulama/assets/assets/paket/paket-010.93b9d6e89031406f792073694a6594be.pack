ilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.036,"gorsel":null},{"kimlik":"f9865a2517dd","sablon":"mantik.dizi.sabit_fark","govde":"14, 24, 34, 44, 54, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"54","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"64","dogru":true,"yanilgi":null},{"harf":"C","metin":"44","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"74","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"E","metin":"63","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"24−14=10 , 34−24=10 , 44−34=10 , 54−44=10"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerliyor:","ifade":"fark = 10"},{"aciklama":"Son terime bu farkı ekle:","ifade":"54 + 10 = 64"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"64"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"87bb2feb2619","sablon":"problem.isci.ek_isci","govde":"20 işçi bir işi 20 günde bitirmektedir. Aynı iş 16 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"16 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"4 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"C","metin":"5 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"36 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"E","metin":"25 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"20 × 20 = 400"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"400 / 16 = 25"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"25 − 20 = 5"},{"aciklama":"Gereken ek işçi:","ifade":"5 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.381,"gorsel":null},{"kimlik":"6a3783ca87fe","sablon":"oran.paylastirma.artan_pay","govde":"1.970 TL paranın bir kısmı Fatma'ya ve Zeynep'e 3 : 7 oranında dağıtılmış, Fatma'nın payı 540 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"197 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"3.770 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"170 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"445 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"1.260 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Fatma'nın payından birim payı çöz:","ifade":"3k = 540 → k = 180"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(3 + 7) × 180 = 1.800 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"1.970 − 1.800 = 170 TL"},{"aciklama":"Geriye kalan:","ifade":"170 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":3.35,"gorsel":null},{"kimlik":"208d2958afac","sablon":"yuzde.artis.zam","govde":"Fiyatı 2.300 TL olan bir gömlek, %16 zamlanmıştır. Zamdan sonra gömleğin fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"2.668 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"1.932 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"39.100 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"368 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.316 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"2.300 × 16/100 = 368 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"2.300 + 368 = 2.668 TL"},{"aciklama":"Zamlı fiyat:","ifade":"2.668 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.242,"gorsel":null},{"kimlik":"5c4c4fc9fdd4","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 16 kişilik A grubunun puan ortalaması 86, 24 kişilik B grubunun puan ortalaması 66 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"152","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"74","dogru":true,"yanilgi":null},{"harf":"C","metin":"76","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"2.960","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"185","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 16 × 86","ifade":"1.376"},{"aciklama":"B grubu: 24 × 66","ifade":"1.584"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"2.960 / 40 = 74"},{"aciklama":"Ortak ortalama:","ifade":"74"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.495,"gorsel":null},{"kimlik":"198771b5b2fa","sablon":"sayilar.uslu.us_kurallari","govde":"(3⁴)³ · (3⁵)³ : 3⁹ işleminin sonucu, 3 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"171","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"B","metin":"18","dogru":true,"yanilgi":null},{"harf":"C","metin":"−27","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"D","metin":"36","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"6","dogru":false,"yanilgi":"us_us_toplandi"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(3⁴)³ = 3¹² , (3⁵)³ = 3¹⁵"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"3¹² · 3¹⁵ = 3²⁷"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"3²⁷ : 3⁹ = 3¹⁸"},{"aciklama":"Aranan kuvvet:","ifade":"18"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.902,"gorsel":null},{"kimlik":"95a43be13b0b","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 24 kişilik bir grubun yaş ortalaması 85, ikinci bir grubun yaş ortalaması ise 60'tır. İki grup birleştiğinde yaş ortalaması 70 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"60 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"24 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"25 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"34 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"36 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"24·85 + n·60"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(24·85 + n·60) / (24 + n) = 70"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"24·(85 − 70) = n·(70 − 60)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"36 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.589,"gorsel":null},{"kimlik":"b2a19be27ba3","sablon":"cebir.denklem.kesirli","govde":"(x + 16)/7 − (x − 21)/8 = 5 denkleminde x kaçtır?","secenekler":[{"harf":"A","metin":"299","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"−270","dogru":false,"yanilgi":"dagitma_eksik"},{"harf":"C","metin":"5","dogru":true,"yanilgi":null},{"harf":"D","metin":"1/3","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"E","metin":"21","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Paydaların EKOK'u 56; denklemin *her* terimi bu sayıyla çarpılır:","ifade":"EKOK(7, 8) = 56"},{"aciklama":"Çarpımdan sonra parantezleri dağıt; ikinci parantezin önündeki eksi içerideki her terimin işaretini çevirir:","ifade":"8(x + 16) − 7(x − 21) = 280"},{"aciklama":"Benzer terimleri topla:","ifade":"x + 275 = 280"},{"aciklama":"x'i yalıt:","ifade":"x = 5 / 1 = 5"},{"aciklama":"x değeri:","ifade":"5"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":[],"zorluk":3.409,"gorsel":null},{"kimlik":"1314d3f97c9a","sablon":"oran.paylastirma.fark","govde":"5.850 TL tutarındaki bir ödül, Buse ile Onur arasında 3/10 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"5.850 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"1.350 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"3.150 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"4.500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"2.925 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"3 + 10 = 13"},{"aciklama":"Bir parçanın değeri:","ifade":"5.850 / 13 = 450 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(10 − 3) × 450 = 3.150 TL"},{"aciklama":"Aradaki fark:","ifade":"3.150 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"cabbd0807b2c","sablon":"yuzde.faiz.anapara","govde":"Yıllık %25 basit faiz oranıyla 20 ay vadeye yatırılan bir anapara 16.000 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"64.000 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"1.920 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"38.400 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"54.400 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"3.200 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"20 ay için faiz katsayısı:","ifade":"25/100 × 20/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"16.000 / (25 × 20/1200) = 38.400 TL"},{"aciklama":"Anapara:","ifade":"38.400 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_ala