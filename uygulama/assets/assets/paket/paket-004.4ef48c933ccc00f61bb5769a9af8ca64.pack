tirma"],"zorluk":0.417,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[265,8]},{"ad":"Samsun","degerler":[290,40]},{"ad":"Eskişehir","degerler":[105,38]},{"ad":"İzmir","degerler":[270,10]}]}},{"kimlik":"5b648c18868b","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 30 ve a · b = 160 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"1.220","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"B","metin":"260","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"C","metin":"900","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"580","dogru":true,"yanilgi":null},{"harf":"E","metin":"740","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"30² − 2 × 160 = 900 − 320 = 580"},{"aciklama":"a² + b² değeri:","ifade":"580"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"9bf2903dc1ec","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Sonbahar mevsiminde Trabzon'un yaptığı satışın Konya'nın yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"2,5","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"0,4","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"60","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"0,5","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"2","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sonbahar sütunundan iki değeri oku:","ifade":"Trabzon: 120 · Konya: 60"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"120 / 60 = 2"},{"aciklama":"Aranan oran:","ifade":"2"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[110,110,60,20]},{"ad":"Eskişehir","degerler":[120,30,30,80]},{"ad":"Samsun","degerler":[50,70,50,80]},{"ad":"Trabzon","degerler":[60,30,120,50]}]}},{"kimlik":"8e2085691582","sablon":"sayilar.basamak.sifir_ekleme","govde":"Üç basamaklı bir sayının sağına 0 yazılarak yeni bir sayı elde ediliyor. Yeni sayı ilk sayıdan 7.461 fazla olduğuna göre, yeni sayı kaçtır?","secenekler":[{"harf":"A","metin":"7.461","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"B","metin":"82.900","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"C","metin":"829","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"839","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"E","metin":"8.290","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 7.461"},{"aciklama":"İlk sayı:","ifade":"x = 7.461 / 9 = 829"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 829 = 8.290"},{"aciklama":"Yeni sayı:","ifade":"8.290"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.552,"gorsel":null},{"kimlik":"0a88330fac89","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 2 : 12 : 7 oranındadır. İkinci arkadaşın parası 648 TL olduğuna göre birinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"2 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"B","metin":"108 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"378 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"54 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"3.888 TL","dogru":false,"yanilgi":"oran_terslendi"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"2k : 12k : 7k"},{"aciklama":"Bilinen paydan k'yı çöz (ikinci arkadaş):","ifade":"12k = 648 → k = 54"},{"aciklama":"Sorulan payı k ile çarp (birinci arkadaş):","ifade":"2 × 54 = 108"},{"aciklama":"Birinci arkadaşın parası:","ifade":"108 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.313,"gorsel":null},{"kimlik":"9af5ebb8425d","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 2.600 TL olan bir klavye %25 kârla, maliyeti 3.500 TL olan bir valiz ise %15 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"125 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"650 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"10 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"1.175 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"610 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"2.600 × 25/100 = 650 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"3.500 × 15/100 = 525 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"650 − 525 = 125 TL"},{"aciklama":"Net kâr:","ifade":"125 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":2.393,"gorsel":null},{"kimlik":"f526152d1a11","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Buse, Emre, Fatma ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Ahmet ile Emre yan yana oturmamaktadır.\n• Yusuf uçtaki koltuklarda oturmamaktadır.\n• Fatma, Buse adlı kişinin solunda oturmaktadır.\n• Emre, Fatma adlı kişinin hemen solundadır.\n• Emre uçtaki koltuklarda oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Yusuf, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"B","metin":"Yusuf, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"C","metin":"Fatma, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"D","metin":"Yusuf, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"E","metin":"Emre, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Ahmet − Yusuf − Emre − Fatma − Buse"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Yusuf, Ahmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"638ea97345ad","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İzmir'in yıllık toplam satışı, Trabzon'un yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"340 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"635 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"C","metin":"285 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"1.040 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"1.740 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"İzmir satırını topla:","ifade":"320 + 145 + 280 + 295 = 1.040"},{"aciklama":"Trabzon satırını topla:","ifade":"225 + 175 + 25 + 275 = 700"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"1.040 − 700 = 340"},{"aciklama":"Aradaki fark:","ifade":"340 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.448,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[320,145,280,295]},{"ad":"Bursa","degerler":[310,295,75,215]},{"ad":"Eskişehir","degerler":[325,135,320,110]},{"ad":"Trabzon","degerler":[225,175,25,275]}]}},{"kimlik":"00e4c08c39eb","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil Konya'ya giderken yolun ilk bölümünü saatte 110 km hızla 3 saatte, kalan bölümünü saatte 50 km hızla 2 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"430 km","dogru":true,"yanilgi":null},{"harf":"B","metin":"400 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"370 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"D","metin":"330 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"250 km","dogru":false,"yanilgi":"hareket_yavas_arac"}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"110 × 3 = 330 km"},{"aciklama":"İkinci bölüm:","ifade":"50 × 2 = 100 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"330 + 100 = 430 km"},{"aciklama":"Toplam yol:","ifade":"430 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.555,"gorsel":null},{"kimlik":"603286263c22","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 693 azalmaktadır. Bu sayının yüzler basamağındaki rakam 8, onlar basamağındaki rakam 5'tir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"158","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"B","metin":"806","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"C","metin":"81","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"D","metin":"815","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"E","metin":"851","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (8 − b) = 693 ⟹ 8 − b = 7 ⟹ b = 1"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 8 + 10 × 5 + 1 = 851"},{"aciklama":"Aranan sayı:","ifade":"851"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":0.381,"gorsel":null},{"kimlik":"1751e01079ac","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan ayva, kiraz ve elmanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 120 kilogram satılmış ve toplam 80 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram ayva ve elma satılmıştır?","secenekler":[{"harf":"A","metin":"20","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"115","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"100","dogru":true,"yanilgi":null},{"harf":"D","metin":"80","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"112","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Ayva: 2,1 − 1,5 = 0,6 TL, Kiraz: 5,5 − 4,5 = 1 TL, Elma: 4,6 − 4 = 0,6 TL.","ifade":null},{"aciklama":"Ayva ile elmanın kilogram kârı aynı. Hepsi 0,6 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"120 · 0,6 = 72 TL"},{"aciklama":"Fazladan 8 TL yalnızca kiraz yüzünden: onun her kilogramı 0,4 TL fazla kazandırıyor.","ifade":"kiraz = 8 ÷ 0,4 = 20 kg"},{"aciklama":"İstenen: 120 − 20 =","ifade":"100"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Ayva","degerler":[1.5,2.1]},{"ad":"Kiraz","degerler":[4.5,5.5]},{"ad":"Elma","degerler":[4.0,4.6]}]}},{"kimlik":"de68b1e4da5f","sablon":"oran.temel.zincir","govde":"Buse'nin parasının Burak'ın parasına oranı 6/11, Burak'ın parasının Onur'un parasına oranı 13/6 olarak veriliyor. Buna göre Buse'nin parasının Onur'un parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"36/143","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"179/66","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"11/13","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"D","metin":"13/11","dogru":true,"yanilgi":null},{"harf":"E","metin":"6/11","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ortadaki terim ortak olduğu için oranlar zincirlenir:","ifade":"(6/11) × (13/6)"},{"aciklama":"Çarpım sadeleştirilir:","ifade":"78/66 = 13/11"},{"aciklama":"Aranan oran:","ifade":"13/11"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.dogru"],"zorluk":2.034,"gorsel":null},{"kimlik":"9363db8551cb","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 2.720 TL olan bir çanta 3.400 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%680","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"%80","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%25","dogru":true,"yanilgi":null},{"harf":"E","metin":"%125","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"3.400 TL − 2.720 TL = 680 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"680 / 2.720 × 100 = 25"},{"aciklama":"Kâr oranı:","ifade":"%25"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"037a355aaa0f","sablon":"kume.olasilik.en_az_bir","govde":"Bir torbada 14 tane beyaz, 5 tane kırmızı top vardır. Torbadan rastgele bir top çekilip rengine bakıldıktan sonra geri konuluyor. Bu işlem 2 kez tekrarlandığına göre, çekilen toplardan en az birinin beyaz olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"161/171","dogru":false,"yanilgi":"olasilik_bagimsiz_sanildi"},{"harf":"B","metin":"140/361","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"C","metin":"28/19","dogru":false,"yanilgi":"olasilik_toplam_bir_asildi"},{"harf":"D","metin":"336/361","dogru":true,"yanilgi":null},{"harf":"E","metin":"25/361","dogru":false,"yanilgi":"olasilik_istenen_tum_ters"}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: istenenin **tam tersini** hesapla, yani hiçbirinin istenen renkte olmama olasılığını. Bu ikisi birlikte 1 eder.","ifade":null},{"aciklama":"Top geri konulduğu için her çekiliş bağımsızdır ve kırmızı gelme olasılığı hep aynıdır:","ifade":"(5/19)² = 25/361"},{"aciklama":"İstenen olasılık, bunun 1'den farkıdır:","ifade":"1 − 25/361 = 336/361"},{"aciklama":"İstenen olasılık:","ifade":"336/361"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":[],"zorluk":2.858,"gorsel":null},{"kimlik":"f0689d10a78e","sablon":"veri.tablo.satir_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Eskişehir'in dört mevsimdeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"354 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"B","metin":"1.080 adet","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"315 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"270 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"360 adet","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Eskişehir satırındaki dört değeri topla:","ifade":"332 + 76 + 336 + 336 = 1.080"},{"aciklama":"Ortalama, toplamın **terim sayısına** bölümüdür; burada dört mevsim var:","ifade":"1.080 / 4 = 270"},{"aciklama":"Satır ortalaması:","ifade":"270 adet"}],"mikrobeceriler":["veri.tablo","veri.ortalama"],"yanilgi_alanlari":[],"zorluk":-1.041,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[332,76,336,336]},{"ad":"Konya","degerler":[300,360,315,285]},{"ad":"Samsun","degerler":[255,215,140,355]},{"ad":"Bursa","degerler":[125,190,385,25]}]}},{"kimlik":"1e23266ab8fa","sablon":"mantik.esleme.yanlis_ifade","govde":"Ahmet, Buse, Elif, Kerem ve Onur adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Elif, Kerem adlı kişinin solunda oturmaktadır.\n• Elif uçtaki koltuklarda oturmamaktadır.\n• Onur, Buse adlı kişinin hemen solundadır.\n• Ahmet, Elif adlı kişinin solunda oturmaktadır.\n• Ahmet uçtaki koltuklarda oturmamaktadır.\n\nBuna göre aşağıdakilerden hangisi yanlıştır?","secenekler":[{"harf":"A","metin":"Elif, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"},{"harf":"B","metin":"Onur, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"C","metin":"Ahmet ortadaki koltukta oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"D","metin":"Ahmet, Buse adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"E","metin":"Kerem, Elif adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"}],"cozum":[{"aciklama":"Önce kısıtları birleştirip dizilimi bul; 'hangisi yanlıştır' sorusu ancak dizilim tek türlü belirlendiğinde yanıtlanır.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Onur − Buse − Ahmet − Elif − Kerem"},{"aciklama":"Şıkları bu dizilimle karşılaştır; dördü doğrulanır, biri doğrulanmaz.","ifade":null},{"aciklama":"Yanlış olan ifade:","ifade":"Onur, Buse adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"ae78b073dae9","sablon":"problem.hareket.ortalama_hiz","govde":"Bir araç İzmir ile Bursa arasındaki yolu giderken 110 km/sa, dönerken 66 km/sa sabit hızla almıştır. Buna göre aracın gidiş-dönüş ortalama hızı kaç km/sa'tır?","secenekler":[{"harf":"A","metin":"110 km/sa","dogru":false,"yanilgi":"hareket_tek_hiz"},{"harf":"B","metin":"88 km/sa","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"82,5 km/sa","dogru":true,"yanilgi":null},{"harf":"D","metin":"41,25 km/sa","dogru":false,"yanilgi":"ortalama_hiz_iki_carpani_dustu"},{"harf":"E","metin":"176 km/sa","dogru":false,"yanilgi":"hiz_toplama_yonu"}],"cozum":[{"aciklama":"Ortalama hız, hızların ortalaması değil; toplam yolun toplam süreye bölümüdür. Yola x dersek toplam yol 2x olur.","ifade":null},{"aciklama":"Toplam süre:","ifade":"x/110 + x/66 = x·(176)/(110·66)"},{"aciklama":"Ortalama hız:","ifade":"2x ÷ [x·176/(110·66)] = 2·110·66/176 = 82,5 km/sa"},{"aciklama":"Ortalama hız:","ifade":"82,5 km/sa"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.798,"gorsel":null},{"kimlik":"f6869924e2db","sablon":"sayilar.bolme.bolunen_bulma","govde":"Bir doğal sayının 13 ile bölümünden elde edilen bölüm 11, kalan ise 12'dir. Buna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"167","dogru":false,"yanilgi":"kalan_bolen_karisimi"},{"harf":"B","metin":"299","dogru":false,"yanilgi":"kalan_bolume_eklendi"},{"harf":"C","metin":"131","dogru":false,"yanilgi":"kalan_cikarildi"},{"harf":"D","metin":"155","dogru":true,"yanilgi":null},{"harf":"E","metin":"143","dogru":false,"yanilgi":"kalan_sifir_sayildi"}],"cozum":[{"aciklama":"Bölmenin temel eşitliği: bölünen = bölen × bölüm + kalan.","ifade":null},{"aciklama":"Değerleri yerine koy:","ifade":"13 × 11 + 12 = 143 + 12 = 155"},{"aciklama":"Kalan (12) bölenden (13) küçük olduğu için bölme geçerlidir.","ifade":null},{"aciklama":"Aranan sayı:","ifade":"155"}],"mikrobeceriler":["sayilar.bolme"],"yanilgi_alanlari":[],"zorluk":-1.972,"gorsel":null},{"kimlik":"ccee83c6f923","sablon":"veri.tablo.satir_toplami","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Eskişehir'in yıl boyunca yaptığı toplam satış kaç adettir?","secenekler":[{"harf":"A","metin":"830 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"980 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"555 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"815 adet","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"1.105 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"}],"cozum":[{"aciklama":"Tabloda sorulan satırı bul: Eskişehir satırı.","ifade":null},{"aciklama":"O satırdaki dört mevsim değerini sırayla oku:","ifade":"İlkbahar: 70 · Yaz: 210 · Sonbahar: 275 · Kış: 275"},{"aciklama":"Dördünü topla:","ifade":"70 + 210 + 275 + 275 = 830"},{"aciklama":"Yıl boyunca yapılan toplam satış:","ifade":"830 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":[],"zorluk":-0.901,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Trabzon","degerler":[60,280,310,330]},{"ad":"Samsun","degerler":[30,295,100,165]},{"ad":"İzmir","degerler":[240,30,135,65]},{"ad":"Eskişehir","degerler":[70,210,275,275]}]}},{"kimlik":"19f3301759bd","sablon":"oran.ters.hiz_sure","govde":"Bir araç Konya ile Antalya arasını saatte 40 km hızla 16 saatte almaktadır. Aynı yolu saatte 80 k