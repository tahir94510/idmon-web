in":"8.064","dogru":false,"yanilgi":"gidis_donus_ayri_sayildi"}],"cozum":[{"aciklama":"Gidişte her ayakta bağımsız seçim yapılır; sayılar çarpılır:","ifade":"3 × 8 × 4 = 96"},{"aciklama":"Dönüşte her ayakta bir yol kullanılmış durumdadır:","ifade":"2 × 7 × 3 = 42"},{"aciklama":"Gidiş ve dönüş peş peşe yapıldığı için çarpılır:","ifade":"96 × 42 = 4.032"},{"aciklama":"Yolculuğun yapılabileceği biçim sayısı:","ifade":"4.032"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"5902e550b838","sablon":"veri.grafik.sutun_fark","govde":"Bir işletmenin dört şubede sattığı Telefon ve Tablet sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre D şubesinde satılan Telefon sayısı, aynı şubede satılan Tablet sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"40 adet","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"65 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"5 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"130 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"115 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Önce sorunun istediği şube işaretle: D şubesi.","ifade":null},{"aciklama":"Telefon sütununu oku:","ifade":"90 adet"},{"aciklama":"Tablet sütununu oku:","ifade":"25 adet"},{"aciklama":"İki değerin farkını al:","ifade":"90 − 25 = 65"},{"aciklama":"Aradaki fark:","ifade":"65 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.988,"gorsel":{"tur":"sutun","baslik":"Telefon ve Tablet satışları (adet)","etiketler":["A şubesi","B şubesi","C şubesi","D şubesi"],"birim":"adet","seriler":[{"ad":"Telefon","degerler":[90,50,50,90]},{"ad":"Tablet","degerler":[35,45,70,25]}]}},{"kimlik":"d71e33f47a1f","sablon":"sayilar.rasyonel.islem_onceligi","govde":"15 + 1/3 × 7/9 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"322/27","dogru":false,"yanilgi":"islem_oncelig