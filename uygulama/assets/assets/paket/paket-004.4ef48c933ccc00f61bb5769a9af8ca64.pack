f":"C","metin":"529","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"D","metin":"8.119","dogru":true,"yanilgi":null},{"harf":"E","metin":"62.569","dogru":false,"yanilgi":"iki_kare_farki_toplam"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(188 − 165)(188 + 165) = 23 × 353"},{"aciklama":"Çarpımı yap:","ifade":"23 × 353 = 8.119"},{"aciklama":"İşlemin sonucu:","ifade":"8.119"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.334,"gorsel":null},{"kimlik":"8885135cd74c","sablon":"mantik.dizi.sabit_oran","govde":"5, 15, 45, 135, 405, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"135","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"B","metin":"675","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"405","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"D","metin":"1.215","dogru":true,"yanilgi":null},{"harf":"E","metin":"3.645","dogru":false,"yanilgi":"dizi_bir_adim_fazla"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farklar sabit değil; oranlara bak:","ifade":"15÷5=3 , 45÷15=3 , 135÷45=3 , 405÷135=3"},{"aciklama":"Oran her adımda aynı, yani her terim bir öncekinin katı:","ifade":"oran = 3"},{"aciklama":"Son terimi bu oranla çarp:","ifade":"405 × 3 = 1.215"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"1.215"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.006,"gorsel":null},{"kimlik":"b2ffe448c731","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 5/8 katı ile 1/6 katı arasındaki fark 33'tür.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"66","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"792/19","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"72","dogru":true,"yanilgi":null},{"harf":"D","metin":"77","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"121/8","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(5/8 − 1/6) · x = 33"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(8, 6) = 24"},{"aciklama":"Her kesri, paydası 24 olacak biçimde genişlet:","ifade":"5/8 = 15/24  (payı da paydayı da 3 ile çarptık)\n1/6 = 4/24  (payı da paydayı da 4 ile çarptık)"},{"aciklama":"Payları çıkar; payda değişmez:","ifade":"15/24 − 4/24 = 11/24"},{"aciklama":"Kesirle çarpımı bozmak için tersiyle çarp:","ifade":"x = 33 × 24/11 = 72"},{"aciklama":"Aranan sayı:","ifade":"72"}],"mikrobeceriler":["sayilar.rasyonel","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":0.985,"gorsel":null},{"kimlik":"bc3be4835b84","sablon":"problem.isci.ek_isci","govde":"14 işçi bir işi 38 günde bitirmektedir. Aynı iş 19 günde bitirilmek istendiğine göre kaç işçi **daha** gerekir?","secenekler":[{"harf":"A","metin":"19 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"B","metin":"7 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"C","metin":"33 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"D","metin":"28 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"14 kişi","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"14 × 38 = 532"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"532 / 19 = 28"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"28 − 14 = 14"},{"aciklama":"Gereken ek işçi:","ifade":"14 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.567,"gorsel":null},{"kimlik":"62c57153982b","sablon":"veri.grafik.sutun_seri_toplam_farki","govde":"Bir işletmenin dört ayda sattığı Bisiklet ve Scooter sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre dört ayda satılan toplam Bisiklet sayısı, toplam Scooter sayısından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"470 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"205 adet","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"C","metin":"280 adet","dogru":true,"yanilgi":null},{"harf":"D","metin":"355 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"E","metin":"110 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Soru tek bir ay değil, dördünün toplamını istiyor. Önce Bisiklet sütunlarını topla:","ifade":"85 + 125 + 185 + 75 = 470"},{"aciklama":"Sonra Scooter sütunlarını topla:","ifade":"30 + 40 + 75 + 45 = 190"},{"aciklama":"İki toplamın farkını al:","ifade":"470 − 190 = 280"},{"aciklama":"Aradaki fark:","ifade":"280 adet"}],"mikrobeceriler":["veri.grafik"],"yanilgi_alanlari":["oran.paylastirma","veri.tablo"],"zorluk":-0.229,"gorsel":{"tur":"sutun","baslik":"Bisiklet ve Scooter satışları (adet)","etiketler":["Mayıs","Haziran","Temmuz","Ağustos"],"birim":"adet","seriler":[{"ad":"Bisiklet","degerler":[85,125,185,75]},{"ad":"Scooter","degerler":[30,40,75,45]}]}},{"kimlik":"44de0f83d95a","sablon":"oran.dogru.olcek","govde":"Ölçeği 1/800.000 olan bir haritada Samsun ile Antalya arasındaki uzaklık 13 cm ölçülmüştür. İki şehir arasındaki gerçek uzaklık kaç km'dir?","secenekler":[{"harf":"A","metin":"10,4 km","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"B","metin":"21 km","dogru":false,"yanilgi":"oran_yerine_sabit_fark"},{"harf":"C","metin":"1.040 km","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"D","metin":"104 km","dogru":true,"yanilgi":null},{"harf":"E","metin":"13 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ölçek, haritadaki uzunluğun gerçek uzunluğa oranıdır; gerçek uzunluk haritadakinin ölçek payda sayısı katıdır:","ifade":"13 × 800.000 = 10.400.000 cm"},{"aciklama":"1 km = 100.000 cm olduğundan:","ifade":"10.400.000 / 100.000 = 104 km"},{"aciklama":"Kısayol: ölçek 1/800.000 olduğunda haritadaki 1 cm, 8 km demektir.","ifade":null},{"aciklama":"Gerçek uzaklık:","ifade":"104 km"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["oran.temel","problem.hareket"],"zorluk":0.405,"gorsel":null},{"kimlik":"a0177cf241a0","sablon":"yuzde.artis.azalma_orani","govde":"Bir atölyenin aylık üretimi 1.560 adetten 312 adede düşmüştür. Üretimdeki azalma yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%20","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"%400","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"C","metin":"%80","dogru":true,"yanilgi":null},{"harf":"D","metin":"%1.248","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%312","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Azalma yüzdesi, azalma miktarının **eski** değere oranıdır.","ifade":null},{"aciklama":"Azalma miktarı:","ifade":"1.560 − 312 = 1.248"},{"aciklama":"Bunu eski değere oranla ve 100 ile çarp:","ifade":"1.248 / 1.560 × 100 = 80"},{"aciklama":"Azalma oranı:","ifade":"%80"}],"mikrobeceriler":["yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":-0.086,"gorsel":null},{"kimlik":"12cc2ea051df","sablon":"veri.grafik.sutun_toplam","govde":"Bir işletmenin dört mağazada sattığı Ekmek ve Simit sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre iki ürünün toplam satışının en yüksek olduğu mağaza için bu toplam kaç adettir?","secenekler":[{"harf":"A","metin":"60 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"B","metin":"135 adet","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"120 adet","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"D","metin":"160 adet","dogru":true,"yanilgi":null},{"harf":"E","metin":"320 adet","dogru":false,"yanilgi":"grafik_eksen_olcegi"}],"cozum":[{"acikla