ablon":"veri.grafik.daire_merkez_aci","govde":"Bir ankete katılanların tercihleri yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Yüzme dilimine karşılık gelen merkez açı kaç derecedir?","secenekler":[{"harf":"A","metin":"10 derece","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"B","metin":"18 derece","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"C","metin":"162 derece","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"324 derece","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"E","metin":"36 derece","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bir dairenin tamamı 360°, dağılımın tamamı ise 100'dür. Dilimin açısı bu iki bütün arasındaki orantıdan çıkar.","ifade":null},{"aciklama":"Yüzme diliminin payı:","ifade":"%10"},{"aciklama":"Merkez açısı:","ifade":"360 × 10 / 100 = 36"},{"aciklama":"Merkez açısı:","ifade":"36 derece"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":-0.066,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Futbol","Basketbol","Voleybol","Yüzme"],"birim":"%","seriler":[{"ad":"Pay","degerler":[45,20,25,10]}]}},{"kimlik":"0e52190523df","sablon":"sayilar.mutlak.kokler_toplami","govde":"|2x − 3| = 20 denkleminin köklerinin toplamı kaçtır?","secenekler":[{"harf":"A","metin":"−3","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"B","metin":"3","dogru":true,"yanilgi":null},{"harf":"C","metin":"20","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"D","metin":"11,5","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"−8,5","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"}],"cozum":[{"aciklama":"Mutlak değer 20'ye eşitse içerideki ifade 20 ya da −20 olabilir; bu yüzden iki kök vardır.","ifade":null},{"aciklama":"Birinci durum:","ifade":"2x − 3 = 20 ⟹ x = 11,5"},{"aciklama":"İkinci durum:","ifade":"2x − 3 = −20 ⟹ x = −8,5"},{"aciklama":"Kökleri topla. Artı ve eksi terimler birbirini götürür:","ifade":"11,5 + (−8,5) = 2 × 3 / 2 