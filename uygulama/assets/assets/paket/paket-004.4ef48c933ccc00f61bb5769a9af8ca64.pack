dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"576","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"İki kare farkı çarpanlara ayrılır; kareleri tek tek hesaplamaya gerek yoktur:","ifade":"a² − b² = (a − b)(a + b)"},{"aciklama":"Çarpanları yaz:","ifade":"(72 − 64)(72 + 64) = 8 × 136"},{"aciklama":"Çarpımı yap:","ifade":"8 × 136 = 1.088"},{"aciklama":"İşlemin sonucu:","ifade":"1.088"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":-0.054,"gorsel":null},{"kimlik":"4a32bb384390","sablon":"mantik.dizi.toplamsal","govde":"1, 22, 23, 45, 68, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"181","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"68","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"C","metin":"113","dogru":true,"yanilgi":null},{"harf":"D","metin":"136","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"E","metin":"91","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"}],"cozum":[{"aciklama":"Farklar sabit değil, oranlar da değil; her terimi kendinden önceki ikisiyle karşılaştır:","ifade":"1 + 22 = 23"},{"aciklama":"Kural aynı biçimde devam ediyor:","ifade":"22 + 23 = 45"},{"aciklama":"Son iki terimi topla:","ifade":"45 + 68 = 113"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"113"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.799,"gorsel":null},{"kimlik":"d35c86eb5493-1","sablon":"oran.blok.paylastirma_uc_soru","govde":"Kerem'in payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"9.750 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"750 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"C","metin":"4.500 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"5.250 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"E","metin":"31.500 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oran katsayıl