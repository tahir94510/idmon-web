ma":"Örnek uzay sınıfın tamamıdır:","ifade":"51 öğrenci"},{"aciklama":"Olasılık, istenen durum sayısının tüm durumlara oranıdır:","ifade":"43/51"},{"aciklama":"İstenen olasılık:","ifade":"43/51"}],"mikrobeceriler":["kume.olasilik","kume.temel"],"yanilgi_alanlari":[],"zorluk":2.393,"gorsel":null},{"kimlik":"1cd8de992a71","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"7 · 2² · 2³ · 8⁰ + 2⁶ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"288","dogru":true,"yanilgi":null},{"harf":"B","metin":"64","dogru":false,"yanilgi":"sifir_us"},{"harf":"C","metin":"512","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"D","metin":"160","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"14.336","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"8⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2² · 2³ = 2⁵ = 32"},{"aciklama":"Katsayıyla çarp:","ifade":"7 × 32 = 224"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"224 + 64 = 288"},{"aciklama":"İşlemin sonucu:","ifade":"288"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.013,"gorsel":null},{"kimlik":"8455e0497636","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 12 kişilik A grubunun puan ortalaması 66, 18 kişilik B grubunun puan ortalaması 46 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"54","dogru":true,"yanilgi":null},{"harf":"B","metin":"112","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"56","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"1.620","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"E","metin":"135","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 12 × 66","ifade":"792"},{"aciklama":"B grubu: 18 × 46","ifade":"828"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"1.620 / 30 = 54"},{"aciklama":"Ortak ortalama:","ifade":"54"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.495,"gorsel":null},{"kimlik":"9b7acfccd52d","sablon":"oran.paylastirma.fark","govde":"3.780 TL tutarındaki bir ödül, Burak ile Merve arasında 8/13 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.440 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"2.340 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"900 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"3.780 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"1.890 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"8 + 13 = 21"},{"aciklama":"Bir parçanın değeri:","ifade":"3.780 / 21 = 180 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(13 − 8) × 180 = 900 TL"},{"aciklama":"Aradaki fark:","ifade":"900 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.465,"gorsel":null},{"kimlik":"709360d3861f","sablon":"yuzde.artis.zam","govde":"Fiyatı 1.900 TL olan bir masa lambası, %24 zamlanmıştır. Zamdan sonra masa lambasının fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"1.924 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"456 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"1.444 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"2.356 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"47.500 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"1.900 × 24/100 = 456 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"1.900 + 456 = 2.356 TL"},{"aciklama":"Zamlı fiyat:","ifade":"2.356 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.058,"gorsel":null},{"kimlik":"1c162ab50d86","sablon":"mantik.dizi.artan_fark","govde":"7, 16, 26, 37, 49, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"58","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"B","metin":"61","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"62","dogru":true,"yanilgi":null},{"harf":"D","metin":"49","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"E","metin":"36","dogru":false,"yanilgi":"dizi_yon_ters"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"16−7=9 , 26−16=10 , 37−26=11 , 49−37=12"},{"aciklama":"Farklar sabit değil; her adımda 1 artıyor. Sıradaki fark:","ifade":"12 + 1 = 13"},{"aciklama":"Son terime bu farkı ekle:","ifade":"49 + 13 = 62"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"62"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"04ebaedf3e60","sablon":"problem.sayi.kesir_kalan","govde":"Ece, parasının 1/2'sini ulaşıma, kalan parasının 1/4'ünü kırtasiyeye harcadığında geriye 180 TL kalmaktadır.\n\nBuna göre Ece'nin başlangıçtaki parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.440","dogru":false,"yanilgi":"harcanan_kesir_kalan_sanildi"},{"harf":"B","metin":"240","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"720","dogru":false,"yanilgi":"kalanin_kesri_butunden"},{"harf":"D","metin":"480","dogru":true,"yanilgi":null},{"harf":"E","metin":"300","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Önce paranın 1/2'si harcanınca 1/2'si kalır.","ifade":null},{"aciklama":"Sonra **kalanın** 1/4'ü harcanınca kala