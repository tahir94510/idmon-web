{"surum":1,"uretim":"2026-10-04","taksonomi_parmak_izi":"c38bfac816a16c83","motor_parmak_izi":"89f6a7c03067ceb5","tohum":20260902,"dilim":4,"madde_sayisi":500,"maddeler":[{"kimlik":"e713401b997d","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 15 kız öğrencinin matematik notu ortalaması 80, 9 erkek öğrencinin ortalaması ise 40'tır. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"1.560","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"B","metin":"60","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"104","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"D","metin":"55","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"65","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"15 × 80 + 9 × 40 = 1.560"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"15 + 9 = 24"},{"aciklama":"Sınıf ortalaması:","ifade":"1.560 / 24 = 65"},{"aciklama":"Sınıfın ortalaması:","ifade":"65"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":1.274,"gorsel":null},{"kimlik":"52427c98eab4","sablon":"sayilar.rasyonel.toplama","govde":"12/13 + 2/3 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"38/13","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"B","metin":"10/39","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"7/8","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"D","metin":"14/13","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"E","metin":"62/39","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 3) = 39"},{"aciklama":"Her kesri, paydası 39 olacak biçimde genişlet:","ifade":"12/13 = 36/39  (payı da paydayı da 3 ile çarptık)\n2/3 = 26/39  (payı da paydayı da 13 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"36/39 + 26/39 = 62/39"},{"aciklama":"İşlemin sonucu:","ifade":"62/39"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.229,"gorsel":null},{"kimlik":"37f4ce881110","sablon":"oran.paylastirma.artan_pay","govde":"310 TL paranın bir kısmı Ahmet'e ve Emre'ye 2 : 3 oranında dağıtılmış, Ahmet'in payı 60 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"62 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"95 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"90 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"160 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"460 TL","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Ahmet'in payından birim payı çöz:","ifade":"2k = 60 → k = 30"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(2 + 3) × 30 = 150 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"310 − 150 = 160 TL"},{"aciklama":"Geriye kalan:","ifade":"160 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":0.94,"gorsel":null},{"kimlik":"933850fb39f8","sablon":"yuzde.artis.indirim","govde":"Fiyatı 3.200 TL olan bir koltuk, %10 indirimle satılmaktadır. Koltuğun indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"320 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"3.520 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"3.190 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"2.880 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"2.592 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"3.200 × 10 / 100 = 320"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"3.200 − 320 = 2.880"},{"aciklama":"İndirimli fiyat:","ifade":"2.880 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-1.92,"gorsel":null},{"kimlik":"d48b39732f57","sablon":"veri.ortalama.eksik_terim","govde":"4 öğrencinin sınav notu ortalaması 50. Öğrencilerden 3'ü sırasıyla 96, 38 ve 43 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"66","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"B","metin":"23","dogru":true,"yanilgi":null},{"harf":"C","metin":"59","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"73","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"177","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"50 × 4 = 200"},{"aciklama":"Bilinen notların toplamı:","ifade":"96 + 38 + 43 = 177"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"200 − 177 = 23"},{"aciklama":"Kalan öğrencinin notu:","ifade":"23"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.254,"gorsel":null},{"kimlik":"6411db349d70","sablon":"sayilar.uslu.negatif_us","govde":"(6⁻³)⁴ · 6⁴ işleminin sonucu, 6 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"−8","dogru":true,"yanilgi":null},{"harf":"B","metin":"−48","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"C","metin":"8","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"−3","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"E","metin":"16","dogru":false,"yanilgi":"negatif_us_isaret"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(6⁻³)⁴ = 6⁻¹²"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"6⁻¹² · 6⁴ = 6⁻⁸"},{"aciklama":"Aranan kuvvet:","ifade":"−8"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.07,"gorsel":null},{"kimlik":"6254e86668b2","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 8 kişinin yaş ortalaması 38. Gruptan bir kişi ayrılınca ortalama 39 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"577","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"8","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"C","metin":"273","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"1","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"E","metin":"31","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam: 8 × 38","ifade":"304"},{"aciklama":"Ayrıldıktan sonra grup 7 kişi: 7 × 39","ifade":"273"},{"aciklama":"Ayrılan kişinin yaşı iki toplamın farkıdır:","ifade":"304 − 273 = 31"},{"aciklama":"Ayrılan kişinin yaşı:","ifade":"31"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.187,"gorsel":null},{"kimlik":"8a89ff94924b","sablon":"cebir.esitsizlik.negatif_katsayi","govde":"−4(x + 9) > 21 eşitsizliğini sağlayan en büyük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"−15","dogru":true,"yanilgi":null},{"harf":"B","metin":"−14","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"C","metin":"−16","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"D","metin":"−4","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"−3","dogru":false,"yanilgi":"dagitma_eksik"}],"cozum":[{"aciklama":"Önce parantezi dağıt; dışarıdaki çarpan içerideki *her* terime uygulanır:","ifade":"−4x − 36 > 21"},{"aciklama":"Sabit terimi karşı tarafa geçir:","ifade":"−4x > 57"},{"aciklama":"Her iki tarafı −4 ile böl. Negatif bir sayıyla bölerken eşitsizliğin yönü döner: büyüktür işareti küçüktür olur:","ifade":"x < −14,25"},{"aciklama":"Sınır dahil olmadığı için ondan küçük en büyük tam sayı alınır:","ifade":"−15"},{"aciklama":"En büyük tam sayı:","ifade":"−15"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":["cebir.ozdeslik"],"zorluk":1.826,"gorsel":null},{"kimlik":"a2a48fd0b4de","sablon":"mantik.dizi.sabit_fark","govde":"21, 28, 35, 42, 49, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"56","dogru":true,"yanilgi":null},{"harf":"B","metin":"55","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"C","metin":"42","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"63","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"E","metin":"49","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"28−21=7 , 35−28=7 , 42−35=7 , 49−42=7"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerliyor:","ifade":"fark = 7"},{"aciklama":"Son terime bu farkı ekle:","ifade":"49 + 7 = 56"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"56"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.626,"gorsel":null},{"kimlik":"086c681b6a90","sablon":"problem.yas.kat_iliskisi","govde":"Ece'nin yaşı bugün Kaan'ın yaşının 10 katıdır. 21 yıl sonra Ece'nin yaşı Kaan'ın yaşının 3 katı olacaktır. Buna göre Ece bugün kaç yaşındadır?","secenekler":[{"harf":"A","metin":"54","dogru":false,"yanilgi":"fark_verildi_deger_istendi"},{"harf":"B","metin":"66","dogru":false,"yanilgi":"yas_toplam_fark_karisimi"},{"harf":"C","metin":"81","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"D","metin":"90","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"E","metin":"60","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kaan'ın bugünkü yaşına x dersek, Ece'nin yaşı 10x olur.","ifade":null},{"aciklama":"21 yıl sonra ikisi de 21 yaş büyür; fark değişmez:","ifade":"10x + 21 = 3·(x + 21)"},{"aciklama":"Denklemi çöz:","ifade":"10x + 21 = 3x + 63  ⟹  7x = 42  ⟹  x = 6"},{"aciklama":"Ece'nin bugünkü yaşı bunun 10 katıdır:","ifade":"10 × 6 = 60"},{"aciklama":"Ece bugün:","ifade":"60"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":2.176,"gorsel":null},{"kimlik":"082356a66ea5","sablon":"oran.paylastirma.fark","govde":"2.880 TL tutarındaki bir ödül, Onur ile Kaan arasında 4/5 oranında paylaştırılmıştır. Buna göre iki kişinin aldığı paralar arasındaki fark kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.280 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"1.440 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"320 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"2.880 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"1.600 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Payların toplamı bütünü kaç eş parçaya böldüğünü verir:","ifade":"4 + 5 = 9"},{"aciklama":"Bir parçanın değeri:","ifade":"2.880 / 9 = 320 TL"},{"aciklama":"Paylar arasındaki fark, katsayı farkı kadar parçadır:","ifade":"(5 − 4) × 320 = 320 TL"},{"aciklama":"Aradaki fark:","ifade":"320 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":0.537,"gorsel":null},{"kimlik":"6daf45b26bb6","sablon":"yuzde.artis.zam","govde":"Fiyatı 1.700 TL olan bir valiz, %15 zamlanmıştır. Zamdan sonra valizin fiyatı kaç TL olmuştur?","secenekler":[{"harf":"A","metin":"1.955 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"27.200 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"C","metin":"255 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.715 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"1.445 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zam tutarı, eski fiyatın verilen yüzdesidir:","ifade":"1.700 × 15/100 = 255 TL"},{"aciklama":"Yeni fiyat, eski fiyat ile zam tutarının toplamıdır:","ifade":"1.700 + 255 = 1.955 TL"},{"aciklama":"Zamlı fiyat:","ifade":"1.955 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-2.29,"gorsel":null},{"kimlik":"e9340b8768b6","sablon":"veri.ortalama.iki_grup_birlesme","govde":"Bir sınavda 18 kişilik A grubunun puan ortalaması 46, 36 kişilik B grubunun puan ortalaması 76 olmuştur. İki grup birlikte değerlendirildiğinde puan ortalaması kaç olur?","secenekler":[{"harf":"A","metin":"198","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"3.564","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"C","metin":"61","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"D","metin":"122","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"66","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortalama tek başına toplanmaz; önce her grubun **toplam puanı** bulunur.","ifade":null},{"aciklama":"A grubu: 18 × 46","ifade":"828"},{"aciklama":"B grubu: 36 × 76","ifade":"2.736"},{"aciklama":"Ortak ortalama, toplam puanın **toplam kişi sayısına** bölümüdür:","ifade":"3.564 / 54 = 66"},{"aciklama":"Ortak ortalama:","ifade":"66"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.592,"gorsel":null},{"kimlik":"f0c5f57ebf50","sablon":"sayilar.uslu.toplam_ve_sifirinci","govde":"11 · 2³ · 2³ · 3⁰ + 2⁴ işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"16","dogru":false,"yanilgi":"sifir_us"},{"harf":"B","metin":"720","dogru":true,"yanilgi":null},{"harf":"C","metin":"688","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"11.264","dogru":false,"yanilgi":"uslu_toplama_birlestirildi"},{"harf":"E","metin":"5.648","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"}],"cozum":[{"aciklama":"Sıfırdan farklı her sayının sıfırıncı kuvveti 1'dir:","ifade":"3⁰ = 1"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"2³ · 2³ = 2⁶ = 64"},{"aciklama":"Katsayıyla çarp:","ifade":"11 × 64 = 704"},{"aciklama":"Üslü toplam tek bir üslüde birleşmez; iki terim ayrı ayrı hesaplanıp toplanır:","ifade":"704 + 16 = 720"},{"aciklama":"İşlemin sonucu:","ifade":"720"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.036,"gorsel":null},{"kimlik":"83bef1f85d31","sablon":"veri.ortalama.iki_ortalamadan_toplam","govde":"Bir kursta 22 kişilik bir grubun yaş ortalaması 45, ikinci bir grubun yaş ortalaması ise 60'tır. İki grup birleştiğinde yaş ortalaması 49 olduğuna göre ikinci grup kaç kişidir?","secenekler":[{"harf":"A","metin":"8 kişi","dogru":true,"yanilgi":null},{"harf":"B","metin":"22 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"33 kişi","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"15 kişi","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"E","metin":"30 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Ortalama, toplamın kişi sayısına bölümüdür; önce toplamları yaz:","ifade":"22·45 + n·60"},{"aciklama":"Birleşik ortalama da aynı tanımı sağlar:","ifade":"(22·45 + n·60) / (22 + n) = 49"},{"aciklama":"Paydayı karşıya at ve n'yi yalnız bırak:","ifade":"22·(45 − 49) = n·(49 − 60)"},{"aciklama":"İkinci grubun kişi sayısı:","ifade":"8 kişi"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":1.048,"gorsel":null},{"kimlik":"f9810af5235c","sablon":"kume.temel.uc_kume","govde":"Bir sınıftaki 93 öğrenciden 50 tanesi müzik, 48 tanesi satranç, 52 tanesi fotoğrafçılık kulübüne üyedir. Müzik ve satranç kulüplerinin ikisine birden 26, müzik ve fotoğrafçılık kulüplerine 27, satranç ve fotoğrafçılık kulüplerine 28 öğrenci üyedir. Üç kulübe birden üye olan öğrenci sayısı 17'dir. Buna göre en az bir kulübe üye olan kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"69","dogru":false,"yanilgi":"kume_uc_kume_kesisim"},{"harf":"B","metin":"86","dogru":true,"yanilgi":null},{"harf":"C","metin":"7","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"D","metin":"39","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"150","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"}],"cozum":[{"aciklama":"İçler-dışlar ilkesi: tekli toplamlardan ikili kesişimler düşülür, üçlü kesişim geri eklenir.","ifade":"|A∪B∪C| = |A|+|B|+|C| − |A∩B| − |A∩C| − |B∩C| + |A∩B∩C|"},{"aciklama":"Değerleri yerine koy:","ifade":"50 + 48 + 52 − 26 − 27 − 28 + 17 = 86"},{"aciklama":"Sınıf mevcudu bu hesaba girmez; geri kalan 7 öğrenci hiçbir kulübe üye değildir.","ifade":null},{"aciklama":"En az bir kulübe üye olan öğrenci sayısı:","ifade":"86"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":3.021,"gorsel":null},{"kimlik":"79e0674b5ca0","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Emre, Kaan ve Fatma arasında sırasıyla 3, 8 ve 12 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 17.250 TL olduğuna göre, Fatma'nın payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"8.250 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"69.000 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"C","metin":"5.750 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"D","metin":"2.250 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"9.000 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"3 + 8 + 12 = 23"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"17.250 / 23 = 750 TL"},{"aciklama":"Fatma bu paylardan 12 tane alır:","ifade":"12 × 750 = 9.000 TL"},{"aciklama":"Fatma'nın payı:","ifade":"9.000 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.612,"gorsel":null},{"kimlik":"c3ddcc62bfac","sablon":"yuzde.faiz.anapara","govde":"Yıllık %12 basit faiz oranıyla 4 ay vadeye yatırılan bir anapara 144 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.600 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"300 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"C","metin":"3.744 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"1.200 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"E","metin":"900 TL","dogru":false,"yanilgi":"faizde_sure_bolme"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"4 ay için faiz katsayısı:","ifade":"12/100 × 4/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"144 / (12 × 4/1200) = 3.600 TL"},{"aciklama":"Anapara:","ifade":"3.600 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.416,"gorsel":null},{"kimlik":"af858b189b04","sablon":"veri.ortalama.medyan_tek","govde":"48, 170, 26, 32, 154 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"26","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"B","metin":"98","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"C","metin":"48","dogru":true,"yanilgi":null},{"harf":"D","metin":"86","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"154","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"26 < 32 < 48 < 154 < 170"},{"aciklama":"Terim sayısı 5, yani tek: ortada tek bir terim var.","ifade":"5 → 3. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"48"},{"aciklama":"Ortanca:","ifade":"48"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.643,"gorsel":null},{"kimlik":"d45336116d88","sablon":"sayilar.uslu.us_kurallari","govde":"(7⁴)⁵ · (7⁴)⁴ : 7² işleminin sonucu, 7 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"34","dogru":true,"yanilgi":null},{"harf":"B","metin":"−36","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"C","metin":"15","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"D","metin":"38","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"318","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"}],"cozum":[{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(7⁴)⁵ = 7²⁰ , (7⁴)⁴ = 7¹⁶"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"7²⁰ · 7¹⁶ = 7³⁶"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"7³⁶ : 7² = 7³⁴"},{"aciklama":"Aranan kuvvet:","ifade":"34"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":3.153,"gorsel":null},{"kimlik":"d20790e85f17","sablon":"mantik.dizi.terim_sirasi","govde":"24, 34, 44, 54, ... biçiminde devam eden dizide 404 sayısı kaçıncı terimdir?","secenekler":[{"harf":"A","metin":"38","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"40,4","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"404","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"40","dogru":false,"yanilgi":"ardisik_terim_sayisi"},{"harf":"E","metin":"39","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimler arasındaki fark sabit:","ifade":"34 − 24 = 10"},{"aciklama":"Genel terim, **ilk** terimden başlar; n. terime kadar (n − 1) adım atılır:","ifade":"a(n) = 24 + (n − 1)·10"},{"aciklama":"Verilen terimi yerine koy ve n'yi çöz:","ifade":"404 = 24 + (n − 1)·10 → n = 39"},{"aciklama":"Terimin sırası:","ifade":"39"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.619,"gorsel":null},{"kimlik":"456d89d67c3b","sablon":"problem.yas.toplam_iliskisi","govde":"Merve ile Elif'in bugünkü yaşları toplamı 60'tır, aralarındaki yaş farkı ise 12'dir.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"36","dogru":true,"yanilgi":null},{"harf":"B","metin":"72","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"C","metin":"47","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"D","metin":"58","dogru":false,"yanilgi":"yas_farki_degisti"},{"harf":"E","metin":"24","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(60 + 12) / 2 = 36"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"60 − 36 = 24"},{"aciklama":"Büyük olanın yaşı:","ifade":"36"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.171,"gorsel":null},{"kimlik":"de1b66f92e45","sablon":"veri.ortalama.yeni_eleman","govde":"Bir gruptaki 15 kişinin yaş ortalaması 43. Gruba bir kişi daha katılınca ortalama 45'e çıkmıştır. Katılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"44","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"75","dogru":true,"yanilgi":null},{"harf":"C","metin":"30","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"D","metin":"73","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"E","metin":"45","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Önceki toplam yaş:","ifade":"15 × 43 = 645"},{"aciklama":"Kişi sayısı bir arttı; yeni toplam yaş:","ifade":"16 × 45 = 720"},{"aciklama":"Katılanın yaşı, iki toplamın farkıdır:","ifade":"720 − 645 = 75"},{"aciklama":"Katılan kişinin yaşı:","ifade":"75"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":1.775,"gorsel":null},{"kimlik":"8033c81ad692","sablon":"oran.temel.oran_ve_fark","govde":"Serkan'ın parasının Selin'in parasına oranı 11/9'dur. Aralarındaki fark 560 TL olduğuna göre Serkan kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"3.080 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"5.600 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"C","metin":"308 TL","dogru":false,"yanilgi":"verilen_toplam_fark_karisimi"},{"harf":"D","metin":"2.520 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"E","metin":"280 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oran verildiğinde iki büyüklük ortak bir birimin katları olarak yazılır: Serkan 11k, Selin 9k.","ifade":null},{"aciklama":"Verilen **fark**tır, toplam değil:","ifade":"11k − 9k = 2k = 560"},{"aciklama":"Birim payı bul:","ifade":"k = 560 / 2 = 280"},{"aciklama":"Serkan için:","ifade":"11 × 280 = 3.080"},{"aciklama":"Serkan'ın parası:","ifade":"3.080 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":2.606,"gorsel":null},{"kimlik":"ab2c7d4913a6","sablon":"yuzde.faiz.basit_ay","govde":"14.400 TL tutarındaki bir anapara, yıllık %45 basit faiz oranıyla 10 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"6.480 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"648 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"19.800 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"5.400 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"64.800 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"10 ay, yıl cinsinden:","ifade":"10/12"},{"aciklama":"Faiz tutarı:","ifade":"14.400 × 45/100 × 10/12 = 5.400 TL"},{"aciklama":"Elde edilen faiz:","ifade":"5.400 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.566,"gorsel":null},{"kimlik":"775ff495134d","sablon":"sayilar.ardisik.tek_toplam","govde":"Ardışık 7 tek doğal sayının toplamı 819'dur.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"121","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"B","metin":"120","dogru":false,"yanilgi":"ardisik_adim_hatasi"},{"harf":"C","metin":"111","dogru":false,"yanilgi":"ardisik_en_kucuk_en_buyuk"},{"harf":"D","metin":"117","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"123","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık 7 sayı