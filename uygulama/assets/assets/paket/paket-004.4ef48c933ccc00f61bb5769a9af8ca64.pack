erekir?","secenekler":[{"harf":"A","metin":"32 kişi","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"20 kişi","dogru":false,"yanilgi":"sure_farki_isci_sanildi"},{"harf":"C","metin":"16 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"36 kişi","dogru":false,"yanilgi":"isci_gun_carpim_yerine_toplam"},{"harf":"E","metin":"8 kişi","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"}],"cozum":[{"aciklama":"İşin büyüklüğü işçi-gün cinsinden sabittir:","ifade":"16 × 40 = 640"},{"aciklama":"İşçi sayısı ile süre **ters orantılıdır**; gereken toplam işçi:","ifade":"640 / 20 = 32"},{"aciklama":"Sorulan ek işçi sayısıdır, toplam değil:","ifade":"32 − 16 = 16"},{"aciklama":"Gereken ek işçi:","ifade":"16 kişi"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":["oran.ters"],"zorluk":0.617,"gorsel":null},{"kimlik":"566128389fcb","sablon":"sayilar.rasyonel.bilesik_bolme","govde":"(5/6 + 11/14) : 9/13 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"52/45","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"B","metin":"442/189","dogru":true,"yanilgi":null},{"harf":"C","metin":"102/91","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"D","metin":"104/27","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"E","metin":"13/189","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Parantez içindeki toplamla başla. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(6, 14) = 42"},{"aciklama":"Her kesri, paydası 42 olacak biçimde genişlet:","ifade":"5/6 = 35/42  (payı da paydayı da 7 ile çarptık)\n11/14 = 33/42  (payı da paydayı da 3 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"35/42 + 33/42 = 68/42"},{"aciklama":"Payı ve paydayı ortak bölenleri 2 ile sadeleştir:","ifade":"68/42 = 34/21"},{"aciklama":"Bir kesire bölmek, o kesrin tersiyle çarpmaktır:","ifade":"34/21 × 13/9"},{"aciklama":"Çarpımı yap:","ifade":"34 × 