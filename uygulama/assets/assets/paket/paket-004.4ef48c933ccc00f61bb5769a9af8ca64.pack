imlik":"550e4a15526e","sablon":"kume.temel.uc_kume","govde":"Bir sınıftaki 84 öğrenciden 24 tanesi robotik, 31 tanesi tiyatro, 41 tanesi müzik kulübüne üyedir. Robotik ve tiyatro kulüplerinin ikisine birden 10, robotik ve müzik kulüplerine 12, tiyatro ve müzik kulüplerine 20 öğrenci üyedir. Üç kulübe birden üye olan öğrenci sayısı 8'dir. Buna göre en az bir kulübe üye olan kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"62","dogru":true,"yanilgi":null},{"harf":"B","metin":"54","dogru":false,"yanilgi":"kume_uc_kume_kesisim"},{"harf":"C","metin":"96","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"36","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"22","dogru":false,"yanilgi":"kume_tumleyen_karisimi"}],"cozum":[{"aciklama":"İçler-dışlar ilkesi: tekli toplamlardan ikili kesişimler düşülür, üçlü kesişim geri eklenir.","ifade":"|A∪B∪C| = |A|+|B|+|C| − |A∩B| − |A∩C| − |B∩C| + |A∩B∩C|"},{"aciklama":"Değerleri yerine koy:","ifade":"24 + 31 + 41 − 10 − 12 − 20 + 8 = 62"},{"aciklama":"Sınıf mevcudu bu hesaba girmez; geri kalan 22 öğrenci hiçbir kulübe üye değildir.","ifade":null},{"aciklama":"En az bir kulübe üye olan öğrenci sayısı:","ifade":"62"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":[],"zorluk":2.928,"gorsel":null},{"kimlik":"6e4c31476dbd","sablon":"mantik.dizi.sabit_fark","govde":"11, 22, 33, 44, 55, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"55","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"77","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"C","metin":"65","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"D","metin":"44","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"E","metin":"66","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"22−11=11 , 33−22=11 , 44−33=11 , 55−44=11"},{"aciklama":"Fark her adımda aynı, yani dizi sabit farkla ilerli