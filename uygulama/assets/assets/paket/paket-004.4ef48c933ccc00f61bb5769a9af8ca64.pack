},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"5¹² · 5²⁰ = 5³²"},{"aciklama":"Aynı tabanlı bölmede üsler çıkarılır:","ifade":"5³² : 5² = 5³⁰"},{"aciklama":"Aranan kuvvet:","ifade":"30"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":2.997,"gorsel":null},{"kimlik":"5f822b14521e","sablon":"veri.ortalama.medyan_tek","govde":"80, 104, 26, 170, 160 sayılarının ortancası (medyanı) kaçtır?","secenekler":[{"harf":"A","metin":"160","dogru":false,"yanilgi":"ortalama_eksik_terim"},{"harf":"B","metin":"26","dogru":false,"yanilgi":"medyan_siralanmadan_alindi"},{"harf":"C","metin":"98","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"108","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"E","metin":"104","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Ortanca, **sıralanmış** verinin ortasındaki terimdir; önce sırala:","ifade":"26 < 80 < 104 < 160 < 170"},{"aciklama":"Terim sayısı 5, yani tek: ortada tek bir terim var.","ifade":"5 → 3. terim"},{"aciklama":"Ortadaki terimi oku (ortalama alınmaz, terim seçilir):","ifade":"104"},{"aciklama":"Ortanca:","ifade":"104"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":["veri.tablo"],"zorluk":-0.643,"gorsel":null},{"kimlik":"8e588b6ee3bf","sablon":"oran.paylastirma.ucul","govde":"Bir ikramiye Ayşe, Kaan ve Serkan arasında sırasıyla 2, 3 ve 12 sayıları ile orantılı olarak paylaştırılacaktır. İkramiyenin tamamı 10.200 TL olduğuna göre, Ayşe'nin payı kaç TL'dir?","secenekler":[{"harf":"A","metin":"1.200 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"7.200 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"600 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"D","metin":"9.000 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"6.800 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"}],"cozum":[{"aciklama":"Oran katsayılarının toplamı bütünü kaç eş paya böldüğünü verir:","ifade":"2 + 3 + 12 = 17"},{"aciklama":"Bir payın değeri, toplam tutarın pay sayısına bölümüdür:","ifade":"10.200 / 17 = 600 TL"},{"aciklama":"Ayşe bu paylardan 2 tane alır:","ifade":"2 × 600 = 1.200 TL"},{"aciklama":"Ayşe'nin payı:","ifade":"1.200 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":-0.885,"gorsel":null},{"kimlik":"7e4d47a8ad3d","sablon":"yuzde.faiz.anapara","govde":"Yıllık %12 basit faiz oranıyla 8 ay vadeye yatırılan bir anapara 480 TL faiz getirmiştir. Anapara kaç TL'dir?","secenekler":[{"harf":"A","metin":"750 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"B","metin":"6.480 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"4.000 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"D","metin":"6.000 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"500 TL","dogru":false,"yanilgi":"birim_donusumu"}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"8 ay için faiz katsayısı:","ifade":"12/100 × 8/12"},{"aciklama":"Anapara, faizin bu katsayıya bölümüdür:","ifade":"480 / (12 × 8/1200) = 6.000 TL"},{"aciklama":"Anapara:","ifade":"6.000 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.416,"gorsel":null},{"kimlik":"d087cd615f9b","sablon":"mantik.dizi.carpansal","govde":"18, 30, 54, 102, 198, ?\n\nYukarıdaki dizide soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"198","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"B","metin":"294","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"C","metin":"102","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"D","metin":"390","dogru":true,"yanilgi":null},{"harf":"E","metin":"396","dogru":false,"yanilgi":"dizi_kurali_eksik"}],"cozum":[{"aciklama":"Ardışık terimlerin farkları sabit değil; oran da tam çıkmıyor. Kural iki işlemli olabilir.","ifade":null},{"aciklama":"Her terim bir öncekinin katının sabitl