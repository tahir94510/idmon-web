r işletmenin dört ayda sattığı Kitap sayıları yukarıdaki sütun grafiğinde verilmiştir.\n\nBuna göre Nisan ayında satılan Kitap sayısı, dört ayda satılan toplamın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%5","dogru":true,"yanilgi":null},{"harf":"B","metin":"%10","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"D","metin":"%95","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"E","metin":"%100","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"}],"cozum":[{"aciklama":"Dört sütunun toplamını bul:","ifade":"600 + 1.000 + 300 + 100 = 2.000"},{"aciklama":"Sorulan sütunun toplama oranını yüzdeye çevir:","ifade":"100 / 2.000 × 100 = %5"},{"aciklama":"Bu sütunun toplam içindeki payı:","ifade":"%5"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":1.672,"gorsel":{"tur":"sutun","baslik":"Kitap satışları (adet)","etiketler":["Ocak","Şubat","Mart","Nisan"],"birim":"adet","seriler":[{"ad":"Kitap","degerler":[600,1000,300,100]}]}},{"kimlik":"c315faaab970","sablon":"oran.dogru.yakit_yol","govde":"Bir araç 100 kilometrede 5 litre yakıt tüketmektedir.\n\nBu araç Trabzon'a yapılan 1.500 kilometrelik yolculukta kaç litre yakıt tüketir?","secenekler":[{"harf":"A","metin":"5 litre","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"300 litre","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"750 litre","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"15 litre","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"75 litre","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yol ile yakıt doğru orantılıdır: yol iki katına çıkarsa yakıt da iki katına çıkar. Yolun kaç \"yüz kilometre\" olduğu cevabın kendisi değil, çarpanı.","ifade":null},{"aciklama":"Orantıyı kur (yakıt/yol sabit):","ifade":"5/100 = x/1.500"},{"aciklama":"İçler dışlar çarpımı:","ifade":"x = 1.500 × 5/100 = 75"},{"aciklama":"Tüketilen yakıt:","ifade":"75 litre"}],"mikrobeceriler":["oran.dogru"],"yanilgi_alanlari":["problem.hareket","oran.temel"],"zorluk":-0.788,"gorsel":null},{"kimlik":"99a1b3e56fff","sablon":"yuzde.artis.esitleyen_indirim","govde":"Fiyatı 2.360 TL olan bir çanta %60 zamlanmıştır. Fiyatın eski değerine dönmesi için yeni fiyat üzerinden yüzde kaç indirim yapılmalıdır?","secenekler":[{"harf":"A","metin":"%62,5","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"%160","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%37,5","dogru":true,"yanilgi":null},{"harf":"D","metin":"%96","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%60","dogru":false,"yanilgi":"ardisik_yuzde_toplama"}],"cozum":[{"aciklama":"Önce zamlı fiyatı bul:","ifade":"2.360 × 160/100 = 3.776 TL"},{"aciklama":"İndirim **zamlı** fiyat üzerinden alınır; indirilecek tutar zam tutarı kadardır:","ifade":"3.776 − 2.360 = 1.416 TL"},{"aciklama":"Bu tutarın zamlı fiyata oranı indirim yüzdesini verir (taban değişti, o yüzden aynı yüzde geri alınmaz):","ifade":"1.416/3.776 × 100 = 37,5"},{"aciklama":"Gereken indirim:","ifade":"%37,5"}],"mikrobeceriler":["yuzde.ardisik","yuzde.artis_azalis"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.746,"gorsel":null},{"kimlik":"c6b7cfc3b7d2","sablon":"sayilar.rasyonel.toplama","govde":"10/13 + 1/14 işleminin sonucu kaçtır?","secenekler":[{"harf":"A","metin":"11/13","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"},{"harf":"B","metin":"153/182","dogru":true,"yanilgi":null},{"harf":"C","metin":"23/13","dogru":false,"yanilgi":"kesir_sadelestirme_terim"},{"harf":"D","metin":"11/27","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"E","metin":"127/182","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(13, 14) = 182"},{"aciklama":"Her kesri, paydası 182 olacak biçimde genişlet:","ifade":"10/13 = 140/182  (payı da paydayı da 14 ile çarptık)\n1/14 = 13/182  (payı da paydayı da 13 ile çarptık)"},{"aciklama":"Payları topla; payda değişmez:","ifade":"140/182 + 13/182 = 153/182"},{"aciklama":"İşlemin sonucu:","ifade":"153/182"}],"mikrobeceriler":["sayilar.rasyonel"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":0.524,"gorsel":null},{"kimlik":"aaeb5201c121","sablon":"veri.ortalama.agirlikli","govde":"Bir sınıftaki 20 kız öğrencinin matematik notu ortalaması 90, 30 erkek öğrencinin ortalaması ise 80'dir. Buna göre sınıfın matematik notu ortalaması kaçtır?","secenekler":[{"harf":"A","metin":"84","dogru":true,"yanilgi":null},{"harf":"B","metin":"85","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"C","metin":"4.200","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"86","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"210","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Ağırlıklı ortalamada her grup, kişi sayısı kadar ağırlık taşır. Önce toplam puanı bul:","ifade":"20 × 90 + 30 × 80 = 4.200"},{"aciklama":"Toplam öğrenci sayısı:","ifade":"20 + 30 = 50"},{"aciklama":"Sınıf ortalaması:","ifade":"4.200 / 50 = 84"},{"aciklama":"Sınıfın ortalaması:","ifade":"84"}],"mikrobeceriler":["veri.ortalama","veri.tablo"],"yanilgi_alanlari":[],"zorluk":0.687,"gorsel":null},{"kimlik":"8b459602c062","sablon":"mantik.sifreleme.konuma_bagli","govde":"Bir şifrelemede DEFTER kelimesi HAİÖIM biçiminde yazılmaktadır. Aynı kurala göre SANDIK kelimesi nasıl yazılır?","secenekler":[{"harf":"A","metin":"NEİHEÖ","dogru":false,"yanilgi":"sifreleme_yonu_ters"},{"harf":"B","metin":"VESHMÖ","dogru":false,"yanilgi":"sifreleme_konum_yok_sayildi"},{"harf":"C","metin":"VUSZMĞ","dogru":true,"yanilgi":null},{"harf":"D","metin":"NUİZEĞ","dogru":false,"yanilgi":"sifreleme_kural_tutarsiz"},{"harf":"E","metin":"YÜŞANH","dogru":false,"yanilgi":"harf_sira_kaydi"}],"cozum":[{"aciklama":"Harfleri tek tek eşleştir; kaydırma miktarının işareti değişiyor:","ifade":"D→H (+5) , E→A (−5) , F→İ (+5) , T→Ö (−5) , E→I (+5) , R→M (−5)"},{"aciklama":"Kural konuma bağlıdır: baştan tek sıradaki harfler 5 ileri, çift sıradakiler 5 geri kayar.","ifade":null},{"aciklama":"Aynı kuralı SANDIK kelimesine uygula:","ifade":"S→V , A→U , N→S , D→Z , I→M , K→Ğ"},{"aciklama":"Şifrelenmiş kelime:","ifade":"VUSZMĞ"}],"mikrobeceriler":["mantik.sifreleme"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"85d0ed18d23d","sablon":"problem.sayi.ardisik_tek_cift","govde":"Ardışık 5 sayının toplamı 350'dir.\n\nBuna göre bu sayıların en büyüğü kaçtır?","secenekler":[{"harf":"A","metin":"140","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"B","metin":"72","dogru":true,"yanilgi":null},{"harf":"C","metin":"68","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"70","dogru":false,"yanilgi":"ardisik_ortalama_terim_sayisi"},{"harf":"E","metin":"71","dogru":false,"yanilgi":"zaman_kaydirmasi"}],"cozum":[{"aciklama":"5 ardışık sayı, ortadaki etrafında simetriktir; toplam, terim sayısı çarpı ortadaki sayıdır.","ifade":null},{"aciklama":"Sayıları yaz:","ifade":"68 + 69 + 70 + 71 + 72 = 350"},{"aciklama":"En büyüğü seç:","ifade":"72"},{"aciklama":"En büyük sayı:","ifade":"72"}],"mikrobeceriler":["problem.sayi"],"yanilgi_alanlari":["sayilar.ardisik","veri.ortalama"],"zorluk":0.687,"gorsel":null},{"kimlik":"85c359297eee","sablon":"veri.ortalama.eksik_terim","govde":"7 öğrencinin sınav notu ortalaması 70. Öğrencilerden 6'yı sırasıyla 72, 64, 86, 92, 47 ve 65 aldığına göre, kalan öğrencinin notu kaçtır?","secenekler":[{"harf":"A","metin":"71","dogru":false,"yanilgi":"ortalama_agirliksiz"},{"harf":"B","metin":"426","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"129","dogru":false,"yanilgi":"toplamda_deger_atlandi"},{"harf":"D","metin":"64","dogru":true,"yanilgi":null},{"harf":"E","metin":"134","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama, toplamın terim sayısına bölümüdür; önce toplamı bul:","ifade":"70 × 7 = 490"},{"aciklama":"Bilinen notların toplamı:","ifade":"72 + 64 + 86 + 92 + 47 + 65 = 426"},{"aciklama":"Eksik not, iki toplamın farkıdır:","ifade":"490 − 426 = 64"},{"aciklama":"Kalan öğrencinin notu:","ifade":"64"}],"mikrobeceriler":["veri.ortalama"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null},{"kimlik":"a948f1025a3e","sablon":"sayilar.uslu.negatif_us","govde":"(3⁻³)² · 3¹¹ işleminin sonucu, 3 sayısının kaçıncı kuvvetine eşittir?","secenekler":[{"harf":"A","metin":"6","dogru":false,"yanilgi":"us_us_toplandi"},{"harf":"B","metin":"17","dogru":false,"yanilgi":"negatif_us_isaret"},{"harf":"C","metin":"5","dogru":true,"yanilgi":null},{"harf":"D","metin":"−66","dogru":false,"yanilgi":"uslu_carpma_us_carpildi"},{"harf":"E","metin":"−5","dogru":false,"yanilgi":"isaret_hatasi"}],"cozum":[{"aciklama":"Negatif üs işareti değil, çarpmaya göre tersi gösterir; üs kuralları negatif üslerde de aynen işler.","ifade":null},{"aciklama":"Üssün üssünde üsler çarpılır:","ifade":"(3⁻³)² = 3⁻⁶"},{"aciklama":"Aynı tabanlı çarpmada üsler toplanır:","ifade":"3⁻⁶ · 3¹¹ = 3⁵"},{"aciklama":"Aranan kuvvet:","ifade":"5"}],"mikrobeceriler":["sayilar.uslu"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.619,"gorsel":null},{"kimlik":"b7bfb30e29bc","sablon":"oran.paylastirma.artan_pay","govde":"1.200 TL paranın bir kısmı Buse'ye ve Emre'ye 3 : 5 oranında dağıtılmış, Buse'nin payı 405 TL olmuştur. Geriye kaç TL kalmıştır?","secenekler":[{"harf":"A","metin":"150 TL","dogru":false,"yanilgi":"paylastirmada_toplam_yerine_pay"},{"harf":"B","metin":"195 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"C","metin":"2.280 TL","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"D","metin":"120 TL","dogru":true,"yanilgi":null},{"harf":"E","metin":"675 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Buse'nin payından birim payı çöz:","ifade":"3k = 405 → k = 135"},{"aciklama":"Dağıtılan toplamı bul:","ifade":"(3 + 5) × 135 = 1.080 TL"},{"aciklama":"Kalan, toplamdan dağıtılanın çıkarılmasıdır:","ifade":"1.200 − 1.080 = 120 TL"},{"aciklama":"Geriye kalan:","ifade":"120 TL"}],"mikrobeceriler":["oran.paylastirma","oran.temel"],"yanilgi_alanlari":[],"zorluk":2.727,"gorsel":null},{"kimlik":"d159483fc36d","sablon":"yuzde.artis.indirim","govde":"Fiyatı 4.200 TL olan bir termos, %80 indirimle satılmaktadır. Termosun indirimli fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"840 TL","dogru":true,"yanilgi":null},{"harf":"B","metin":"7.560 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"C","metin":"4.120 TL","dogru":false,"yanilgi":"yuzde_yuze_bolme_atlandi"},{"harf":"D","metin":"3.360 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"168 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"İndirim, **eski** fiyat üzerinden hesaplanır.","ifade":null},{"aciklama":"İndirim tutarı:","ifade":"4.200 × 80 / 100 = 3.360"},{"aciklama":"İndirimli fiyat, eski fiyattan bu tutarın çıkarılmasıdır:","ifade":"4.200 − 3.360 = 840"},{"aciklama":"İndirimli fiyat:","ifade":"840 TL"}],"mikrobeceriler":["yuzde.artis_azalis","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.322,"gorsel":null},{"kimlik":"3c89a18ad05c","sablon":"veri.ortalama.eleman_cikma","govde":"Bir gruptaki 6 kişinin yaş ortalaması 32. Gruptan bir kişi ayrılınca ortalama 33 olmuştur. Ayrılan kişinin yaşı kaçtır?","secenekler":[{"harf":"A","metin":"1","dogru":false,"yanilgi":"ortalamayla_dogrudan_islem"},{"harf":"B","metin":"27","dogru":true,"yanilgi":null},{"harf":"C","metin":"165","dogru":false,"yanilgi":"ortalama_yerine_toplam"},{"harf":"D","metin":"357","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"6","dogru":false,"yanilgi":"ortalama_eksik_terim"}],"cozum":[{"aciklama":"Ortalama tek başına işlem yapılacak bir sayı değildir; önce **toplama** çevrilir.","ifade":null},{"aciklama":"Ayrılmadan önceki toplam