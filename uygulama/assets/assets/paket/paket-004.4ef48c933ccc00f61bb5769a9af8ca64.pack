m":"kişi","seriler":[{"ad":"Personel","degerler":[760,570,380,190]}]}},{"kimlik":"07682dc4cc15","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 6'ya bölümünden kalan 4, 8'e bölümünden kalan 6'dır. Bu koşulu sağlayan ve 240'tan büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"244","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"246","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"},{"harf":"C","metin":"262","dogru":true,"yanilgi":null},{"harf":"D","metin":"242","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"286","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 2 eksik. Demek ki sayıya 2 eklenirse sayı hem 6 hem 8 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(6, 8) = 24"},{"aciklama":"Sayı 24'ün katından 2 eksiktir. 240'tan büyük ilk böyle sayı:","ifade":"262"},{"aciklama":"Aranan sayı:","ifade":"262"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.178,"gorsel":null},{"kimlik":"cc78a31fae22","sablon":"veri.grafik.cizgi_artis","govde":"Bir spor kulübünün Ankara şubesindeki yıllık üye sayıları yukarıdaki çizgi grafiğinde verilmiştir.\n\nBuna göre 2020 yılından 2022 yılına üye sayısındaki artış kaç kişidir?","secenekler":[{"harf":"A","metin":"50 kişi","dogru":false,"yanilgi":"grafik_artis_egim"},{"harf":"B","metin":"30 kişi","dogru":false,"yanilgi":"komsu_kategori_okundu"},{"harf":"C","metin":"40 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"80 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"10 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Artış miktarı, eğrinin dikliği değil iki noktadaki değerlerin farkıdır.","ifade":null},{"aciklama":"2020 değeri:","ifade":"210 kişi"},{"aciklama":"2022 değeri:","ifade":"250 kişi"},{"acikla