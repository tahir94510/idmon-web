ır:","ifade":"120 × 18 = 2.160 km"},{"aciklama":"Yeni süre, aynı yolun yeni hıza bölümüdür:","ifade":"2.160 / 30 = 72 saat"},{"aciklama":"Geçen süre:","ifade":"72 saat"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":0.036,"gorsel":null},{"kimlik":"1a3970aaf836","sablon":"yuzde.kar_zarar.maliyet_bulma","govde":"Bir ürün %60 kârla 7.200 TL fiyatına satılmıştır. Ürünün maliyeti kaç TL'dir?","secenekler":[{"harf":"A","metin":"2.700 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"4.500 TL","dogru":true,"yanilgi":null},{"harf":"C","metin":"7.140 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"D","metin":"18.000 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"E","metin":"2.880 TL","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"}],"cozum":[{"aciklama":"Kâr her zaman maliyet üzerinden hesaplanır; satış fiyatı maliyetin %160'ıdır:","ifade":"maliyet × 160/100 = 7.200"},{"aciklama":"Maliyet, satış fiyatının bu orana bölümüdür:","ifade":"7.200 × 100/160 = 4.500 TL"},{"aciklama":"Maliyet:","ifade":"4.500 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.398,"gorsel":null},{"kimlik":"9cc212c04fcc","sablon":"sayilar.bolunebilme.eksik_rakam","govde":"166A0 beş basamaklı sayısı 12 ile tam bölünmektedir. Buna göre A yerine yazılabilecek rakamların toplamı kaçtır?","secenekler":[{"harf":"A","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"B","metin":"6","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"C","metin":"15","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"D","metin":"10","dogru":true,"yanilgi":null},{"harf":"E","metin":"45","dogru":false,"yanilgi":"bolunebilme_son_basamak"}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A0 sayısı 4'ün katı olmalı ⟹ 20 ve 80"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"1 + 6 + 6 + A + 0 = 13 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"2 ve 8"},{"aciklama":"Bu rakamları topla:","ifade":"2 + 8 = 10"},{"aciklama":"Rakamların toplamı:","ifade":"10"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"b2259e35c675","sablon":"veri.tablo.sutun_yuzde_degisim","govde":"Bir kulübün dört şehirdeki şubelerinin 2024 ve 2025 yıllarındaki üye sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon'da üye sayısı 2024'ten 2025'e yüzde kaç artmıştır?","secenekler":[{"harf":"A","metin":"%25","dogru":true,"yanilgi":null},{"harf":"B","metin":"%375","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"%20","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"D","metin":"%35","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"%125","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Trabzon satırındaki iki değeri oku:","ifade":"2024: 140 · 2025: 175"},{"aciklama":"Artış miktarını bul:","ifade":"175 − 140 = 35"},{"aciklama":"Artış oranı **eski** değere bölünür, yeniye değil:","ifade":"35/140 × 100"},{"aciklama":"Artış oranı:","ifade":"%25"}],"mikrobeceriler":["veri.tablo","veri.yuzde_pay"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":0.254,"gorsel":{"tur":"tablo","baslik":"Yıllara göre üye sayısı (kişi)","etiketler":["2024","2025"],"birim":"kişi","seriler":[{"ad":"Samsun","degerler":[40,190]},{"ad":"Konya","degerler":[240,360]},{"ad":"Bursa","degerler":[340,390]},{"ad":"Trabzon","degerler":[140,175]}]}},{"kimlik":"51d06abfa6fb","sablon":"mantik.dizi.artan_fark","govde":"26, 34, 45, 59, 76, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"95","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"},{"harf":"B","metin":"56","dogru":false,"yanilgi":"dizi_yon_ters"},{"harf":"C","metin":"96","dogru":true,"yanilgi":null},{"harf":"D","metin":"93","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"84","dogru":false,"yanilgi":"dizi_kurali_eksik"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farkları yaz:","ifade":"34−26=8 , 45−34=11 , 59−45=14 , 76−59=17"},{"aciklama":"Farklar sabit değil; her adımda 3 artıyor. Sıradaki fark:","ifade":"17 + 3 = 20"},{"aciklama":"Son terime bu farkı ekle:","ifade":"76 + 20 = 96"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"96"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"9445abceb9aa","sablon":"problem.hareket.karsilikli","govde":"Aralarındaki uzaklık 450 km olan Trabzon ve İzmir şehirlerinden aynı anda birbirine doğru iki araç hareket ediyor. Araçların hızları sırasıyla 60 km/sa ve 15 km/sa olduğuna göre, araçlar kaç saat sonra karşılaşır?","secenekler":[{"harf":"A","metin":"10 saat","dogru":false,"yanilgi":"hiz_toplama_yonu"},{"harf":"B","metin":"6 saat","dogru":true,"yanilgi":null},{"harf":"C","metin":"30 saat","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"D","metin":"12 saat","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"E","metin":"7,5 saat","dogru":false,"yanilgi":"hareket_tek_hiz"}],"cozum":[{"aciklama":"Zıt yönde hareket eden araçlar için yaklaşma hızı, hızların toplamıdır:","ifade":"60 + 15 = 75 km/sa"},{"aciklama":"Karşılaşma süresi, aradaki uzaklığın yaklaşma hızına bölümüdür:","ifade":"450 / 75 = 6 saat"},{"aciklama":"Karşılaşma süresi:","ifade":"6 saat"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":2.997,"gorsel":null},{"kimlik":"c06a9fd6954e","sablon":"veri.tablo.yuzde_pay","govde":"Bir şirketin dört şubesindeki personel sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Trabzon şubesindeki personel sayısı, toplam 700 personelin yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%5","dogru":true,"yanilgi":null},{"harf":"B","metin":"%95","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%50","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"D","metin":"%25","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"E","metin":"%10","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"}],"cozum":[{"aciklama":"Trabzon şubesinin personel sayısı:","ifade":"35"},{"aciklama":"Payda, sorunun tanımladığı bütündür: toplam personel.","ifade":"700"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"35 / 700 × 100 = %5"},{"aciklama":"Toplam içindeki pay:","ifade":"%5"}],"mikrobeceriler":["veri.yuzde_pay","veri.tablo","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":-0.643,"gorsel":{"tur":"tablo","baslik":"Şubelere göre personel sayısı","etiketler":["İzmir","Eskişehir","Konya","Trabzon"],"birim":"kişi","seriler":[{"ad":"Personel","degerler":[350,175,140,35]}]}},{"kimlik":"d9eaf1ef8bc1","sablon":"sayilar.bolunebilme.ortak_kalan","govde":"Bir doğal sayının 9'a bölümünden kalan 7, 12'ye bölümünden kalan 10'dur. Bu koşulu sağlayan ve 651'den büyük en küçük doğal sayı kaçtır?","secenekler":[{"harf":"A","metin":"682","dogru":true,"yanilgi":null},{"harf":"B","metin":"655","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"C","metin":"686","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"D","metin":"754","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"E","metin":"658","dogru":false,"yanilgi":"bolunebilme_kurali_karisimi"}],"cozum":[{"aciklama":"Her iki bölmede de kalan, bölenden 2 eksik. Demek ki sayıya 2 eklenirse sayı hem 9 hem 12 ile tam bölünür.","ifade":null},{"aciklama":"İki bölene birden bölünme, çarpımlarıyla değil EKOK'larıyla ifade edilir:","ifade":"EKOK(9, 12) = 36"},{"aciklama":"Sayı 36'nın katından 2 eksiktir. 651'den büyük ilk böyle sayı:","ifade":"682"},{"aciklama":"Aranan sayı:","ifade":"682"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":1.178,"gorsel":null},{"kimlik":"67a4e3543219","sablon":"oran.ters.isci_gun","gov