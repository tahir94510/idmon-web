bolunebilme_son_basamak"},{"harf":"B","metin":"20","dogru":false,"yanilgi":"bolunebilme_kismi_kosul"},{"harf":"C","metin":"10","dogru":false,"yanilgi":"rakam_toplami_yerine_sayi"},{"harf":"D","metin":"12","dogru":false,"yanilgi":"bolunebilme_carpanlar_asal_degil"},{"harf":"E","metin":"4","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"12 bileşik bir bölendir. Aralarında asal çarpanlarına ayrılır: 4 ve 3. Sayı ikisine birden bölünmelidir.","ifade":null},{"aciklama":"4 kuralı son iki basamağa bakar:","ifade":"A4 sayısı 4'ün katı olmalı ⟹ 44"},{"aciklama":"3 kuralı rakamlar toplamına bakar:","ifade":"2 + 7 + 1 + A + 4 = 14 + A, bu toplam 3'ün katı olmalı"},{"aciklama":"İki koşulu birden sağlayan rakamlar:","ifade":"4"},{"aciklama":"Bu rakamları topla:","ifade":"4 = 4"},{"aciklama":"Rakamların toplamı:","ifade":"4"}],"mikrobeceriler":["sayilar.bolunebilme"],"yanilgi_alanlari":[],"zorluk":0.758,"gorsel":null},{"kimlik":"d63609aab559","sablon":"mantik.dizi.sabit_oran","govde":"10, 20, 40, 80, 160, ?\n\nYukarıdaki sayı dizisinde soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"640","dogru":false,"yanilgi":"dizi_bir_adim_fazla"},{"harf":"B","metin":"160","dogru":false,"yanilgi":"dizi_son_terimi_tekrarladi"},{"harf":"C","metin":"320","dogru":true,"yanilgi":null},{"harf":"D","metin":"240","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"80","dogru":false,"yanilgi":"dizi_yon_ters"}],"cozum":[{"aciklama":"Ardışık terimler arasındaki farklar sabit değil; oranlara bak:","ifade":"20÷10=2 , 40÷20=2 , 80÷40=2 , 160÷80=2"},{"aciklama":"Oran her adımda aynı, yani her terim bir öncekinin katı:","ifade":"oran = 2"},{"aciklama":"Son terimi bu oranla çarp:","ifade":"160 × 2 = 320"},{"aciklama":"Soru işareti yerine gelecek sayı:","ifade":"320"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":0.906,"gorsel":null},{"kimlik":"394aa01381d4","sablon":"problem.hareket.mesafe_bulma","govde":"Bir otomobil İzmir'e giderken yolun ilk bölümünü saatte 90 km hızla 1 saatte, kalan bölümünü saatte 40 km hızla 4 saatte almıştır. Otomobilin aldığı toplam yol kaç kilometredir?","secenekler":[{"harf":"A","metin":"400 km","dogru":false,"yanilgi":"hareket_formul_yer_degistirme"},{"harf":"B","metin":"325 km","dogru":false,"yanilgi":"hiz_ortalamasi_aritmetik"},{"harf":"C","metin":"90 km","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"200 km","dogru":false,"yanilgi":"hareket_yavas_arac"},{"harf":"E","metin":"250 km","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yol = hız × süre. Birinci bölüm:","ifade":"90 × 1 = 90 km"},{"aciklama":"İkinci bölüm:","ifade":"40 × 4 = 160 km"},{"aciklama":"Toplam yol iki bölümün toplamıdır. Hızları ortalayıp toplam süreyle çarpmak yanlış olur: süreler eşit değil.","ifade":"90 + 160 = 250 km"},{"aciklama":"Toplam yol:","ifade":"250 km"}],"mikrobeceriler":["problem.hareket"],"yanilgi_alanlari":[],"zorluk":0.11,"gorsel":null},{"kimlik":"957a4c4d38ff","sablon":"oran.ters.isci_gun","govde":"Bir inşaat işini 29 işçi 30 günde bitirmektedir. Aynı işi, aynı hızda çalışan 58 işçi kaç günde bitirir?","secenekler":[{"harf":"A","metin":"60 gün","dogru":false,"yanilgi":"ters_orantiyi_dogru_kurma"},{"harf":"B","metin":"1 gün","dogru":false,"yanilgi":"ters_orantida_fark_kullanma"},{"harf":"C","metin":"870 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"15 gün","dogru":true,"yanilgi":null},{"harf":"E","metin":"59 gün","dogru":false,"yanilgi":"ters_orantida_fark_ters_yon"}],"cozum":[{"aciklama":"İşçi sayısı ile süre ters orantılıdır; çarpımları toplam iş yükünü verir:","ifade":"29 × 30 = 870 işçi-gün"},{"aciklama":"Aynı iş yükü 58 işçiye bölündüğünde süre:","ifade":"870 / 58 = 15 gün"},{"aciklama":"İşin biteceği süre:","ifade":"15 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":[],"zorluk":2.07,"gorsel":null},{"kimlik":"6b81984ddc13","sablon":"yuzde.kar_zarar.satis_fiyati","govde":"Bir esnaf, tanesini 3.300 TL maliye