:"22 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"}],"cozum":[{"aciklama":"Birlikte çalışmada süreler değil, birim zamandaki iş hızları toplanır:","ifade":"1/220 + 1/22 = 11/220"},{"aciklama":"Birlikte bitirme süresi, bu hızın tersidir:","ifade":"220/11 = 20 gün"},{"aciklama":"Birlikte çalışma süresi:","ifade":"20 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.785,"gorsel":null,"grup":"2c29495cbecb","grup_govde":"Bir işi Selin tek başına 220 günde, Fatma tek başına 22 günde bitirmektedir."},{"kimlik":"2c29495cbecb-2","sablon":"problem.blok.ortak_is_iki_soru","govde":"Selin işe başlayıp 90 gün çalıştıktan sonra işi bırakmıştır. Kalan işi Fatma tek başına kaç günde bitirir?","secenekler":[{"harf":"A","metin":"242 gün","dogru":false,"yanilgi":"isci_sure_toplama"},{"harf":"B","metin":"121 gün","dogru":false,"yanilgi":"isci_sure_ortalamasi"},{"harf":"C","metin":"22 gün","dogru":false,"yanilgi":"isci_hizli_olan_belirler"},{"harf":"D","metin":"9 gün","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"13 gün","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Selin bir günde işin 1/220'sini yapıyor; 90 gün çalışınca yaptığı iş:","ifade":"90/220"},{"aciklama":"Kalan iş, bütünden yapılanı çıkarmaktır; paydalar aynı olduğu için paylar çıkarılır:","ifade":"(220 − 90)/220 = 13/22"},{"aciklama":"Fatma işin tamamını 22 günde bitiriyor; kalanı için süre, kalan kesirle çarpılır:","ifade":"13/22 × 22 = 13"},{"aciklama":"Kalan iş için gereken süre:","ifade":"13 gün"}],"mikrobeceriler":["problem.isci"],"yanilgi_alanlari":[],"zorluk":3.945,"gorsel":null,"grup":"2c29495cbecb","grup_govde":"Bir işi Selin tek başına 220 günde, Fatma tek başına 22 günde bitirmektedir."},{"kimlik":"d6729cec191b","sablon":"oran.temel.oran_ve_toplam","govde":"Selin'in parasının Burak'ın parasına oranı 12/7'dir. İkisinin parası toplam 10.260 TL olduğuna göre Selin kaç TL'ye sahiptir?","secenekler":[{"harf":"A","metin":"3.780 TL","dogru":false,"yanilg