3","sablon":"cebir.denklem.mutlak_sistem","govde":"x, y ve z gerçel sayıları için\n\n|3x + y − 28| + z = 2\n|2x − 2y − 16| = 2z − 4\n\neşitlikleri veriliyor.\n\nBuna göre x + y kaçtır?","secenekler":[{"harf":"A","metin":"10","dogru":true,"yanilgi":null},{"harf":"B","metin":"8","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"2","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"−18","dogru":false,"yanilgi":"taraf_degistirirken_toplama"},{"harf":"E","metin":"12","dogru":false,"yanilgi":"mutlak_deger_negatife_esitlendi"}],"cozum":[{"aciklama":"Mutlak değer negatif olamaz. Birinci eşitlikten:","ifade":"z = 2 − |…| ≤ 2"},{"aciklama":"İkinci eşitliğin sol yanı da negatif olamaz:","ifade":"2z − 4 ≥ 0 , yani z ≥ 2"},{"aciklama":"İkisi birlikte:","ifade":"z = 2"},{"aciklama":"O hâlde iki mutlak değerin içi de sıfır:","ifade":"3x + y = 28 , 2x − 2y = 16"},{"aciklama":"Bu iki denklemi çöz:","ifade":"x = 9 , y = 1"},{"aciklama":"İstenen toplam, x + y:","ifade":"10"}],"mikrobeceriler":["cebir.denklem"],"yanilgi_alanlari":["sayilar.mutlak"],"zorluk":2.176,"gorsel":null},{"kimlik":"57e7f48a4e5b","sablon":"sayilar.rasyonel.kat_denklemi","govde":"Bir sayının 4/7 katı ile 2/21 katı arasındaki fark 240'tır.\n\nBuna göre bu sayı kaçtır?","secenekler":[{"harf":"A","metin":"1.120","dogru":false,"yanilgi":"kesir_toplamada_payda_toplandi"},{"harf":"B","metin":"504","dogru":true,"yanilgi":null},{"harf":"C","metin":"800/7","dogru":false,"yanilgi":"kesir_bolmede_ters_cevrilmedi"},{"harf":"D","metin":"360","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"E","metin":"840","dogru":false,"yanilgi":"kesir_payda_esitlenmedi"}],"cozum":[{"aciklama":"Sayıya x dersek, iki katın farkı x ile çarpanların farkına eşittir:","ifade":"(4/7 − 2/21) · x = 240"},{"aciklama":"Parantezdeki çıkarma için paydalar farklı. Önce paydaları eşitliyoruz: ikisine de tam bölünen en küçük sayıyı, yani EKOK'u buluyoruz.","ifade":"EKOK(7, 21) = 21"},{"aciklama":"Her kesri, paydası 21 ola