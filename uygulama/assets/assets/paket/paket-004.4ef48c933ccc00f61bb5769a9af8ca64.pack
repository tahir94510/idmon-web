tin":"68.800","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"C","metin":"698","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"D","metin":"6.192","dogru":false,"yanilgi":"basamak_farki_yanlis_bolen"},{"harf":"E","metin":"6.880","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Bir sayının sağına 0 yazmak, onu 10 katına çıkarır. İlk sayıya x dersek yeni sayı 10x olur.","ifade":null},{"aciklama":"Aradaki fark:","ifade":"10x − x = 9x = 6.192"},{"aciklama":"İlk sayı:","ifade":"x = 6.192 / 9 = 688"},{"aciklama":"Sorulan yeni sayıdır:","ifade":"10 × 688 = 6.880"},{"aciklama":"Yeni sayı:","ifade":"6.880"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":["cebir.denklem"],"zorluk":-0.739,"gorsel":null},{"kimlik":"f5704ed19441","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Yaz mevsiminde Eskişehir'in yaptığı satışın İzmir'in yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"1,75","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"0,3","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"0,5","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"90","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"2","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Yaz sütunundan iki değeri oku:","ifade":"Eskişehir: 180 · İzmir: 90"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"180 / 90 = 2"},{"aciklama":"Aranan oran:","ifade":"2"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Eskişehir","degerler":[360,180,210,120]},{"ad":"İzmir","degerler":[150,90,120,240]},{"ad":"Samsun","degerler":[150,150,300,240]},{"ad":"Ankara","degerler":[60,150,180,330]}]}},{"kimlik":"df7c1d18f8a2","sablon":"cebir.esitsizlik.iki_taraf_bilinmeyen","govde":"10x + 20 > 6x − 7 eşitsizliğini sağlayan en küçük tam sayı kaçtır?","secenekler":[{"harf":"A","metin":"−7","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"},{"harf":"B","metin":"4","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"−1","dogru":false,"yanilgi":"esitsizlikte_sabitler_ayni_tarafta"},{"harf":"D","metin":"−5","dogru":false,"yanilgi":"esitsizlik_tam_sayi_sayimi"},{"harf":"E","metin":"−6","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"x'li terimleri bir tarafta, sabitleri öbür tarafta topla:","ifade":"10x − 6x > −7 − 20"},{"aciklama":"Katsayıları sadeleştir:","ifade":"4x > −27"},{"aciklama":"Her iki tarafı 4 ile böl:","ifade":"x > −6,75"},{"aciklama":"Eşitsizliği sağlayan en küçük tam sayı:","ifade":"−6"}],"mikrobeceriler":["cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":2.107,"gorsel":null},{"kimlik":"5af8f39feb42","sablon":"kume.sayma.en_az_bir_kosullu","govde":"11 kadın ve 12 erkeğin bulunduğu bir ekipten 4 kişilik bir çalışma grubu seçilecektir. Grupta en az bir kadın bulunması koşuluyla, bu seçim kaç farklı biçimde yapılabilir?","secenekler":[{"harf":"A","metin":"8.360","dogru":true,"yanilgi":null},{"harf":"B","metin":"200.640","dogru":false,"yanilgi":"sayma_sira_onemli_mi"},{"harf":"C","metin":"8.855","dogru":false,"yanilgi":"sayma_ozdes_nesne"},{"harf":"D","metin":"16.940","dogru":false,"yanilgi":"sayma_toplama_carpma_karisimi"},{"harf":"E","metin":"495","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"}],"cozum":[{"aciklama":"'En az bir' durumunu tek tek saymak uzun sürer. Kısa yol: önce hiçbir kısıt koymadan say, sonra **istenmeyen** durumları düş. Burada istenmeyen durum, hiç kadın olmaması.","ifade":null},{"aciklama":"Önce koşulsuz seçim sayısı. C(n, r), n kişiden r kişiyi sırasız seçme sayısıdır; burada 23 kişiden 4 kişi:","ifade":"C(23, 4) = (23×22×21×20) / (4×3×2×1) = 8.855"},{"aciklama":"Hiç kadın içermeyen seçimler yalnızca erkeklerden kurulur:","ifade":"C(12, 4) = (12×11×10×9) / (4×3×2×1) = 495"},{"aciklama":"Farkı al:","ifade":"8.855 − 495 = 8.360"},{"aciklama":"Farklı seçim sayısı:","ifade":"8.360"}],"mikrobeceriler":["kume.sayma"],"yanilgi_alanlari":["kume.olasilik"],"zorluk":2.176,"gorsel":null},{"kimlik":"edcc36bc8eec","sablon":"oran.temel.uc_terimli","govde":"Üç arkadaşın biriktirdiği para 12 : 3 : 10 oranındadır. Birinci arkadaşın parası 504 TL olduğuna göre ikinci arkadaşın parası kaç TL'dir?","secenekler":[{"harf":"A","metin":"350 TL","dogru":false,"yanilgi":"paylastirmada_esit_bolme"},{"harf":"B","metin":"2.016 TL","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"126 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"3 TL","dogru":false,"yanilgi":"oran_katsayisi_pay_sanildi"},{"harf":"E","metin":"42 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Oranı bir **birim pay** ile yaz: paylar k'nın katlarıdır.","ifade":"12k : 3k : 10k"},{"aciklama":"Bilinen paydan k'yı çöz (birinci arkadaş):","ifade":"12k = 504 → k = 42"},{"aciklama":"Sorulan payı k ile çarp (ikinci arkadaş):","ifade":"3 × 42 = 126"},{"aciklama":"İkinci arkadaşın parası:","ifade":"126 TL"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.495,"gorsel":null},{"kimlik":"2a937bf8a2da","sablon":"veri.tablo.iki_satir_farki","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Konya'nın yıllık toplam satışı, Eskişehir'in yıllık toplam satışından kaç adet fazladır?","secenekler":[{"harf":"A","metin":"50 adet","dogru":false,"yanilgi":"toplam_yerine_ortalama"},{"harf":"B","metin":"200 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"590 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"505 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"1.065 adet","dogru":false,"yanilgi":"toplam_yerine_parca"}],"cozum":[{"aciklama":"Konya satırını topla:","ifade":"390 + 95 + 190 + 390 = 1.065"},{"aciklama":"Eskişehir satırını topla:","ifade":"180 + 40 + 385 + 260 = 865"},{"aciklama":"Sorulan iki toplamın **farkı**:","ifade":"1.065 − 865 = 200"},{"aciklama":"Aradaki fark:","ifade":"200 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":-0.765,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"Trabzon","degerler":[395,195,340,210]},{"ad":"Eskişehir","degerler":[180,40,385,260]},{"ad":"Samsun","degerler":[310,90,390,65]},{"ad":"Konya","degerler":[390,95,190,390]}]}},{"kimlik":"35d67f6ddb8f","sablon":"yuzde.kar_zarar.iki_urun","govde":"Bir satıcı maliyeti 1.800 TL olan bir kol saati %40 kârla, maliyeti 1.500 TL olan bir bisiklet ise %30 zararla satmıştır. Satıcının bu iki satıştan net kârı kaç TL'dir?","secenekler":[{"harf":"A","metin":"330 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"10 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"1.170 TL","dogru":false,"yanilgi":"yuzde_yon_ters"},{"harf":"D","metin":"720 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"270 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Kâr, o ürünün **kendi** maliyeti üzerinden alınır:","ifade":"1.800 × 40/100 = 720 TL"},{"aciklama":"Zarar da kendi maliyeti üzerinden:","ifade":"1.500 × 30/100 = 450 TL"},{"aciklama":"Net sonuç, iki tutarın farkıdır. Yüzdeler doğrudan çıkarılamaz: tabanları farklı.","ifade":"720 − 450 = 270 TL"},{"aciklama":"Net kâr:","ifade":"270 TL"}],"mikrobeceriler":["yuzde.kar_zarar"],"yanilgi_alanlari":["yuzde.temel"],"zorluk":1.724,"gorsel":null},{"kimlik":"0e309b14e1cd","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 396 azalmaktadır. Bu sayının yüzler basamağındaki rakam 5, onlar basamağındaki rakam 4'tür. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"541","dogru":true,"yanilgi":null},{"harf":"B","metin":"514","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"},{"harf":"C","metin":"51","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"D","metin":"145","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"E","metin":"505","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (5 − b) = 396 ⟹ 5 − b = 4 ⟹ b = 1"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 5 + 10 × 4 + 1 = 541"},{"aciklama":"Aranan sayı:","ifade":"541"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.013,"gorsel":null},{"kimlik":"47713fd60cdd-1","sablon":"kume.blok.iki_kurs_uc_soru","govde":"Yalnızca İngilizce kursuna giden kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"6","dogru":true,"yanilgi":null},{"harf":"B","metin":"2","dogru":false,"yanilgi":"kesisim_fark_yerine_verildi"},{"harf":"C","metin":"16","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"D","metin":"10","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"E","metin":"8","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"}],"cozum":[{"aciklama":"Bir kursa giden öğrenci sayısı, iki kursa da gidenleri de içerir.","ifade":"İngilizce kursuna giden: 8"},{"aciklama":"Yalnızca İngilizce kursuna gidenleri bulmak için iki kursa da gidenleri çıkar:","ifade":"8 − 2 = 6"},{"aciklama":"Yalnızca o kursa gidenler:","ifade":"6"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.036,"gorsel":null,"grup":"47713fd60cdd","grup_govde":"Bir sınıfta 40 öğrenci vardır. Bu öğrencilerin 8 tanesi İngilizce, 12 tanesi matematik kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 2'dir."},{"kimlik":"47713fd60cdd-2","sablon":"kume.blok.iki_kurs_uc_soru","govde":"Bu kursların hiçbirine gitmeyen kaç öğrenci vardır?","secenekler":[{"harf":"A","metin":"22","dogru":true,"yanilgi":null},{"harf":"B","metin":"18","dogru":false,"yanilgi":"kume_hicbiri_atlandi"},{"harf":"C","metin":"20","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"38","dogru":false,"yanilgi":"kume_tumleyen_karisimi"},{"harf":"E","metin":"24","dogru":false,"yanilgi":"kume_yalnizca_biri"}],"cozum":[{"aciklama":"Önce en az bir kursa gidenleri bul. İki kümenin birleşiminde ortak kısım iki kez sayıldığı için bir kez düşülür:","ifade":"8 + 12 − 2 = 18"},{"aciklama":"Sınıfın tamamından bu sayıyı çıkar:","ifade":"40 − 18 = 22"},{"aciklama":"Hiçbir kursa gitmeyenler:","ifade":"22"}],"mikrobeceriler":["kume.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.42,"gorsel":null,"grup":"47713fd60cdd","grup_govde":"Bir sınıfta 40 öğrenci vardır. Bu öğrencilerin 8 tanesi İngilizce, 12 tanesi matematik kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 2'dir."},{"kimlik":"47713fd60cdd-3","sablon":"kume.blok.iki_kurs_uc_soru","govde":"İki kursa da giden öğrenciler, sınıfın yüzde kaçıdır?","secenekler":[{"harf":"A","metin":"%95","dogru":false,"yanilgi":"tumleyeni_verme"},{"harf":"B","metin":"%25","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"C","metin":"%50","dogru":false,"yanilgi":"kesisim_iki_kez_sayildi"},{"harf":"D","metin":"%40","dogru":false,"yanilgi":"kume_yalnizca_biri"},{"harf":"E","metin":"%5","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"İki kursa da gidenlerin sayısı soruda verilmiş:","ifade":"2"},{"aciklama":"Payda, sorunun tanımladığı bütündür: sınıfın tamamı.","ifade":"40"},{"aciklama":"Payı bütüne bölüp 100 ile çarp:","ifade":"2 / 40 × 100 = %5"},{"aciklama":"Sınıf içindeki pay:","ifade":"%5"}],"mikrobeceriler":["kume.temel","yuzde.temel"],"yanilgi_alanlari":["veri.yuzde_pay"],"zorluk":0.626,"gorsel":null,"grup":"47713fd60cdd","grup_govde":"Bir sınıfta 40 öğrenci vardır. Bu öğrencilerin 8 tanesi İngilizce, 12 tanesi matematik kursuna gitmektedir. Her iki kursa da giden öğrenci sayısı 2'dir."},{"kimlik":"a7448d131fc0","sablon":"mantik.dizi.kare_farki","govde":"Aşağıdaki sayı dizisi belirli bir kurala göre oluşturulmuştur:\n\n43, 45, 53, 71, 103, ?\n\nBuna göre soru işareti yerine hangi sayı gelmelidir?","secenekler":[{"harf":"A","metin":"103","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"B","metin":"153","dogru":true,"yanilgi":null},{"harf":"C","metin":"113","dogru":false,"yanilgi":"dizi_kurali_eksik"},{"harf":"D","metin":"135","dogru":false,"yanilgi":"dizi_fark_sabit_sanma"},{"harf":"E","metin":"152","dogru":false,"yanilgi":"dizi_farki_bir_kaydirdi"}],"cozum":[{"aciklama":"Ardışık terimlerin farklarını yaz:","ifade":"2, 8, 18, 32"},{"aciklama":"Farklar ardışık sayıların karelerinin **2 katı**: 2·1², 2·2², 2·3², 2·4². Sıradaki fark 2·5²:","ifade":"50"},{"aciklama":"Son terime bu farkı ekle:","ifade":"103 + 50 = 153"},{"aciklama":"Sıradaki terim:","ifade":"153"}],"mikrobeceriler":["mantik.dizi"],"yanilgi_alanlari":[],"zorluk":1.458,"gorsel":null},{"kimlik":"b43d286110a9","sablon":"problem.yas.toplam_iliskisi","govde":"Ece ile Deniz'in bugünkü yaşları toplamı 52'dir, aralarındaki yaş farkı ise 14'tür.\n\nBuna göre büyük olanın bugünkü yaşı kaçtır?","secenekler":[{"harf":"A","metin":"66","dogru":false,"yanilgi":"toplam_fark_ikiye_bolunmedi"},{"harf":"B","metin":"19","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"46","dogru":false,"yanilgi":"zaman_kaydirmasi"},{"harf":"D","metin":"33","dogru":true,"yanilgi":null},{"harf":"E","metin":"59","dogru":false,"yanilgi":"yas_farki_degisti"}],"cozum":[{"aciklama":"Toplamı ve farkı verilen iki sayıda büyük olan, (toplam + fark) / 2 ile bulunur.","ifade":null},{"aciklama":"Yerine yaz:","ifade":"(52 + 14) / 2 = 33"},{"aciklama":"Küçük olan da toplamdan çıkarılarak bulunur:","ifade":"52 − 33 = 19"},{"aciklama":"Büyük olanın yaşı:","ifade":"33"}],"mikrobeceriler":["problem.yas","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":-1.124,"gorsel":null},{"kimlik":"32097eb6811f","sablon":"veri.tablo.kosullu_toplam","govde":"Bir markette satılan muz, patates ve soğanın kilogram alış ve satış fiyatları tabloda verilmiştir.\n\nMarkette bu üç üründen toplam 150 kilogram satılmış ve toplam 72 TL kâr elde edilmiştir.\n\nBuna göre markette toplam kaç kilogram muz ve patates satılmıştır?","secenekler":[{"harf":"A","metin":"120","dogru":true,"yanilgi":null},{"harf":"B","metin":"30","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"135","dogru":false,"yanilgi":"kar_farki_yerine_tam_kar"},{"harf":"D","metin":"140","dogru":false,"yanilgi":"fark_yerine_toplam"},{"harf":"E","metin":"100","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"}],"cozum":[{"aciklama":"Kilogram başına kâr = satış − alış. Muz: 2,9 − 2,5 = 0,4 TL, Patates: 1,9 − 1,5 = 0,4 TL, Soğan: 5,8 − 5 = 0,8 TL.","ifade":null},{"aciklama":"Muz ile patatesin kilogram kârı aynı. Hepsi 0,4 TL kârla satılsaydı toplam kâr şu olurdu:","ifade":"150 · 0,4 = 60 TL"},{"aciklama":"Fazladan 12 TL yalnızca soğan yüzünden: onun her kilogramı 0,4 TL fazla kazandırıyor.","ifade":"soğan = 12 ÷ 0,4 = 30 kg"},{"aciklama":"İstenen: 150 − 30 =","ifade":"120"}],"mikrobeceriler":["veri.tablo","problem.sayi","cebir.denklem"],"yanilgi_alanlari":[],"zorluk":1.902,"gorsel":{"tur":"tablo","baslik":"Kilogram fiyatları (TL)","etiketler":["Alış fiyatı","Satış fiyatı"],"birim":"TL","seriler":[{"ad":"Muz","degerler":[2.5,2.9]},{"ad":"Patates","degerler":[1.5,1.9]},{"ad":"Soğan","degerler":[5.0,5.8]}]}},{"kimlik":"6f7811b7a851","sablon":"oran.temel.zincir","govde":"Yusuf'un parasının Ali'nin parasına oranı 6/7, Ali'nin parasının Elif'in parasına oranı 9/4 olarak veriliyor. Buna göre Yusuf'un parasının Elif'in parasına oranı kaçtır?","secenekler":[{"harf":"A","metin":"8/21","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"B","metin":"6/7","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"27/14","dogru":true,"yanilgi":null},{"harf":"D","metin":"87/28","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"E","metin":"14/27","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"}],"cozum":[{"aciklama":"Ortadaki terim ortak olduğu için oranlar zincirlenir:","ifade":"(6/7) × (9/4)"},{"aciklama":"Çarpım sadeleştirilir:","ifade":"54/28 = 27/14"},{"aciklama":"Aranan oran:","ifade":"27/14"}],"mikrobeceriler":["oran.temel"],"yanilgi_alanlari":["oran.dogru"],"zorluk":1.346,"gorsel":null},{"kimlik":"2aa76e0f0fc1","sablon":"yuzde.kar_zarar.kar_orani","govde":"Maliyeti 340 TL olan bir çanta 850 TL fiyatına satılmıştır. Buna göre kâr oranı yüzde kaçtır?","secenekler":[{"harf":"A","metin":"%150","dogru":true,"yanilgi":null},{"harf":"B","metin":"%510","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"%250","dogru":false,"yanilgi":"kar_maliyet_yerine_satis"},{"harf":"D","metin":"%60","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"E","metin":"%40","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Önce kâr tutarını bul:","ifade":"850 TL − 340 TL = 510 TL"},{"aciklama":"Kâr oranının tabanı **maliyettir**, satış fiyatı değil:","ifade":"510 / 340 × 100 = 150"},{"aciklama":"Kâr oranı:","ifade":"%150"}],"mikrobeceriler":["yuzde.kar_zarar","yuzde.temel"],"yanilgi_alanlari":[],"zorluk":1.097,"gorsel":null},{"kimlik":"2a3ba34a66e9","sablon":"veri.tablo.satir_ortalamasi","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre İzmir'in dört mevsimdeki satışlarının ortalaması kaç adettir?","secenekler":[{"harf":"A","metin":"232 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"B","metin":"243 adet","dogru":true,"yanilgi":null},{"harf":"C","metin":"298 adet","dogru":false,"yanilgi":"toplamda_deger_iki_kez"},{"harf":"D","metin":"188 adet",