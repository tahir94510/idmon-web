iklama":"Üçüncü durumda gün sayısını sabitten çöz:","ifade":"720/15 = 48"},{"aciklama":"Gereken süre:","ifade":"48 gün"}],"mikrobeceriler":["oran.ters"],"yanilgi_alanlari":["oran.bilesik"],"zorluk":1.006,"gorsel":null},{"kimlik":"1f26814a86bd","sablon":"yuzde.temel.orandan_oran","govde":"Bir sayının %5'i 90'dır.\n\nBuna göre aynı sayının %30'u kaçtır?","secenekler":[{"harf":"A","metin":"115","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"B","metin":"540","dogru":true,"yanilgi":null},{"harf":"C","metin":"15","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"D","metin":"1.800","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"E","metin":"27","dogru":false,"yanilgi":"yuzde_taban_karisimi"}],"cozum":[{"aciklama":"Sayının %5'i biliniyorsa sayının kendisi bulunur:","ifade":"90 / (5/100) = 1.800"},{"aciklama":"Sayının %30'u:","ifade":"1.800 × 30/100 = 540"},{"aciklama":"Aranan değer:","ifade":"540"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["oran.temel","yuzde.artis_azalis"],"zorluk":-0.765,"gorsel":null},{"kimlik":"310b3d8168b4","sablon":"sayilar.mutlak.esitsizlik_tam_sayi","govde":"|4x + 27| < 35 eşitsizliğini sağlayan kaç tam sayı vardır?","secenekler":[{"harf":"A","metin":"17","dogru":true,"yanilgi":null},{"harf":"B","metin":"3","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"C","metin":"16","dogru":false,"yanilgi":"sayimda_bir_eksik"},{"harf":"D","metin":"8","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"9","dogru":false,"yanilgi":"esitsizlik_yon_degismedi"}],"cozum":[{"aciklama":"|A| < 35 eşitsizliği, A'nın −35 ile 35 arasında olması demektir:","ifade":"−35 < 4x + 27 < 35"},{"aciklama":"Eşitsizliğin her iki tarafına aynı işlemi uygula:","ifade":"−15,5 < x < 2"},{"aciklama":"Uçlar dâhil olmadığı için aralıktaki tam sayılar sayılır:","ifade":"17 tane"},{"aciklama":"Tam sayı adedi:","ifade":"17"}],"mikrobeceriler":["sayilar.mutlak","cebir.esitsizlik"],"yanilgi_alanlari":[],"zorluk":1.81,"gorsel":null},{"kimlik":"2adcc25673d4","sablon":"veri.grafik.daire_aciyla_sayi","govde":"Toplam 1.000 kişinin katıldığı bir ankette verilen cevapların merkez açıları yukarıdaki daire grafiğinde verilmiştir.\n\nBuna göre Öykü seçeneğini işaretleyen kaç kişi vardır?","secenekler":[{"harf":"A","metin":"250 kişi","dogru":false,"yanilgi":"veri_esit_dagilim_varsayimi"},{"harf":"B","metin":"150 kişi","dogru":true,"yanilgi":null},{"harf":"C","metin":"540 kişi","dogru":false,"yanilgi":"aciyi_yuzde_sanma"},{"harf":"D","metin":"75 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"E","metin":"850 kişi","dogru":false,"yanilgi":"tumleyeni_verme"}],"cozum":[{"aciklama":"Grafikte Öykü diliminin merkez açısını oku:","ifade":"54°"},{"aciklama":"Açıyı orana çevir: dairenin tamamı 360°, dağılımın tamamı 100'dür.","ifade":"54/360 = 0,15"},{"aciklama":"Bulunan oranı toplam kişi sayısıyla çarp:","ifade":"1.000 × 0,15 = 150"},{"aciklama":"Dereceyi doğrudan sayıya oranlamak iki adımdan birini atlamak olurdu; önce yüzde, sonra sayı.","ifade":null},{"aciklama":"Bu dilimi seçen kişi sayısı:","ifade":"150 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":[],"zorluk":0.427,"gorsel":{"tur":"daire","baslik":"Tercihlerin merkez açıları","etiketler":["Roman","Şiir","Deneme","Öykü"],"birim":"derece","seriler":[{"ad":"Açı","degerler":[198,72,36,54]}]}},{"kimlik":"cfab756ad3e9","sablon":"cebir.ozdeslik.kareler_toplami","govde":"a + b = 12 ve a · b = 22 olduğuna göre a² + b² kaçtır?","secenekler":[{"harf":"A","metin":"122","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"B","metin":"144","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"C","metin":"188","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"},{"harf":"D","metin":"56","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"E","metin":"100","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Tam kare açılımı orta terimi taşır:","ifade":"(a + b)² = a² + 2ab + b²"},{"aciklama":"İstenen a² + b² için orta terimi yalıt:","ifade":"a² + b² = (a + b)² − 2ab"},{"aciklama":"Değerleri yerine koy:","ifade":"12² − 2 × 22 = 144 − 44 = 100"},{"aciklama":"a² + b² değeri:","ifade":"100"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":0.724,"gorsel":null},{"kimlik":"d76812c5e953","sablon":"veri.grafik.daire_fark","govde":"Yukarıdaki daire grafiği 1.460 kişinin tercihlerinin dağılımını göstermektedir. Buna göre Öykü tercih edenler, Şiir tercih edenlerden kaç kişi fazladır?","secenekler":[{"harf":"A","metin":"2.920 kişi","dogru":false,"yanilgi":"grafik_eksen_olcegi"},{"harf":"B","metin":"511 kişi","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"C","metin":"292 kişi","dogru":true,"yanilgi":null},{"harf":"D","metin":"20 kişi","dogru":false,"yanilgi":"grafik_dilim_yuzde_sayi"},{"harf":"E","metin":"1.022 kişi","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Dilimler yüzdedir; önce ikisinin yüzde farkını al:","ifade":"%45 − %25 = %20"},{"aciklama":"Yüzde farkını kişi sayısına çevir:","ifade":"1.460 × 20 / 100 = 292"},{"aciklama":"Aradaki fark:","ifade":"292 kişi"}],"mikrobeceriler":["veri.grafik","veri.yuzde_pay"],"yanilgi_alanlari":["oran.paylastirma"],"zorluk":0.874,"gorsel":{"tur":"daire","baslik":"Tercih dağılımı","etiketler":["Roman","Şiir","Deneme","Öykü"],"birim":"%","seriler":[{"ad":"Pay","degerler":[10,25,20,45]}]}},{"kimlik":"b250a11aec43","sablon":"oran.bilesik.isci_ucret","govde":"2 işçi 11 günde çalışarak toplam 17.600 TL kazanmaktadır. Aynı günlük ücretle çalışan 5 işçi 10 günde toplam kaç TL kazanır?","secenekler":[{"harf":"A","metin":"44.000 TL","dogru":false,"yanilgi":"bilesik_oranti_tek_carpan"},{"harf":"B","metin":"16.000 TL","dogru":false,"yanilgi":"oran_carpim_capraz_hata"},{"harf":"C","metin":"40.000 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"7.744 TL","dogru":false,"yanilgi":"dogru_orantiyi_ters_kurma"},{"harf":"E","metin":"800 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"}],"cozum":[{"aciklama":"Toplam ücret, işçi sayısı ve gün sayısıyla doğru orantılıdır. Önce bir işçinin bir günlük ücretini bul:","ifade":"17.600 / (2 × 11) = 800 TL"},{"aciklama":"Yeni durumda toplam işçi-gün:","ifade":"5 × 10 = 50"},{"aciklama":"Toplam ücret:","ifade":"50 × 800 = 40.000 TL"},{"aciklama":"Kazanılan toplam ücret:","ifade":"40.000 TL"}],"mikrobeceriler":["oran.bilesik","oran.dogru","oran.ters"],"yanilgi_alanlari":[],"zorluk":1.201,"gorsel":null},{"kimlik":"257879dc92db","sablon":"yuzde.temel.ters_yuzde","govde":"Bir battaniye fiyatına %50 zam yapıldıktan sonra fiyatı 7.500 TL olmuştur. Battaniyenin zamdan önceki fiyatı kaç TL'dir?","secenekler":[{"harf":"A","metin":"3.750 TL","dogru":false,"yanilgi":"yuzde_taban_karisimi"},{"harf":"B","metin":"2.500 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"C","metin":"5.000 TL","dogru":true,"yanilgi":null},{"harf":"D","metin":"7.450 TL","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"E","metin":"15.000 TL","dogru":false,"yanilgi":"yuzde_yon_ters"}],"cozum":[{"aciklama":"Zamlı fiyat, eski fiyatın %150'sidir:","ifade":"eski × 150/100 = 7.500"},{"aciklama":"Eski fiyat, zamlı fiyatın bu orana bölümüdür:","ifade":"7.500 × 100/150 = 5.000 TL"},{"aciklama":"Zamdan önceki fiyat:","ifade":"5.000 TL"}],"mikrobeceriler":["yuzde.temel"],"yanilgi_alanlari":["yuzde.artis_azalis"],"zorluk":1.097,"gorsel":null},{"kimlik":"86f5089aa8b2","sablon":"sayilar.mutlak.kokler_carpimi","govde":"|x − 17| = 4 denkleminin köklerinin çarpımı kaçtır?","secenekler":[{"harf":"A","metin":"−273","dogru":false,"yanilgi":"mutlak_deger_dagitildi"},{"harf":"B","metin":"305","dogru":false,"yanilgi":"isaret_hatasi"},{"harf":"C","metin":"13","dogru":false,"yanilgi":"mutlak_deger_ic_isaret"},{"harf":"D","metin":"21","dogru":false,"yanilgi":"mutlak_deger_tek_kok"},{"harf":"E","metin":"273","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Mutlak değerli denklemin iki kökü vardır:","ifade":"x = 17 + 4 = 21 ve x = 17 − 4 = 13"},{"aciklama":"Kökleri çarp; iki kare farkı çıkar:","ifade":"(17 + 4) × (17 − 4) = 17² − 4² = 273"},{"aciklama":"Köklerin çarpımı:","ifade":"273"}],"mikrobeceriler":["sayilar.mutlak"],"yanilgi_alanlari":[],"zorluk":1.604,"gorsel":null},{"kimlik":"2f29772eeef9","sablon":"mantik.esleme.kesin_dogru","govde":"Ahmet, Fatma, Mehmet, Serkan ve Yusuf adlı beş kişi yan yana beş koltuğa oturmuştur. Buna göre:\n\n• Yusuf, Fatma adlı kişinin solunda oturmaktadır.\n• Serkan uçtaki koltuklarda oturmamaktadır.\n• Serkan, Yusuf adlı kişinin solunda oturmaktadır.\n• Ahmet uçtaki koltuklarda oturmamaktadır.\n• Mehmet, Ahmet adlı kişinin hemen solundadır.\n\nBuna göre aşağıdakilerden hangisi kesinlikle doğrudur?","secenekler":[{"harf":"A","metin":"Ahmet, Mehmet adlı kişinin hemen sağında oturmaktadır.","dogru":true,"yanilgi":null},{"harf":"B","metin":"Yusuf, Fatma adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kosul_ters"},{"harf":"C","metin":"Yusuf, Ahmet adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_kesin_olmayan_cikarim"},{"harf":"D","metin":"Serkan, Yusuf adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_tek_senaryo"},{"harf":"E","metin":"Mehmet, Serkan adlı kişinin hemen sağında oturmaktadır.","dogru":false,"yanilgi":"esleme_olumsuz_kosul_atlandi"}],"cozum":[{"aciklama":"Kısıtları soldan sağa bir tabloya işle. 'Hemen solunda' kısıtı iki kişiyi bitişik bir blok yapar; 'solunda' kısıtı yalnızca sırayı söyler, bitişikliği değil.","ifade":null},{"aciklama":"Olumsuz kısıtlar da eleme yapar; onları da işaretle.","ifade":null},{"aciklama":"Bütün kısıtları birlikte sağlayan tek dizilim şudur:","ifade":"Mehmet − Ahmet − Serkan − Yusuf − Fatma"},{"aciklama":"Kesinlikle doğru olan ifade:","ifade":"Ahmet, Mehmet adlı kişinin hemen sağında oturmaktadır."}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":2.526,"gorsel":null},{"kimlik":"5b8a9a954e3c","sablon":"problem.isci.birlikte","govde":"Bir işi Emre tek başı