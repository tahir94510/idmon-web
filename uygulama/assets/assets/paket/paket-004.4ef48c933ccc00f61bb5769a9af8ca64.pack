ma"],"zorluk":3.704,"gorsel":null},{"kimlik":"860e1cc395a0","sablon":"yuzde.faiz.basit_ay","govde":"40.800 TL tutarındaki bir anapara, yıllık %24 basit faiz oranıyla 8 ay vadeli olarak yatırılmıştır. Vade sonunda elde edilen faiz kaç TL'dir?","secenekler":[{"harf":"A","metin":"9.792 TL","dogru":false,"yanilgi":"faizde_sure_atlandi"},{"harf":"B","metin":"1.224 TL","dogru":false,"yanilgi":"faizde_sure_bolme"},{"harf":"C","metin":"47.328 TL","dogru":false,"yanilgi":"sorulani_degil_arayi_verme"},{"harf":"D","metin":"78.336 TL","dogru":false,"yanilgi":"birim_donusumu"},{"harf":"E","metin":"6.528 TL","dogru":true,"yanilgi":null}],"cozum":[{"aciklama":"Basit faiz = anapara × yıllık oran × süre (yıl cinsinden).","ifade":null},{"aciklama":"8 ay, yıl cinsinden:","ifade":"8/12"},{"aciklama":"Faiz tutarı:","ifade":"40.800 × 24/100 × 8/12 = 6.528 TL"},{"aciklama":"Elde edilen faiz:","ifade":"6.528 TL"}],"mikrobeceriler":["yuzde.faiz"],"yanilgi_alanlari":[],"zorluk":1.178,"gorsel":null},{"kimlik":"8aabecf22e44","sablon":"veri.tablo.en_yuksek_oran","govde":"Yukarıdaki tabloda dört mağazanın satış ve iade sayıları veriliyor. Satışın iadeye oranı en yüksek olan mağazanın satış sayısı kaç adettir?","secenekler":[{"harf":"A","metin":"345 adet","dogru":true,"yanilgi":null},{"harf":"B","metin":"180 adet","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"C","metin":"395 adet","dogru":false,"yanilgi":"toplam_yerine_parca"},{"harf":"D","metin":"14 adet","dogru":false,"yanilgi":"grafik_yanlis_seri"},{"harf":"E","metin":"390 adet","dogru":false,"yanilgi":"fark_yerine_toplam"}],"cozum":[{"aciklama":"Her satır için satış/iade oranını kur:","ifade":"Konya: 395/42 · Trabzon: 180/34 · Bursa: 390/22 · Ankara: 345/14"},{"aciklama":"Oranları karşılaştır. En büyük satış sayısı en büyük oranı **vermez**: iade sayısı da değişiyor.","ifade":null},{"aciklama":"En yüksek oran Ankara satırında:","ifade":"345/14"},{"aciklama":"O satırın satış sayısı:","ifade":"345 adet"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["oran.temel","oran.paylastirma"],"zorluk":0.574,"gorsel":{"tur":"tablo","baslik":"Satış ve iade sayıları (adet)","etiketler":["Satış","İade"],"birim":"adet","seriler":[{"ad":"Konya","degerler":[395,42]},{"ad":"Trabzon","degerler":[180,34]},{"ad":"Bursa","degerler":[390,22]},{"ad":"Ankara","degerler":[345,14]}]}},{"kimlik":"e8fb45c798e4","sablon":"cebir.ozdeslik.ters_toplam","govde":"x + 12/x = 17 olduğuna göre x² + 12²/x² kaçtır?","secenekler":[{"harf":"A","metin":"241","dogru":false,"yanilgi":"iki_kare_farki_toplam"},{"harf":"B","metin":"265","dogru":true,"yanilgi":null},{"harf":"C","metin":"277","dogru":false,"yanilgi":"tam_kare_orta_terim_katsayi"},{"harf":"D","metin":"289","dogru":false,"yanilgi":"tam_kare_orta_terim"},{"harf":"E","metin":"313","dogru":false,"yanilgi":"ozdeslik_isaret_kaymasi"}],"cozum":[{"aciklama":"İfadenin karesini al; tam kare açılımında orta terim çıkar:","ifade":"(x + 12/x)² = x² + 2 · x · 12/x + 12²/x²"},{"aciklama":"Orta terimde x sadeleşir ve geriye 2 · 12 kalır:","ifade":"17² = x² + 12²/x² + 24"},{"aciklama":"İstenen ifadeyi yalıt:","ifade":"x² + 12²/x² = 289 − 24 = 265"},{"aciklama":"İstenen değer:","ifade":"265"}],"mikrobeceriler":["cebir.ozdeslik"],"yanilgi_alanlari":[],"zorluk":2.606,"gorsel":null},{"kimlik":"e3faa6b714c3","sablon":"kume.olasilik.geri_koymadan","govde":"Bir torbada 21 tane mavi, 10 tane sarı top vardır. Torbadan rastgele çekilen bir top geri konulmadan ikinci bir top çekiliyor. Çekilen iki topun da mavi olma olasılığı kaçtır?","secenekler":[{"harf":"A","metin":"42/31","dogru":false,"yanilgi":"olasilik_toplam_bir_asildi"},{"harf":"B","metin":"14/31","dogru":true,"yanilgi":null},{"harf":"C","metin":"420/961","dogru":false,"yanilgi":"olasilik_ornek_uzay"},{"harf":"D","metin":"28/31","dogru":false,"yanilgi":"olasilik_tumleyen_atlandi"},{"harf":"E","metin":"441/961","dogru":false,"yanilgi":"olasilik_bagimsiz_sanildi"}],"cozum":[{"aciklama":"Birinci topun mavi olma olasılığı:","ifade":"21/31"},{"aciklama":"Top geri konulmadığı için ikinci çekilişte hem torbadaki toplam hem mavi sayısı birer azalır:","ifade":"20/30"},{"aciklama":"Peş peşe gerçekleşen olayların olasılıkları çarpılır:","ifade":"21/31 × 20/30 = 420/930 = 14/31"},{"aciklama":"İstenen olasılık:","ifade":"14/31"}],"mikrobeceriler":["kume.olasilik"],"yanilgi_alanlari":[],"zorluk":2.916,"gorsel":null},{"kimlik":"7f964e50a975","sablon":"mantik.esleme.yerlestirme","govde":"3, 5, 7, 12, 14 ve 15 sayılarından beşi aşağıdaki kutulara birer kez yazılarak doğru bir eşitlik kuruluyor. Sayılardan biri dışarıda kalıyor.\n\n□ + □ + □ = □ × □\n\nBuna göre dışarıda kalan sayı kaçtır?","secenekler":[{"harf":"A","metin":"15","dogru":false,"yanilgi":null},{"harf":"B","metin":"12","dogru":false,"yanilgi":null},{"harf":"C","metin":"3","dogru":false,"yanilgi":null},{"harf":"D","metin":"5","dogru":true,"yanilgi":null},{"harf":"E","metin":"7","dogru":false,"yanilgi":null}],"cozum":[{"aciklama":"Sağdaki iki sayının çarpımı, soldaki üç sayının toplamına eşit olmalı.","ifade":null},{"aciklama":"İki sayının çarpımını dene; kalan sayılardan uygun olanlarla eşitliği tamamlayıp tamamlayamadığına bak.","ifade":null},{"aciklama":"Eşitliği sağlayan düzen:","ifade":"7 + 14 + 15 = 3 × 12"},{"aciklama":"Başka hiçbir düzende başka bir sayı dışarıda kalmıyor; eşitliği kuran her düzende aynı sayı açıkta.","ifade":null},{"aciklama":"Dışarıda kalan sayı:","ifade":"5"}],"mikrobeceriler":["mantik.esleme"],"yanilgi_alanlari":[],"zorluk":0.592,"gorsel":null,"cevap_uzayi":true},{"kimlik":"ed893a38f0f5","sablon":"sayilar.basamak.uc_basamak_yer_degistirme","govde":"Üç basamaklı bir sayının yüzler ve birler basamağındaki rakamlar yer değiştirdiğinde sayı 99 azalmaktadır. Bu sayının yüzler basamağındaki rakam 5, onlar basamağındaki rakam 7'dir. Buna göre sayı kaçtır?","secenekler":[{"harf":"A","metin":"54","dogru":false,"yanilgi":"sifir_basamak_atlandi"},{"harf":"B","metin":"574","dogru":true,"yanilgi":null},{"harf":"C","metin":"475","dogru":false,"yanilgi":"basamak_yer_degistirme"},{"harf":"D","metin":"511","dogru":false,"yanilgi":"basamak_degeri_sayi_degeri"},{"harf":"E","metin":"547","dogru":false,"yanilgi":"basamak_cozumleme_hatasi"}],"cozum":[{"aciklama":"Sayı 100y + 10o + b, yer değiştirmişi 100b + 10o + y'dir. Aradaki fark yalnızca uç basamaklardan gelir:","ifade":"(100y + 10o + b) − (100b + 10o + y) = 99 × (y − b)"},{"aciklama":"Verilen azalmayı yerine koy:","ifade":"99 × (5 − b) = 99 ⟹ 5 − b = 1 ⟹ b = 4"},{"aciklama":"Rakamları basamak ağırlıklarıyla birleştir:","ifade":"100 × 5 + 10 × 7 + 4 = 574"},{"aciklama":"Aranan sayı:","ifade":"574"}],"mikrobeceriler":["sayilar.basamak"],"yanilgi_alanlari":[],"zorluk":-0.267,"gorsel":null},{"kimlik":"cfb28a6c6546","sablon":"veri.tablo.iki_hucre_orani","govde":"Bir firmanın dört şehirdeki mağazalarının mevsimlere göre satış sayıları yukarıdaki tabloda verilmiştir.\n\nBuna göre Kış mevsiminde Konya'nın yaptığı satışın İzmir'in yaptığı satışa oranı kaçtır?","secenekler":[{"harf":"A","metin":"2","dogru":true,"yanilgi":null},{"harf":"B","metin":"40","dogru":false,"yanilgi":"yuzde_yerine_fark"},{"harf":"C","metin":"0,5","dogru":false,"yanilgi":"oran_terslendi"},{"harf":"D","metin":"0,4","dogru":false,"yanilgi":"veri_yanlis_paydaya_bolme"},{"harf":"E","metin":"1","dogru":false,"yanilgi":"grafik_yanlis_seri"}],"cozum":[{"aciklama":"Kış sütunundan iki değeri oku:","ifade":"Konya: 80 · İzmir: 40"},{"aciklama":"Oran, sorulan sırayla kurulur (önce geçen paya yazılır):","ifade":"80 / 40 = 2"},{"aciklama":"Aranan oran:","ifade":"2"}],"mikrobeceriler":["veri.tablo"],"yanilgi_alanlari":["veri.yuzde_pay","oran.temel"],"zorluk":-0.193,"gorsel":{"tur":"tablo","baslik":"Mevsimlere göre satış (adet)","etiketler":["İlkbahar","Yaz","Sonbahar","Kış"],"birim":"adet","seriler":[{"ad":"İzmir","degerler":[110,30,20,40]},{"ad":"Trabzon","degerler":[120,100,50,110]},{"ad":"Konya","degerler":[110,50,120,80]},{"ad":"Eskişehir","degerler":[70,70,110,110]}]}},{"kimlik":"4e05fcad0694","sablon":"prob